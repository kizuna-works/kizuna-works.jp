---
// Cross-page notice for the KW Plugin Updater Chrome extension.
//
// Why a component: the same message goes on the home page, the plugin index and the
// ranking page. Each audience is at a different stage (browsing / about to install /
// already installed), so the heading and lead differ per page while the layout, the
// store URL and the GA label stay in one place.
//
// The store URL comes from extensions.ts so it can never drift from the product data.
import Picture from './Picture.astro';
import { extensions } from '../data/extensions';

interface Props {
  /** Headline — write it for the audience of the page it sits on. */
  heading: string;
  /** One or two sentences under the headline. */
  body: string;
  /** GA4 event label so we can tell which surface actually drives installs. */
  gaLabel: string;
  /** Tint the block for pages whose surrounding section is white. */
  tone?: 'light' | 'white';
}

const { heading, body, gaLabel, tone = 'light' } = Astro.props;

const ext = extensions.find((e) => e.slug === 'kw-plugin-updater-for-kintone');
const storeUrl = ext?.chromeWebStoreUrl ?? '';
const pageUrl = '/extensions/kw-plugin-updater-for-kintone/';
---

<section class:list={['ext-notice', `is-${tone}`]} aria-labelledby={`ext-notice-${gaLabel}`}>
  <div class="ext-notice-inner">
    <div class="ext-notice-icon">
      <Picture
        src="/images/extensions/kw-plugin-updater-icon.png"
        alt="KW Plugin Updater for kintone のアイコン"
        width="256"
        height="256"
      />
    </div>

    <div class="ext-notice-body">
      <span class="ext-notice-eyebrow">Chrome 拡張機能・完全無料</span>
      <h2 class="ext-notice-heading" id={`ext-notice-${gaLabel}`}>{heading}</h2>
      <p class="ext-notice-text">{body}</p>
      <ul class="ext-notice-chips">
        <li>導入済みの版を自動照合</li>
        <li>プラグイン一覧を外部送信しない</li>
        <li>Chrome / Edge 対応</li>
      </ul>
    </div>

    <div class="ext-notice-actions">
      {storeUrl && (
        <a
          class="ext-notice-btn"
          href={storeUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-ext-cta={gaLabel}
          data-ext-cta-kind="store"
        >
          ウェブストアで入手
        </a>
      )}
      <a class="ext-notice-btn ghost" href={pageUrl} data-ext-cta={gaLabel} data-ext-cta-kind="detail">
        詳しく見る
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // GA4: which surface (home / plugins / ranking) actually drives installs.
  document.querySelectorAll('[data-ext-cta]').forEach((el) => {
    el.addEventListener('click', () => {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', 'ext_updater_click', {
        surface: el.getAttribute('data-ext-cta'),
        link_kind: el.getAttribute('data-ext-cta-kind'),
      });
    });
  });
</script>

<style>
  .ext-notice {
    padding: 40px 5%;
  }
  .ext-notice.is-light {
    background: #F0F4F8;
  }
  .ext-notice.is-white {
    background: #FFFFFF;
  }
  .ext-notice-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 24px;
    background: #FFFFFF;
    border: 1px solid #e2e8f0;
    border-left: 5px solid #2E8B2E;
    border-radius: 14px;
    padding: 24px 28px;
    box-shadow: 0 4px 16px rgba(27, 58, 107, 0.08);
  }
  .ext-notice.is-white .ext-notice-inner {
    background: #F8FBF8;
  }

  .ext-notice-icon {
    flex-shrink: 0;
    width: 68px;
  }
  .ext-notice-icon :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
  }

  .ext-notice-body {
    flex: 1;
    min-width: 0;
  }
  .ext-notice-eyebrow {
    display: inline-block;
    background: #e6f4e6;
    color: #1f6b1f;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border-radius: 10px;
    margin-bottom: 8px;
  }
  .ext-notice-heading {
    color: #1B3A6B;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.5;
    margin: 0 0 8px;
  }
  .ext-notice-text {
    color: #4a5568;
    font-size: 0.92rem;
    line-height: 1.8;
    margin: 0 0 12px;
  }
  .ext-notice-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ext-notice-chips li {
    background: #F0F4F8;
    color: #1B3A6B;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 12px;
  }

  .ext-notice-actions {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 200px;
  }
  .ext-notice-btn {
    display: block;
    text-align: center;
    background: #2E8B2E;
    color: #FFFFFF;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 12px 18px;
    border-radius: 24px;
    text-decoration: none;
    transition: background-color 0.25s, transform 0.25s;
  }
  .ext-notice-btn:hover {
    background: #36a336;
    transform: translateY(-2px);
  }
  .ext-notice-btn.ghost {
    background: #FFFFFF;
    color: #1B3A6B;
    border: 1px solid #cbd5e1;
  }
  .ext-notice-btn.ghost:hover {
    background: #F0F4F8;
    color: #1B3A6B;
  }

  @media (max-width: 860px) {
    .ext-notice {
      padding: 32px 5%;
    }
    .ext-notice-inner {
      flex-wrap: wrap;
      /* Top-align once it wraps: centering leaves the icon floating beside a tall
         text block instead of sitting next to the heading. */
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
    }
    .ext-notice-icon {
      width: 52px;
    }
    .ext-notice-body {
      flex: 1 1 200px;
    }
    .ext-notice-actions {
      width: 100%;
      flex-direction: row;
    }
    .ext-notice-btn {
      flex: 1;
    }
  }
  @media (max-width: 480px) {
    .ext-notice-actions {
      flex-direction: column;
    }
    .ext-notice-heading {
      font-size: 1.08rem;
    }
  }
</style>
