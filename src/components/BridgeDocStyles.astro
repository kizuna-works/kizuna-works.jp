---
// Shared look for the two reference pages of KIZUNA Bridge:
// /plugins/bridge/guide/ and /plugins/bridge/formula/.
---
<style is:global>
  body { background-color: #F0F4F8; }
  .bd-hero {
    background:
      url('/images/kizuna-pro-hero-bg.webp') center top / 100% auto no-repeat,
      linear-gradient(90deg, #020816 0%, #050b1c 30%, #081427 50%, #09182f 70%, #0c1729 100%);
    color: #fff;
    padding: 48px 5% 40px;
    text-align: center;
    border-bottom: 4px solid #b8862b;
  }
  .bd-crumb { font-size: 0.82rem; margin: 0 0 14px; color: rgba(255, 255, 255, 0.75); }
  .bd-crumb a { color: #f0d58a; text-decoration: none; }
  .bd-crumb a:hover { text-decoration: underline; }
  .bd-hero h1 { font-size: clamp(1.5rem, 3.8vw, 2.2rem); margin: 0 0 14px; line-height: 1.4; }
  .bd-hero p { max-width: 820px; margin: 0 auto 10px; line-height: 1.9; color: rgba(255, 255, 255, 0.92); }
  .bd-hero p:last-child { margin-bottom: 0; }
  .bd-hero strong { color: #fff; }
  .bd-hero a { color: #f0d58a; }

  .bd-section { padding: 36px 5% 8px; }
  .bd-section:last-of-type { padding-bottom: 64px; }
  .bd-wrap { max-width: 980px; margin: 0 auto; min-width: 0; }
  .bd-card { background: #fff; border: 1px solid #dbe3ee; border-radius: 12px; padding: 24px 26px; margin: 0 0 20px; min-width: 0; }
  .bd-card h2 { font-size: 1.3rem; color: #1B3A6B; margin: 0 0 12px; padding-bottom: 8px; border-bottom: 3px solid #2E8B2E; line-height: 1.5; scroll-margin-top: 100px; }
  .bd-card h3 { font-size: 1.05rem; color: #1B3A6B; margin: 22px 0 8px; line-height: 1.5; scroll-margin-top: 100px; }
  .bd-card p { margin: 0 0 12px; line-height: 1.9; color: #333; font-size: 0.95rem; }
  .bd-card ul, .bd-card ol { margin: 0 0 12px; padding-left: 1.4em; line-height: 1.9; color: #333; font-size: 0.95rem; }
  .bd-card li { margin: 0 0 4px; }
  .bd-card code { background: #eef1f5; color: #0f1f3d; padding: 1px 6px; border-radius: 4px; font-size: 0.88em; overflow-wrap: anywhere; }
  .bd-card pre { background: #0f1f3d; color: #f4f7fb; padding: 12px 14px; border-radius: 8px; overflow-x: auto; margin: 0 0 12px; font-size: 0.88rem; line-height: 1.7; max-width: 100%; }
  .bd-card pre code { background: none; color: inherit; padding: 0; }
  .bd-note { background: #fbf7ec; border: 1px solid #ecdcae; border-radius: 8px; padding: 10px 14px; margin: 0 0 14px; font-size: 0.9rem; line-height: 1.8; color: #5a4310; }
  .bd-note p { margin: 0; font-size: inherit; color: inherit; }
  .bd-note strong { color: #5a4310; }

  .bd-toc { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .bd-toc li { margin: 0; }
  .bd-toc a { display: inline-block; padding: 7px 14px; border-radius: 20px; border: 1px solid #c9d3e0; background: #fff; color: #1B3A6B; text-decoration: none; font-size: 0.88rem; font-weight: 700; }
  .bd-toc a:hover { border-color: #1B3A6B; }

  .bd-scroll { overflow-x: auto; margin: 0 0 14px; max-width: 100%; }
  .bd-table { border-collapse: collapse; width: 100%; font-size: 0.88rem; line-height: 1.7; min-width: 520px; }
  .bd-table th, .bd-table td { border: 1px solid #dbe3ee; padding: 8px 10px; text-align: left; vertical-align: top; color: #333; }
  .bd-table th { background: #1B3A6B; color: #fff; font-weight: 700; white-space: nowrap; }
  .bd-table tbody tr:nth-child(even) td { background: #f7f9fc; }
  .bd-table code { white-space: nowrap; }

  .bd-link-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 0; }
  .bd-btn { display: inline-block; padding: 10px 20px; border-radius: 30px; font-weight: 700; text-decoration: none; font-size: 0.92rem; }
  .bd-btn.is-primary { background: linear-gradient(135deg, #e8c766 0%, #b8862b 100%); color: #1a1405; }
  .bd-btn.is-line { border: 1px solid #1B3A6B; color: #1B3A6B; background: #fff; }
  .bd-btn.is-line:hover { background: #eef2f8; }

  @media (max-width: 640px) {
    .bd-card { padding: 18px 16px; }
    .bd-btn { width: 100%; box-sizing: border-box; text-align: center; }
  }
</style>
