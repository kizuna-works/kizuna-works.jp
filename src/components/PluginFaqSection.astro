---
// Renders both the FAQ accordion (details/summary) and the FAQPage JSON-LD
// for the given plugin. Drop this into any plugin detail page near the bottom
// (right before SupporterCTA) to gain the FAQ rich-result eligibility.
import { getFaqs, getFaqJsonLd } from '../data/plugin-faqs';

interface Props {
  pluginId: string;
  pageUrl: string;
}

const { pluginId, pageUrl } = Astro.props;
const faqs = getFaqs(pluginId);
const faqJsonLd = getFaqJsonLd(pluginId, pageUrl);
---

{faqs.length > 0 && (
  <>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <section class="plugin-faq-section" aria-labelledby="plugin-faq-heading">
      <div class="plugin-faq-inner">
        <h2 id="plugin-faq-heading" class="plugin-faq-heading">よくある質問</h2>
        <div class="plugin-faq-list">
          {faqs.map((f) => (
            <details class="plugin-faq">
              <summary>
                <span class="plugin-faq-q">{f.q}</span>
                <span class="plugin-faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="plugin-faq-answer">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </>
)}

<style>
  .plugin-faq-section {
    background: #F0F4F8;
    padding: 64px 5%;
  }
  .plugin-faq-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .plugin-faq-heading {
    color: #1B3A6B;
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    margin: 0 0 32px 0;
    position: relative;
    padding-bottom: 12px;
  }
  .plugin-faq-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 56px;
    height: 3px;
    background: #2E8B2E;
    border-radius: 2px;
  }
  .plugin-faq-list {
    display: grid;
    gap: 10px;
  }
  .plugin-faq {
    background: #FFFFFF;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .plugin-faq[open] {
    border-color: #1B3A6B;
    box-shadow: 0 4px 12px rgba(27, 58, 107, 0.08);
  }
  .plugin-faq summary {
    list-style: none;
    cursor: pointer;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #1B3A6B;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.5;
  }
  .plugin-faq summary::-webkit-details-marker {
    display: none;
  }
  .plugin-faq-q {
    flex: 1;
  }
  .plugin-faq-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .plugin-faq-icon::before,
  .plugin-faq-icon::after {
    content: '';
    position: absolute;
    background: #2E8B2E;
    transition: transform 0.18s ease;
  }
  .plugin-faq-icon::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    transform: translateY(-50%);
  }
  .plugin-faq-icon::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
  }
  .plugin-faq[open] .plugin-faq-icon::after {
    transform: translateX(-50%) scaleY(0);
  }
  .plugin-faq-answer {
    padding: 0 22px 20px;
    color: #333333;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .plugin-faq-section {
      padding: 48px 5%;
    }
    .plugin-faq-heading {
      font-size: 1.4rem;
    }
    .plugin-faq summary {
      padding: 16px 18px;
      font-size: 0.95rem;
    }
    .plugin-faq-answer {
      padding: 0 18px 18px;
      font-size: 0.9rem;
    }
  }
</style>
