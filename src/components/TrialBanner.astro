---
// Reusable campaign banner linking to the Premium Free Trial LP.
// Used on the supporter page and the plugins index to drive trial signups.
---

<aside class="tb-banner">
  <a class="tb-inner" href="/plugins/premium-trial/">
    <div class="tb-text">
      <span class="tb-badge">30日間無料キャンペーン</span>
      <span class="tb-title">プレミアム年間サポーターを、30日間無料でお試し</span>
      <span class="tb-desc">全プラグイン（ちょこっと＋プレミアム）が広告なし・全機能で使えます。カード登録不要・自動課金なし。</span>
    </div>
    <span class="tb-cta">無料体験を見る <span aria-hidden="true">→</span></span>
  </a>
</aside>

<style>
  .tb-banner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 5%;
  }

  .tb-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background: linear-gradient(120deg, #12294d 0%, #1B3A6B 38%, #226b45 78%, #2E8B2E 100%);
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-radius: 16px;
    padding: 24px 30px;
    text-decoration: none;
    color: #FFFFFF;
    box-shadow: 0 10px 26px rgba(27, 58, 107, 0.18);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .tb-inner:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(27, 58, 107, 0.26);
  }

  .tb-text {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tb-badge {
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 12px;
    border-radius: 20px;
  }

  .tb-title {
    font-size: 1.2rem;
    font-weight: 900;
    line-height: 1.5;
  }

  .tb-desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: #eaf3ea;
  }

  .tb-cta {
    flex-shrink: 0;
    background-color: #FFFFFF;
    color: #1f6f2a;
    font-weight: 700;
    font-size: 0.98rem;
    padding: 12px 22px;
    border-radius: 8px;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .tb-inner {
      padding: 20px 22px;
    }
    .tb-title {
      font-size: 1.05rem;
    }
    .tb-cta {
      width: 100%;
      text-align: center;
    }
  }
</style>
