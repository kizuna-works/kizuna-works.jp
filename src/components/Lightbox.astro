---
// Global click-to-enlarge lightbox for kintone screenshots and plugin
// preview images. Automatically applies to images inside these containers
// used across plugin product pages:
//   .compare-image                  (Before / After comparison images)
//   .screenshot-thumb img           (theme-styler / field-comment style)
//   .screenshot-item > img          (conditional-numbering style)
//   .screenshots-grid img           (catch-all for any screenshot grid)
//   .screenshot-gallery img         (legacy field-styler screenshot gallery)
//   .ba-item img                    (legacy field-styler Before/After block)
//   .lightbox-image                 (explicit opt-in class)
//
// Excludes images inside .related-posts-grid, .plugin-card, etc. by relying
// on the specific class names above rather than blanket `img` selectors.
---

<div id="kw-lightbox" hidden role="dialog" aria-modal="true" aria-label="拡大画像">
  <button type="button" class="kw-lightbox-close" aria-label="閉じる">×</button>
  <img class="kw-lightbox-image" alt="" />
</div>

<style is:global>
  /* Zoomable images: indicate clickability */
  .compare-image,
  .screenshot-thumb img,
  .screenshot-item > img,
  .screenshots-grid img,
  .screenshot-gallery img,
  .ba-item img,
  .lightbox-image {
    cursor: zoom-in;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .compare-image:hover,
  .screenshot-thumb img:hover,
  .screenshot-item > img:hover,
  .screenshots-grid img:hover,
  .screenshot-gallery img:hover,
  .ba-item img:hover,
  .lightbox-image:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.14);
  }

  /* Lightbox overlay */
  #kw-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    padding: 24px;
    cursor: zoom-out;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  #kw-lightbox[hidden] { display: none; }
  #kw-lightbox.is-open { opacity: 1; }

  .kw-lightbox-image {
    max-width: 95vw;
    max-height: 90vh;
    object-fit: contain;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.55);
    background: #fff;
    border-radius: 4px;
    cursor: default;
  }

  .kw-lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
    font-family: inherit;
  }
  .kw-lightbox-close:hover,
  .kw-lightbox-close:focus {
    background: rgba(255, 255, 255, 0.24);
    outline: none;
  }

  @media (max-width: 768px) {
    #kw-lightbox { padding: 8px; }
    .kw-lightbox-image { max-width: 100vw; max-height: 85vh; }
    .kw-lightbox-close { width: 40px; height: 40px; font-size: 24px; top: 8px; right: 8px; }
  }
</style>

<script is:inline>
  (function () {
    var overlay = document.getElementById('kw-lightbox');
    if (!overlay) return;
    var fullImg = overlay.querySelector('.kw-lightbox-image');
    var closeBtn = overlay.querySelector('.kw-lightbox-close');

    // Selectors that opt in to the lightbox.
    var SELECTORS = [
      '.compare-image',
      '.screenshot-thumb img',
      '.screenshot-item > img',
      '.screenshots-grid img',
      '.screenshot-gallery img',
      '.ba-item img',
      '.lightbox-image'
    ].join(',');

    function open(src, alt) {
      fullImg.src = src;
      fullImg.alt = alt || '';
      overlay.hidden = false;
      requestAnimationFrame(function () {
        overlay.classList.add('is-open');
      });
      document.body.style.overflow = 'hidden';
      // Move focus to close button for keyboard accessibility
      try { closeBtn.focus({ preventScroll: true }); } catch (e) {}
    }

    function close() {
      overlay.classList.remove('is-open');
      setTimeout(function () {
        overlay.hidden = true;
        fullImg.removeAttribute('src');
        document.body.style.overflow = '';
      }, 200);
    }

    // Event delegation: handle clicks anywhere on the document, check whether
    // the click target is (or is inside) a matching image.
    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!(target instanceof Element)) return;
      // Skip clicks inside the lightbox itself (closing handled separately)
      if (overlay.contains(target)) return;

      // Find the matching image (target itself, or descendant of a matching wrapper)
      var img = null;
      if (target.tagName === 'IMG' && target.matches(SELECTORS)) {
        img = target;
      } else {
        // For .compare-image, the image IS the matched element.
        // For wrapper selectors like ".screenshot-thumb img", the img inside is.
        // Walk up to find a matching wrapper, then take the first img.
        var wrapper = target.closest('.screenshot-thumb, .screenshot-item, .screenshots-grid, .screenshot-gallery, .ba-item, .lightbox-image, .compare-image');
        if (wrapper) {
          img = wrapper.tagName === 'IMG'
            ? wrapper
            : wrapper.querySelector('img');
        }
      }
      if (!img || img.tagName !== 'IMG') return;
      // Use currentSrc when available (handles <picture>/srcset), else src
      var url = img.currentSrc || img.src;
      if (!url) return;
      e.preventDefault();
      open(url, img.alt);
    });

    // Click on backdrop or close button closes the lightbox.
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay || e.target === closeBtn) close();
    });

    // ESC key closes
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.hidden) close();
    });
  })();
</script>
