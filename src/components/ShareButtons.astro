---
// Social share buttons (intent-link method — no third-party SDK/JS).
// X / LINE / はてなブックマーク open as static links; URL copy and the mobile
// OS share sheet (Web Share API) are the only client-side JS.
// Drop into a plugin detail page near the FAQ / supporter CTA.
interface Props {
  title: string; // share text (usually the plugin display name + short phrase)
  url?: string; // canonical URL; defaults to the current page's absolute URL
  label?: string; // heading text
}

const site = Astro.site?.href ?? 'https://kizuna-works.jp/';
const { title, url, label = 'このプラグインをシェア' } = Astro.props;
const shareUrl = url ?? new URL(Astro.url.pathname, site).href;

const enc = encodeURIComponent;
const xUrl = `https://x.com/intent/tweet?text=${enc(title)}&url=${enc(shareUrl)}&via=KIZUNA_works_DX`;
const lineUrl = `https://social-plugins.line.me/lineit/share?url=${enc(shareUrl)}`;
const hatenaUrl = `https://b.hatena.ne.jp/add?mode=confirm&url=${enc(shareUrl)}&title=${enc(title)}`;
---

<section class="share-section" data-share-url={shareUrl} data-share-title={title}>
  <div class="share-card">
    <span class="share-label">{label}</span>
    <div class="share-btns">
      <a
        class="share-btn share-x"
        href={xUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X（旧Twitter）でシェア"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
          ></path>
        </svg>
        <span>X</span>
      </a>

      <a
        class="share-btn share-line"
        href={lineUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LINEでシェア"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 2C6.48 2 2 5.64 2 10.13c0 4.02 3.55 7.39 8.36 8.03.32.07.77.21.88.49.1.25.06.63.03.88l-.14.86c-.04.25-.2 1 .88.54 1.08-.45 5.8-3.42 7.92-5.85C21.27 13.5 22 11.9 22 10.13 22 5.64 17.52 2 12 2ZM8.28 12.5H6.3a.53.53 0 0 1-.53-.53V8.03a.53.53 0 0 1 1.06 0v3.4h1.45a.53.53 0 0 1 0 1.07Zm2.07-.53a.53.53 0 0 1-1.06 0V8.03a.53.53 0 0 1 1.06 0v3.94Zm4.71 0a.53.53 0 0 1-.36.5.55.55 0 0 1-.17.03.53.53 0 0 1-.43-.21l-2.02-2.75v2.43a.53.53 0 0 1-1.06 0V8.03a.53.53 0 0 1 .36-.5.53.53 0 0 1 .6.18l2.02 2.75V8.03a.53.53 0 0 1 1.06 0v3.94Zm3.34-2.5a.53.53 0 0 1 0 1.06h-1.45v.92h1.45a.53.53 0 0 1 0 1.05h-1.98a.53.53 0 0 1-.53-.52V8.03a.53.53 0 0 1 .53-.53h1.98a.53.53 0 0 1 0 1.06h-1.45v.92h1.45Z"
          ></path>
        </svg>
        <span>LINE</span>
      </a>

      <a
        class="share-btn share-hatena"
        href={hatenaUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="はてなブックマークに追加"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <text
            x="12"
            y="18"
            text-anchor="middle"
            fill="currentColor"
            font-family="Arial, Helvetica, sans-serif"
            font-size="17"
            font-weight="900">B!</text>
        </svg>
        <span>はてブ</span>
      </a>

      <button class="share-btn share-copy" type="button" aria-label="URLをコピー">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1Zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 16H8V7h11v14Z"
          ></path>
        </svg>
        <span class="share-copy-label">URLコピー</span>
      </button>

      <button class="share-btn share-native" type="button" aria-label="その他の方法でシェア" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81a3 3 0 1 0-3-3c0 .24.04.47.09.7L8.04 9.81A3 3 0 1 0 6 15c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65a2.92 2.92 0 1 0 2.92-2.92Z"
          ></path>
        </svg>
        <span>その他</span>
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.share-section').forEach((section) => {
    const url = section.dataset.shareUrl ?? location.href;
    const title = section.dataset.shareTitle ?? document.title;

    // URL copy
    const copyBtn = section.querySelector<HTMLButtonElement>('.share-copy');
    const copyLabel = section.querySelector<HTMLElement>('.share-copy-label');
    if (copyBtn && copyLabel) {
      const original = copyLabel.textContent;
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch {
            /* ignore */
          }
          document.body.removeChild(ta);
        }
        copyBtn.classList.add('is-copied');
        copyLabel.textContent = 'コピーしました';
        window.setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          copyLabel.textContent = original;
        }, 1800);
      });
    }

    // Native share sheet (mobile) — reveal only when supported
    const nativeBtn = section.querySelector<HTMLButtonElement>('.share-native');
    if (nativeBtn && typeof navigator.share === 'function') {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {
          /* user cancelled — ignore */
        });
      });
    }
  });
</script>

<style>
  .share-section {
    background-color: #f0f4f8;
    padding: 40px 5% 56px;
    display: flex;
    justify-content: center;
  }
  .share-card {
    width: 100%;
    max-width: 880px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 24px;
  }
  .share-label {
    color: #1b3a6b;
    font-size: 1.05rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .share-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: none;
    background: #ffffff;
    color: #1b3a6b;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(27, 58, 107, 0.1);
    transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s, color 0.2s;
  }
  .share-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(27, 58, 107, 0.18);
  }
  .share-btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  /* Brand accents on hover */
  .share-x:hover {
    background: #000000;
    color: #ffffff;
  }
  .share-line {
    color: #06c755;
  }
  .share-line:hover {
    background: #06c755;
    color: #ffffff;
  }
  .share-hatena {
    color: #00a4de;
  }
  .share-hatena:hover {
    background: #00a4de;
    color: #ffffff;
  }
  .share-copy:hover {
    background: #1b3a6b;
    color: #ffffff;
  }
  .share-copy.is-copied {
    background: #2e8b2e;
    color: #ffffff;
  }
  .share-native:hover {
    background: #1b3a6b;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .share-section {
      padding: 32px 5% 44px;
    }
    .share-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
