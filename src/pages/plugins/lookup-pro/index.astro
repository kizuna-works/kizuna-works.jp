---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { plugins, premiumPlugins } from '../../../data/plugins';
import { PREMIUM_PLAN, PRO_SET_PLAN, PRO_ADDON, yen } from '../../../data/pricing';

const VERSION = '1.3.0';
const ZIP = `/downloads/kw-lookup-pro-v${VERSION}.zip`;
const PAGE_URL = 'https://kizuna-works.jp/plugins/lookup-pro/';
const DATE_MODIFIED = '2026-10-30';

// The five single products this one bundles. Cards are built from plugins.ts so names and slugs never drift.
const singleOf = (id: string) => {
  const p = [...plugins, ...premiumPlugins].find((x) => x.id === id);
  if (!p) throw new Error(`lookup-pro: plugin "${id}" not found in plugins.ts`);
  return p;
};
const iconOf = (slug: string) => `/images/${slug}-icon.png`;
const BUNDLED = [
  { id: 'kw-lookup-suggest', role: '入力中の候補表示' },
  { id: 'kw-lookup-filter', role: '候補の絞り込み' },
  { id: 'kw-lookup-add', role: 'マスターのその場登録' },
  { id: 'kw-free-lookup', role: 'フリールックアップ' },
  { id: 'kw-lookup-sync', role: 'マスター更新の自動反映' },
];
const bundled = BUNDLED.map((b) => ({ ...b, p: singleOf(b.id) }));

// FAQ: the accordion and FAQPage JSON-LD are built from the same array so they always match.
const faqs: { q: string; a: string }[] = [
  {
    q: 'ルックアップ Pro だけを購入できますか？',
    a: `製品ごとの個別のご契約はありません。プレミアム年間サポーターに KIZUNA Pro 拡張パックを追加すると、ルックアップ Pro を含む KIZUNA Pro プラグインをすべてお使いいただけます。両方をまとめた「KIZUNA Pro 年間サポーター」（税込 ${yen(PRO_SET_PLAN.priceInTax)}/年）もあります。`,
  },
  {
    q: '年間サポーター（ちょこっとプラグインすべて）に、KIZUNA Pro 拡張パックを追加できますか？',
    a: 'できません。KIZUNA Pro 拡張パックは、プレミアム年間サポーターに追加していただくプランです。年間サポーターからは、KIZUNA Pro 年間サポーターへの切り替えでお使いいただけます。',
  },
  {
    q: 'ルックアップサジェストなどのプラグインと、何が違いますか？',
    a: '5つの機能（入力中の候補表示・候補の絞り込み・マスターのその場登録・フリールックアップ・マスター更新の自動反映）は、もとのプラグインの機能を取り込んだもので、動きは同じです。ルックアップ Pro では、1つの設定画面で扱え、無料プランのような数の制限もありません。もとのプラグインに新しい機能が加わったときは、ルックアップ Pro への取り込みが、もとのプラグインの公開より後になることがあります。そのうえで、欄ごとの一覧、まとめて設定、絞り込みの条件のその場登録への引き継ぎ、フリールックアップの取得元の更新のお知らせ、テーブルのコピーが加わります。',
  },
  {
    q: '同じアプリに、もとのプラグインが入っていても大丈夫ですか？',
    a: '大丈夫です。もとのプラグインが有効で設定済みのときは、その機能はもとのプラグインが動き、ルックアップ Pro は動かしません（二重にボタンが出る・二重に取得する、を防ぐためです）。もとのプラグインを「無効」にするか外せば、ルックアップ Pro が動かします。ほかの機能は、ルックアップ Pro が動かします。',
  },
  {
    q: 'これまでのプラグインで作った設定を、ルックアップ Pro に引き継げますか？',
    a: '引き継げます。もとのプラグインが入っているアプリでルックアップ Pro の設定画面を開くと、該当の機能のタブに［単品の設定を読み込む］が出ます。押して確認で OK を押すと、設定が写ります。読み込みは手動で、もとのプラグインの設定はそのまま残ります。内容を確かめて保存し、もとのプラグインを「無効」にするか、アプリから外してください。',
  },
  {
    q: '使わない機能を、止められますか？',
    a: 'はい。設定画面の機能ごとのタブで［使う］を切り替えます。使わない機能は、レコード画面に何も出さず、保存のときに設定を確かめません。保存済みの設定は残るので、オンに戻せばそのまま使えます。設定そのものを消したいときは、［この機能の設定を消す］を使います。既存の設定は、すべての機能が「使う」のまま引き継がれます。',
  },
  {
    q: 'マスター更新の自動反映は、どのアプリに入れますか？',
    a: 'ルックアップの参照先（マスター）側のアプリです。ルックアップを持つ側のアプリではありません。設定画面の［スキャン実行］で、このアプリを参照しているルックアップを自動で見つけます。',
  },
  {
    q: 'マスターを更新すると、必ず自動で追従して更新されますか？',
    a: 'コピー元のキーが「値の重複を禁止する」になっているルックアップは、マスターを保存した直後に、ルックアップを持つアプリの既存レコードを更新します。キーが重複しうるときは、次の2つから選びます。1つは、ルックアップを持つアプリのレコードを開いたときに、マスターの更新を知らせる方式です。もう1つは、ルックアップを持つアプリの設定を書き換えて、マスターを保存したときに既存のレコードを更新する方式です。マスターの更新を見つけるのは、パソコンでマスターの編集画面から保存したときだけです。CSV 読み込み・REST API・一覧のインライン編集で更新したときや、新しく作ったときは動かないので、［今すぐ全件同期］で最新にしてください。',
  },
  {
    q: 'フリールックアップの取得元の更新のお知らせは、どんなときに出ますか？',
    a: 'レコードの詳細画面を開いたとき、コピーした値と取得元の値が違っていれば出ます。［最新の値にする］を押したときだけレコードを更新し、開いただけでは書き換えません。既定はオフで、「欄ごとの一覧」タブの［詳細画面で知らせる］にチェックを入れると使えます。フリールックアップのタブで、取得元を開くための［レコード番号を入れる］フィールドを設定した欄だけが対象です。テーブルの中のフリールックアップとスマートフォンは対象外です。もとのフリールックアップが有効で設定済みのあいだは出ません（もとのプラグインを無効にするか外すと出ます）。',
  },
  {
    q: '無料で試せますか？',
    a: 'はい、30日間無料で試せます（カード登録不要・自動課金なし・1ドメインにつき1回まで。新しい KIZUNA Pro プラグインが出たときは、もう一度お試しいただけます）。プレミアム年間サポーターを未契約の方は、プレミアム年間サポーターの無料体験に KIZUNA Pro プラグインが含まれます。プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを30日間無料でお試しいただけます。体験が終わると機能は止まりますが、設定は消えません。',
  },
  {
    q: 'ご契約が切れたら、設定はどうなりますか？',
    a: '設定は消えません。ご契約が確認できない間は、機能は動かず、設定画面にはご契約の案内だけが出ます。ご契約が戻れば、保存済みの設定のまま、すぐに動きます。',
  },
  {
    q: 'スマートフォンでも使えますか？',
    a: 'フリールックアップとテーブルのコピーは、スマートフォンでも使えます。入力中の候補表示と候補の絞り込みは、スマートフォンではテーブルの外のルックアップだけに使えます（テーブルの中は、パソコンのみです）。マスターのその場登録・マスター更新の自動反映・取得元の更新のお知らせは、パソコンのみです。設定画面もパソコンのみです。',
  },
  {
    q: 'テーブルのコピーでは、何が写り、何が写りませんか？',
    a: '取得元のレコードのテーブルの行を、列の対応どおりに、このアプリのテーブルへ写します。追加画面・編集画面で取得したときに写し、取り直すとテーブルの行は取得したレコードの行に置き換わります。対象は、テーブルの外の標準のルックアップと、テーブルの外のフリールックアップ（参照先が1つのもの）です。フリールックアップから写すのは、ルックアップ Pro がフリールックアップを動かしているとき（もとのフリールックアップを無効にするか外したあと）です。写さない列は空になります。添付ファイルは写せません。選択肢の列は、このアプリの選択肢に無い値を入れず、取得したときに知らせます。型の合わない列の組み合わせは、設定画面で理由が出て保存できません。',
  },
  {
    q: 'ゲストスペースのアプリでも使えますか？',
    a: '使えます。',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  heroBg="/images/kizuna-pro-hero-bg.webp"
  title="ルックアップ Pro for kintone｜入力・絞り込み・登録・自動反映を1つに | KIZUNA Works"
  description="ルックアップ Pro for kintone は、ルックアップの入力中の候補表示・候補の絞り込み・マスターのその場登録・フリールックアップ・マスター更新の自動反映を1つにまとめた KIZUNA Pro プラグイン。欄ごとの一覧とまとめて設定、取得元のテーブルの行を写すテーブルのコピー、日本語・英語・中国語（簡体字）の表示にも対応します。"
  ogTitle="ルックアップ Pro for kintone｜入力・絞り込み・登録・自動反映を1つに | KIZUNA Works"
  ogDescription="ルックアップサジェスト・ルックアップ絞り込み・ルックアップ新規登録・フリールックアップ・ルックアップ自動同期の5機能を1つに統合。欄ごとの一覧・まとめて設定・取得元の更新のお知らせ・テーブルのコピー、機能ごとに「使う」の選択、日本語・英語・中国語（簡体字）の表示に対応する KIZUNA Pro プラグインです。"
  ogType="website"
  ogUrl={PAGE_URL}
  ogImage="https://kizuna-works.jp/images/lookup-pro-banner.png"
  canonical={PAGE_URL}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': PAGE_URL,
          url: PAGE_URL,
          name: 'ルックアップ Pro for kintone｜入力・絞り込み・登録・自動反映を1つに | KIZUNA Works',
          description: 'ルックアップ Pro for kintone は、kintone のルックアップの入力・絞り込み・登録・自動反映を1つのプラグインにまとめ、欄ごとの一覧で設定を確認できる kintone プラグイン（KIZUNA Pro プラグイン）。',
          dateModified: DATE_MODIFIED,
          primaryImageOfPage: { '@type': 'ImageObject', url: 'https://kizuna-works.jp/images/lookup-pro-banner.png', width: 1200, height: 630 },
          isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: 'https://kizuna-works.jp/' },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
            { '@type': 'ListItem', position: 2, name: 'kintoneプラグイン', item: 'https://kizuna-works.jp/plugins/' },
            { '@type': 'ListItem', position: 3, name: 'ルックアップ Pro for kintone', item: PAGE_URL },
          ],
        },
        {
          '@type': 'SoftwareApplication',
          name: 'ルックアップ Pro for kintone',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'kintone',
          // Literal on purpose: scripts/check-plugin-summaries.mjs reads it as text. Keep equal to VERSION.
          "softwareVersion": "1.3.0",
          dateModified: DATE_MODIFIED,
          url: PAGE_URL,
          downloadUrl: `https://kizuna-works.jp${ZIP}`,
          image: 'https://kizuna-works.jp/images/lookup-pro-banner.png',
          offers: [
            {
              '@type': 'Offer',
              name: PRO_SET_PLAN.name,
              price: String(PRO_SET_PLAN.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターと KIZUNA Pro 拡張パックのセット（年額）。KIZUNA Pro プラグインをすべて含みます。製品ごとの個別のご契約はありません。',
            },
            {
              '@type': 'Offer',
              name: PRO_ADDON.name,
              price: String(PRO_ADDON.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターに追加するプラン（年額）。',
            },
          ],
          description: 'ルックアップ Pro for kintone は、kintone のルックアップについて、入力中の候補表示・候補の絞り込み・マスターのその場登録・フリールックアップ・マスター更新の自動反映の5つの機能を1つの設定画面で使えるプラグイン。ルックアップの欄ごとに入力中の候補表示・候補の絞り込み・マスターのその場登録の設定の有無を確認できる「欄ごとの一覧」、入力中の候補表示とその場登録の設定をまとめて作る「まとめて設定」、絞り込みの条件を引き継いでその場登録で条件に合うマスターしか登録できなくする機能（条件を固定できるとき）、フリールックアップの取得元が更新されたときに詳細画面で知らせる機能、ルックアップで取得したときに取得元のテーブルの行をこのアプリのテーブルへ写す「テーブルのコピー」に対応。同じアプリにもとのプラグインが入っているときは、その機能はもとのプラグインが動く。もとのプラグインの設定は［単品の設定を読み込む］で引き継げる。kintone のユーザーの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示する。',
          publisher: { '@type': 'Organization', name: 'KIZUNA Works', url: 'https://kizuna-works.jp' },
          featureList: [
            '入力中の候補表示：ルックアップに文字を入れると、その場で候補が出て、選ぶと取得まで終わる',
            '候補の絞り込み：［取得］で出る候補を、同じレコードで入力済みの値で絞る（場面ごとに最大10通り）。数値・計算の列は単位・桁区切りどおり、添付ファイルの画像はサムネイルで表示',
            'マスターのその場登録：参照先のマスターに無いとき、［＋新規登録］でその場で登録して取得する',
            'フリールックアップ：文字列（1行）フィールドの横に［取得］を出し、別のアプリから値をコピーする',
            'マスター更新の自動反映：マスターを更新すると、ルックアップでコピーしているルックアップを持つアプリの既存レコードも更新する（キーが重複禁止なら自動、重複しうるときは方式を選ぶ）',
            '欄ごとの一覧：ルックアップの欄ごとに、候補表示・絞り込み・その場登録の設定の有無と、見直しが必要な設定を確認する',
            'まとめて設定：ルックアップの設定から、入力中の候補表示とその場登録の設定をまとめて作る',
            '絞り込みの条件をその場登録に引き継ぎ、固定できる条件では条件に合うマスターしか登録できなくする',
            'フリールックアップの取得元が更新されたら、詳細画面で知らせて［最新の値にする］で更新する',
            'テーブルのコピー：ルックアップで取得したとき、取得元のレコードのテーブルの行を、このアプリのテーブルへ列の対応どおりにまとめて写す',
            'これまでのプラグインの設定を読み込んで引き継ぐ',
            '機能ごとに「使う」を選べる：使わない機能はレコード画面に何も出さず、保存済みの設定は残る。［この機能の設定を消す］で機能ごとに設定を消せる',
            '絞り込みの比べ方：ユーザー・組織・グループ選択を条件に使うとき、取得元と「コード」で比べるか「名前」で比べるかを選べる',
            '多言語：kintone のユーザーの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示',
            'ゲストスペースのアプリに対応',
          ],
        },
      ],
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --kbp-navy: #1B3A6B;
      --kbp-ink: #0f1f3d;
      --kbp-gold: #b8862b;
      --kbp-gold-light: #e8c766;
      --kbp-gold-soft: #f0d58a;
      --kbp-green: #2E8B2E;
      --kbp-text: #333333;
      --kbp-muted: #64748b;
    }

    /* Hero: darker than the premium hero, gold accents mark the Pro series */
    .kbp-hero {
      /* Shared KIZUNA Pro hero background; sized by width, its baked bottom fade blends into this base gradient */
      background:
        url('/images/kizuna-pro-hero-bg.webp') center top / 100% auto no-repeat,
        linear-gradient(90deg, #020816 0%, #050b1c 30%, #081427 50%, #09182f 70%, #0c1729 100%);
      color: #fff;
      padding: 60px 5% 54px;
      text-align: center;
      border-bottom: 4px solid var(--kbp-gold);
    }
    .kbp-hero-icon {
      width: 136px; height: 136px; object-fit: contain; display: block; margin: 0 auto 18px;
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(232, 199, 102, 0.5);
      border-radius: 26px; padding: 10px; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    }
    .kbp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
    .kbp-badge-pro {
      display: inline-flex; align-items: center; gap: 6px; line-height: 1;
      padding: 7px 16px; border-radius: 20px;
      background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%);
      color: #1a1405; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.08em;
    }
    .kbp-hero-version {
      padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.45);
      font-size: 0.85rem; font-weight: 700; line-height: 1;
    }
    .kbp-hero-title { font-size: clamp(1.7rem, 4.2vw, 2.6rem); margin: 0 0 12px; line-height: 1.3; }
    .kbp-tagline { font-size: clamp(1.05rem, 2.4vw, 1.35rem); font-weight: 700; margin: 0 0 14px; color: var(--kbp-gold-soft); }
    .kbp-sub { max-width: 860px; margin: 0 auto 26px; line-height: 1.9; font-size: 1rem; color: rgba(255, 255, 255, 0.92); }
    .kbp-sub strong { color: #fff; }
    .kbp-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; max-width: 900px; margin: 0 auto 28px; }
    .kbp-pillar {
      display: block; padding: 16px 14px; border-radius: 12px; text-decoration: none; color: #fff;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(232, 199, 102, 0.45);
    }
    .kbp-pillar:hover { background: rgba(255, 255, 255, 0.14); }
    .kbp-pillar-no { display: block; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--kbp-gold-soft); font-weight: 800; }
    .kbp-pillar-name { display: block; font-size: 1.05rem; font-weight: 800; margin: 4px 0; }
    .kbp-pillar-desc { display: block; font-size: 0.84rem; line-height: 1.6; color: rgba(255, 255, 255, 0.85); }
    .kbp-hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .kbp-btn {
      display: inline-block; padding: 14px 26px; border-radius: 10px; font-weight: 800; text-decoration: none;
      font-size: 1rem; line-height: 1.3;
    }
    .kbp-btn.is-primary { background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%); color: #1a1405; box-shadow: 0 6px 18px rgba(184, 134, 43, 0.35); }
    .kbp-btn.is-ghost { border: 1px solid rgba(255, 255, 255, 0.6); color: #fff; }
    .kbp-btn.is-ghost:hover { background: rgba(255, 255, 255, 0.1); }
    .kbp-hero-note { margin: 14px auto 0; font-size: 0.85rem; color: rgba(255, 255, 255, 0.75); max-width: 760px; line-height: 1.7; }

    /* Update box (version highlight) */
