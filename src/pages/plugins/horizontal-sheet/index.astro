---
import Layout from '../../../layouts/Layout.astro';
import ResellerCard from '../../../components/ResellerCard.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import PremiumFaqSection from '../../../components/PremiumFaqSection.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
---

<Layout
  title="横並びシート for kintone｜レコードを横に並べて比べる・入れる kintone プラグイン | KIZUNA Works"
  description="レコードを1列ずつ横に並べ、大・中・小の3段の見出しでまとめて比べられる kintone プラグイン。店舗別・月別の表を一覧に作り、セルはその場で編集、列の追加・分類ごとの集計列・条件付き書式にも対応。レコードの無い日は空の列で表示します。"
  ogTitle="横並びシート for kintone｜レコードを横に並べて比べる・入れる kintone プラグイン | KIZUNA Works"
  ogDescription="kintone の一覧は1レコード1行。横並びシートは1レコードを1列にして、店舗別・月別の数字を3段の見出しで並べます。表の上で編集でき、分類ごとの集計列も出せます。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/horizontal-sheet/"
  ogImage="https://kizuna-works.jp/images/horizontal-sheet-banner.png"
  canonical="https://kizuna-works.jp/plugins/horizontal-sheet/"
  heroBg="/images/premium-plugins-bg.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/horizontal-sheet/",
          "url": "https://kizuna-works.jp/plugins/horizontal-sheet/",
          "name": "横並びシート for kintone｜レコードを横に並べて比べる・入れる kintone プラグイン | KIZUNA Works",
          "description": "レコードを1列ずつ、フィールドを行にして横に並べる kintone プラグイン。分類の値で列を大・中・小の3段の見出しにまとめ、日付から年・月・日を切り出す。表の上でセルを編集し、列の追加・削除・並べ替え、分類ごとの集計列、条件付き書式が使える。外部サービスは使わない。",
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "https://kizuna-works.jp/images/horizontal-sheet-banner.png",
            "width": 1200,
            "height": 630
          },
          "isPartOf": { "@type": "WebSite", "name": "KIZUNA Works", "url": "https://kizuna-works.jp/" }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://kizuna-works.jp/" },
            { "@type": "ListItem", "position": 2, "name": "kintoneプラグイン", "item": "https://kizuna-works.jp/plugins/" },
            { "@type": "ListItem", "position": 3, "name": "横並びシート for kintone", "item": "https://kizuna-works.jp/plugins/horizontal-sheet/" }
          ]
        },
        {
          "@type": "SoftwareApplication",
          "name": "横並びシート for kintone",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "kintone",
          "softwareVersion": "1.0.0",
          "dateModified": "2026-10-16",
          "url": "https://kizuna-works.jp/plugins/horizontal-sheet/",
          "downloadUrl": "https://kizuna-works.jp/downloads/kw-horizontal-sheet-v1.0.0.zip",
          "image": "https://kizuna-works.jp/images/horizontal-sheet-banner.png",
          "offers": {
            "@type": "Offer",
            "name": "プレミアム年間サポーター（全プラグイン込み）",
            "price": "16500",
            "priceCurrency": "JPY",
            "availability": "https://schema.org/InStock",
            "description": "プレミアム年間サポーター（税込 ¥16,500/年）に含まれます。単品販売はありません。無料プランでも、最初の1つの一覧で、1段の分類見出しの横並び表示・セルの編集・列の追加まで利用できます。"
          },
          "description": "レコードを1列ずつ、フィールドを行にして横に並べる kintone プラグイン。レコードの分類の値で列を大・中・小の3段の見出しにまとめ、同じ値の隣り合うセルは結合する。日付のフィールドから年・年度・四半期・月・週・日を切り出して分類にでき、レコードの無い日や選択肢の未登録分は空の列として表示し、［＋］でその場で作成できる。表の上でセルを編集して保存し、列の追加・削除・ドラッグでの並べ替えができる。分類ごとと総合計に合計・平均・件数・最大・最小の集計列を追加し、条件に当てはまるセルに色を付ける条件付き書式も使える。レコードの値は外部へ送信しない。",
          "publisher": { "@type": "Organization", "name": "KIZUNA Works", "url": "https://kizuna-works.jp" },
          "featureList": [
            "1レコード＝1列で横に並べる表をカスタマイズビューに作成",
            "大・中・小の3段の分類見出しと、同じ値の隣り合うセルの結合",
            "日付から年・年度・四半期・月・週・日を切り出して分類にする",
            "土日・祝日の色分け",
            "レコードの無い日・選択肢の未登録分を空の列として表示",
            "空の列の［＋］で、分類の値を引き継いだレコードを作成",
            "表示期間の切り替えと、前後の期間のレコードへの移動",
            "セルの編集・保存（自動／ボタン）・元に戻す・コピー＆貼り付け・右方向のオートフィル",
            "ほかの人が先に更新したレコードの競合検知",
            "列（レコード）の追加と削除",
            "ドラッグでの列・行の並べ替えと、並び順の保存（利用者ごと・全員の既定）",
            "分類ごとと総合計の集計列（合計・平均・件数・最大・最小）",
            "同じ分類に複数のレコードがある列の重複警告",
            "条件付き書式（セルの値や同じレコードの別の項目が条件・複数条件）",
            "見た目の種類（標準・Excel風・カジュアル・スタイリッシュ・オーシャン・モノトーン・カスタム）と行ごとの書式",
            "上の見出しと左の行見出しの固定表示",
            "列数の上限（10〜500列）とページ送り",
            "カスタマイズビューの自動作成",
            "外部サービス不使用・レコードの値を外部へ送信しない",
            "ゲストスペース対応"
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0,0,0,0.08);
    }

    .afp-hero {
      background: linear-gradient(135deg, rgba(21,41,77,0.72) 0%, rgba(27,58,107,0.55) 60%, rgba(46,139,46,0.5) 130%),
                  url('/images/premium-plugins-bg.png') center center / cover no-repeat;
      background-color: #1B3A6B;
      color: #fff;
      padding: 56px 5% 48px;
      text-align: center;
    }
    .afp-hero-icon {
      width: 132px; height: 132px; object-fit: contain; display: block; margin: 0 auto 16px;
      background: rgba(255,255,255,0.14); border-radius: 24px; padding: 10px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }
    .afp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; margin-bottom: 14px; }
    .afp-badge-premium {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.5);
      color: #fff; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.06em;
      padding: 6px 14px; border-radius: 20px; line-height: 1;
    }
    /* Crown and label are separate flex items with line-height:1 so the emoji
       centres against the text instead of sitting on its baseline. */
    .afp-badge-premium .crown { display: block; line-height: 1; font-size: 1.02em; }
    .afp-badge-premium .label { display: block; line-height: 1; }
    .afp-hero-version {
      display: inline-flex; align-items: center; line-height: 1;
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.4);
      color: #fff; font-weight: 700; font-size: 0.82rem; padding: 6px 12px; border-radius: 20px;
    }
    .afp-hero h1 { font-size: 2.1rem; font-weight: 700; margin: 0 0 10px; letter-spacing: 0.04em; }
    .afp-hero .afp-tagline { font-size: 1.15rem; font-weight: 600; margin: 0 0 8px; }
    .afp-hero .afp-sub { font-size: 1rem; opacity: 0.92; margin: 0 auto; max-width: 760px; line-height: 1.8; }
    .afp-hero-cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 26px; }
    .afp-hero-btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 48px; padding: 0 26px; border-radius: 26px;
      font-weight: 700; font-size: 1rem; text-decoration: none; line-height: 1.3;
    }
    .afp-hero-btn.is-primary { background: #2E8B2E; color: #fff; box-shadow: 0 6px 16px rgba(0,0,0,0.22); }
    .afp-hero-btn.is-primary:hover { background: #35a035; }
    .afp-hero-btn.is-ghost { background: rgba(255,255,255,0.14); color: #fff; border: 1px solid rgba(255,255,255,0.6); }
    .afp-hero-btn.is-ghost:hover { background: rgba(255,255,255,0.24); }
    @media (max-width: 600px) { .afp-hero-btn { width: 100%; } }

    .afp-hero-gradient-line { height: 6px; background: linear-gradient(to right, var(--color-navy), var(--color-green)); }

    /* Update box (latest release) */
    .update-box {
      max-width: 980px; margin: 0 auto; background: var(--color-white);
      border: 1px solid #e2e8f0; border-left: 5px solid var(--color-green);
      border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.06);
      padding: 32px 32px 36px;
    }
    .update-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .update-tag {
      background-color: var(--color-green); color: var(--color-white);
      font-size: 12px; font-weight: 700; letter-spacing: 0.05em;
      padding: 4px 12px; border-radius: 6px; flex-shrink: 0;
    }
    .update-title { color: var(--color-navy); font-size: 20px; font-weight: 700; line-height: 1.4; margin: 0; }
    .update-desc { color: var(--color-text-main); font-size: 15px; line-height: 1.8; margin: 0 0 16px; }
    .update-desc strong { color: var(--color-navy); }
    .update-note { color: var(--color-text-muted); font-size: 13px; line-height: 1.7; margin: 18px 0 0; }
    @media (max-width: 768px) {
      .update-box { padding: 24px 20px 28px; }
      .update-title { font-size: 17px; }
    }

    .afp-wrap { max-width: 1100px; margin: 0 auto; padding: 0 5%; }
    .afp-section { padding: 56px 0; }
    .afp-section.alt { background: #fff; }
    .afp-h2 {
      font-size: 1.7rem; color: var(--color-navy); margin: 0 0 28px; padding-left: 16px;
      border-left: 5px solid var(--color-green);
    }
    .afp-lead {
      font-size: 1.08rem; line-height: 1.9; color: var(--color-text-main);
      background: #fff; border-radius: 12px; padding: 28px 32px; box-shadow: var(--shadow-card);
      /* The lead is itself a white card; keep a gap so it does not touch the next card. */
      margin: 0 0 26px;
    }
    .afp-lead strong { color: var(--color-navy); }
    /* Answer card right after the problem statement */
    .afp-lead.is-accent { background: #eef7ee; border-left: 5px solid var(--color-green); }

    .afp-feature { display: grid; grid-template-columns: 1.05fr 1fr; gap: 32px; align-items: center; margin-bottom: 48px; }
    .afp-feature:last-child { margin-bottom: 0; }
    .afp-feature.reverse { grid-template-columns: 1fr 1.05fr; }
    .afp-feature.reverse .afp-feature-text { order: 2; }
    .afp-feature picture, .afp-feature img { width: 100%; height: auto; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: var(--shadow-card); background: #fff; display: block; }
    .afp-feature img { cursor: zoom-in; }
    .afp-feature h3 { font-size: 1.25rem; color: var(--color-navy); margin: 0 0 12px; }
    .afp-feature p { font-size: 1rem; line-height: 1.8; margin: 0 0 12px; }
    .afp-feature p:last-child { margin-bottom: 0; }

    .afp-grid-feats { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
    .afp-feat-card { background: #fff; border-radius: 10px; padding: 24px; box-shadow: var(--shadow-card); }
    .afp-feat-card h3 { font-size: 1.1rem; color: var(--color-navy); margin: 0 0 10px; }
    .afp-feat-card p { font-size: 0.95rem; line-height: 1.75; margin: 0; }

    .afp-shot { max-width: 960px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: var(--shadow-card); overflow: hidden; }
    /* Keep consecutive white cards apart. */
    .afp-shot + .afp-shot,
    .afp-shot + .afp-cautions,
    .afp-shot + .afp-note,
    .afp-shot + .afp-grid-feats { margin-top: 26px; }
    .afp-shot img { width: 100%; height: auto; display: block; background: #F0F4F8; cursor: zoom-in; }
    /* Captions are 1-3 lines of Japanese. Without balancing, a long one drops a
       two-character orphan onto the last line. balance evens the lines out; the
       max-width keeps a caption from running the full width of a wide screenshot. */
    .afp-shot-cap {
      text-align: center; font-size: 0.9rem; color: var(--color-text-muted);
      margin: 12px 0 0; padding: 0 16px 2px; line-height: 1.75;
      max-width: 46em; margin-left: auto; margin-right: auto;
    }
    /* Cap narrow captures at the width the UI really has, so nothing is blown up
       larger than the user will see it in kintone. */
    .afp-shot-w420 { max-width: 420px; }
    .afp-shot-w640 { max-width: 640px; }
    .afp-shot-w840 { max-width: 840px; }

    .afp-shot-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
    /* Auto margins on grid items stop them stretching; fill the cell instead. */
    .afp-shot-pair > .afp-shot { margin: 0; width: 100%; }
    .afp-shot-pair + .afp-shot { margin-top: 26px; }
    @media (max-width: 900px) { .afp-shot-pair { grid-template-columns: 1fr; } }

    .afp-tablewrap { overflow-x: auto; }
    table.afp-compare { border-collapse: collapse; width: 100%; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: var(--shadow-card); min-width: 520px; }
    table.afp-compare th, table.afp-compare td { border: 1px solid #e2e8f0; padding: 12px 14px; text-align: left; }
    table.afp-compare thead th { background: var(--color-navy); color: #fff; }
    table.afp-compare td.c, table.afp-compare th.c { text-align: center; }
    table.afp-compare tbody tr:nth-child(even) { background: #f8fafc; }

    .afp-plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-bottom: 44px; align-items: stretch; }
    .afp-plan-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 34px 28px 30px; box-shadow: var(--shadow-card); position: relative; text-align: center; display: flex; flex-direction: column; }
    .afp-plan-card.recommended { border: 2px solid var(--color-green); }
    .afp-plan-badge { position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: var(--color-green); color: #fff; font-weight: 700; font-size: 0.82rem; padding: 6px 18px; border-radius: 20px; white-space: nowrap; }
    .afp-plan-name { font-size: 1.3rem; color: var(--color-navy); margin: 0 0 18px; }
    .afp-plan-price { margin-bottom: 6px; }
    .afp-plan-price .amt { font-size: 2.4rem; font-weight: 700; color: var(--color-navy); }
    .afp-plan-price .unit { font-size: 0.95rem; color: var(--color-text-muted); margin-left: 4px; }
    .afp-plan-discount { color: var(--color-green); font-weight: 700; font-size: 0.92rem; margin-bottom: 16px; }
    .afp-plan-features { list-style: none; padding: 0; margin: 18px 0 24px; text-align: left; flex-grow: 1; }
    .afp-plan-features li { font-size: 0.95rem; line-height: 1.7; padding: 9px 0; border-bottom: 1px solid #eef2f7; }
    .afp-plan-cta { display: block; background: var(--color-navy); color: #fff; font-weight: 700; padding: 14px 20px; border-radius: 8px; text-decoration: none; transition: background .2s, transform .2s, box-shadow .2s; }
    .afp-plan-card.recommended .afp-plan-cta { background: var(--color-green); }
    .afp-plan-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(0,0,0,0.16); }
    .afp-plan-compare-head { font-size: 1.15rem; color: var(--color-navy); margin: 8px 0 16px; padding-left: 12px; border-left: 4px solid var(--color-green); }

    .afp-note { background: #fff8e6; border-left: 4px solid #e0a400; padding: 14px 16px; border-radius: 0 8px 8px 0; margin: 16px 0; line-height: 1.7; }
    .afp-cautions { background: #fff; border-radius: 10px; padding: 24px 28px; box-shadow: var(--shadow-card); }
    .afp-cautions li { margin: 8px 0; line-height: 1.7; }

    .afp-cta { background: linear-gradient(135deg, #15294d 0%, #1B3A6B 60%, #2E8B2E 140%); color: #fff; text-align: center; padding: 56px 5%; }
    .afp-cta h2 { font-size: 1.6rem; margin: 0 0 12px; }
    .afp-cta p { font-size: 1.05rem; opacity: 0.95; max-width: 640px; margin: 0 auto 24px; line-height: 1.8; }
    .afp-cta-btn { display: inline-block; background: #fff; color: var(--color-navy); font-weight: 700; font-size: 1.05rem; padding: 16px 36px; border-radius: 10px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
    .afp-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,0.3); }

    .zoomable { cursor: zoom-in; }
    .afp-faq { max-width: 860px; margin: 0 auto; }
    .afp-faq-item { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); overflow: hidden; }
    .afp-faq-item > summary { list-style: none; cursor: pointer; padding: 16px 48px 16px 20px; font-weight: 700; color: var(--color-navy); font-size: 15px; line-height: 1.6; position: relative; }
    .afp-faq-item > summary::-webkit-details-marker { display: none; }
    .afp-faq-item > summary::before { content: "Q"; display: inline-block; width: 22px; height: 22px; line-height: 22px; text-align: center; background: var(--color-navy); color: #fff; border-radius: 50%; font-size: 12px; margin-right: 10px; vertical-align: middle; }
    .afp-faq-item > summary::after { content: "＋"; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); color: var(--color-green); font-weight: 700; }
    .afp-faq-item[open] > summary::after { content: "－"; }
    .afp-faq-answer { padding: 0 20px 18px 20px; font-size: 14px; line-height: 1.95; color: #333; }
    .afp-faq-answer strong { color: var(--color-navy); }

    .afp-steps { counter-reset: afpstep; list-style: none; padding: 0; margin: 8px 0 4px; }
    .steps-list li { display: flex; gap: 20px; align-items: flex-start; padding: 18px 0; border-top: 1px dashed #d7dee8; line-height: 1.9; }
    .steps-list li:first-child { border-top: none; }
    .steps-list li::before {
      counter-increment: afpstep; content: counter(afpstep);
      flex-shrink: 0; width: 38px; height: 38px; background: var(--color-navy); color: #fff;
      border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 17px;
    }
    .steps-list li > span { flex: 1; min-width: 0; font-size: 14.5px; }

    /* Feature block: usage screen followed by its settings screen. */
    .afp-usecfg { margin-top: 30px; }
    .afp-usecfg-head {
      display: inline-block; background: var(--color-navy); color: #fff; font-weight: 700;
      font-size: 0.85rem; padding: 5px 14px; border-radius: 20px; margin-bottom: 12px;
    }

    .lightbox { position: fixed; inset: 0; background: rgba(0,0,0,0.85); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 24px; cursor: zoom-out; }
    .lightbox.is-open { display: flex; }
    .lightbox img { max-width: 96vw; max-height: 92vh; width: auto; height: auto; border-radius: 8px; box-shadow: 0 12px 48px rgba(0,0,0,0.5); }
    .lightbox-close { position: absolute; top: 14px; right: 22px; width: 44px; height: 44px; background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 28px; line-height: 1; border-radius: 50%; cursor: pointer; }
    .lightbox-close:hover { background: rgba(255,255,255,0.25); }

    @media (max-width: 768px) {
      .afp-hero h1 { font-size: 1.6rem; }
      .afp-feature, .afp-feature.reverse { grid-template-columns: 1fr; }
      .afp-feature.reverse .afp-feature-text { order: 0; }
      .afp-plan-grid { grid-template-columns: 1fr; }
      .afp-h2 { font-size: 1.4rem; }
    }
  </style>

  <style is:global>
    /* Page-specific additions */
    /* Sub-headings. Same look as .afp-plan-compare-head (navy text, green bar). */
    .afp-h3 {
      font-size: 1.15rem; color: var(--color-navy); margin: 34px 0 12px;
