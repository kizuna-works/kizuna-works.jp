---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { plugins } from '../../../data/plugins';
import { PREMIUM_PLAN, PRO_SET_PLAN, PRO_ADDON, yen } from '../../../data/pricing';

const VERSION = '1.3.0';
const ZIP = `/downloads/kw-search-pro-v${VERSION}.zip`;
const PAGE_URL = 'https://kizuna-works.jp/plugins/search-pro/';
const DATE_MODIFIED = '2026-10-29';

// The four free products this one bundles, plus the two it can start a bulk run in.
const singleOf = (id: string) => plugins.find((p) => p.id === id);
const iconOf = (slug: string) => `/images/${slug}-icon.png`;
const BUNDLED = [
  { id: 'kw-quick-search', role: '検索バー' },
  { id: 'kw-quick-filter', role: '絞り込みの窓' },
  { id: 'kw-summary-bar', role: '集計カード' },
  { id: 'kw-csv-export', role: 'CSV出力' },
];
const BATCH = [
  { id: 'kw-bulk-update', role: '絞り込んだレコードをまとめて更新' },
  { id: 'kw-status-bulk-action', role: '絞り込んだレコードのステータスをまとめて進める' },
];
const bundled = BUNDLED.map((b) => ({ ...b, p: singleOf(b.id) })).filter((b) => !!b.p);
const batch = BATCH.map((b) => ({ ...b, p: singleOf(b.id) })).filter((b) => !!b.p);

// FAQ: the accordion and FAQPage JSON-LD are built from the same array so they always match.
const faqs: { q: string; a: string }[] = [
  {
    q: 'サーチ Pro だけを購入できますか？',
    a: `製品ごとの個別のご契約はありません。プレミアム年間サポーターに KIZUNA Pro 拡張パックを追加すると、サーチ Pro を含む KIZUNA Pro プラグインをすべてお使いいただけます。両方をまとめた「KIZUNA Pro 年間サポーター」（税込 ${yen(PRO_SET_PLAN.priceInTax)}/年）もあります。`,
  },
  {
    q: '年間サポーター（ちょこっとプラグインすべて）に、KIZUNA Pro 拡張パックを追加できますか？',
    a: 'できません。KIZUNA Pro 拡張パックは、プレミアム年間サポーターに追加していただくプランです。年間サポーターからは、KIZUNA Pro 年間サポーターへの切り替えでお使いいただけます。',
  },
  {
    q: 'クイックサーチなどのプラグインと、何が違いますか？',
    a: '4つの機能（検索バー・絞り込みの窓・集計カード・CSV出力）は、もとのプラグインと同じ内容です。サーチ Pro では、1つの設定画面で扱え、窓の数・設定セットの数の制限もありません。そのうえで、検索と絞り込みを1つの条件にまとめる、条件の帯、集計カードからの絞り込み、CSVへの条件の記載、保存した検索、帯からの一括処理が加わります。',
  },
  {
    q: '同じアプリに、クイックサーチなどのプラグインが入っていても大丈夫ですか？',
    a: '大丈夫です。同じ機能が両方に入っているときは、もとのプラグインが有効で設定済みなら、その機能はもとのプラグインが動き、サーチ Pro は動かしません（二重にボタンが出る・二重に集計する、を防ぐためです）。もとのプラグインを外さず「無効」にしただけのときは、サーチ Pro がその機能を動かします。条件の帯と条件の一本化は、サーチ Pro に対応した最新版のプラグインで働きます。',
  },
  {
    q: '使わない機能を、出さないようにできますか？',
    a: 'できます。設定画面の目次の［使う］、または各機能の右上の［この機能を使う］で、機能ごとにオン・オフを選べます。使わない機能は一覧画面に出ず、保存のときも設定を確かめません。保存済みの設定は残るので、オンに戻せばそのまま使えます。設定そのものを消したいときは、［この機能の設定を消す］を押し、確認のあと［保存］で確定します。新しく入れたときは、すべての機能がオフから始まります。v1.0.0 の設定は、これまでどおり動きます。',
  },
  {
    q: 'これまでのプラグインで作った設定を、サーチ Pro に引き継げますか？',
    a: '引き継げます。もとのプラグインが入っているアプリでサーチ Pro の設定画面を開くと、該当の設定欄に［単品の設定を読み込む］が出ます。押して確認で OK を押すと、設定が写ります。読み込みは手動で、もとのプラグインの設定はそのまま残ります。内容を確かめて保存し、もとのプラグインをアプリから外してください。',
  },
  {
    q: '保存した検索は、誰が使えますか？',
    a: '自分用と全員用があります。自分用は利用者がブラウザに保存し（20件まで）、自分だけが使えます。全員用は管理者が設定画面で登録し（30件まで）、すべての利用者が使えます。',
  },
  {
    q: '条件の帯から一括更新やステータス一括実行を開くには、何が必要ですか？',
    a: '同じアプリに、かんたん一括更新・ステータス一括実行が入っているときに、入っている方のボタンが帯に出ます。条件が効いているときだけ出ます。',
  },
  {
    q: '無料で試せますか？',
    a: 'はい、30日間無料で試せます（カード登録不要・自動課金なし・1ドメインにつき1回まで。新しい KIZUNA Pro プラグインが出たときは、もう一度お試しいただけます）。プレミアム年間サポーターを未契約の方は、プレミアム年間サポーターの無料体験に KIZUNA Pro プラグインが含まれます。プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを30日間無料でお試しいただけます。体験が終わると一覧の機能は止まりますが、設定は消えません。',
  },
  {
    q: 'ご契約が切れたら、設定はどうなりますか？',
    a: '設定は消えません。ご契約が確認できない間は、一覧の機能は動かず、設定画面にはご契約の案内だけが出ます。ご契約が戻れば、保存済みの設定のまま、すぐに動きます。',
  },
  {
    q: '表示は何語に対応していますか？',
    a: 'kintone のユーザーごとの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示します。ほかの言語の方には英語で表示します。レコード一覧の機能と設定画面のすべてが対象です。フィールド名・一覧名など、kintone に登録した内容はそのまま表示します。',
  },
  {
    q: 'kintone 標準の［絞り込み］で条件を足すと、サーチ Pro の条件はどうなりますか？',
    a: 'サーチ Pro の条件の帯は消えずに残り、両方の条件で絞り込まれます。［すべて解除］を押すと、サーチ Pro の条件だけが外れ、kintone 標準の［絞り込み］で足した条件は残ります。',
  },
  {
    q: 'スマートフォンでも使えますか？',
    a: 'パソコンの一覧画面のみ対応です。',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  heroBg="/images/kizuna-pro-hero-bg.webp"
  title="サーチ Pro for kintone｜検索・絞り込み・集計・CSVを、ひとつの条件でつなぐ | KIZUNA Works"
  description="サーチ Pro for kintone は、kintone の一覧の検索・絞り込み・集計・CSV出力をひとつの条件でつなぐ KIZUNA Pro プラグイン。効いている条件を帯で確認・解除、よく使う条件の保存、集計カードを押して絞り込み、絞った結果をそのまま CSV や一括処理へ。検索窓の長さ・高さを選べ、CSV は出力できる人を限定できます。使う機能は機能ごとに選べます。日本語・英語・中国語（簡体字）の表示にも対応します。"
  ogTitle="サーチ Pro for kintone｜検索・絞り込み・集計・CSVを、ひとつの条件でつなぐ | KIZUNA Works"
  ogDescription="検索・絞り込み・集計・CSV出力が、ひとつの条件でつながる。条件の帯・保存した検索・集計カードから絞り込み・絞った結果を一括処理へ。使う機能は機能ごとに選べ、日本語・英語・中国語（簡体字）の表示に対応する KIZUNA Pro プラグインです。"
  ogType="website"
  ogUrl={PAGE_URL}
  ogImage="https://kizuna-works.jp/images/search-pro-banner.png"
  canonical={PAGE_URL}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': PAGE_URL,
          url: PAGE_URL,
          name: 'サーチ Pro for kintone｜検索・絞り込み・集計・CSVを、ひとつの条件でつなぐ | KIZUNA Works',
          description: 'サーチ Pro for kintone は、kintone の一覧の検索・絞り込み・集計・CSV出力をひとつの条件でつなぎ、条件の帯・保存した検索・集計カードからの絞り込み・絞った結果の一括処理ができる kintone プラグイン（KIZUNA Pro プラグイン）。',
          dateModified: DATE_MODIFIED,
          primaryImageOfPage: { '@type': 'ImageObject', url: 'https://kizuna-works.jp/images/search-pro-banner.png', width: 1200, height: 630 },
          isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: 'https://kizuna-works.jp/' },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
            { '@type': 'ListItem', position: 2, name: 'kintoneプラグイン', item: 'https://kizuna-works.jp/plugins/' },
            { '@type': 'ListItem', position: 3, name: 'サーチ Pro for kintone', item: PAGE_URL },
          ],
        },
        {
          '@type': 'SoftwareApplication',
          name: 'サーチ Pro for kintone',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'kintone',
          // Literal on purpose: scripts/check-plugin-summaries.mjs reads it as text. Keep equal to VERSION.
          "softwareVersion": "1.3.0",
          dateModified: DATE_MODIFIED,
          url: PAGE_URL,
          downloadUrl: `https://kizuna-works.jp${ZIP}`,
          image: 'https://kizuna-works.jp/images/search-pro-banner.png',
          offers: [
            {
              '@type': 'Offer',
              name: PRO_SET_PLAN.name,
              price: String(PRO_SET_PLAN.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターと KIZUNA Pro 拡張パックのセット（年額）。KIZUNA Pro プラグインをすべて含みます。製品ごとの個別のご契約はありません。',
            },
            {
              '@type': 'Offer',
              name: PRO_ADDON.name,
              price: String(PRO_ADDON.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターに追加するプラン（年額）。',
            },
          ],
          description: 'サーチ Pro for kintone は、kintone のレコード一覧の検索・絞り込み・集計・CSV出力をひとつの条件でつなぐプラグイン。検索・絞り込み・集計の条件を1つにまとめ、効いている条件を「条件の帯」に並べて1つずつ外せる。集計カードを押してその条件で絞り込む、CSV のファイル名や先頭行に今の条件を入れる、検索や絞り込みに名前を付けて「保存した検索」にする（自分用・全員用）、絞り込んだレコードにかんたん一括更新・ステータス一括実行をかける、にも対応。検索バー（検索窓の長さ・高さを大・中・小から選べる）・絞り込みの窓・集計カード・CSV出力の4つの機能も1つの設定画面で使える。CSV出力はテンプレートごとに、出力できる人（ユーザー・組織・グループ）を限定できる。同じアプリにクイックサーチなどのプラグインが入っているときは、その機能はもとのプラグインが動く。もとのプラグインの設定は［単品の設定を読み込む］で引き継げる。kintone 標準の［絞り込み］で条件を足しても条件の帯は消えず、両方で絞り込める。kintone のユーザーの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示する。使う機能は機能ごとに選べ、使わない機能は一覧に出ない。',
          publisher: { '@type': 'Organization', name: 'KIZUNA Works', url: 'https://kizuna-works.jp' },
          featureList: [
            '検索・絞り込み・集計の条件を1つにまとめる（kintone 標準の絞り込みも消えない）',
            '条件の帯：効いている条件を並べて、×で1つずつ外せる',
            '集計カードを押して、そのカードの条件で一覧を絞り込む',
            'CSV のファイル名と先頭行に、今の条件を入れる',
            '保存した検索（自分用・全員用）',
            '帯から、絞り込んだレコードにかんたん一括更新・ステータス一括実行をかける',
            'KIZUNAブリッジ for kintone から、保存した検索の結果を CSV にして添付ファイル欄に入れる',
            '検索バー：キーワード（AND／OR）・語句検索・完全一致で、複数のフィールドを横断して探す（検索窓の長さ・高さを大・中・小から選べる）',
            '絞り込みの窓：フィールドごとの窓で、値の一覧から選ぶだけで絞り込む（窓の数・設定セットの数に制限なし）',
            '集計カード：合計・平均・件数などを一覧の上に並べ、絞り込みに合わせて再集計する',
            'CSV出力：用途別のテンプレートで、絞り込んだ結果をワンクリックで CSV にする。テンプレートごとに出力できる人（ユーザー・組織・グループ）を限定できる',
            'これまでのプラグインの設定を読み込んで引き継ぐ',
            '使う機能を機能ごとに選べる（使わない機能は一覧に出ず、保存のときも設定を確かめない。設定を消すこともできる）',
            '多言語：kintone のユーザーの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示',
            'ゲストスペースのアプリに対応（パソコンの一覧画面）',
          ],
        },
      ],
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --kbp-navy: #1B3A6B;
      --kbp-ink: #0f1f3d;
      --kbp-gold: #b8862b;
      --kbp-gold-light: #e8c766;
      --kbp-gold-soft: #f0d58a;
      --kbp-green: #2E8B2E;
      --kbp-text: #333333;
      --kbp-muted: #64748b;
    }

    /* Hero: darker than the premium hero, gold accents mark the Pro series */
    .kbp-hero {
      /* Shared KIZUNA Pro hero background; sized by width, its baked bottom fade blends into this base gradient */
      background:
        url('/images/kizuna-pro-hero-bg.webp') center top / 100% auto no-repeat,
        linear-gradient(90deg, #020816 0%, #050b1c 30%, #081427 50%, #09182f 70%, #0c1729 100%);
      color: #fff;
      padding: 60px 5% 54px;
      text-align: center;
      border-bottom: 4px solid var(--kbp-gold);
    }
    .kbp-hero-icon {
      width: 136px; height: 136px; object-fit: contain; display: block; margin: 0 auto 18px;
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(232, 199, 102, 0.5);
      border-radius: 26px; padding: 10px; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    }
    .kbp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
    .kbp-badge-pro {
      display: inline-flex; align-items: center; gap: 6px; line-height: 1;
      padding: 7px 16px; border-radius: 20px;
      background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%);
      color: #1a1405; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.08em;
    }
    .kbp-hero-version {
      padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.45);
      font-size: 0.85rem; font-weight: 700; line-height: 1;
    }
    .kbp-hero-title { font-size: clamp(1.7rem, 4.2vw, 2.6rem); margin: 0 0 12px; line-height: 1.3; }
    .kbp-tagline { font-size: clamp(1.05rem, 2.4vw, 1.35rem); font-weight: 700; margin: 0 0 14px; color: var(--kbp-gold-soft); }
    .kbp-sub { max-width: 860px; margin: 0 auto 26px; line-height: 1.9; font-size: 1rem; color: rgba(255, 255, 255, 0.92); }
    .kbp-sub strong { color: #fff; }
    .kbp-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; max-width: 900px; margin: 0 auto 28px; }
    .kbp-pillar {
      display: block; padding: 16px 14px; border-radius: 12px; text-decoration: none; color: #fff;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(232, 199, 102, 0.45);
    }
    .kbp-pillar:hover { background: rgba(255, 255, 255, 0.14); }
    .kbp-pillar-no { display: block; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--kbp-gold-soft); font-weight: 800; }
    .kbp-pillar-name { display: block; font-size: 1.05rem; font-weight: 800; margin: 4px 0; }
    .kbp-pillar-desc { display: block; font-size: 0.84rem; line-height: 1.6; color: rgba(255, 255, 255, 0.85); }
    .kbp-hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .kbp-btn {
      display: inline-block; padding: 14px 26px; border-radius: 10px; font-weight: 800; text-decoration: none;
      font-size: 1rem; line-height: 1.3;
    }
    .kbp-btn.is-primary { background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%); color: #1a1405; box-shadow: 0 6px 18px rgba(184, 134, 43, 0.35); }
    .kbp-btn.is-ghost { border: 1px solid rgba(255, 255, 255, 0.6); color: #fff; }
    .kbp-btn.is-ghost:hover { background: rgba(255, 255, 255, 0.1); }
    .kbp-hero-note { margin: 14px auto 0; font-size: 0.85rem; color: rgba(255, 255, 255, 0.75); max-width: 760px; line-height: 1.7; }

    /* Update box (version highlight) */
    .update-box { max-width: 980px; margin: 0 auto; background: #fff; border: 1px solid #dbe3ee; border-left: 5px solid var(--kbp-green); border-radius: 12px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); padding: 28px 28px 32px; min-width: 0; }
    .update-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .update-tag { background: var(--kbp-green); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; padding: 4px 12px; border-radius: 6px; flex-shrink: 0; }
    .update-title { color: var(--kbp-navy); font-size: 20px; font-weight: 700; line-height: 1.4; margin: 0; }
    .update-desc { color: var(--kbp-text); font-size: 15px; line-height: 1.8; margin: 0 0 16px; }
    .update-desc strong { color: var(--kbp-navy); }
    .update-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #e3eaf3; }
    .update-list > li { position: relative; padding: 14px 4px 14px 34px; border-bottom: 1px solid #e3eaf3; line-height: 1.8; color: var(--kbp-text); min-width: 0; }
    .update-list > li::before { content: '✓'; position: absolute; left: 4px; top: 18px; width: 20px; height: 20px; border-radius: 50%; background: var(--kbp-green); color: #fff; font-size: 12px; font-weight: 900; line-height: 20px; text-align: center; }
    .update-list > li > strong:first-child { display: block; color: var(--kbp-navy); font-size: 16px; margin-bottom: 2px; }
    .update-sub { list-style: disc; margin: 6px 0 0; padding-left: 1.3em; }
    .update-sub li { padding: 1px 0; }
    .update-sub li::marker { color: var(--kbp-green); }
    .update-list + .kbp-h3 { margin-top: 26px; }
    .update-note { color: var(--kbp-muted); font-size: 13px; line-height: 1.7; margin: 18px 0 0; }
    @media (max-width: 700px) { .update-box { padding: 22px 18px 26px; } .update-title { font-size: 17px; } }

    /* Series strip */
    .kbp-series { background: #fffaf0; border-bottom: 1px solid #eadcb2; }
    .kbp-series-inner { max-width: 1100px; margin: 0 auto; padding: 20px 5%; display: flex; gap: 16px; align-items: center; }
    .kbp-series-tag {
