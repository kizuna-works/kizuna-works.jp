---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="経過計算アシスト for kintone - 経過日数・年齢・在籍期間を自動計算するプラグイン | KIZUNA Works"
  description="kintone の基準日フィールドから経過日数・経過年数・年齢・残日数・在籍期間（◯年◯ヶ月）など9パターンを自動計算するプラグイン。一覧・詳細を開くたびに「今日」時点の値を再計算表示し、保存時に実フィールドへ書き込むので並び替え・絞り込み・集計にも使えます。kintone完結・外部API不使用。"
  ogTitle="経過計算アシスト for kintone - 経過日数・年齢・在籍期間を自動計算するプラグイン | KIZUNA Works"
  ogDescription="基準日から経過日数・年齢・在籍期間などを自動計算。開くたびに今日の値を再計算表示し、保存時に実フィールドへ書き込み。並び替え・集計にも使える。kintone完結。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/elapsed-assist/"
  ogImage="https://kizuna-works.jp/images/elapsed-assist-banner.png"
  canonical="https://kizuna-works.jp/plugins/elapsed-assist/"
>
