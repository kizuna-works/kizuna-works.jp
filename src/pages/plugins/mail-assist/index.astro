          "name": "メールアシスト for kintone",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web (kintone)",
          "softwareVersion": "1.1.0",
          "dateModified": "2026-06-30",
          "url": "https://kizuna-works.jp/plugins/mail-assist/",
          "downloadUrl": "https://kizuna-works.jp/downloads/kw-mail-assist-v1.1.0.zip",
