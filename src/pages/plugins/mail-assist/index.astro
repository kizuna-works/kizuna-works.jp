---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="メールアシスト for kintone - レコードからワンクリックでメール作成 | KIZUNA Works"
  description="kintone のレコードの値を差し込んで件名・本文・宛先を組み立て、ワンクリックでメーラー（既定メーラー/Gmail/Outlook（個人・法人）/Yahoo!）を起動するプラグイン。詳細から個別に、一覧の絞り込み結果から BCC 一斉に送信。条件でテンプレートを出し分け、送信履歴も記録。外部サーバー不要で kintone 完結。"
  ogTitle="メールアシスト for kintone - レコードからワンクリックでメール作成 | KIZUNA Works"
  ogDescription="kintone のレコード値を差し込んで件名・本文・宛先を組み立て、ワンクリックでメーラー（既定/Gmail/Outlook 個人・法人/Yahoo!）を起動。詳細＝個別／一覧＝BCC一斉。条件でテンプレ出し分け・送信履歴も記録。外部サーバー不要・kintone完結。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/mail-assist/"
  ogImage="https://kizuna-works.jp/images/mail-assist-banner.png"
  canonical="https://kizuna-works.jp/plugins/mail-assist/"
>
