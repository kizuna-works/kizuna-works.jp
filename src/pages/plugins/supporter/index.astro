---
import Layout from '../../../layouts/Layout.astro';
import SupporterForm from '../../../components/SupporterForm.astro';
import TrialBanner from '../../../components/TrialBanner.astro';
import { plugins, premiumPlugins } from '../../../data/plugins';
---

<Layout
  title="kintone プラグイン 年間サポーターライセンス｜ちょこっとプラグイン | KIZUNA Works"
  description="kintone プラグイン「ちょこっとプラグイン」シリーズの年間サポーターライセンスお申込みページ。年間サポーターは 1 プラグイン ¥3,000/年（税抜）、プレミアム年間サポーターは全プラグイン対象で ¥15,000/年（税抜）。広告非表示・優先サポート付き。"
  ogTitle="kintone プラグイン 年間サポーターライセンス｜ちょこっとプラグイン | KIZUNA Works"
  ogDescription="kintone プラグイン「ちょこっとプラグイン」シリーズの年間サポーターライセンスお申込みページ。年間サポーターは 1 プラグイン ¥3,000/年（税抜）、プレミアム年間サポーターは全プラグイン対象で ¥15,000/年（税抜）。広告非表示・優先サポート付き。"
  ogUrl="https://kizuna-works.jp/plugins/supporter/"
  ogType="website"
  canonical="https://kizuna-works.jp/plugins/supporter/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/supporter/",
          "url": "https://kizuna-works.jp/plugins/supporter/",
          "name": "kintone プラグイン 年間サポーターライセンス｜ちょこっとプラグイン | KIZUNA Works",
          "description": "kintone プラグイン「ちょこっとプラグイン」シリーズの年間サポーターライセンス。年間サポーター ¥3,000/年（税抜）／プレミアム年間サポーター ¥15,000/年（税抜）。",
          "isPartOf": {
            "@type": "WebSite",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
          }
        },
        {
          "@type": "Service",
          "@id": "https://kizuna-works.jp/plugins/supporter/#service",
          "name": "kintone プラグイン 年間サポーターライセンス（ちょこっとプラグイン）",
          "description": "kintone プラグイン「ちょこっとプラグイン」シリーズの年間サポーター向けライセンス。プラグイン内の広告非表示、プラグイン作成リクエスト、既存プラグインへの改善要望の送付、優先サポートなどの特典を提供。年間サポーターとプレミアム年間サポーターの2種類をご用意。",
          "serviceType": "SoftwareLicense",
          "provider": {
            "@type": "Organization",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
          },
          "areaServed": "JP",
          "offers": [
            {
              "@type": "Offer",
              "name": "年間サポーターライセンス（1プラグイン・年額）",
              "price": "3000",
              "priceCurrency": "JPY",
              "url": "https://kizuna-works.jp/plugins/supporter/",
              "availability": "https://schema.org/InStock",
              "priceSpecification": {
                "@type": "UnitPriceSpecification",
                "price": "3000",
                "priceCurrency": "JPY",
                "billingDuration": "P1Y",
                "unitText": "year",
                "valueAddedTaxIncluded": false
              }
            },
            {
              "@type": "Offer",
              "name": "プレミアム年間サポーターライセンス（販売中の全プラグイン対象・年額）",
              "price": "15000",
              "priceCurrency": "JPY",
              "url": "https://kizuna-works.jp/plugins/supporter/?plan=all",
              "availability": "https://schema.org/InStock",
              "priceSpecification": {
                "@type": "UnitPriceSpecification",
                "price": "15000",
                "priceCurrency": "JPY",
                "billingDuration": "P1Y",
                "unitText": "year",
                "valueAddedTaxIncluded": false
              }
            }
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ホーム",
              "item": "https://kizuna-works.jp/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "kintone プラグイン一覧",
              "item": "https://kizuna-works.jp/plugins/"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "年間サポーターライセンス",
              "item": "https://kizuna-works.jp/plugins/supporter/"
            }
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://kizuna-works.jp/plugins/supporter/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "年間サポーターとプレミアム年間サポーターの違いは何ですか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "年間サポーター（¥3,300/年税込）はお申込み時に選択した 1 プラグインが対象で、対象プラグインの広告エリアが非表示になります。プレミアム年間サポーター（¥16,500/年税込）は販売中の全プラグインが対象で、契約期間中にリリースされる新プラグインも追加料金なしで利用できます。さらに HP サポーター一覧へのロゴ掲載特典が付きます。"
              }
            },
            {
              "@type": "Question",
              "name": "途中で年間サポーターからプレミアム年間サポーターにアップグレードできますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "本ページの申込フォームから新規申込として手続きできます。差額返金等は行っていませんが、プラグインの設定画面には個別とプレミアムのうち最も遅い有効期限が自動的に表示される仕組みになっているため、契約者にとって不利益はありません。"
              }
            },
            {
              "@type": "Question",
              "name": "申し込みから利用開始までどのくらいかかりますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "お支払い確認後、3 営業日以内にライセンスを発行いたします。銀行振込の場合は入金確認後、Square 決済の場合は決済完了後にライセンス発行メールをお送りします。"
              }
            },
            {
              "@type": "Question",
              "name": "法人でも申し込めますか？見積書・請求書の発行は可能ですか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "はい、法人・個人どちらでも申し込めます。銀行振込をご選択いただくと、お申込みと同時に見積書および請求書 PDF を自動発行してメール添付でお送りします。インボイス制度に対応した適格請求書（登録番号 T4810295462932）として発行されます。"
              }
            },
            {
              "@type": "Question",
              "name": "ライセンスは何台のドメインで使えますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "1 ライセンスにつき登録ドメイン 1 つで有効です。kintone のサブドメイン単位での認証となります。複数の kintone 環境で利用される場合は、それぞれにライセンスが必要です。"
              }
            },
            {
              "@type": "Question",
              "name": "解約・返金はできますか？年間ライセンスは自動更新されますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "お申込み後の返金・キャンセルはお受けしておりません。年間ライセンスの自動更新はなく、期限の 30 日前・7 日前・当日に更新案内メールをお送りしますので、必要に応じて更新申込フォームからお手続きください。"
              }
            }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    /* Breadcrumb */
    .breadcrumb-bar {
      max-width: 1200px;
      margin: 0 auto;
      padding: 16px 5% 0;
      font-size: 0.85rem;
      color: var(--color-text-muted);
    }
    .breadcrumb-bar a {
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .breadcrumb-bar a:hover {
      color: var(--color-green);
      text-decoration: underline;
    }
    .breadcrumb-sep {
      margin: 0 8px;
      color: #cbd5e1;
    }

    /* Hero */
    .supporter-hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.55) 0%, rgba(46,139,46,0.5) 100%),
                  url('/images/plugins-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 100px 5%;
      text-align: center;
      color: var(--color-white);
    }

    .supporter-hero h1 {
      font-size: 2rem;
      font-weight: 700;
      margin: 0 0 14px;
      letter-spacing: 0.04em;
      line-height: 1.35;
    }

    .supporter-hero .hero-tagline {
      font-size: 1.5rem;
      font-weight: 700;
      margin: 0 0 16px;
      letter-spacing: 0.06em;
      opacity: 0.95;
    }

    .supporter-hero .lead {
      font-size: 1.1rem;
      max-width: 720px;
      margin: 0 auto;
      font-weight: 500;
      line-height: 1.7;
    }

    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    /* Section base */
    .content-section {
      max-width: 900px;
      margin: 0 auto;
      padding: 60px 5% 0;
    }

    .content-section:last-of-type {
      padding-bottom: 80px;
    }

    .content-section h2 {
      font-size: 1.6rem;
      color: var(--color-navy);
      margin: 0 0 28px;
      padding-left: 14px;
      border-left: 5px solid var(--color-green);
      line-height: 1.4;
    }

    .content-section .section-desc {
      font-size: 1rem;
      line-height: 1.8;
      color: var(--color-text-main);
      margin: 0 0 20px;
    }

    /* Plan cards (3-up layout) */
    .plan-cards-section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 60px 5% 0;
    }

    .plan-cards-heading {
      font-size: 1.6rem;
      color: var(--color-navy);
      margin: 0 0 12px;
      padding-left: 14px;
      border-left: 5px solid var(--color-green);
      line-height: 1.4;
    }

    .plan-cards-desc {
      font-size: 1rem;
      line-height: 1.8;
      color: var(--color-text-main);
      margin: 0 0 32px;
    }

    .plan-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      align-items: stretch;
    }

    .plan-card {
      background-color: var(--color-white);
      border-radius: 14px;
      padding: 36px 24px 28px;
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      text-align: center;
      position: relative;
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .plan-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }

    .plan-card.is-premium {
      border: 2px solid var(--color-green);
      background-color: #fafff8;
    }

    .plan-card-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--color-green);
      color: var(--color-white);
      padding: 4px 14px;
      border-radius: 12px;
      font-size: 0.78rem;
      font-weight: 700;
      white-space: nowrap;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    }

    .plan-card-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--color-navy);
      margin: 0 0 14px;
      line-height: 1.4;
    }

    .plan-card-price {
      margin-bottom: 4px;
    }

    .plan-card-price .amount {
      font-size: 2.1rem;
      font-weight: 700;
      color: var(--color-navy);
    }

    .plan-card-price .unit {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin-left: 4px;
      font-weight: 500;
    }

    .plan-card-sub {
      font-size: 0.82rem;
      color: var(--color-text-muted);
      margin: 0 0 22px;
      min-height: 1.2em;
    }

    .plan-card-features {
      list-style: none;
      padding: 0;
      margin: 0 0 26px;
      text-align: left;
      flex: 1;
    }

    .plan-card-features li {
      position: relative;
      padding: 9px 0 9px 26px;
      font-size: 0.92rem;
      color: var(--color-text-main);
      line-height: 1.55;
      border-top: 1px solid #eef2f6;
    }

    .plan-card-features li:first-child {
      border-top: none;
    }

    .plan-card-features li::before {
      content: '✓';
      position: absolute;
      left: 4px;
      top: 9px;
      color: var(--color-green);
      font-weight: 700;
    }

    .plan-card-features li.is-cross {
      color: var(--color-text-muted);
    }

    .plan-card-features li.is-cross::before {
      content: '−';
      color: #94a3b8;
    }

    .plan-card-cta {
      display: block;
      padding: 13px 16px;
      background-color: var(--color-green);
      color: var(--color-white);
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      transition: background-color 0.3s, transform 0.3s, box-shadow 0.3s;
    }

    .plan-card-cta:hover {
      background-color: var(--color-navy);
      transform: translateY(-2px);
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
    }

    .plan-card.is-free .plan-card-cta {
      background-color: var(--color-navy);
    }

    .plan-card.is-free .plan-card-cta:hover {
      background-color: var(--color-green);
    }

    @media (max-width: 900px) {
      .plan-cards-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .plan-cards-section {
        padding: 40px 5% 0;
      }
      .plan-cards-heading {
        font-size: 1.35rem;
      }
    }

    /* Perks list */
    .perks-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 14px;
    }

    .perks-list li {
      background-color: var(--color-white);
      border-radius: 10px;
      padding: 18px 22px 18px 56px;
      position: relative;
      box-shadow: var(--shadow-card);
      font-size: 1rem;
      line-height: 1.7;
      color: var(--color-text-main);
    }

    .perks-list li::before {
      content: '✓';
      position: absolute;
      left: 18px;
      top: 18px;
      width: 28px;
      height: 28px;
      background-color: var(--color-green);
      color: var(--color-white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.95rem;
    }

    /* Notes list */
    .notes-list {
      list-style: none;
      padding: 24px 28px;
      margin: 0;
      background-color: var(--color-white);
      border-left: 4px solid #94a3b8;
      border-radius: 0 10px 10px 0;
      box-shadow: var(--shadow-card);
    }

    .notes-list li {
      position: relative;
      padding: 8px 0 8px 22px;
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--color-text-main);
    }

    .notes-list li::before {
      content: '・';
      position: absolute;
      left: 0;
      color: #94a3b8;
      font-weight: 700;
    }

    /* Supported plugins list (internal links) */
    .supported-subhead {
      font-size: 1.05rem;
      color: var(--color-navy, #1B3A6B);
      margin: 28px 0 14px;
      padding-left: 12px;
      border-left: 4px solid var(--color-green, #2E8B2E);
    }
    .supported-subhead:first-of-type {
      margin-top: 8px;
    }

    .supported-plugins-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .supported-plugins-list li {
      background-color: var(--color-white);
      border-radius: 10px;
      box-shadow: var(--shadow-card);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .supported-plugins-list li:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .supported-plugins-list a {
      display: block;
      padding: 14px 18px;
      text-decoration: none;
      color: var(--color-text-main);
    }

    .supported-plugin-name {
      display: block;
      font-weight: 700;
      color: var(--color-navy);
      font-size: 1rem;
      margin-bottom: 4px;
    }

    .supported-plugin-name::after {
      content: ' →';
      color: var(--color-green);
      font-weight: 700;
    }

    .supported-plugin-desc {
      display: block;
      font-size: 0.83rem;
      color: var(--color-text-muted);
      line-height: 1.5;
    }

    @media (max-width: 640px) {
      .supported-plugins-list {
        grid-template-columns: 1fr;
      }
    }

    /* FAQ (details/summary accordion) */
    .supporter-faq-list {
      display: grid;
      gap: 10px;
    }

    .supporter-faq {
      background-color: var(--color-white);
      border-radius: 10px;
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .supporter-faq summary {
      cursor: pointer;
      padding: 16px 48px 16px 22px;
      font-weight: 700;
      color: var(--color-navy);
      font-size: 0.98rem;
      position: relative;
      line-height: 1.55;
      list-style: none;
    }

    .supporter-faq summary::-webkit-details-marker {
      display: none;
    }

    .supporter-faq summary::after {
      content: '+';
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--color-green);
      color: var(--color-white);
      border-radius: 50%;
      font-size: 1.1rem;
      font-weight: 700;
      line-height: 1;
      transition: transform 0.3s;
    }

    .supporter-faq[open] summary::after {
      content: '−';
      transform: translateY(-50%) rotate(180deg);
    }

    .supporter-faq-answer {
      padding: 0 22px 18px;
      font-size: 0.92rem;
      line-height: 1.75;
      color: var(--color-text-main);
    }

    /* Mobile */
    @media (max-width: 768px) {
      .supporter-hero {
        padding: 70px 5%;
      }
      .supporter-hero h1 {
        font-size: 1.45rem;
      }
      .supporter-hero .hero-tagline {
        font-size: 1.2rem;
      }
      .supporter-hero .lead {
        font-size: 0.95rem;
      }
      .content-section {
        padding: 40px 5% 0;
      }
      .content-section h2 {
        font-size: 1.35rem;
      }
      .notes-list {
        padding: 20px 18px;
      }
    }
  </style>

  <main>
    <nav class="breadcrumb-bar" aria-label="パンくず">
      <a href="/">ホーム</a><span class="breadcrumb-sep">／</span>
      <a href="/plugins/">kintone プラグイン一覧</a><span class="breadcrumb-sep">／</span>
      <span>年間サポーターライセンス</span>
    </nav>

    <section class="supporter-hero">
      <h1>kintone プラグイン 年間サポーターライセンス</h1>
      <p class="hero-tagline">現場の声を、絆に。</p>
      <p class="lead">
        ちょこっとプラグインの年間サポーターとして<br />
        kintone の現場改善を応援してください
      </p>
    </section>
    <div class="hero-gradient-line"></div>

    <div style="margin: 40px 0;">
      <TrialBanner />
    </div>

    <section class="plan-cards-section">
      <h2 class="plan-cards-heading">プランを選ぶ</h2>
      <p class="plan-cards-desc">
        ご利用のプラグイン数に応じて、3 つのプランからお選びいただけます。<br />
        <strong>5 プラグイン以上ご利用ならプレミアム年間サポーターがお得</strong>です。
      </p>
      <div class="plan-cards-grid">
        <article class="plan-card is-free">
          <h3 class="plan-card-name">無料プラン</h3>
          <div class="plan-card-price">
            <span class="amount">¥0</span>
            <span class="unit">完全無料</span>
          </div>
          <div class="plan-card-sub">利用期限なし・いつまでも無料</div>
          <ul class="plan-card-features">
            <li>全プラグインの全機能が利用可能</li>
            <li>レコード一覧画面に控えめな広告エリア表示あり</li>
            <li class="is-cross">プラグイン作成リクエストは不可</li>
            <li class="is-cross">改善要望の送付は不可</li>
          </ul>
          <a href="/plugins/" class="plan-card-cta">プラグイン一覧を見る →</a>
        </article>

        <article class="plan-card is-individual">
          <h3 class="plan-card-name">年間サポーター</h3>
