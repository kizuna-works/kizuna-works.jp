---
import Layout from '../../../layouts/Layout.astro';
import SupporterForm from '../../../components/SupporterForm.astro';
---

<Layout
  title="年間サポーターライセンス | KIZUNA Works"
  description="ちょこっとプラグインの年間サポーターライセンス。広告非表示・プラグイン作成リクエスト・改善要望の送付など、開発を応援していただける特典付き。1プラグインあたり年間¥3,000（税抜）。"
  ogTitle="年間サポーターライセンス | KIZUNA Works"
  ogDescription="ちょこっとプラグインの年間サポーターライセンス。広告非表示・プラグインリクエスト・改善要望の送付などの特典付き。"
  ogUrl="https://kizuna-works.jp/plugins/supporter/"
  ogType="website"
  canonical="https://kizuna-works.jp/plugins/supporter/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/supporter/",
          "url": "https://kizuna-works.jp/plugins/supporter/",
          "name": "年間サポーターライセンス | KIZUNA Works",
          "description": "ちょこっとプラグインの年間サポーターライセンスのご案内・お申し込みフォーム。",
          "isPartOf": {
            "@type": "WebSite",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ホーム",
              "item": "https://kizuna-works.jp/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "kintoneプラグイン",
              "item": "https://kizuna-works.jp/plugins/"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "年間サポーターライセンス",
              "item": "https://kizuna-works.jp/plugins/supporter/"
            }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    /* Breadcrumb */
    .breadcrumb-bar {
      max-width: 1200px;
      margin: 0 auto;
      padding: 16px 5% 0;
      font-size: 0.85rem;
      color: var(--color-text-muted);
    }
    .breadcrumb-bar a {
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .breadcrumb-bar a:hover {
      color: var(--color-green);
      text-decoration: underline;
    }
    .breadcrumb-sep {
      margin: 0 8px;
      color: #cbd5e1;
    }

    /* Hero */
    .supporter-hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.55) 0%, rgba(46,139,46,0.5) 100%),
                  url('/images/plugins-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 100px 5%;
      text-align: center;
      color: var(--color-white);
    }

    .supporter-hero h1 {
      font-size: 2.6rem;
      font-weight: 700;
      margin: 0 0 18px;
      letter-spacing: 0.08em;
    }

    .supporter-hero .lead {
      font-size: 1.15rem;
      max-width: 720px;
      margin: 0 auto;
      font-weight: 500;
      line-height: 1.7;
    }

    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    /* Section base */
    .content-section {
      max-width: 900px;
      margin: 0 auto;
      padding: 60px 5% 0;
    }

    .content-section:last-of-type {
      padding-bottom: 80px;
    }

    .content-section h2 {
      font-size: 1.6rem;
      color: var(--color-navy);
      margin: 0 0 28px;
      padding-left: 14px;
      border-left: 5px solid var(--color-green);
      line-height: 1.4;
    }

    .content-section .section-desc {
      font-size: 1rem;
      line-height: 1.8;
      color: var(--color-text-main);
      margin: 0 0 20px;
    }

    /* Plan comparison table */
    .plan-table-wrapper {
      background-color: var(--color-white);
      border-radius: 12px;
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .plan-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .plan-table thead th {
      padding: 18px 16px;
      font-size: 1rem;
      font-weight: 700;
      text-align: center;
      background-color: var(--color-navy);
      color: var(--color-white);
      border-right: 1px solid rgba(255, 255, 255, 0.15);
    }

    .plan-table thead th:first-child {
      width: 35%;
      background-color: #14305a;
    }

    .plan-table thead th:last-child {
      border-right: none;
      background-color: var(--color-green);
    }

    .plan-table tbody th,
    .plan-table tbody td {
      padding: 16px;
      font-size: 0.95rem;
      border-top: 1px solid #e2e8f0;
      vertical-align: middle;
    }

    .plan-table tbody th {
      background-color: #F0F4F8;
      color: var(--color-navy);
      font-weight: 700;
      text-align: left;
    }

    .plan-table tbody td {
      text-align: center;
      color: var(--color-text-main);
    }

    .plan-table tbody td.cell-supporter {
      background-color: #f4faf4;
      font-weight: 700;
      color: var(--color-navy);
    }

    .plan-table tbody td.cell-price-supporter {
      font-weight: 700;
      color: var(--color-navy);
    }

    .plan-table tbody td .check {
      color: var(--color-green);
      font-weight: 700;
    }

    .plan-table tbody td .cross {
      color: #94a3b8;
    }

    /* Mobile: stack the table */
    @media (max-width: 640px) {
      .plan-table thead {
        display: none;
      }

      .plan-table,
      .plan-table tbody,
      .plan-table tr,
      .plan-table th,
      .plan-table td {
        display: block;
        width: 100%;
        box-sizing: border-box;
      }

      .plan-table tr {
        padding: 18px 16px;
        border-top: 1px solid #e2e8f0;
      }

      .plan-table tr:first-child {
        border-top: none;
      }

      .plan-table tbody th {
        background: none;
        padding: 0 0 12px;
        font-size: 1rem;
        text-align: left;
        border-top: none;
      }

      .plan-table tbody td {
        text-align: left;
        padding: 8px 0 8px 16px;
        border-top: none;
        position: relative;
      }

      .plan-table tbody td::before {
        content: attr(data-label) '：';
        font-weight: 700;
        color: var(--color-text-muted);
        margin-right: 8px;
      }

      .plan-table tbody td.cell-supporter {
        background: none;
      }
    }

    /* Perks list */
    .perks-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 14px;
    }

    .perks-list li {
      background-color: var(--color-white);
      border-radius: 10px;
      padding: 18px 22px 18px 56px;
      position: relative;
      box-shadow: var(--shadow-card);
      font-size: 1rem;
      line-height: 1.7;
      color: var(--color-text-main);
    }

    .perks-list li::before {
      content: '✓';
      position: absolute;
      left: 18px;
      top: 18px;
      width: 28px;
      height: 28px;
      background-color: var(--color-green);
      color: var(--color-white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.95rem;
    }

    /* Notes list */
    .notes-list {
      list-style: none;
      padding: 24px 28px;
      margin: 0;
      background-color: var(--color-white);
      border-left: 4px solid #94a3b8;
      border-radius: 0 10px 10px 0;
      box-shadow: var(--shadow-card);
    }

    .notes-list li {
      position: relative;
      padding: 8px 0 8px 22px;
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--color-text-main);
    }

    .notes-list li::before {
      content: '・';
      position: absolute;
      left: 0;
      color: #94a3b8;
      font-weight: 700;
    }

    /* Mobile */
    @media (max-width: 768px) {
      .supporter-hero {
        padding: 70px 5%;
      }
      .supporter-hero h1 {
        font-size: 1.9rem;
      }
      .supporter-hero .lead {
        font-size: 1rem;
      }
      .content-section {
        padding: 40px 5% 0;
      }
      .content-section h2 {
        font-size: 1.35rem;
      }
      .notes-list {
        padding: 20px 18px;
      }
    }
  </style>

  <main>
    <nav class="breadcrumb-bar" aria-label="パンくず">
      <a href="/">ホーム</a><span class="breadcrumb-sep">／</span>
      <a href="/plugins/">kintoneプラグイン</a><span class="breadcrumb-sep">／</span>
      <span>年間サポーターライセンス</span>
    </nav>

    <section class="supporter-hero">
      <h1>現場の声を、絆に。</h1>
      <p class="lead">
        ちょこっとプラグインの年間サポーターとして開発を応援してください
      </p>
    </section>
    <div class="hero-gradient-line"></div>

    <section class="content-section">
      <h2>プランについて</h2>
      <div class="plan-table-wrapper">
        <table class="plan-table">
          <thead>
            <tr>
              <th scope="col">項目</th>
              <th scope="col">無料プラン</th>
              <th scope="col">年間サポーター</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">基本機能</th>
              <td data-label="無料プラン"><span class="check">利用可</span></td>
              <td class="cell-supporter" data-label="年間サポーター"><span class="check">利用可</span></td>
            </tr>
            <tr>
              <th scope="row">広告表示</th>
              <td data-label="無料プラン">あり</td>
              <td class="cell-supporter" data-label="年間サポーター">なし</td>
            </tr>
            <tr>
              <th scope="row">プラグインリクエスト</th>
              <td data-label="無料プラン"><span class="cross">不可</span></td>
              <td class="cell-supporter" data-label="年間サポーター"><span class="check">可</span></td>
            </tr>
            <tr>
              <th scope="row">改善要望の送付</th>
              <td data-label="無料プラン"><span class="cross">不可</span></td>
              <td class="cell-supporter" data-label="年間サポーター"><span class="check">可</span></td>
            </tr>
            <tr>
              <th scope="row">料金</th>
              <td data-label="無料プラン">無料</td>
              <td class="cell-price-supporter" data-label="年間サポーター">1プラグインあたり<br />年額¥3,000（税抜）</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>サポーターの特典</h2>
      <ul class="perks-list">
        <li>プラグイン内の広告エリアが非表示になります</li>
        <li>設定画面から無料ツール・プラグインへのリンクを利用できます</li>
        <li>プラグイン作成リクエストフォームをご利用いただけます</li>
        <li>既存プラグインへの改善要望をお送りいただけます</li>
        <li>サポーターの声を優先してプラグイン開発を進めます</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>年間サポーターライセンス 申込フォーム</h2>
      <p class="section-desc">
        以下のフォームからお申し込みください。<br />
        お申し込み内容を確認の上、担当者メールアドレスへご連絡いたします。
      </p>
    </section>

    <SupporterForm />

    <section class="content-section">
      <h2>注意事項</h2>
      <ul class="notes-list">
        <li>本ライセンスはご購入後の返金はいたしかねます</li>
        <li>ライセンスは登録ドメイン1つに対して有効です</li>
        <li>第三者への譲渡・転売は禁止しております</li>
        <li>お支払い確認後、3営業日以内にライセンスを発行いたします</li>
      </ul>
    </section>
  </main>
</Layout>
