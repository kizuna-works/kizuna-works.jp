---
import Layout from '../../../layouts/Layout.astro';
import SupporterForm from '../../../components/SupporterForm.astro';
import { plugins } from '../../../data/plugins';
---

<Layout
  title="年間サポーターライセンス | KIZUNA Works"
  description="KIZUNA Works の kintone プラグインをご愛用いただいている方向けの年間サポーターライセンス。広告非表示・優先サポート・開発リクエスト権など、開発を応援していただける特典をご用意しています。1プラグインあたり年間¥3,000（税抜）。"
  ogTitle="年間サポーターライセンス | KIZUNA Works"
  ogDescription="広告非表示・サポーター特典付きの年間サポーターライセンス。1プラグインあたり年間¥3,000（税抜）で開発を応援いただけます。"
  ogUrl="https://kizuna-works.jp/plugins/supporter/"
  ogType="website"
  canonical="https://kizuna-works.jp/plugins/supporter/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/supporter/",
          "url": "https://kizuna-works.jp/plugins/supporter/",
          "name": "年間サポーターライセンス | KIZUNA Works",
          "description": "KIZUNA Works の kintone プラグイン年間サポーターライセンスのご案内・お申し込みフォーム。",
          "isPartOf": {
            "@type": "WebSite",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ホーム",
              "item": "https://kizuna-works.jp/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "kintoneプラグイン",
              "item": "https://kizuna-works.jp/plugins/"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "年間サポーターライセンス",
              "item": "https://kizuna-works.jp/plugins/supporter/"
            }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    .breadcrumb-bar {
      max-width: 1200px;
      margin: 0 auto;
      padding: 16px 5% 0;
      font-size: 0.85rem;
      color: var(--color-text-muted);
    }
    .breadcrumb-bar a {
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .breadcrumb-bar a:hover {
      color: var(--color-green);
      text-decoration: underline;
    }
    .breadcrumb-sep {
      margin: 0 8px;
      color: #cbd5e1;
    }

    .supporter-hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.55) 0%, rgba(46,139,46,0.5) 100%),
                  url('/images/plugins-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 90px 5%;
      text-align: center;
      color: var(--color-white);
    }
    .supporter-hero h1 {
      font-size: 2.4rem;
      font-weight: 700;
      margin: 0 0 16px;
      letter-spacing: 0.04em;
    }
    .supporter-hero .lead {
      font-size: 1.1rem;
      max-width: 700px;
      margin: 0 auto;
      font-weight: 500;
      line-height: 1.7;
    }
    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    .content-section {
      max-width: 900px;
      margin: 0 auto;
      padding: 60px 5% 0;
    }

    .content-section h2 {
      font-size: 1.6rem;
      color: var(--color-navy);
      margin: 0 0 24px;
      padding-left: 14px;
      border-left: 5px solid var(--color-green);
      line-height: 1.4;
    }

    .content-section p {
      font-size: 1rem;
      line-height: 1.9;
      color: var(--color-text-main);
      margin: 0 0 20px;
    }

    .perks-list {
      list-style: none;
      padding: 0;
      margin: 0 0 20px;
      display: grid;
      gap: 14px;
    }

    .perks-list li {
      background-color: var(--color-white);
      border-radius: 10px;
      padding: 18px 22px 18px 56px;
      position: relative;
      box-shadow: var(--shadow-card);
      font-size: 1rem;
      line-height: 1.65;
      color: var(--color-text-main);
    }

    .perks-list li::before {
      content: '✓';
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      width: 28px;
      height: 28px;
      background-color: var(--color-green);
      color: var(--color-white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.95rem;
    }

    .perk-strong {
      color: var(--color-navy);
      font-weight: 700;
    }

    .price-card {
      background-color: var(--color-white);
      border-radius: 14px;
      padding: 32px 28px;
      box-shadow: var(--shadow-card);
      border-top: 4px solid var(--color-green);
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
    }

    .price-card-name {
      font-size: 1.1rem;
      color: var(--color-navy);
      font-weight: 700;
      margin: 0 0 8px;
    }

    .price-card-amount {
      font-size: 2.4rem;
      color: var(--color-navy);
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.2;
      margin: 0;
    }

    .price-card-amount .yen-unit {
      font-size: 1rem;
      color: var(--color-text-muted);
      font-weight: 500;
      margin-left: 6px;
    }

    .price-card-note {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin: 12px 0 0;
      line-height: 1.6;
    }

    .future-plan {
      max-width: 720px;
      margin: 16px auto 0;
      background-color: #fff8e1;
      border: 1px solid #ffe082;
      border-radius: 8px;
      padding: 16px 20px;
      font-size: 0.92rem;
      color: #6d4c00;
      line-height: 1.7;
    }

    .future-plan strong {
      color: #5a3a00;
    }

    .target-list {
      background-color: var(--color-white);
      border-radius: 10px;
      padding: 24px;
      box-shadow: var(--shadow-card);
      list-style: none;
      margin: 0 0 20px;
    }

    .target-list li {
      padding: 12px 0;
      border-bottom: 1px solid #e2e8f0;
      font-size: 0.95rem;
      color: var(--color-text-main);
    }
    .target-list li:last-child {
      border-bottom: none;
    }

    .form-anchor {
      padding-top: 60px;
    }

    @media (max-width: 768px) {
      .supporter-hero {
        padding: 60px 5%;
      }
      .supporter-hero h1 {
        font-size: 1.7rem;
      }
      .supporter-hero .lead {
        font-size: 0.95rem;
      }
      .content-section {
        padding: 40px 5% 0;
      }
      .content-section h2 {
        font-size: 1.35rem;
      }
      .price-card-amount {
        font-size: 2rem;
      }
    }
  </style>

  <main>
    <nav class="breadcrumb-bar" aria-label="パンくず">
      <a href="/">ホーム</a><span class="breadcrumb-sep">／</span>
      <a href="/plugins/">kintoneプラグイン</a><span class="breadcrumb-sep">／</span>
      <span>年間サポーターライセンス</span>
    </nav>

    <section class="supporter-hero">
      <h1>年間サポーターライセンス</h1>
      <p class="lead">
        KIZUNA Works のプラグインを気に入ってくださった方に、<br />
        広告非表示・特典付きで開発を応援していただける年間ライセンスです。
      </p>
    </section>
    <div class="hero-gradient-line"></div>

    <section class="content-section">
      <h2>サポーターライセンスとは</h2>
      <p>
        KIZUNA Works のプラグインは、基本機能を無料でご利用いただけます。
        サポーターライセンスは、無料プランに表示される広告を非表示にしつつ、
        プラグインの継続開発を応援していただくための任意のライセンスです。
      </p>
      <p>
        ご支援いただいた皆さまの声を優先的に反映し、より便利なプラグインを長く提供できる体制を維持していきます。
      </p>
    </section>

    <section class="content-section">
      <h2>サポーター特典</h2>
      <ul class="perks-list">
        <li><span class="perk-strong">プラグイン内の広告エリアが非表示</span>になります</li>
        <li>設定画面に <span class="perk-strong">無料ツール・他プラグインへのリンク</span>を表示し、業務効率化に役立つ情報をお届けします</li>
        <li>設定画面から <span class="perk-strong">プラグインリクエストフォーム</span>へアクセスでき、機能要望を直接お送りいただけます</li>
        <li><span class="perk-strong">サポーターの声を優先</span>してプラグイン開発を進めます</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>料金</h2>
      <div class="price-card">
        <p class="price-card-name">個別サポーターライセンス</p>
        <p class="price-card-amount">¥3,000<span class="yen-unit">／年・税抜</span></p>
        <p class="price-card-note">対象プラグイン1つにつきの年額です。<br />複数プラグインをご利用の場合は、それぞれお申し込みください。</p>
      </div>
      <div class="future-plan">
        <strong>近日提供予定:</strong> プラグインのラインナップが充実次第、すべてのプラグインをまとめて利用できる「全プラグインサポーターライセンス」をご用意する予定です。
      </div>
    </section>

    <section class="content-section">
      <h2>対象プラグイン</h2>
      <ul class="target-list">
        {plugins.map((p) => (
          <li>
            <a href={`/plugins/${p.slug}/`}>{p.formName}</a>
          </li>
        ))}
      </ul>
      <p>※ 各プラグインの詳細はリンク先のページをご覧ください。</p>
    </section>

    <section class="content-section">
      <h2>ご利用の流れ</h2>
      <p>
        下記フォームよりお申し込みいただくと、ご入力のメールアドレス宛に
        Square 決済リンク（または銀行振込の場合は見積書・請求書）をお送りします。
        ご入金確認後、ライセンスを発行し、プラグインの広告エリアが非表示になります。
      </p>
    </section>

    <div id="form" class="form-anchor"></div>

    <SupporterForm />
  </main>
</Layout>
