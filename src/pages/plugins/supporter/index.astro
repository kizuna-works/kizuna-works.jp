---
import Layout from '../../../layouts/Layout.astro';
import SupporterForm from '../../../components/SupporterForm.astro';
---

<Layout
  title="ちょこっとプラグイン 年間サポーターライセンス申込 | KIZUNA Works"
  description="KIZUNA Works「ちょこっとプラグイン」の年間サポーターライセンスお申込みページ。年間サポーターは1プラグイン年額¥3,000（税抜）、プレミアム年間サポーターは全プラグイン対象で年額¥15,000（税抜）。広告非表示・リクエスト機能・優先サポート付き。"
  ogTitle="ちょこっとプラグイン 年間サポーターライセンス申込 | KIZUNA Works"
  ogDescription="KIZUNA Works「ちょこっとプラグイン」の年間サポーターライセンスお申込みページ。年間サポーターは1プラグイン年額¥3,000（税抜）、プレミアム年間サポーターは全プラグイン対象で年額¥15,000（税抜）。広告非表示・リクエスト機能・優先サポート付き。"
  ogUrl="https://kizuna-works.jp/plugins/supporter/"
  ogType="website"
  canonical="https://kizuna-works.jp/plugins/supporter/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/supporter/",
          "url": "https://kizuna-works.jp/plugins/supporter/",
          "name": "ちょこっとプラグイン 年間サポーターライセンス申込 | KIZUNA Works",
          "description": "KIZUNA Works「ちょこっとプラグイン」の年間サポーターライセンスお申込みページ。年間サポーター¥3,000/年（税抜）／プレミアム年間サポーター¥15,000/年（税抜）。",
          "isPartOf": {
            "@type": "WebSite",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
          }
        },
        {
          "@type": "Service",
          "@id": "https://kizuna-works.jp/plugins/supporter/#service",
          "name": "ちょこっとプラグイン 年間サポーターライセンス",
          "description": "KIZUNA Works「ちょこっとプラグイン」の年間サポーター向けライセンス。プラグイン内の広告非表示、プラグイン作成リクエスト、既存プラグインへの改善要望の送付、優先サポートなどの特典を提供。年間サポーターとプレミアム年間サポーターの2種類をご用意。",
          "serviceType": "SoftwareLicense",
          "provider": {
            "@type": "Organization",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
          },
          "areaServed": "JP",
          "offers": [
            {
              "@type": "Offer",
              "name": "年間サポーターライセンス（1プラグイン・年額）",
              "price": "3000",
              "priceCurrency": "JPY",
              "url": "https://kizuna-works.jp/plugins/supporter/",
              "availability": "https://schema.org/InStock",
              "priceSpecification": {
                "@type": "UnitPriceSpecification",
                "price": "3000",
                "priceCurrency": "JPY",
                "billingDuration": "P1Y",
                "unitText": "year",
                "valueAddedTaxIncluded": false
              }
            },
            {
              "@type": "Offer",
              "name": "プレミアム年間サポーターライセンス（販売中の全プラグイン対象・年額）",
              "price": "15000",
              "priceCurrency": "JPY",
              "url": "https://kizuna-works.jp/plugins/supporter/?plan=all",
              "availability": "https://schema.org/InStock",
              "priceSpecification": {
                "@type": "UnitPriceSpecification",
                "price": "15000",
                "priceCurrency": "JPY",
                "billingDuration": "P1Y",
                "unitText": "year",
                "valueAddedTaxIncluded": false
              }
            }
          ]
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ホーム",
              "item": "https://kizuna-works.jp/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "kintoneプラグイン",
              "item": "https://kizuna-works.jp/plugins/"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "年間サポーターライセンス",
              "item": "https://kizuna-works.jp/plugins/supporter/"
            }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    /* Breadcrumb */
    .breadcrumb-bar {
      max-width: 1200px;
      margin: 0 auto;
      padding: 16px 5% 0;
      font-size: 0.85rem;
      color: var(--color-text-muted);
    }
    .breadcrumb-bar a {
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .breadcrumb-bar a:hover {
      color: var(--color-green);
      text-decoration: underline;
    }
    .breadcrumb-sep {
      margin: 0 8px;
      color: #cbd5e1;
    }

    /* Hero */
    .supporter-hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.55) 0%, rgba(46,139,46,0.5) 100%),
                  url('/images/plugins-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 100px 5%;
      text-align: center;
      color: var(--color-white);
    }

    .supporter-hero h1 {
      font-size: 2.6rem;
      font-weight: 700;
      margin: 0 0 18px;
      letter-spacing: 0.08em;
    }

    .supporter-hero .lead {
      font-size: 1.15rem;
      max-width: 720px;
      margin: 0 auto;
      font-weight: 500;
      line-height: 1.7;
    }

    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    /* Section base */
    .content-section {
      max-width: 900px;
      margin: 0 auto;
      padding: 60px 5% 0;
    }

    .content-section:last-of-type {
      padding-bottom: 80px;
    }

    .content-section h2 {
      font-size: 1.6rem;
      color: var(--color-navy);
      margin: 0 0 28px;
      padding-left: 14px;
      border-left: 5px solid var(--color-green);
      line-height: 1.4;
    }

    .content-section .section-desc {
      font-size: 1rem;
      line-height: 1.8;
      color: var(--color-text-main);
      margin: 0 0 20px;
    }

    /* Plan cards (3-up layout) */
    .plan-cards-section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 60px 5% 0;
    }

    .plan-cards-heading {
      font-size: 1.6rem;
      color: var(--color-navy);
      margin: 0 0 12px;
      padding-left: 14px;
      border-left: 5px solid var(--color-green);
      line-height: 1.4;
    }

    .plan-cards-desc {
      font-size: 1rem;
      line-height: 1.8;
      color: var(--color-text-main);
      margin: 0 0 32px;
    }

    .plan-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      align-items: stretch;
    }

    .plan-card {
      background-color: var(--color-white);
      border-radius: 14px;
      padding: 36px 24px 28px;
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      text-align: center;
      position: relative;
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .plan-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }

    .plan-card.is-premium {
      border: 2px solid var(--color-green);
      background-color: #fafff8;
    }

    .plan-card-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--color-green);
      color: var(--color-white);
      padding: 4px 14px;
      border-radius: 12px;
      font-size: 0.78rem;
      font-weight: 700;
      white-space: nowrap;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    }

    .plan-card-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--color-navy);
      margin: 0 0 14px;
      line-height: 1.4;
    }

    .plan-card-price {
      margin-bottom: 4px;
    }

    .plan-card-price .amount {
      font-size: 2.1rem;
      font-weight: 700;
      color: var(--color-navy);
    }

    .plan-card-price .unit {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin-left: 4px;
      font-weight: 500;
    }

    .plan-card-sub {
      font-size: 0.82rem;
      color: var(--color-text-muted);
      margin: 0 0 22px;
      min-height: 1.2em;
    }

    .plan-card-features {
      list-style: none;
      padding: 0;
      margin: 0 0 26px;
      text-align: left;
      flex: 1;
    }

    .plan-card-features li {
      position: relative;
      padding: 9px 0 9px 26px;
      font-size: 0.92rem;
      color: var(--color-text-main);
      line-height: 1.55;
      border-top: 1px solid #eef2f6;
    }

    .plan-card-features li:first-child {
      border-top: none;
    }

    .plan-card-features li::before {
      content: '✓';
      position: absolute;
      left: 4px;
      top: 9px;
      color: var(--color-green);
      font-weight: 700;
    }

    .plan-card-features li.is-cross {
      color: var(--color-text-muted);
    }

    .plan-card-features li.is-cross::before {
      content: '−';
      color: #94a3b8;
    }

    .plan-card-cta {
      display: block;
      padding: 13px 16px;
      background-color: var(--color-green);
      color: var(--color-white);
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      transition: background-color 0.3s, transform 0.3s, box-shadow 0.3s;
    }

    .plan-card-cta:hover {
      background-color: var(--color-navy);
      transform: translateY(-2px);
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
    }

    .plan-card.is-free .plan-card-cta {
      background-color: var(--color-navy);
    }

    .plan-card.is-free .plan-card-cta:hover {
      background-color: var(--color-green);
    }

    @media (max-width: 900px) {
      .plan-cards-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .plan-cards-section {
        padding: 40px 5% 0;
      }
      .plan-cards-heading {
        font-size: 1.35rem;
      }
    }

    /* Perks list */
    .perks-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 14px;
    }

    .perks-list li {
      background-color: var(--color-white);
      border-radius: 10px;
      padding: 18px 22px 18px 56px;
      position: relative;
      box-shadow: var(--shadow-card);
      font-size: 1rem;
      line-height: 1.7;
      color: var(--color-text-main);
    }

    .perks-list li::before {
      content: '✓';
      position: absolute;
      left: 18px;
      top: 18px;
      width: 28px;
      height: 28px;
      background-color: var(--color-green);
      color: var(--color-white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.95rem;
    }

    /* Notes list */
    .notes-list {
      list-style: none;
      padding: 24px 28px;
      margin: 0;
      background-color: var(--color-white);
      border-left: 4px solid #94a3b8;
      border-radius: 0 10px 10px 0;
      box-shadow: var(--shadow-card);
    }

    .notes-list li {
      position: relative;
      padding: 8px 0 8px 22px;
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--color-text-main);
    }

    .notes-list li::before {
      content: '・';
      position: absolute;
      left: 0;
      color: #94a3b8;
      font-weight: 700;
    }

    /* Mobile */
    @media (max-width: 768px) {
      .supporter-hero {
        padding: 70px 5%;
      }
      .supporter-hero h1 {
        font-size: 1.9rem;
      }
      .supporter-hero .lead {
        font-size: 1rem;
      }
      .content-section {
        padding: 40px 5% 0;
      }
      .content-section h2 {
        font-size: 1.35rem;
      }
      .notes-list {
        padding: 20px 18px;
      }
    }
  </style>

  <main>
    <nav class="breadcrumb-bar" aria-label="パンくず">
      <a href="/">ホーム</a><span class="breadcrumb-sep">／</span>
      <a href="/plugins/">kintoneプラグイン</a><span class="breadcrumb-sep">／</span>
      <span>年間サポーターライセンス</span>
    </nav>

    <section class="supporter-hero">
      <h1>現場の声を、絆に。</h1>
      <p class="lead">
        ちょこっとプラグインの年間サポーターとして開発を応援してください
      </p>
    </section>
    <div class="hero-gradient-line"></div>

    <section class="plan-cards-section">
      <h2 class="plan-cards-heading">プランを選ぶ</h2>
      <p class="plan-cards-desc">
        ご利用のプラグイン数に応じて、3 つのプランからお選びいただけます。<br />
        <strong>5 プラグイン以上ご利用ならプレミアム年間サポーターがお得</strong>です。
      </p>
      <div class="plan-cards-grid">
        <article class="plan-card is-free">
          <h3 class="plan-card-name">無料プラン</h3>
          <div class="plan-card-price">
            <span class="amount">¥0</span>
            <span class="unit">完全無料</span>
          </div>
          <div class="plan-card-sub">利用期限なし・いつまでも無料</div>
          <ul class="plan-card-features">
            <li>全プラグインの全機能が利用可能</li>
            <li>設定画面に控えめな広告エリア表示あり</li>
            <li class="is-cross">プラグイン作成リクエストは不可</li>
            <li class="is-cross">改善要望の送付は不可</li>
          </ul>
          <a href="/plugins/" class="plan-card-cta">プラグイン一覧を見る →</a>
        </article>

        <article class="plan-card is-individual">
          <h3 class="plan-card-name">年間サポーター</h3>
          <div class="plan-card-price">
            <span class="amount">¥3,300</span>
            <span class="unit">/ 年（税込）</span>
          </div>
          <div class="plan-card-sub">税抜 ¥3,000 ／ 月額換算 約 250 円</div>
          <ul class="plan-card-features">
            <li>選択した <strong>1 プラグイン</strong>が対象</li>
            <li>対象プラグインの広告エリアが非表示</li>
            <li>プラグイン作成リクエスト・改善要望の送付</li>
            <li>サポーターの声を優先反映</li>
          </ul>
          <a href="#sf-form" class="plan-card-cta" data-select-plan="individual">年間サポーターに申し込む →</a>
        </article>

        <article class="plan-card is-premium">
          <span class="plan-card-badge">5プラグイン以上ならお得</span>
          <h3 class="plan-card-name">プレミアム年間サポーター</h3>
          <div class="plan-card-price">
            <span class="amount">¥16,500</span>
            <span class="unit">/ 年（税込）</span>
          </div>
          <div class="plan-card-sub">税抜 ¥15,000 ／ 月額換算 約 1,250 円</div>
          <ul class="plan-card-features">
            <li>販売中の<strong>全プラグイン</strong>が対象</li>
            <li><strong>契約期間中にリリースされる新プラグイン</strong>も追加料金なしで対象</li>
            <li>全プラグインの広告エリアが非表示</li>
            <li>プラグイン作成リクエスト・改善要望の送付</li>
            <li>サポーターの声を優先反映</li>
            <li>HP サポーター一覧に貴社ロゴ掲載（任意）</li>
          </ul>
          <a href="#sf-form" class="plan-card-cta" data-select-plan="all">プレミアムに申し込む →</a>
        </article>
      </div>
    </section>

    <section class="content-section">
      <h2>サポーターの特典</h2>
      <ul class="perks-list">
        <li>プラグイン内の広告エリアが非表示になります（年間サポーターはそのプラグインのみ／プレミアム年間サポーターは販売中の全プラグインが対象）</li>
        <li>設定画面から無料ツール・プラグインへのリンクを利用できます</li>
        <li>プラグイン作成リクエストフォームをご利用いただけます</li>
        <li>既存プラグインへの改善要望をお送りいただけます</li>
        <li>サポーターの声を優先してプラグイン開発を進めます</li>
        <li><strong>プレミアム年間サポーター限定：</strong>契約期間中にリリースされる新しいちょこっとプラグインシリーズも追加料金なしでご利用いただけます</li>
        <li><strong>プレミアム年間サポーター限定：</strong>本ページ下部のサポーター一覧に貴社ロゴ・サイトリンクを掲載いたします（任意・ご希望の場合のみ）</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>年間サポーターライセンス 申込フォーム</h2>
      <p class="section-desc">
        以下のフォームからお申し込みください。<br />
        お申し込み内容を確認の上、担当者メールアドレスへご連絡いたします。
      </p>
    </section>

    <SupporterForm />

    <section class="content-section">
      <h2>注意事項</h2>
      <ul class="notes-list">
        <li>本ライセンスはご購入後の返金はいたしかねます</li>
        <li>ライセンスは登録ドメイン1つに対して有効です</li>
        <li>第三者への譲渡・転売は禁止しております</li>
        <li>お支払い確認後、3営業日以内にライセンスを発行いたします</li>
        <li>プレミアム年間サポーターはご契約時点で販売中の全プラグインが対象です。ご契約期間中に新規リリースされたプラグインは追加料金なしで対象に含まれます</li>
      </ul>
    </section>
  </main>

  <script is:inline>
    // Plan-card CTA buttons set the form's planType radio before the anchor scroll lands on the form.
    document.querySelectorAll('[data-select-plan]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var plan = btn.getAttribute('data-select-plan');
        var radio = document.querySelector('input[name="planType"][value="' + plan + '"]');
        if (radio && !radio.checked) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    });
  </script>
</Layout>
