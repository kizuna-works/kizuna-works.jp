---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
---

<Layout
  title="テーマスタイラー for kintone - 無料 kintoneプラグイン | KIZUNA Works"
  description="kintoneアプリのテーマカラーとアプリタイトル帯を自由にカスタマイズする無料プラグイン。12種プリセット＋カラーピッカー、グラデーション背景、テキスト・リンク、最大5個のカスタムボタン（50種スタイル）対応。完全無料のkintoneプラグイン、kintone プラグイン 無料配布中。"
  ogTitle="テーマスタイラー for kintone - 無料 kintoneプラグイン | KIZUNA Works"
  ogDescription="kintoneアプリのテーマカラーとアプリタイトル帯をノーコードでカスタマイズ。グラデーション・テキスト・最大5個のカスタムボタン（50種スタイル）に対応した無料プラグイン。kintone プラグイン 無料配布中。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/theme-styler/"
  ogImage="https://kizuna-works.jp/images/ogp.png"
  canonical="https://kizuna-works.jp/plugins/theme-styler/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
