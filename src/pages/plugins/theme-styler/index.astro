---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="テーマスタイラー for kintone - 関連アプリ・社内サイトへのクイックリンク集約 | KIZUNA Works"
  description="kintone アプリのタイトル帯に関連 kintone アプリ・社内ポータル・マニュアル・外部 Web サイトへのクイックリンク（テキスト＋最大5個のボタン）を集約。アプリを業務ハブ化する無料プラグイン。テーマカラーの一括着色（タイトル帯・ヘッダー・行・罫線・フォーム背景）と10種の日本語フォント、50種ボタンスタイルにも対応。"
  ogTitle="テーマスタイラー for kintone - 関連アプリ・社内サイトへのクイックリンク集約 | KIZUNA Works"
  ogDescription="kintone アプリのタイトル帯に関連アプリ・社内ポータル・外部サイトへのクイックリンクをまとめて配置。テーマカラーの一括着色と10種フォント・50種ボタンスタイルにも対応した無料プラグイン。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/theme-styler/"
  ogImage="https://kizuna-works.jp/images/theme-styler-banner.png"
  canonical="https://kizuna-works.jp/plugins/theme-styler/"
>
