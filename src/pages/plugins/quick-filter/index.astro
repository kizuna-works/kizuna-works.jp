    /* Japanese line breaking.
       - balance: short centred blocks (hero lead, captions, CTA) get lines of
         even length instead of dropping two characters onto a last line.
       - pretty: longer left-aligned prose keeps its ragged edge but never ends
         on an orphan.
       - strict: a line may not start with a small kana (ォ ャ ッ) or a closing
         bracket (a katakana word split before a small kana in a caption). */
    .afp-hero .afp-sub,
    .afp-hero .afp-tagline,
    .afp-cta p,
    .afp-shot-cap { text-wrap: balance; }
    /* Left-aligned prose fills the line; balance would shorten every line and
       leave a wide gap on the right. pretty only avoids a one-word last line. */
    .afp-lead,
    .afp-note,
    .afp-cautions li,
    .afp-feat-card p,
    .afp-plan-features li,
    .gc-step p,
    .gc-step li,
    .gc-branch p,
    .afp-faq-answer { text-wrap: pretty; }
    .afp-hero .afp-sub,
    .afp-hero .afp-tagline,
    .afp-cta p,
    .afp-shot-cap,
    .afp-lead,
    .afp-note,
    .afp-cautions li,
    .afp-feat-card p,
    .afp-plan-features li,
    .gc-step p,
    .gc-branch p,
    .afp-faq-answer { line-break: strict; }
    /* Phrase breaking only for short, centred or heading text. In left-aligned
       body text it breaks early whenever a phrase does not fit, which leaves
       uneven gaps on the right; normal breaking with line-break: strict reads
       better there. */
    .afp-h2 { text-wrap: balance; }
    .afp-h2,
    .afp-h3,
    .afp-hero .afp-tagline,
    .afp-feat-card h3,
    .afp-faq-item > summary { word-break: auto-phrase; }
    @media (min-width: 769px) {
      .afp-hero .afp-sub,
      .afp-cta p,
      .afp-shot-cap { word-break: auto-phrase; }
    }
    /* Bullet list inside a caution card: a small green dot per item so the
       items read as one list rather than separate paragraphs. */
    .afp-cautions ul { list-style: none; margin: 0; padding: 0; }
    .afp-cautions li { position: relative; padding-left: 1.2em; }
    .afp-cautions li::before {
      content: ""; position: absolute; left: 0.2em; top: 0.72em;
      width: 6px; height: 6px; border-radius: 50%; background: var(--color-green);
    }

