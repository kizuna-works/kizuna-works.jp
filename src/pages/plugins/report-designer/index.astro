  <script is:inline>
    (function () {
      var box = document.getElementById('rd-lightbox');
      if (!box) return;
      var img = box.querySelector('img');
      var close = box.querySelector('.rd-lightbox-close');
      function open(src, alt) { img.src = src; img.alt = alt || ''; box.hidden = false; document.body.style.overflow = 'hidden'; }
      function hide() { box.hidden = true; img.src = ''; document.body.style.overflow = ''; }
      document.querySelectorAll('img.zoomable').forEach(function (el) {
        el.addEventListener('click', function () { open(el.getAttribute('src'), el.getAttribute('alt')); });
      });
      close.addEventListener('click', hide);
      box.addEventListener('click', function (e) { if (e.target === box) hide(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.hidden) hide(); });
    })();
    (function () {
      var dl = document.getElementById('btn-download');
      if (dl && typeof gtag === 'function') {
        dl.addEventListener('click', function () {
          gtag('event', 'file_download', {
            file_name: 'kw-report-designer-v1.1.0.zip',
            file_extension: 'zip',
            link_text: '無料でダウンロードして試す',
            link_url: '/downloads/kw-report-designer-v1.1.0.zip'
          });
        });
      }
    })();
  </script>
