---
import Layout from '../../layouts/Layout.astro';
import SupporterCTA from '../../components/SupporterCTA.astro';
import TrialBanner from '../../components/TrialBanner.astro';
import Picture from '../../components/Picture.astro';
import { plugins, premiumPlugins, pluginsItemListJsonLd } from '../../data/plugins';
import type { Plugin } from '../../data/plugins';
import {
  pluginCategoryGroups,
  pluginCategoryMeta,
  pluginCategories,
} from '../../data/pluginCategories';

const itemListJson = JSON.stringify(pluginsItemListJsonLd);

// Chip counts span both grids: filtering hides cards in the premium and the
// chokotto section alike, so a count that only covered one would mislead.
const categoryCounts = new Map<string, number>();
for (const p of [...premiumPlugins, ...plugins]) {
  for (const c of p.categories) {
    categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  }
}

// Emitted as a JSON island so the filter script has the category names and
// captions without duplicating them in JavaScript.
const categoryClientMeta = Object.fromEntries(
  pluginCategories.map((c) => [
    pluginCategoryMeta[c].slug,
    { name: c, desc: pluginCategoryMeta[c].description },
  ])
);

/** Slug list for the card's filter matching. */
const catSlugs = (p: Plugin) => p.categories.map((c) => pluginCategoryMeta[c].slug).join('|');

/**
 * Haystack for a future keyword search box. The input is not rendered yet, but
 * shipping the attribute now means turning search on is a markup-only change.
 */
const searchText = (p: Plugin) =>
  [p.name, p.description, p.problemTitle, p.problemDesc, ...p.categories]
    .join(' ')
    .toLowerCase();

// Product counts are derived so the copy never drifts from the actual lineup.
const chokottoCount = plugins.length;
const premiumCount = premiumPlugins.length;
const totalCount = chokottoCount + premiumCount;

// "kintone プラグイン 無料" is a high-intent query where this page ranked ~30th.
// Searchers want to know how many plugins exist and exactly what "free" covers,
// so both are answered in static text below and mirrored in FAQPage structured data.
const freeFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'kintoneプラグインは無料で使えますか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `KIZUNA Works の kintone プラグインは全 ${totalCount} 製品すべて無料でダウンロードでき、利用期限はありません。ちょこっとプラグイン ${chokottoCount} 製品は無料で全機能を利用できます。プレミアムプラグイン ${premiumCount} 製品は基本機能を無料で試せます。`,
      },
    },
    {
      '@type': 'Question',
      name: '無料プランと年間サポーターの違いは何ですか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `ちょこっとプラグインは無料プランでも全機能が使え、違いはレコード一覧画面に控えめな広告エリアが表示される点です。年間サポーター（選んだ 1 製品が対象・年額 ¥3,300 税込）に加入すると、その製品の広告エリアが非表示になり、プラグイン作成リクエストや改善要望を送れます。プレミアムプラグインは全機能の利用にプレミアム年間サポーター（年額 ¥16,500 税込・販売中の全製品が対象）が必要で、単品販売はありません。`,
      },
    },
    {
      '@type': 'Question',
      name: 'プラグインの導入にプログラミングは必要ですか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'いりません。kintone のシステム管理からプラグインの ZIP ファイルを読み込み、使用するアプリで追加して、設定画面で対象のフィールドや条件を選ぶだけで導入できます。JavaScript の記述は不要です。',
      },
    },
  ],
};
---

<Layout
  title={`無料のkintoneプラグイン一覧 全${totalCount}製品｜ちょこっとプラグイン | KIZUNA Works`}
  description={`kintoneプラグインを全${totalCount}製品、無料で配布中。フィールド装飾・自動採番・横断検索・一括更新・帳票出力などをノーコードで追加できます。ちょこっとプラグイン${chokottoCount}製品は無料で全機能が使え、利用期限もありません。目的別に選べる一覧です。`}
  ogTitle={`無料のkintoneプラグイン一覧 全${totalCount}製品｜ちょこっとプラグイン | KIZUNA Works`}
  ogDescription={`kintoneプラグインを全${totalCount}製品、無料で配布中。フィールド装飾・自動採番・横断検索・一括更新・帳票出力などをノーコードで追加できます。ちょこっとプラグイン${chokottoCount}製品は無料で全機能が使え、利用期限もありません。`}
  ogUrl="https://kizuna-works.jp/plugins/"
  ogType="website"
  canonical="https://kizuna-works.jp/plugins/"
  heroBg="/images/plugins-bg.webp"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/",
          "url": "https://kizuna-works.jp/plugins/",
          "name": "無料のkintoneプラグイン一覧 全${totalCount}製品｜ちょこっとプラグイン | KIZUNA Works",
          "description": "KIZUNA Works が無料配布している kintone プラグイン全${totalCount}製品の一覧。ノーコードで導入でき、ちょこっとプラグイン${chokottoCount}製品は無料で全機能を利用できる。",
          "dateModified": "2026-08-02"
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ホーム",
              "item": "https://kizuna-works.jp/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "kintoneプラグイン",
              "item": "https://kizuna-works.jp/plugins/"
            }
          ]
        },
        {
          "@type": "ItemList",
          "itemListElement": ${itemListJson}
        }
      ]
    }`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(freeFaqJsonLd)} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    /* Hero */
    .hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.45) 0%, rgba(42,82,152,0.4) 100%),
                  url('/images/plugins-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 100px 5%;
      text-align: center;
      color: var(--color-white);
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 0.05em;
    }

    .hero p {
      font-size: 1.1rem;
      max-width: 700px;
      margin: 0 auto;
      font-weight: 500;
    }

    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    /* Intro */
    .intro-section {
      padding: 60px 5% 40px;
      display: flex;
      justify-content: center;
    }

    .intro-card {
      background: var(--color-white);
      max-width: 800px;
      width: 100%;
      padding: 40px;
      border-radius: 12px;
      box-shadow: var(--shadow-card);
      text-align: center;
    }

    .intro-card h2 {
      color: var(--color-navy);
      font-size: 1.5rem;
      margin-bottom: 24px;
      position: relative;
      display: inline-block;
    }

    .intro-card h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 3px;
      background-color: var(--color-green);
      border-radius: 2px;
    }

    .intro-card p {
      font-size: 1.05rem;
      color: var(--color-text-main);
      line-height: 1.8;
      text-align: left;
      margin: 0 0 18px;
    }

    .intro-card p:last-of-type {
      margin-bottom: 0;
    }

    /* "What free covers" comparison table. Wrapper scrolls horizontally and the
       table keeps a min-width so cells never collapse on narrow screens. */
    .free-scope-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 22px 0 26px;
    }

    .free-scope-table {
      width: 100%;
      min-width: 560px;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    .free-scope-table th,
    .free-scope-table td {
      border: 1px solid var(--color-bg-light);
      padding: 11px 14px;
      text-align: left;
      vertical-align: top;
      line-height: 1.7;
    }

    .free-scope-table thead th {
      background: var(--color-navy);
      color: var(--color-white);
      font-weight: 700;
      white-space: nowrap;
    }

    .free-scope-table tbody th,
    .free-scope-table tbody td:first-child {
      background: #f7fafc;
      font-weight: 700;
      color: var(--color-navy);
      min-width: 190px;
    }

    .free-scope-table .is-free {
      color: var(--color-green);
      font-weight: 700;
    }

    .intro-question {
      text-align: center !important;
      font-weight: 700;
      color: var(--color-navy);
      font-size: 1.1rem !important;
      padding: 12px 0;
    }

    .intro-cta {
      text-align: center;
      margin-top: 28px;
    }

    .intro-cta-button {
      display: inline-block;
      padding: 14px 28px;
      background-color: var(--color-navy);
      color: var(--color-white);
      border-radius: 8px;
      font-weight: 700;
      font-size: 1rem;
      text-decoration: none;
      transition: background-color var(--transition-speed), transform var(--transition-speed), box-shadow var(--transition-speed);
    }

    .intro-cta-button:hover {
      background-color: var(--color-green);
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    /* Plugins Grid */
    .section-container {
      padding: 40px 5% 80px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      color: var(--color-navy);
      margin-bottom: 40px;
      padding-left: 16px;
      border-left: 5px solid var(--color-green);
      display: flex;
      align-items: center;
    }

    /* 3 across on desktop. The container tops out at 1200px with 5% padding, so
       the usable width never exceeds ~1080px: 3x300 + 2x32 = 964 fits, and
       4x300 + 3x32 = 1296 never does, which pins it to exactly 3 columns. */
    .plugins-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 32px;
    }

    /* The card is a plain container, not a link: the category chips inside it are
       buttons, and nesting interactive elements inside an <a> is invalid HTML and
       breaks keyboard use. The title link is stretched over the card instead, so
       clicking anywhere still opens the product page. */
    .plugin-card {
      position: relative;
      background-color: var(--color-white);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: var(--shadow-card);
      transition: transform var(--transition-speed), box-shadow var(--transition-speed);
      display: flex;
      flex-direction: column;
      color: inherit;
    }

    .plugin-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .plugin-card:focus-within {
      box-shadow: var(--shadow-hover), 0 0 0 3px rgba(27, 58, 107, 0.35);
    }

    .plugin-card[hidden] {
      display: none;
    }

    .plugin-card-image {
      width: 100%;
      /* Match the designed banner ratio (1200x630) so left/right edges are not cropped */
      aspect-ratio: 1200 / 630;
      object-fit: cover;
      display: block;
      border-bottom: 1px solid #e2e8f0;
    }

    .plugin-card-content {
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .plugin-title {
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.45;
      color: var(--color-navy);
      margin-bottom: 4px;
      /* At 337px most product names wrap to two lines and a few do not. Reserving
         two lines keeps the description starting at the same y across a row. */
      min-height: 2.9em;
    }

    .plugin-title a {
      color: inherit;
      text-decoration: none;
    }

    /* Stretched link: covers the whole card so the click target is unchanged. */
    .plugin-title a::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .plugin-title a:focus-visible {
      outline: none;
    }

    .plugin-subtitle {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin-bottom: 20px;
    }

    /* Category chips. Sits above the stretched title link so it stays clickable,
       and reserves two rows of height so cards with 1 and 3 chips line up. */
    .plugin-cats {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 12px;
      min-height: 34px;
      align-content: flex-start;
    }

    .plugin-cat {
      font: inherit;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      padding: 4px 11px;
      border: 0;
      border-radius: 999px;
      line-height: 1.5;
      white-space: nowrap;
      cursor: pointer;
      background: var(--cat-bg);
      color: var(--cat-fg);
      /* Keeps the tap target at 32px without inflating the visual pill. */
      outline-offset: 2px;
    }

    .plugin-cat.is-sub {
      background: transparent;
      box-shadow: inset 0 0 0 1px currentColor;
    }

    .plugin-cat:hover {
      filter: brightness(0.94);
    }

    /* Hue family per filter-bar group: warm = 入力・制御, cool = 画面,
       green/neutral = データ・運用. Foregrounds are dark enough for AA at 11px. */
    .plugin-cat[data-cat="自動入力"],
    .pf-chip[data-cat="自動入力"]      { --cat-bg: #fff1e0; --cat-fg: #9c530f; }
    .plugin-cat[data-cat="入力チェック"],
    .pf-chip[data-cat="入力チェック"]    { --cat-bg: #fdeaea; --cat-fg: #a32f2b; }
    .plugin-cat[data-cat="表示・編集制御"],
    .pf-chip[data-cat="表示・編集制御"]  { --cat-bg: #fdf4d9; --cat-fg: #77590a; }
    .plugin-cat[data-cat="一括処理"],
    .pf-chip[data-cat="一括処理"]      { --cat-bg: #fdeaf2; --cat-fg: #962f63; }
    .plugin-cat[data-cat="一覧表示"],
    .pf-chip[data-cat="一覧表示"]      { --cat-bg: #e8f0fb; --cat-fg: #1b3a6b; }
    .plugin-cat[data-cat="画面レイアウト"],
    .pf-chip[data-cat="画面レイアウト"]  { --cat-bg: #e2f1f4; --cat-fg: #0e5f6c; }
    .plugin-cat[data-cat="装飾・配色"],
    .pf-chip[data-cat="装飾・配色"]     { --cat-bg: #f3eafc; --cat-fg: #6b3496; }
    .plugin-cat[data-cat="検索・閲覧"],
    .pf-chip[data-cat="検索・閲覧"]     { --cat-bg: #eaeafa; --cat-fg: #3c368f; }
    .plugin-cat[data-cat="集計・計算"],
    .pf-chip[data-cat="集計・計算"]     { --cat-bg: #e7f5e7; --cat-fg: #1f5c1f; }
    .plugin-cat[data-cat="出力・帳票"],
    .pf-chip[data-cat="出力・帳票"]     { --cat-bg: #eff3e0; --cat-fg: #4d6612; }
    .plugin-cat[data-cat="通知・メール"],
    .pf-chip[data-cat="通知・メール"]    { --cat-bg: #ddf2f0; --cat-fg: #0b6f68; }
    .plugin-cat[data-cat="情報共有"],
    .pf-chip[data-cat="情報共有"]      { --cat-bg: #f5ece3; --cat-fg: #7a4d24; }
    .plugin-cat[data-cat="履歴・復元"],
    .pf-chip[data-cat="履歴・復元"]     { --cat-bg: #ecf0f4; --cat-fg: #3d4c5c; }

    /* Lead block — the long "特長" copy moved below the grids, so this is all a
       first-time visitor reads before reaching the products. */
    .lead-section {
      padding: 48px 5% 8px;
    }

    .lead-card {
      max-width: 1200px;
      padding: 28px 32px;
    }

    .lead-main {
      font-size: 1.05rem;
    }

    .lead-sub {
      font-size: 0.98rem !important;
      color: var(--color-text-muted) !important;
    }

    /* The long copy used to sit below the grids with anchor links pointing at it.
       On a 23,000px page that meant a one-way trip: getting back to the products
       took a full scroll. It opens in place instead, so there is nothing to
       return from. Collapsed by default keeps the grid near the top. */
    .lead-folds {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 4px 0 16px;
    }

    .lead-fold {
      flex: 1 1 280px;
      border: 1px solid #dbe3ec;
      border-radius: 10px;
      background: #f8fafc;
    }

    .lead-fold[open] {
      /* Take the full row when open so the table has room and the sibling wraps. */
      flex-basis: 100%;
      background: var(--color-white);
      border-color: #c3d0e0;
    }

    .lead-fold > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 13px 16px;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--color-navy);
      cursor: pointer;
      list-style: none;
    }

    .lead-fold > summary::-webkit-details-marker {
      display: none;
    }

    .lead-fold > summary::after {
      content: '＋';
      flex-shrink: 0;
      font-size: 0.95rem;
      color: var(--color-green);
    }

    .lead-fold[open] > summary::after {
      content: '−';
    }

    .lead-fold > summary:hover {
      color: var(--color-green);
    }

    .lead-fold-body {
      padding: 0 16px 18px;
      border-top: 1px solid #e2e8f0;
      margin-top: -1px;
      padding-top: 16px;
    }

    .lead-fold-body p {
      font-size: 0.98rem !important;
    }

    /* The campaign banner lives in the lead card so it is seen before the grid.
       `inset` strips the banner's own centring, letting it fill the card. */
    .lead-campaign {
      margin-top: 4px;
    }

    /* Filter bar */
    .pf-bar {
      padding: 16px 5% 0;
      display: flex;
      justify-content: center;
    }

    .pf-inner {
      background: var(--color-white);
      max-width: 1200px;
      width: 100%;
      padding: 22px 28px 18px;
      border-radius: 12px;
      box-shadow: var(--shadow-card);
    }

    .pf-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 16px;
    }

    .pf-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--color-navy);
      margin: 0;
    }

    .pf-count {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--color-text-muted);
      margin: 0;
    }

    .pf-group {
      display: grid;
      grid-template-columns: 88px 1fr;
      gap: 10px;
      align-items: start;
      margin-bottom: 10px;
    }

    .pf-group-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--color-text-muted);
      padding-top: 7px;
    }

    .pf-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pf-chip {
      font: inherit;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid #dbe3ec;
      background: #f4f7fb;
      color: #4a5a6b;
      cursor: pointer;
      white-space: nowrap;
      transition: background-color 0.15s, color 0.15s, border-color 0.15s;
    }

    .pf-chip:hover {
      border-color: #b9c7d8;
      background: #e9eff7;
    }

    .pf-chip[aria-pressed='true'] {
      background: var(--cat-bg);
      color: var(--cat-fg);
      border-color: currentColor;
    }

    .pf-chip-n {
      margin-left: 7px;
      font-size: 0.78em;
      opacity: 0.7;
    }

    .pf-foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid #e2e8f0;
    }

    .pf-desc {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin: 0;
    }

    .pf-clear {
      font: inherit;
      font-size: 0.85rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid var(--color-navy);
      background: transparent;
      color: var(--color-navy);
      cursor: pointer;
      white-space: nowrap;
    }

    .pf-clear:hover {
      background: var(--color-navy);
      color: var(--color-white);
    }

    .pf-empty {
      max-width: 1200px;
      margin: 40px auto 0;
      padding: 0 5%;
      text-align: center;
      color: var(--color-text-muted);
    }

    .pf-empty-clear {
      font: inherit;
      font-weight: 700;
      margin-left: 8px;
      border: 0;
      background: none;
      color: var(--color-navy);
      text-decoration: underline;
      cursor: pointer;
    }

    /* Floating reset. Shown only while a filter is active and the bar has
       scrolled out of view, so 47 cards of scrolling never traps the visitor. */
    .pf-float {
      position: fixed;
      left: 50%;
      bottom: 20px;
      transform: translateX(-50%);
      z-index: 50;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 10px 9px 18px;
      border-radius: 999px;
