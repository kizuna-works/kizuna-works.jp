---
import Layout from '../../layouts/Layout.astro';
import SupporterCTA from '../../components/SupporterCTA.astro';
import { plugins, pluginsItemListJsonLd } from '../../data/plugins';

const itemListJson = JSON.stringify(pluginsItemListJsonLd);
---

<Layout
  title="kintoneプラグイン | KIZUNA Works"
  description="KIZUNA Worksのkintoneプラグイン。フィールドのスタイルをノーコードで変更できる「フィールドスタイラー」と、条件分岐で採番ルールを自動切替する「条件分岐自動採番」を無料・有料で提供中。"
  ogTitle="kintoneプラグイン | KIZUNA Works"
  ogDescription="KIZUNA Worksのkintoneプラグイン。フィールドスタイラー・条件分岐自動採番など。"
  ogUrl="https://kizuna-works.jp/plugins/"
  canonical="https://kizuna-works.jp/plugins/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/",
          "url": "https://kizuna-works.jp/plugins/",
          "name": "kintoneプラグイン | KIZUNA Works",
          "description": "KIZUNA Worksのkintoneプラグイン。フィールドの見た目や入力を自在にカスタマイズできる「フィールドスタイラー」を提供中。"
        },
        {
          "@type": "ItemList",
          "itemListElement": ${itemListJson}
        }
      ]
    }`} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    /* Hero */
    .hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.45) 0%, rgba(42,82,152,0.4) 100%),
                  url('/images/plugins-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 100px 5%;
      text-align: center;
      color: var(--color-white);
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 0.05em;
    }

    .hero p {
      font-size: 1.1rem;
      max-width: 700px;
      margin: 0 auto;
      font-weight: 500;
    }

    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    /* Intro */
    .intro-section {
      padding: 60px 5% 40px;
      display: flex;
      justify-content: center;
    }

    .intro-card {
      background: var(--color-white);
      max-width: 800px;
      width: 100%;
      padding: 40px;
      border-radius: 12px;
      box-shadow: var(--shadow-card);
      text-align: center;
    }

    .intro-card h2 {
      color: var(--color-navy);
      font-size: 1.5rem;
      margin-bottom: 24px;
      position: relative;
      display: inline-block;
    }

    .intro-card h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 3px;
      background-color: var(--color-green);
      border-radius: 2px;
    }

    .intro-card p {
      font-size: 1.05rem;
      color: var(--color-text-main);
      line-height: 1.8;
      text-align: left;
    }

    /* Plugins Grid */
    .section-container {
      padding: 40px 5% 80px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      color: var(--color-navy);
      margin-bottom: 40px;
      padding-left: 16px;
      border-left: 5px solid var(--color-green);
      display: flex;
      align-items: center;
    }

    .plugins-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 40px;
    }

    .plugin-card {
      background-color: var(--color-white);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: var(--shadow-card);
      transition: transform var(--transition-speed), box-shadow var(--transition-speed);
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }

    .plugin-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .plugin-card-image {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      border-bottom: 1px solid #e2e8f0;
    }

    .plugin-card-content {
      padding: 30px 24px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .plugin-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--color-navy);
      margin-bottom: 4px;
    }

    .plugin-subtitle {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin-bottom: 20px;
    }

    .plugin-desc {
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 24px;
      flex-grow: 1;
    }

    .plugin-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .plugin-pricing-row {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .pricing-divider {
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .badge-free {
      background-color: var(--color-green);
      color: var(--color-white);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .badge-coming-soon {
      background-color: #94a3b8;
      color: var(--color-white);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .badge-recommended {
      background-color: #e74c3c;
      color: #FFFFFF;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .badge-save {
      background-color: #fff3cd;
      color: #856404;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 700;
      margin-left: 8px;
      white-space: nowrap;
    }

    .badge-price {
      color: var(--color-navy);
      font-weight: 700;
      font-size: 1rem;
    }

    .plugin-button {
      display: block;
      text-align: center;
      padding: 12px 20px;
      border: 1px solid var(--color-navy);
      color: var(--color-navy);
      border-radius: 6px;
      font-weight: 700;
      transition: all var(--transition-speed);
    }

    .plugin-card:hover .plugin-button {
      background-color: var(--color-navy);
      color: var(--color-white);
    }

    @media (max-width: 768px) {
      .hero {
        padding: 60px 5%;
      }
      .hero h1 {
        font-size: 1.8rem;
      }
      .intro-section {
        padding: 40px 5% 30px;
      }
      .intro-card {
        padding: 30px 20px;
      }
      .plugins-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main>
    <section class="hero">
      <h1>kintone プラグイン</h1>
      <p>kintoneをもっと使いやすく。現場の「困った」を解決するプラグインを提供しています</p>
    </section>
    <div class="hero-gradient-line"></div>

    <section class="intro-section">
      <div class="intro-card">
        <h2>KIZUNA Works プラグインの特長</h2>
        <p>KIZUNA Worksのプラグインは、kintoneの標準機能では手が届かない「見た目のカスタマイズ」や「入力制御」を実現します。ノーコードで設定でき、プログラミング知識は不要。基本機能は完全無料でご利用いただけます。気に入っていただけたら、年間サポーターライセンスで広告非表示・サポーター特典をお楽しみいただけます。</p>
      </div>
    </section>

    <section class="section-container">
      <h2 class="section-title">プラグイン一覧</h2>
      <div class="plugins-grid">
        {plugins.map((plugin) => (
          <a href={`/plugins/${plugin.slug}/`} class="plugin-card">
            <img
              src={plugin.image}
              alt={plugin.imageAlt}
              class="plugin-card-image"
              width={plugin.imageWidth}
              height={plugin.imageHeight}
              loading="lazy"
            />
            <div class="plugin-card-content">
              <h3 class="plugin-title">{plugin.name}</h3>
              <span class="plugin-subtitle">{plugin.subtitle}</span>
              <p class="plugin-desc">{plugin.description}</p>
              <div class="plugin-meta">
                {plugin.status === 'available' ? (
                  <span class="badge-free">無料</span>
                ) : (
                  <span class="badge-coming-soon">近日販売開始予定</span>
                )}
              </div>
              {plugin.status === 'available' && plugin.price !== undefined && (
                <div class="plugin-pricing-row">
                  <span class="badge-price">¥{plugin.price.toLocaleString()}</span>
                </div>
              )}
              <span class="plugin-button">詳しく見る &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <SupporterCTA />
  </main>
</Layout>
