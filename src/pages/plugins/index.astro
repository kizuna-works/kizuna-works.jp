---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="kintoneプラグイン | KIZUNA Works"
  description="KIZUNA Worksのkintoneプラグイン。フィールドのスタイルをノーコードで変更できる「フィールドスタイラー」と、条件分岐で採番ルールを自動切替する「条件分岐自動採番」を無料・有料で提供中。"
  ogTitle="kintoneプラグイン | KIZUNA Works"
  ogDescription="KIZUNA Worksのkintoneプラグイン。フィールドスタイラー・条件分岐自動採番など。"
  ogUrl="https://kizuna-works.jp/plugins/"
  canonical="https://kizuna-works.jp/plugins/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/",
          "url": "https://kizuna-works.jp/plugins/",
          "name": "kintoneプラグイン | KIZUNA Works",
          "description": "KIZUNA Worksのkintoneプラグイン。フィールドの見た目や入力を自在にカスタマイズできる「フィールドスタイラー」を提供中。"
        },
        {
          "@type": "ItemList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "item": {
                "@type": "SoftwareApplication",
                "name": "フィールドスタイラー",
                "url": "https://kizuna-works.jp/plugins/field-styler/",
                "description": "kintoneフィールドの背景色・文字色・フォント・条件付きスタイルなど、10種類のカスタマイズをノーコードで実現。"
              }
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "条件分岐自動採番 kintone プラグイン",
              "url": "https://kizuna-works.jp/plugins/kw-conditional-numbering/"
            }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    /* Hero */
    .hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.45) 0%, rgba(42,82,152,0.4) 100%),
                  url('/images/plugins-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 100px 5%;
      text-align: center;
      color: var(--color-white);
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 0.05em;
    }

    .hero p {
      font-size: 1.1rem;
      max-width: 700px;
      margin: 0 auto;
      font-weight: 500;
    }

    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    /* Intro */
    .intro-section {
      padding: 60px 5% 40px;
      display: flex;
      justify-content: center;
    }

    .intro-card {
      background: var(--color-white);
      max-width: 800px;
      width: 100%;
      padding: 40px;
      border-radius: 12px;
      box-shadow: var(--shadow-card);
      text-align: center;
    }

    .intro-card h2 {
      color: var(--color-navy);
      font-size: 1.5rem;
      margin-bottom: 24px;
      position: relative;
      display: inline-block;
    }

    .intro-card h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 3px;
      background-color: var(--color-green);
      border-radius: 2px;
    }

    .intro-card p {
      font-size: 1.05rem;
      color: var(--color-text-main);
      line-height: 1.8;
      text-align: left;
    }

    /* Plugins Grid */
    .section-container {
      padding: 40px 5% 80px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      color: var(--color-navy);
      margin-bottom: 40px;
      padding-left: 16px;
      border-left: 5px solid var(--color-green);
      display: flex;
      align-items: center;
    }

    .plugins-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 40px;
    }

    .plugin-card {
      background-color: var(--color-white);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: var(--shadow-card);
      transition: transform var(--transition-speed), box-shadow var(--transition-speed);
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }

    .plugin-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .plugin-card-image {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      border-bottom: 1px solid #e2e8f0;
    }

    .plugin-card-content {
      padding: 30px 24px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .plugin-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--color-navy);
      margin-bottom: 4px;
    }

    .plugin-subtitle {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin-bottom: 20px;
    }

    .plugin-desc {
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 24px;
      flex-grow: 1;
    }

    .plugin-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .plugin-pricing-row {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .pricing-divider {
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .badge-free {
      background-color: var(--color-green);
      color: var(--color-white);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .badge-coming-soon {
      background-color: #94a3b8;
      color: var(--color-white);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .badge-recommended {
      background-color: #e74c3c;
      color: #FFFFFF;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .badge-save {
      background-color: #fff3cd;
      color: #856404;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 700;
      margin-left: 8px;
      white-space: nowrap;
    }

    .badge-price {
      color: var(--color-navy);
      font-weight: 700;
      font-size: 1rem;
    }

    .plugin-button {
      display: block;
      text-align: center;
      padding: 12px 20px;
      border: 1px solid var(--color-navy);
      color: var(--color-navy);
      border-radius: 6px;
      font-weight: 700;
      transition: all var(--transition-speed);
    }

    .plugin-card:hover .plugin-button {
      background-color: var(--color-navy);
      color: var(--color-white);
    }

    /* Supporter License Form */
    .supporter-section {
      padding-top: 0;
    }

    .supporter-card {
      background-color: var(--color-white);
      max-width: 720px;
      margin: 0 auto;
      padding: 48px 40px;
      border-radius: 12px;
      box-shadow: var(--shadow-card);
    }

    .supporter-intro {
      font-size: 1rem;
      color: var(--color-text-main);
      line-height: 1.9;
      margin-bottom: 36px;
      text-align: center;
    }

    .supporter-form .form-group {
      margin-bottom: 24px;
    }

    .supporter-form label {
      display: block;
      font-weight: 700;
      color: var(--color-navy);
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    .supporter-form .required {
      color: #e74c3c;
      margin-left: 4px;
      font-size: 0.85rem;
    }

    .supporter-form input,
    .supporter-form select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 1rem;
      font-family: inherit;
      background-color: var(--color-white);
      color: var(--color-text-main);
      box-sizing: border-box;
      transition: border-color var(--transition-speed), box-shadow var(--transition-speed);
    }

    .supporter-form input:focus,
    .supporter-form select:focus {
      outline: none;
      border-color: var(--color-green);
      box-shadow: 0 0 0 3px rgba(46, 139, 46, 0.15);
    }

    .supporter-form .field-error {
      color: #e74c3c;
      font-size: 0.85rem;
      margin: 6px 0 0;
      min-height: 1em;
    }

    .supporter-form .form-submit {
      display: block;
      width: 100%;
      padding: 14px 20px;
      margin-top: 8px;
      background-color: var(--color-green);
      color: var(--color-white);
      border: none;
      border-radius: 6px;
      font-size: 1.05rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: background-color var(--transition-speed), transform var(--transition-speed), box-shadow var(--transition-speed);
    }

    .supporter-form .form-submit:hover:not(:disabled) {
      background-color: var(--color-navy);
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .supporter-form .form-submit:disabled {
      background-color: #94a3b8;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .form-message {
      padding: 28px 24px;
      border-radius: 8px;
      text-align: center;
      font-size: 1rem;
      line-height: 1.8;
    }

    .form-message-success {
      background-color: #e6f4ea;
      color: #1e6b3a;
      border: 1px solid var(--color-green);
    }

    .form-message-error {
      background-color: #fdecea;
      color: #c0392b;
      border: 1px solid #e74c3c;
      margin-top: 16px;
    }

    @media (max-width: 768px) {
      .hero {
        padding: 60px 5%;
      }
      .hero h1 {
        font-size: 1.8rem;
      }
      .intro-section {
        padding: 40px 5% 30px;
      }
      .intro-card {
        padding: 30px 20px;
      }
      .plugins-grid {
        grid-template-columns: 1fr;
      }
      .supporter-card {
        padding: 32px 20px;
      }
    }
  </style>

  <main>
    <section class="hero">
      <h1>kintone プラグイン</h1>
      <p>kintoneをもっと使いやすく。現場の「困った」を解決するプラグインを提供しています</p>
    </section>
    <div class="hero-gradient-line"></div>

    <section class="intro-section">
      <div class="intro-card">
        <h2>KIZUNA Works プラグインの特長</h2>
        <p>KIZUNA Worksのプラグインは、kintoneの標準機能では手が届かない「見た目のカスタマイズ」や「入力制御」を実現します。ノーコードで設定でき、プログラミング知識は不要。30日間の無料お試し期間があるので、安心して導入いただけます。</p>
      </div>
    </section>

    <section class="section-container">
      <h2 class="section-title">プラグイン一覧</h2>
      <div class="plugins-grid">
        <a href="/plugins/field-styler/" class="plugin-card">
          <img src="/images/field-styler-after.png" alt="フィールドスタイラー導入後の一覧画面 — 背景色・文字色・条件付きスタイルで視認性が向上" class="plugin-card-image" width="1920" height="960" loading="lazy" />
          <div class="plugin-card-content">
            <h3 class="plugin-title">フィールドスタイラー</h3>
            <span class="plugin-subtitle">Field Styler</span>
            <p class="plugin-desc">kintoneフィールドの背景色・文字色・フォント・条件付きスタイルなど、10種類のカスタマイズをノーコードで実現。</p>
            <div class="plugin-meta">
              <span class="badge-coming-soon">近日販売開始予定</span>
            </div>
            <span class="plugin-button">詳しく見る &rarr;</span>
          </div>
        </a>
        <a href="/plugins/kw-conditional-numbering/" class="plugin-card">
          <img
            src="/images/conditional-numbering-banner.png"
            alt="条件分岐自動採番プラグイン — フィールドの条件に応じて採番ルールを自動切替"
            class="plugin-card-image"
            width="1200"
            height="675"
            loading="lazy"
          />
          <div class="plugin-card-content">
            <h3 class="plugin-title">条件分岐自動採番</h3>
            <span class="plugin-subtitle">kintone プラグイン</span>
            <p class="plugin-desc">条件分岐で採番ルールを自動切替。CSVインポート後の一括採番にも対応。</p>
            <div class="plugin-meta">
              <span class="badge-free">無料</span>
            </div>
            <div class="plugin-pricing-row">
              <span class="badge-price">¥0</span>
            </div>
            <span class="plugin-button">詳しく見る &rarr;</span>
          </div>
        </a>
      </div>
    </section>

    <section class="section-container supporter-section">
      <h2 class="section-title">年間サポーターライセンス 申込フォーム</h2>
      <div class="supporter-card">
        <p class="supporter-intro">
          無料プランをお試しいただき、気に入っていただけましたら<br />
          年間サポーターライセンス（¥3,000/年・税抜）をご検討ください。<br />
          月額換算わずか250円のご支援が、開発の大きな励みになります。
        </p>

        <form id="supporter-form" class="supporter-form" novalidate>
          <div class="form-group">
            <label for="sf-companyName">会社・団体名<span class="required">必須</span></label>
            <input type="text" id="sf-companyName" name="companyName" autocomplete="organization" />
            <p class="field-error" data-error-for="companyName"></p>
          </div>

          <div class="form-group">
            <label for="sf-domain">ドメイン<span class="required">必須</span></label>
            <input type="text" id="sf-domain" name="domain" placeholder="例：abc.cybozu.com" autocomplete="off" />
            <p class="field-error" data-error-for="domain"></p>
          </div>

          <div class="form-group">
            <label for="sf-email">担当者メールアドレス<span class="required">必須</span></label>
            <input type="email" id="sf-email" name="email" autocomplete="email" />
            <p class="field-error" data-error-for="email"></p>
          </div>

          <div class="form-group">
            <label for="sf-pluginName">プラグイン名<span class="required">必須</span></label>
            <select id="sf-pluginName" name="pluginName">
              <option value="">選択してください</option>
              <option value="フィールドスタイラープラグイン">フィールドスタイラープラグイン</option>
              <option value="条件分岐自動採番プラグイン">条件分岐自動採番プラグイン</option>
            </select>
            <p class="field-error" data-error-for="pluginName"></p>
          </div>

          <div class="form-group">
            <label for="sf-paymentMethod">支払い方法<span class="required">必須</span></label>
            <select id="sf-paymentMethod" name="paymentMethod">
              <option value="">選択してください</option>
              <option value="銀行振込">銀行振込</option>
              <option value="Square決済">Square決済</option>
            </select>
            <p class="field-error" data-error-for="paymentMethod"></p>
          </div>

          <button type="submit" id="sf-submit" class="form-submit">申し込む</button>
        </form>

        <div id="sf-success" class="form-message form-message-success" hidden>
          お申し込みを受け付けました。担当者メールアドレス宛にご連絡いたします。
        </div>
        <div id="sf-error" class="form-message form-message-error" hidden>
          送信に失敗しました。時間をおいて再度お試しいただくか、info@kizuna-works.jpまでご連絡ください。
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      const form = document.getElementById('supporter-form');
      if (!form) return;

      const submitBtn = document.getElementById('sf-submit');
      const successMsg = document.getElementById('sf-success');
      const errorMsg = document.getElementById('sf-error');
      const ENDPOINT = 'https://script.google.com/macros/s/AKfycbzqMJ9CTBR0qC5F9yF5a4W3uPGhq105cft0ONflVGJcdsNsS-eg82U_Th5_qRZnIm6B_A/exec';

      const setError = (name, msg) => {
        const el = form.querySelector('[data-error-for="' + name + '"]');
        if (el) el.textContent = msg || '';
      };

      const clearErrors = () => {
        form.querySelectorAll('.field-error').forEach((el) => {
          el.textContent = '';
        });
      };

      const validate = (data) => {
        let ok = true;
        if (!data.companyName.trim()) {
          setError('companyName', '会社・団体名を入力してください');
          ok = false;
        }
        if (!data.domain.trim()) {
          setError('domain', 'ドメインを入力してください');
          ok = false;
        }
        if (!data.email.trim()) {
          setError('email', '担当者メールアドレスを入力してください');
          ok = false;
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email.trim())) {
          setError('email', '正しいメールアドレスの形式で入力してください');
          ok = false;
        }
        if (!data.pluginName) {
          setError('pluginName', 'プラグイン名を選択してください');
          ok = false;
        }
        if (!data.paymentMethod) {
          setError('paymentMethod', '支払い方法を選択してください');
          ok = false;
        }
        return ok;
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearErrors();
        errorMsg.hidden = true;

        const data = {
          companyName: form.companyName.value,
          domain: form.domain.value,
          email: form.email.value,
          pluginName: form.pluginName.value,
          paymentMethod: form.paymentMethod.value,
        };

        if (!validate(data)) return;

        const originalLabel = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = '送信中...';

        try {
          await fetch(ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          form.hidden = true;
          successMsg.hidden = false;
        } catch (err) {
          console.error('Supporter form submit error:', err);
          errorMsg.hidden = false;
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      });
    })();
  </script>
</Layout>
