  <script is:inline type="application/json" id="pf-meta" set:html={JSON.stringify(categoryClientMeta)} />

  <script is:inline>
    (function () {
      var bar = document.getElementById('plugin-filter');
      var metaEl = document.getElementById('pf-meta');
      if (!bar || !metaEl) return;

      var META = JSON.parse(metaEl.textContent || '{}');
      var chips = Array.prototype.slice.call(bar.querySelectorAll('.pf-chip'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('[data-plugin]'));
      var sections = Array.prototype.slice.call(document.querySelectorAll('[data-plugin-section]'));
      var countEl = document.getElementById('pf-count');
      var descEl = document.getElementById('pf-desc');
      var clearBtn = document.getElementById('pf-clear');
      var emptyEl = document.getElementById('pf-empty');
      var total = cards.length;
      var defaultDesc = descEl ? descEl.textContent : '';
      var selected = [];
      var barVisible = true;
      var floatEl = null;
      var floatLabel = null;

      function has(slug) {
        return selected.indexOf(slug) !== -1;
      }

      function label(slug) {
        return META[slug] ? META[slug].name : slug;
      }

      function buildFloat() {
        floatEl = document.createElement('div');
        floatEl.className = 'pf-float';
        floatEl.hidden = true;

        floatLabel = document.createElement('span');
        floatLabel.className = 'pf-float-label';
        floatLabel.setAttribute('role', 'button');
        floatLabel.setAttribute('tabindex', '0');
        floatLabel.addEventListener('click', scrollToBar);
        floatLabel.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            scrollToBar();
          }
        });

        var reset = document.createElement('button');
        reset.type = 'button';
        reset.className = 'pf-float-clear';
        reset.setAttribute('aria-label', '絞り込みを解除');
        reset.textContent = '×';
        reset.addEventListener('click', function () {
          selected = [];
          apply();
        });

        floatEl.appendChild(floatLabel);
        floatEl.appendChild(reset);
        document.body.appendChild(floatEl);
      }

      function scrollToBar() {
        bar.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function syncUrl() {
        var url = new URL(window.location.href);
        if (selected.length) url.searchParams.set('cat', selected.join(','));
        else url.searchParams.delete('cat');
        window.history.replaceState({}, '', url.pathname + url.search + url.hash);
      }

      function apply() {
        var visible = 0;

        cards.forEach(function (card) {
          var slugs = (card.getAttribute('data-cat-slugs') || '').split('|');
          var show = selected.length === 0 || slugs.some(has);
          if (show) {
            card.removeAttribute('hidden');
            visible++;
          } else {
            card.setAttribute('hidden', '');
          }
        });

        sections.forEach(function (section) {
          section.hidden = !section.querySelector('[data-plugin]:not([hidden])');
        });

        chips.forEach(function (chip) {
          chip.setAttribute(
            'aria-pressed',
            has(chip.getAttribute('data-cat-slug')) ? 'true' : 'false'
          );
        });

        if (countEl) {
          countEl.textContent = selected.length
            ? total + ' 製品中 ' + visible + ' 製品を表示中'
            : '全 ' + total + ' 製品を表示中';
        }

        if (descEl) {
          if (!selected.length) {
            descEl.textContent = defaultDesc;
          } else if (selected.length === 1) {
            var meta = META[selected[0]];
            descEl.textContent = meta ? meta.name + ' — ' + meta.desc : '';
          } else {
            // Names already contain "・", so join with "／" to stay readable.
            descEl.textContent =
              selected.map(label).join('／') + ' の ' + selected.length + ' カテゴリを表示中';
          }
        }

        if (clearBtn) clearBtn.hidden = !selected.length;
        if (emptyEl) emptyEl.hidden = visible !== 0;

        syncUrl();
        updateFloat(visible);
      }

      function updateFloat(visible) {
        if (!floatEl) buildFloat();
        var show = selected.length > 0 && !barVisible;
        floatEl.hidden = !show;
        if (show) {
          floatLabel.textContent =
            (selected.length === 1 ? label(selected[0]) : selected.length + ' カテゴリ') +
            ' ' + visible + ' 件';
        }
      }

      function toggle(slug) {
        var i = selected.indexOf(slug);
        if (i === -1) selected.push(slug);
        else selected.splice(i, 1);
        apply();
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          toggle(chip.getAttribute('data-cat-slug'));
        });
      });

      // A chip on a card narrows to just that category — "more like this" — rather
      // than adding to the current selection, then brings the bar back into view
      // so the change is visible.
      document.querySelectorAll('.plugin-cat').forEach(function (tag) {
        tag.addEventListener('click', function () {
          selected = [tag.getAttribute('data-cat-slug')];
          apply();
          scrollToBar();
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          selected = [];
          apply();
        });
      }

      if (emptyEl) {
        var emptyClear = emptyEl.querySelector('.pf-empty-clear');
        if (emptyClear) {
          emptyClear.addEventListener('click', function () {
            selected = [];
            apply();
          });
        }
      }

      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          barVisible = entries[0].isIntersecting;
          updateFloat(cards.filter(function (c) { return !c.hasAttribute('hidden'); }).length);
        }).observe(bar);
      }

      // Inbound links to #about / #free-scope still work: the target is a closed
      // <details>, so open it before scrolling or the anchor lands on nothing.
      function openFromHash() {
        var id = window.location.hash.slice(1);
        if (!id) return;
        var target = document.getElementById(id);
        if (target && target.tagName === 'DETAILS') {
          target.open = true;
          target.scrollIntoView({ block: 'center' });
        }
      }
      window.addEventListener('hashchange', openFromHash);
      openFromHash();

      var fromUrl = new URLSearchParams(window.location.search).get('cat');
      if (fromUrl) {
        fromUrl.split(',').forEach(function (slug) {
          slug = slug.trim();
          if (META[slug] && !has(slug)) selected.push(slug);
        });
      }

      apply();
    })();
  </script>
</Layout>
