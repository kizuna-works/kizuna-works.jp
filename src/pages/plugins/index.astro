---
import Layout from '../../layouts/Layout.astro';
import SupporterCTA from '../../components/SupporterCTA.astro';
import TrialBanner from '../../components/TrialBanner.astro';
import { plugins, premiumPlugins, pluginsItemListJsonLd } from '../../data/plugins';

const itemListJson = JSON.stringify(pluginsItemListJsonLd);
---

<Layout
  title="kintone プラグイン 無料配布「ちょこっとプラグイン」一覧 | KIZUNA Works"
  description="KIZUNA Worksのkintoneプラグイン一覧（無料・おすすめ）。フィールド装飾・自動採番・横断検索・添付アイコン表示などをノーコードで導入できます。基本機能は完全無料の「ちょこっとプラグイン」シリーズ。kintone プラグイン 無料配布中。"
  ogTitle="kintone プラグイン 無料配布「ちょこっとプラグイン」一覧 | KIZUNA Works"
  ogDescription="KIZUNA Worksのkintoneプラグイン一覧（無料・おすすめ）。フィールド装飾・自動採番・横断検索・添付アイコン表示などをノーコードで導入できます。基本機能は完全無料の「ちょこっとプラグイン」シリーズ。kintone プラグイン 無料配布中。"
  ogUrl="https://kizuna-works.jp/plugins/"
  ogType="website"
  canonical="https://kizuna-works.jp/plugins/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={`{
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/",
          "url": "https://kizuna-works.jp/plugins/",
          "name": "kintone プラグイン 無料配布「ちょこっとプラグイン」一覧 | KIZUNA Works",
          "description": "KIZUNA Worksのkintoneプラグイン一覧（無料・おすすめ）。ノーコードで導入できる「ちょこっとプラグイン」シリーズ。kintone プラグイン 無料配布中。"
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ホーム",
              "item": "https://kizuna-works.jp/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "kintoneプラグイン",
              "item": "https://kizuna-works.jp/plugins/"
            }
          ]
        },
        {
          "@type": "ItemList",
          "itemListElement": ${itemListJson}
        }
      ]
    }`} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    /* Hero */
    .hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.45) 0%, rgba(42,82,152,0.4) 100%),
                  url('/images/plugins-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 100px 5%;
      text-align: center;
      color: var(--color-white);
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 0.05em;
    }

    .hero p {
      font-size: 1.1rem;
      max-width: 700px;
      margin: 0 auto;
      font-weight: 500;
    }

    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    /* Intro */
    .intro-section {
      padding: 60px 5% 40px;
      display: flex;
      justify-content: center;
    }

    .intro-card {
      background: var(--color-white);
      max-width: 800px;
      width: 100%;
      padding: 40px;
      border-radius: 12px;
      box-shadow: var(--shadow-card);
      text-align: center;
    }

    .intro-card h2 {
      color: var(--color-navy);
      font-size: 1.5rem;
      margin-bottom: 24px;
      position: relative;
      display: inline-block;
    }

    .intro-card h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 3px;
      background-color: var(--color-green);
      border-radius: 2px;
    }

    .intro-card p {
      font-size: 1.05rem;
      color: var(--color-text-main);
      line-height: 1.8;
      text-align: left;
      margin: 0 0 18px;
    }

    .intro-card p:last-of-type {
      margin-bottom: 0;
    }

    .intro-question {
      text-align: center !important;
      font-weight: 700;
      color: var(--color-navy);
      font-size: 1.1rem !important;
      padding: 12px 0;
    }

    .intro-cta {
      text-align: center;
      margin-top: 28px;
    }

    .intro-cta-button {
      display: inline-block;
      padding: 14px 28px;
      background-color: var(--color-navy);
      color: var(--color-white);
      border-radius: 8px;
      font-weight: 700;
      font-size: 1rem;
      text-decoration: none;
      transition: background-color var(--transition-speed), transform var(--transition-speed), box-shadow var(--transition-speed);
    }

    .intro-cta-button:hover {
      background-color: var(--color-green);
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    /* Plugins Grid */
    .section-container {
      padding: 40px 5% 80px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      color: var(--color-navy);
      margin-bottom: 40px;
      padding-left: 16px;
      border-left: 5px solid var(--color-green);
      display: flex;
      align-items: center;
    }

    .plugins-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 40px;
    }

    .plugin-card {
      background-color: var(--color-white);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: var(--shadow-card);
      transition: transform var(--transition-speed), box-shadow var(--transition-speed);
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }

    .plugin-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-hover);
    }

    .plugin-card-image {
      width: 100%;
      /* Match the designed banner ratio (1200x630) so left/right edges are not cropped */
      aspect-ratio: 1200 / 630;
      object-fit: cover;
      display: block;
      border-bottom: 1px solid #e2e8f0;
    }

    .plugin-card-content {
      padding: 30px 24px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .plugin-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--color-navy);
      margin-bottom: 4px;
    }

    .plugin-subtitle {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin-bottom: 20px;
    }

    /* Category chip — color-coded by functional area */
    .plugin-cat {
      align-self: flex-start;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      padding: 3px 11px;
      border-radius: 999px;
      margin-bottom: 12px;
      line-height: 1.5;
      white-space: nowrap;
    }
    .plugin-cat[data-cat="一覧"] { background: #e8f0fb; color: #1b3a6b; }
    .plugin-cat[data-cat="レコード画面"] { background: #e7f5e7; color: #256b25; }
    .plugin-cat[data-cat="入力支援"] { background: #fff1e0; color: #b5651d; }
    .plugin-cat[data-cat="装飾"] { background: #f3eafc; color: #7a3ea8; }
    .plugin-cat[data-cat="出力・連携"] { background: #e3f6f4; color: #0f8e84; }

    .plugin-desc {
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 24px;
      flex-grow: 1;
      /* Clamp to 5 lines so every card has the same description height */
      display: -webkit-box;
      -webkit-line-clamp: 5;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 7.7em; /* 5 lines x line-height 1.6 = 8em, trimmed for box model */
    }

    .plugin-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .plugin-pricing-row {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .pricing-divider {
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .badge-free {
      background-color: var(--color-green);
      color: var(--color-white);
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .badge-coming-soon {
      background-color: #fff3cd;
      color: #856404;
      border: 1px solid #ffe082;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .badge-coming-soon::before {
      content: '🔧';
      font-size: 0.95rem;
    }

    .badge-recommended {
      background-color: #e74c3c;
      color: #FFFFFF;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .badge-save {
      background-color: #fff3cd;
      color: #856404;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 700;
      margin-left: 8px;
      white-space: nowrap;
    }

    .badge-price {
      color: var(--color-navy);
      font-weight: 700;
      font-size: 1rem;
    }

    /* Premium plugins section */
    .premium-section {
      padding-bottom: 24px;
    }

    .section-title.premium-title {
      border-left-color: #c9a227;
    }

    .premium-intro {
      margin: -24px 0 36px;
      padding-left: 21px;
      color: var(--color-text-main);
      font-size: 1.02rem;
      line-height: 1.8;
    }

    .premium-intro strong {
      color: var(--color-navy);
    }

    .plugin-card.premium {
      position: relative;
      border: 1px solid #e7d9a8;
    }

    .premium-badge-overlay {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 2;
      background: linear-gradient(135deg, #1B3A6B 0%, #2E8B2E 100%);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 5px 12px;
      border-radius: 20px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .badge-premium {
      background: linear-gradient(135deg, #1B3A6B 0%, #2E8B2E 100%);
      color: #fff;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .badge-free-tier {
      background-color: #e8f0e8;
      color: var(--color-green);
      border: 1px solid #cfe3cf;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    /* Premium card uses a designed banner (1200×630) — show it fully without cropping */
    .plugin-card.premium .plugin-card-image {
      aspect-ratio: 1200 / 630;
    }

    .premium-plan-note {
      color: var(--color-navy);
      font-weight: 700;
      font-size: 0.95rem;
    }

    .premium-divider {
      height: 1px;
      background: #e2e8f0;
      max-width: 1200px;
      margin: 0 auto;
    }

    .plugin-button {
      display: block;
      text-align: center;
      padding: 12px 20px;
      border: 1px solid var(--color-navy);
      color: var(--color-navy);
      border-radius: 6px;
      font-weight: 700;
      transition: all var(--transition-speed);
    }

    .plugin-card:hover .plugin-button {
      background-color: var(--color-navy);
      color: var(--color-white);
    }

    @media (max-width: 768px) {
      .hero {
        padding: 60px 5%;
      }
      .hero h1 {
        font-size: 1.8rem;
      }
      .intro-section {
        padding: 40px 5% 30px;
      }
      .intro-card {
        padding: 30px 20px;
      }
      .plugins-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main>
    <section class="hero">
      <h1>kintone プラグイン</h1>
      <p>kintoneをもっと使いやすく。現場の「困った」を解決するプラグインを提供しています</p>
    </section>
    <div class="hero-gradient-line"></div>

    <section class="intro-section">
      <div class="intro-card">
        <h2>KIZUNA Works プラグインの特長</h2>
        <p>「ちょこっとプラグイン」は、現場の「あとちょっとこうなれば」という声から生まれた kintone 拡張プラグインシリーズです。プログラミング知識は不要。基本機能は完全無料です。</p>
        <p>さらに、より高度な業務に応える「<strong>プレミアムプラグイン</strong>」シリーズもご用意しています。プレミアムプラグインも基本機能は無料でお試しいただけ、<strong>プレミアム年間サポーター</strong>に加入すると全機能が解放されます。今後もラインナップを拡充していきます。</p>
        <p>どれから試すか迷ったら、目的別におすすめを整理した<a href="/blog/kintone-muryou-plugin-osusume/">kintone無料プラグインのおすすめ記事</a>もあわせてご覧ください。</p>
        <p class="intro-question">あなたの現場にも、「あとちょっと」はありませんか？</p>
        <p>年間サポーターになっていただけると、プラグイン作成リクエストや既存プラグインへの改善要望をお送りいただけます。サポーターの声をひとつひとつ形にしながら、現場との絆を広げていきたいと思っています。</p>
        <div class="intro-cta">
          <a href="/plugins/supporter/" class="intro-cta-button">
            年間サポーターについて詳しく見る <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <div style="margin: 0 0 20px;">
      <TrialBanner />
    </div>

    {premiumPlugins.length > 0 && (
      <section class="section-container premium-section">
        <h2 class="section-title premium-title">プレミアムプラグイン</h2>
        <p class="premium-intro">
          より高度な業務に応える kintone プラグインです。<strong>プレミアム年間サポーター</strong>（年額 ¥16,500 税込）にご加入いただくと、ここにあるプレミアムプラグインと販売中の全プラグインをご利用いただけます。今後もラインナップを拡充していきます。
        </p>
        <div class="plugins-grid">
          {premiumPlugins.map((plugin) => (
            <a href={`/plugins/${plugin.slug}/`} class="plugin-card premium">
              <picture>
                {plugin.imageWebp && <source srcset={plugin.imageWebp} type="image/webp" />}
                <img
                  src={plugin.image}
                  alt={plugin.imageAlt}
                  class="plugin-card-image"
                  width={plugin.imageWidth}
                  height={plugin.imageHeight}
                  loading="lazy"
                />
              </picture>
              <div class="plugin-card-content">
                <span class="plugin-cat" data-cat={plugin.category}>{plugin.category}</span>
                <h3 class="plugin-title">{plugin.name}</h3>
                <span class="plugin-subtitle">{plugin.subtitle}</span>
                <p class="plugin-desc">{plugin.description}</p>
                <div class="plugin-meta">
                  {plugin.status === 'available' ? (
                    <span class="badge-premium">👑 プレミアム</span>
                  ) : (
                    <span class="badge-coming-soon">準備中</span>
                  )}
                  <span class="badge-free-tier">無料プランあり</span>
                </div>
                <div class="plugin-pricing-row">
                  <span class="premium-plan-note">プレミアム年間サポーターに含む</span>
                </div>
                <span class="plugin-button">詳しく見る &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section-container">
      <h2 class="section-title">ちょこっとプラグイン一覧</h2>
      <div class="plugins-grid">
        {plugins.map((plugin) => (
          <a href={`/plugins/${plugin.slug}/`} class="plugin-card">
            <picture>
              {plugin.imageWebp && <source srcset={plugin.imageWebp} type="image/webp" />}
              <img
                src={plugin.image}
                alt={plugin.imageAlt}
                class="plugin-card-image"
                width={plugin.imageWidth}
                height={plugin.imageHeight}
                loading="lazy"
              />
            </picture>
            <div class="plugin-card-content">
              <span class="plugin-cat" data-cat={plugin.category}>{plugin.category}</span>
              <h3 class="plugin-title">{plugin.name}</h3>
              <span class="plugin-subtitle">{plugin.subtitle}</span>
              <p class="plugin-desc">{plugin.description}</p>
              <div class="plugin-meta">
                {plugin.status === 'available' ? (
                  <span class="badge-free">無料配布中</span>
                ) : (
                  <span class="badge-coming-soon">準備中</span>
                )}
              </div>
              {plugin.status === 'available' && plugin.price !== undefined && (
                <div class="plugin-pricing-row">
                  <span class="badge-price">¥{plugin.price.toLocaleString()}</span>
                </div>
              )}
              <span class="plugin-button">詳しく見る &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <SupporterCTA />
  </main>
</Layout>
