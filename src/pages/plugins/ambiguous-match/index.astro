---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="あいまい照合 for kintone - 表記ゆれを吸収して重複登録を防ぐ | KIZUNA Works"
  description="会社名・顧客名の入力中に、表記ゆれ（株式会社⇔（株）⇔㈱・全角半角・旧字体など）を吸収して似た既存レコードをその場で表示する kintone プラグイン。標準の「値の重複を禁止する」（完全一致）では気づけない二重登録を保存前に確認できます。参照項目の併記・候補クリックで別タブ表示・kintone完結。"
  ogTitle="あいまい照合 for kintone - 表記ゆれを吸収して重複登録を防ぐ | KIZUNA Works"
  ogDescription="会社名の入力中に表記ゆれ（株式会社⇔（株）⇔㈱等）を吸収して似た既存レコードを表示。標準の重複禁止（完全一致）では防げない二重登録に保存前に気づける kintone プラグイン。kintone完結。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/ambiguous-match/"
  ogImage="https://kizuna-works.jp/images/ambiguous-match-banner.png"
  canonical="https://kizuna-works.jp/plugins/ambiguous-match/"
>
