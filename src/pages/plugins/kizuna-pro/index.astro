---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { proPlugins } from '../../../data/plugins';
import { PREMIUM_PLAN, PRO_SET_PLAN, PRO_ADDON, yen } from '../../../data/pricing';

const PAGE_URL = 'https://kizuna-works.jp/plugins/kizuna-pro/';
const DATE_MODIFIED = '2026-10-27';
const TITLE = 'KIZUNA Pro プラグイン一覧｜kintone の上位版プラグイン | KIZUNA Works';
const DESCRIPTION = `KIZUNA Pro プラグインは、KIZUNA Works の kintone プラグインの上位版シリーズです。ちょこっとプラグイン・プレミアムプラグインでは届かない、より大きな業務の仕組みづくりを支える製品と、お使いいただけるご契約・30日間の無料体験をご紹介します。`;

// "Pro だけ" highlights per product. Keyed by slug so a product without an entry still renders.
const HIGHLIGHTS: Record<string, string[]> = {
  bridge: [
    '保存やボタンをきっかけに、他のアプリのレコードを作る・変える・ステータスを進める',
    '当社のプラグインと連携し、書き込み先でも採番・通知・一括更新',
    '不在カレンダーで、担当者の不在や会社の休みを踏まえて営業日を計算',
    '当社プラグインの新しいバージョンを確かめ、まとめて最新版に上書き',
  ],
  'search-pro': [
    '効いている条件が帯に並び、×で外せる',
    'よく使う条件を保存して呼び出す',
    '集計カードを押して絞り込む・絞った結果を一括処理へ',
  ],
  'lookup-pro': [
    '欄ごとの一覧で、5つの機能の設定を1画面で確認',
    'まとめて設定で、候補表示とその場登録を一括作成',
    '絞り込みの条件をその場登録に引き継ぐ・取得元の更新を知らせる',
  ],
  'file-pro': [
    '詳細画面で、テーブルの中も含む全部の添付を並べて見る',
    '一覧で添付の容量を確認し、大きいレコードの画像を圧縮',
    '添付を検索して PDF にまとめる・保存時にファイル名をそろえる',
  ],
};

const faqs: { q: string; a: string }[] = [
  {
    q: 'KIZUNA Pro プラグインとは何ですか？',
    a: 'KIZUNA Works の kintone プラグインの上位版のシリーズです。ちょこっとプラグイン・プレミアムプラグインでは届かない、より大きな業務の仕組みづくりを支える製品をそろえています。製品は今後も増やしていきます。',
  },
  {
    q: 'KIZUNA Pro プラグインを1つだけ購入できますか？',
    a: `製品ごとの個別のご契約はありません。${PREMIUM_PLAN.name}に${PRO_ADDON.name}（税込 ${yen(PRO_ADDON.priceInTax)}/年）を追加すると、KIZUNA Pro プラグインをすべてお使いいただけます。両方をまとめた「${PRO_SET_PLAN.name}」（税込 ${yen(PRO_SET_PLAN.priceInTax)}/年）もあります。`,
  },
  {
    q: '同じ機能を持つプラグインと同じアプリに入れても大丈夫ですか？',
    a: '大丈夫です。サーチ Pro・ルックアップ Pro・添付ファイル Pro は、同じ機能を持つプラグインが同じアプリに入っているとき、その機能はそちらのプラグインが動き、Pro はその機能だけ動かしません（二重にボタンが出るのを防ぐためです）。そのプラグインの設定を読み込んで引き継ぐこともできます。',
  },
  {
    q: '無料で試せますか？',
    a: '30日間の無料体験で、ちょこっと＆プレミアム＆KIZUNA Pro プラグインすべてを全機能・広告なしでお試しいただけます。カード登録は不要で、自動で課金されることはありません。体験が終わっても設定は消えません。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': PAGE_URL,
      url: PAGE_URL,
      name: TITLE,
      description: DESCRIPTION,
      dateModified: DATE_MODIFIED,
      isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: 'https://kizuna-works.jp/' },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
          { '@type': 'ListItem', position: 2, name: 'プラグイン', item: 'https://kizuna-works.jp/plugins/' },
          { '@type': 'ListItem', position: 3, name: 'KIZUNA Pro プラグイン', item: PAGE_URL },
        ],
      },
    },
    {
      '@type': 'ItemList',
      name: 'KIZUNA Pro プラグイン一覧',
      numberOfItems: proPlugins.length,
      itemListElement: proPlugins.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: p.name,
          url: `https://kizuna-works.jp/plugins/${p.slug}/`,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'kintone',
          description: p.cardDescription,
          offers: {
            '@type': 'Offer',
            name: PRO_SET_PLAN.name,
            price: String(PRO_SET_PLAN.priceInTax),
            priceCurrency: 'JPY',
          },
        },
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  heroBg="/images/kizuna-pro-hero-bg.webp"
  title={TITLE}
  description={DESCRIPTION}
  ogTitle={TITLE}
  ogDescription={DESCRIPTION}
  ogType="website"
  ogUrl={PAGE_URL}
  ogImage="https://kizuna-works.jp/images/ogp.png"
  canonical={PAGE_URL}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <style is:global>
    .kpro-page {
      --kpro-navy: #1B3A6B;
      --kpro-ink: #0f1f3d;
      --kpro-gold: #b8862b;
      --kpro-gold-light: #e8c766;
      --kpro-gold-soft: #f0d58a;
      --kpro-text: #333333;
      --kpro-muted: #64748b;
      color: var(--kpro-text);
    }
    /* Same background as the KIZUNA Pro product heroes; its baked bottom fade blends into the base gradient */
    .kpro-hero {
      background:
        url('/images/kizuna-pro-hero-bg.webp') center top / 100% auto no-repeat,
        linear-gradient(90deg, #020816 0%, #050b1c 30%, #081427 50%, #09182f 70%, #0c1729 100%);
      border-bottom: 4px solid var(--kpro-gold);
      color: #fff;
      padding: 60px 20px 54px;
      text-align: center;
    }
    .kpro-hero .kpro-lead { margin: 0 auto; }
    .kpro-wrap { max-width: 1100px; margin: 0 auto; min-width: 0; }
    .kpro-crumb { font-size: 0.82rem; margin: 0 0 18px; color: rgba(255, 255, 255, 0.75); }
    .kpro-crumb a { color: rgba(255, 255, 255, 0.85); }
    .kpro-badge {
      display: inline-block; padding: 4px 14px; border-radius: 6px;
      background: linear-gradient(135deg, var(--kpro-gold-light) 0%, var(--kpro-gold) 100%);
      color: #1a1405; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; margin-bottom: 14px;
    }
    .kpro-hero h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); font-weight: 900; line-height: 1.4; margin: 0 0 14px; }
    .kpro-tagline { font-size: clamp(1.02rem, 2.3vw, 1.25rem); font-weight: 700; color: var(--kpro-gold-soft); margin: 0 0 14px; }
    .kpro-lead { font-size: 1rem; line-height: 1.9; margin: 0; max-width: 820px; color: rgba(255, 255, 255, 0.92); }

    .kpro-section { padding: 56px 20px; background: #fff; }
    .kpro-section.alt { background: #F0F4F8; }
    .kpro-eyebrow { display: inline-block; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.12em; color: var(--kpro-gold); margin-bottom: 6px; }
    .kpro-h2 { font-size: clamp(1.3rem, 3vw, 1.7rem); color: var(--kpro-navy); margin: 0 0 14px; line-height: 1.5; }
    .kpro-desc { margin: 0 0 28px; line-height: 1.9; }

    .kpro-points { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; list-style: none; margin: 0; padding: 0; }
    .kpro-points li { background: #fff; border: 1px solid #dbe3ee; border-top: 3px solid var(--kpro-gold); border-radius: 12px; padding: 20px 22px; min-width: 0; }
    .kpro-points h3 { font-size: 1.02rem; color: var(--kpro-navy); margin: 0 0 8px; line-height: 1.5; }
    .kpro-points p { margin: 0; font-size: 0.92rem; line-height: 1.8; }

    .kpro-list { display: grid; gap: 24px; }
    /* Equal row heights keep the banner margins identical across cards. */
    @media (min-width: 861px) { .kpro-list { grid-auto-rows: 1fr; } }
    .kpro-card {
      display: grid; grid-template-columns: minmax(0, 44%) minmax(0, 1fr);
      border-radius: 14px; overflow: hidden; border: 1px solid var(--kpro-gold);
      background: linear-gradient(120deg, #0f1f3d 0%, #1B3A6B 70%, #2a2410 100%);
      color: #fff; text-decoration: none; box-shadow: 0 8px 28px rgba(15, 31, 61, 0.2);
    }
    .kpro-card:hover .kpro-card-btn { background: #fff; color: var(--kpro-navy); }
    /* The banner keeps its full 1200x630 frame; the spare height is filled by a blurred copy of itself. */
    .kpro-media { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: center; min-width: 0; background: #0d1e45; }
    .kpro-media::before { content: ''; position: absolute; inset: -40px; z-index: -1; background: var(--bg) center / cover no-repeat; filter: blur(22px) brightness(0.5) saturate(1.15); }
    .kpro-media picture { display: block; width: 100%; overflow: hidden; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35); }
    /* Slight scale trims hairline edges baked into some banners. */
    .kpro-card-image { width: 100%; height: auto; aspect-ratio: 1200 / 630; display: block; transform: scale(1.012); }
    .kpro-card-body { min-width: 0; padding: 24px 28px; display: flex; flex-direction: column; gap: 10px; }
    .kpro-card-title { font-size: 1.25rem; font-weight: 800; margin: 0; line-height: 1.5; }
    .kpro-card-desc { margin: 0; font-size: 0.93rem; line-height: 1.8; color: rgba(255, 255, 255, 0.9); }
    .kpro-card-hl { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 6px; }
    .kpro-card-hl li { font-size: 0.88rem; line-height: 1.6; padding-left: 1.2em; position: relative; }
    .kpro-card-hl li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 7px; height: 7px; border-radius: 50%; background: var(--kpro-gold-light); }
    .kpro-card-btn {
      align-self: flex-start; margin-top: auto; padding: 9px 20px; border-radius: 8px;
      border: 1px solid var(--kpro-gold-soft); color: var(--kpro-gold-soft); font-weight: 700; font-size: 0.92rem;
      transition: background 0.2s, color 0.2s;
    }

    .kpro-plan-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .kpro-plan { background: #fff; border: 1px solid #dbe3ee; border-radius: 14px; padding: 24px 26px; min-width: 0; display: flex; flex-direction: column; }
    .kpro-plan.top { border: 2px solid var(--kpro-gold); }
    .kpro-plan-badge { align-self: flex-start; font-size: 0.75rem; font-weight: 800; padding: 3px 10px; border-radius: 999px; background: var(--kpro-navy); color: var(--kpro-gold-soft); }
    .kpro-plan h3 { font-size: 1.15rem; color: var(--kpro-navy); margin: 10px 0 4px; }
    .kpro-plan-price { margin: 0; color: var(--kpro-navy); }
    .kpro-plan-price .amt { font-size: 1.8rem; font-weight: 900; }
    .kpro-plan-price .unit { font-size: 0.85rem; margin-left: 4px; }
    .kpro-plan-sub { font-size: 0.82rem; color: var(--kpro-muted); margin: 2px 0 12px; }
    .kpro-plan ul { margin: 0 0 18px; padding-left: 1.2em; font-size: 0.92rem; line-height: 1.8; }
    .kpro-plan-cta { margin-top: auto; display: block; text-align: center; padding: 12px 16px; border-radius: 8px; background: var(--kpro-navy); color: #fff; font-weight: 700; text-decoration: none; }
    .kpro-plan.top .kpro-plan-cta { background: linear-gradient(135deg, var(--kpro-gold-light) 0%, var(--kpro-gold) 100%); color: #1a1405; }

    .kpro-trial {
      margin-top: 24px; padding: 22px 26px; border-radius: 14px;
      background: linear-gradient(120deg, #12294d 0%, #1B3A6B 45%, #2E8B2E 100%); color: #fff;
      display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
    }
    .kpro-trial-text { flex: 1 1 420px; min-width: 0; }
    .kpro-trial h3 { margin: 0 0 6px; font-size: 1.15rem; }
    .kpro-trial p { margin: 0; font-size: 0.92rem; line-height: 1.8; }
    .kpro-trial a { flex-shrink: 0; background: #fff; color: #1f6f2a; font-weight: 700; padding: 12px 24px; border-radius: 8px; text-decoration: none; }

    .kpro-faq { display: grid; gap: 12px; }
    .kpro-faq details { background: #fff; border: 1px solid #dbe3ee; border-radius: 10px; padding: 14px 18px; }
    .kpro-faq summary { cursor: pointer; font-weight: 700; color: var(--kpro-navy); line-height: 1.6; }
    .kpro-faq p { margin: 10px 0 0; line-height: 1.85; font-size: 0.95rem; }

    .kpro-back { margin: 28px 0 0; }
    .kpro-back a { color: var(--kpro-navy); font-weight: 700; }

    @media (max-width: 860px) {
      .kpro-points { grid-template-columns: minmax(0, 1fr); }
      .kpro-card { grid-template-columns: minmax(0, 1fr); }
      .kpro-plan-grid { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 640px) {
      .kpro-hero { padding: 40px 16px 36px; }
      .kpro-section { padding: 44px 16px; }
      .kpro-card-body { padding: 20px; }
      .kpro-trial a { width: 100%; text-align: center; box-sizing: border-box; }
    }
  </style>

  <div class="kpro-page">
    <section class="kpro-hero">
      <div class="kpro-wrap">
        <p class="kpro-crumb"><a href="/">ホーム</a> ／ <a href="/plugins/">プラグイン</a> ／ KIZUNA Pro プラグイン</p>
        <span class="kpro-badge">KIZUNA Pro</span>
        <h1>KIZUNA Pro プラグイン一覧</h1>
        <p class="kpro-tagline">これまでのプラグインでは届かないところへ。kintone プラグインの上位版シリーズ。</p>
        <p class="kpro-lead">KIZUNA Pro プラグインは、KIZUNA Works の kintone プラグインの<strong>上位版</strong>のシリーズです。ちょこっとプラグイン・プレミアムプラグインでは届かない、より大きな業務の仕組みづくりを支える製品をそろえ、これからも新しい製品を増やしていきます。</p>
      </div>
    </section>

    <section class="kpro-section alt">
      <div class="kpro-wrap">
        <span class="kpro-eyebrow">WHAT'S PRO</span>
        <h2 class="kpro-h2">KIZUNA Pro プラグインでできること</h2>
        <p class="kpro-desc">できることは製品ごとに違います。いまの製品では、たとえば次のようなことができます。</p>
        <ul class="kpro-points">
          <li><h3>つなぐ</h3><p>KIZUNAブリッジが、アプリをまたぐ作業もプラグインの連携も自動化します。保存をきっかけに、他のアプリへの書き込みや当社プラグインの処理まで続けて行えます。</p></li>
          <li><h3>まとめる</h3><p>いくつものプラグインの機能を、1つのプラグイン・1つの設定画面にまとめました。どの欄に何を設定したかを見渡せます。</p></li>
          <li><h3>Pro だけの機能</h3><p>まとめたことで、もとのプラグインには無い機能が使えます。条件の引き継ぎや一括の設定など、製品ごとの「Pro だけ」の機能は下の一覧と各製品のページでご覧いただけます。</p></li>
        </ul>
      </div>
    </section>

    <section class="kpro-section" id="list">
      <div class="kpro-wrap">
        <span class="kpro-eyebrow">LINEUP</span>
        <h2 class="kpro-h2">KIZUNA Pro プラグインのラインナップ</h2>
        <p class="kpro-desc">今後リリースする KIZUNA Pro プラグインも、追加料金なしで順次お使いいただけます。</p>
        <div class="kpro-list">
          {proPlugins.map((p) => (
            <a class="kpro-card" href={`/plugins/${p.slug}/`}>
              <div class="kpro-media" style={`--bg:url(${p.image.replace(/.png$/i, '-800.webp')})`}>
                <Picture src={p.image} alt={p.imageAlt} class="kpro-card-image" width={p.imageWidth} height={p.imageHeight} card />
              </div>
              <div class="kpro-card-body">
                <h3 class="kpro-card-title">{p.name}</h3>
                <p class="kpro-card-desc">{p.cardDescription}</p>
                {HIGHLIGHTS[p.slug] && (
                  <ul class="kpro-card-hl">
                    {HIGHLIGHTS[p.slug].map((h) => <li>{h}</li>)}
                  </ul>
                )}
                <span class="kpro-card-btn">詳しく見る &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="kpro-section alt" id="plan">
      <div class="kpro-wrap">
        <span class="kpro-eyebrow">PLAN</span>
        <h2 class="kpro-h2">プランと料金</h2>
        <p class="kpro-desc">KIZUNA Pro プラグインは、製品ごとの個別のご契約はありません。<strong>{PREMIUM_PLAN.name}</strong>と<strong>{PRO_ADDON.name}</strong>のご契約で、すべての KIZUNA Pro プラグインをお使いいただけます。</p>
        <div class="kpro-plan-grid">
          <div class="kpro-plan top">
            <span class="kpro-plan-badge">KIZUNA Pro 最上位</span>
            <h3>{PRO_SET_PLAN.name}</h3>
            <p class="kpro-plan-price"><span class="amt">{yen(PRO_SET_PLAN.priceInTax)}</span><span class="unit">/年（税込）</span></p>
            <p class="kpro-plan-sub">税抜 {yen(PRO_SET_PLAN.priceExTax)}／{PREMIUM_PLAN.name}＋{PRO_ADDON.name}</p>
            <ul>
              <li>KIZUNA Pro プラグインすべて</li>
              <li>ちょこっと＆プレミアムプラグインすべて</li>
              <li>プラグイン内の広告非表示</li>
              <li>今後リリースされる KIZUNA Pro プラグインも追加料金なし</li>
            </ul>
            <a class="kpro-plan-cta" href="/plugins/supporter/?plan=pro_set">{PRO_SET_PLAN.name}を申し込む →</a>
          </div>
          <div class="kpro-plan">
            <span class="kpro-plan-badge">プレミアムにご加入中の方</span>
            <h3>{PRO_ADDON.name}</h3>
            <p class="kpro-plan-price"><span class="amt">{yen(PRO_ADDON.priceInTax)}</span><span class="unit">/年（税込）</span></p>
            <p class="kpro-plan-sub">税抜 {yen(PRO_ADDON.priceExTax)}／{PREMIUM_PLAN.name}に追加</p>
            <ul>
              <li>{PREMIUM_PLAN.name}に追加していただくプランです</li>
              <li>KIZUNA Pro プラグインをすべてお使いいただけます</li>
              <li>今後リリースされる KIZUNA Pro プラグインも追加料金なし</li>
            </ul>
            <a class="kpro-plan-cta" href="/plugins/supporter/?plan=pro_add">{PRO_ADDON.name}を申し込む →</a>
          </div>
        </div>
        <div class="kpro-trial">
          <div class="kpro-trial-text">
            <h3>{PRO_SET_PLAN.name}を、30日間無料でお試し</h3>
            <p>ちょこっと＆プレミアム＆KIZUNA Pro プラグインすべてが、広告なし・全機能で使えます。アプリをまたぐ自動化やプラグインの一括更新も、お使いの kintone でそのままお試しいただけます。カード登録不要・自動課金なし。</p>
          </div>
          <a href="/plugins/premium-trial/">無料体験の詳細を見る →</a>
        </div>
      </div>
    </section>

    <section class="kpro-section" id="faq">
      <div class="kpro-wrap">
        <span class="kpro-eyebrow">FAQ</span>
        <h2 class="kpro-h2">よくあるご質問</h2>
        <div class="kpro-faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p class="kpro-back"><a href="/plugins/">プラグイン一覧（ちょこっと・プレミアム・KIZUNA Pro）へ戻る →</a></p>
      </div>
    </section>

    <div class="kpro-wrap">
      <ShareButtons title="KIZUNA Pro プラグイン一覧" />
    </div>
  </div>
</Layout>
