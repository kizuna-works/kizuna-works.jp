---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="シート編集 for kintone｜一覧をExcel風に一括編集・出力 | KIZUNA Works"
  description="kintone のレコード一覧（カスタマイズビュー）を Excel のような表計算グリッドに置き換え、表示中フィールドをその場で直接編集・一括編集・保存できるプラグイン。サブテーブル（明細）の行展開編集・コピペ・連番オートフィル・Undo・競合検知・Excel(xlsx)出力に対応。スプレッドシート感覚で1万件超も扱える、kintone完結のツール。"
  ogTitle="シート編集 for kintone｜一覧をExcel風に一括編集・出力 | KIZUNA Works"
  ogDescription="kintone のレコード一覧を Excel のような表計算グリッドに置き換え、その場で直接編集・一括編集・保存。サブテーブル明細の行展開編集・コピペ・連番オートフィル・Excel(xlsx)出力に対応。1万件超対応・kintone完結。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/sheet-edit/"
  ogImage="https://kizuna-works.jp/images/sheet-edit-banner.png"
  canonical="https://kizuna-works.jp/plugins/sheet-edit/"
>
