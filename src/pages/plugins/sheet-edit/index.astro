          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "https://kizuna-works.jp/images/sheet-edit-banner.png",
            "width": 1200,
            "height": 630
          },
          "isPartOf": {
            "@type": "WebSite",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
