---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { plugins, premiumPlugins } from '../../../data/plugins';
import { PREMIUM_PLAN, PRO_SET_PLAN, PRO_ADDON, yen } from '../../../data/pricing';
import BridgeUpdateNote from '../../../components/BridgeUpdateNote.astro';

const VERSION = '1.3.0';
const ZIP = `/downloads/kw-file-pro-v${VERSION}.zip`;
const PAGE_URL = 'https://kizuna-works.jp/plugins/file-pro/';
const DATE_MODIFIED = '2026-10-28';

// The five single products this one bundles. Cards are built from plugins.ts so names and slugs never drift.
const singleOf = (id: string) => {
  const p = [...plugins, ...premiumPlugins].find((x) => x.id === id);
  if (!p) throw new Error(`file-pro: plugin "${id}" not found in plugins.ts`);
  return p;
};
const iconOf = (slug: string) => `/images/${slug}-icon.png`;
const BUNDLED = [
  { id: 'kw-file-preview', role: 'プレビュー' },
  { id: 'kw-file-icon-marker', role: 'アイコン表示' },
  { id: 'kw-file-export', role: 'ZIP出力' },
  { id: 'kw-image-compress', role: '画像圧縮' },
  { id: 'kw-pdf-edit', role: 'PDFへの書き込み' },
];
const bundled = BUNDLED.map((b) => ({ ...b, p: singleOf(b.id) }));

// FAQ: the accordion and FAQPage JSON-LD are built from the same array so they always match.
const faqs: { q: string; a: string }[] = [
  {
    q: '添付ファイル Pro だけを購入できますか？',
    a: `製品ごとの個別のご契約はありません。プレミアム年間サポーターに KIZUNA Pro 拡張パックを追加すると、添付ファイル Pro を含む KIZUNA Pro プラグインをすべてお使いいただけます。両方をまとめた「KIZUNA Pro 年間サポーター」（税込 ${yen(PRO_SET_PLAN.priceInTax)}/年）もあります。`,
  },
  {
    q: '年間サポーター（ちょこっとプラグインすべて）に、KIZUNA Pro 拡張パックを追加できますか？',
    a: 'できません。KIZUNA Pro 拡張パックは、プレミアム年間サポーターに追加していただくプランです。年間サポーターからは、KIZUNA Pro 年間サポーターへの切り替えでお使いいただけます。',
  },
  {
    q: '添付ファイルプレビューなどのプラグインと、何が違いますか？',
    a: '5つの機能（プレビュー・アイコン表示・ZIP出力・画像圧縮・PDFへの書き込み）は、もとのプラグインと同じ内容です。添付ファイル Pro では、1つの設定画面で扱えます。そのうえで、詳細画面の［このレコードの添付］、一覧の［添付の容量］（画像の一括圧縮は、設定でオンにしたときだけ）、ZIP に入れる画像だけを縮める機能、添付欄ごとの効き具合を確かめられる「まとめ」が加わります。',
  },
  {
    q: '同じアプリに、もとのプラグインが入っていても大丈夫ですか？',
    a: '大丈夫です。もとのプラグインが有効で、設定が済んでいる機能は、もとのプラグインが動き、添付ファイル Pro はその機能だけ動かしません（二重に動くのを防ぐためです）。ほかの機能は、添付ファイル Pro が動かします。もとのプラグインに任せている間は、Pro の追加機能の一部が使えません。たとえば添付ファイルプレビューが動いているときは、［このレコードの添付］に［見る］が出ず、［添付を検索］のカードはレコードを別のタブで開きます。画像圧縮が動いているときは、添付のきまりの「縮めてから添付する」が働きません。もとのプラグインを外すか、無効にすると、添付ファイル Pro がその機能を動かします。',
  },
  {
    q: 'これまでのプラグインで作った設定を、添付ファイル Pro に引き継げますか？',
    a: '引き継げます。もとのプラグインが入っているアプリで添付ファイル Pro の設定画面を開くと、該当の機能の設定欄に［単品の設定を読み込む］が出ます。押して確認で OK を押すと、設定が写ります。読み込みは手動で、もとのプラグインの設定はそのまま残ります。内容を確かめて保存し、もとのプラグインをアプリから外してください。',
  },
  {
    q: '［このレコードの添付］では、何ができますか？',
    a: 'レコードの詳細画面で、テーブルの中も含めた全部の添付を並べます。画像はサムネイルで並び、［見る］でレコードの全部の添付をまたいで続けて開けます。そのほかに、［PDFに書き込む］［ZIPで保存］［画像を圧縮］が使えます。書き込みと圧縮は、レコードを編集できる方だけに表示されます。',
  },
  {
    q: '［添付の容量］では、何が分かりますか？',
    a: '一覧で押すと、いまの絞り込みのレコードの添付の合計サイズ、大きい順の上位10件のレコード、圧縮でおよそ減る量が分かります。調べるのは押したときだけで、5,000件までです。画像の一括圧縮は、設定でオンにしたときだけ実行できます。',
  },
  {
    q: '［添付を検索］では、何が探せますか？',
    a: '添付のファイル名と、ファイルの中の語を探せます。中の語は、kintone の添付ファイルの検索で当たる範囲で探します。テーブルの中の添付欄も対象です。kintone の検索と同じく語の単位で探すので、英数字は語の途中までの入力では当たりません。語を空にして探すと、いまの絞り込みの添付をすべて並べるギャラリーになります。表示は 500 レコード・2,000 点までです。',
  },
  {
    q: '1 つの PDF にまとめるとき、ファイルは外部に送られますか？',
    a: '送られません。ブラウザの中で組み立てます。PDF を組み立てる部品（pdf-lib）は当社サイトから読み込みますが、ファイルやレコードの値は送りません。パスワード付きの PDF は入れられません。300 点・合計 300MB までです。',
  },
  {
    q: 'ファイル名をそろえると、すでにある添付の名前も変わりますか？',
    a: '変わりません。その保存で新しく添付したファイルだけが対象です。保存の直後に差し替えるため、名前が変わるまで数秒かかり、レコードの更新が 1 回増えます。',
  },
  {
    q: 'ZIP で画像を縮めると、レコードの画像も小さくなりますか？',
    a: 'なりません。レコードの画像はそのままで、ZIP に入れるものだけが縮みます。透過の無い PNG は JPEG になり、名前は「写真_png.jpg」のように元の形式が残ります。縮めても小さくならないときは、元のファイルを入れます。',
  },
  {
    q: '無料で試せますか？',
    a: 'はい、30日間無料で試せます（カード登録不要・自動課金なし・1ドメインにつき1回まで。新しい KIZUNA Pro プラグインが出たときは、もう一度お試しいただけます）。プレミアム年間サポーターを未契約の方は、プレミアム年間サポーターの無料体験に KIZUNA Pro プラグインが含まれます。プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを30日間無料でお試しいただけます。体験が終わると機能は止まりますが、設定は消えません。',
  },
  {
    q: 'ご契約が切れたら、設定はどうなりますか？',
    a: '設定は消えません。ご契約が確認できない間は、機能は動かず、設定画面にはご契約の案内だけが出ます。ご契約が戻れば、保存済みの設定のまま、すぐに動きます。',
  },
  {
    q: 'スマートフォンでも使えますか？',
    a: '画像圧縮、PDF のサイン、ファイル名をそろえる機能は使えます。ダウンロードの制限も、スマートフォンの kintone 標準の添付ファイルのリンクで保存を止めます。ほかの機能と、設定画面はパソコンのみです。',
  },
  {
    q: 'ゲストスペースのアプリでも使えますか？',
    a: '使えます。',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  heroBg="/images/kizuna-pro-hero-bg.webp"
  title="添付ファイル Pro for kintone｜見る・まとめる・軽くするを1つに | KIZUNA Works"
  description="添付ファイル Pro for kintone は、添付ファイルのプレビュー・アイコン表示・ZIP出力・画像圧縮・PDFへの書き込みを1つにまとめた KIZUNA Pro プラグイン。レコードの添付の一覧表示・添付の検索・PDFにまとめる・ファイル名をそろえる・添付のきまり・ダウンロードの制限にも対応。使う機能を機能ごとに選べます。プレビューを画面の右に並べる・別ウインドウで開く、日本語・英語・中国語（簡体字）の表示にも対応します。"
  ogTitle="添付ファイル Pro for kintone｜見る・まとめる・軽くするを1つに | KIZUNA Works"
  ogDescription="添付ファイルプレビュー・アイコン表示・ZIP出力・画像圧縮・PDF編集アシストの5機能を1つに統合。このレコードの添付・添付の容量・添付の検索・PDFにまとめる・ファイル名をそろえる・添付のきまり・ダウンロードの制限に対応する KIZUNA Pro プラグインです。"
  ogType="website"
  ogUrl={PAGE_URL}
  ogImage="https://kizuna-works.jp/images/file-pro-banner.png"
  canonical={PAGE_URL}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': PAGE_URL,
          url: PAGE_URL,
          name: '添付ファイル Pro for kintone｜見る・まとめる・軽くするを1つに | KIZUNA Works',
          description: '添付ファイル Pro for kintone は、kintone の添付ファイルのプレビュー・アイコン表示・ZIP出力・画像圧縮・PDFへの書き込みを1つのプラグインにまとめ、添付の検索・PDFにまとめる・ファイル名をそろえる・添付のきまり・ダウンロードの制限もできる kintone プラグイン（KIZUNA Pro プラグイン）。',
          dateModified: DATE_MODIFIED,
          primaryImageOfPage: { '@type': 'ImageObject', url: 'https://kizuna-works.jp/images/file-pro-banner.png', width: 1200, height: 630 },
          isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: 'https://kizuna-works.jp/' },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
            { '@type': 'ListItem', position: 2, name: 'kintoneプラグイン', item: 'https://kizuna-works.jp/plugins/' },
            { '@type': 'ListItem', position: 3, name: '添付ファイル Pro for kintone', item: PAGE_URL },
          ],
        },
        {
          '@type': 'SoftwareApplication',
          name: '添付ファイル Pro for kintone',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'kintone',
          // Literal on purpose: scripts/check-plugin-summaries.mjs reads it as text. Keep equal to VERSION.
          "softwareVersion": "1.3.0",
          dateModified: DATE_MODIFIED,
          url: PAGE_URL,
          downloadUrl: `https://kizuna-works.jp${ZIP}`,
          image: 'https://kizuna-works.jp/images/file-pro-banner.png',
          offers: [
            {
              '@type': 'Offer',
              name: PRO_SET_PLAN.name,
              price: String(PRO_SET_PLAN.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターと KIZUNA Pro 拡張パックのセット（年額）。KIZUNA Pro プラグインをすべて含みます。製品ごとの個別のご契約はありません。',
            },
            {
              '@type': 'Offer',
              name: PRO_ADDON.name,
              price: String(PRO_ADDON.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターに追加するプラン（年額）。',
            },
          ],
          description: '添付ファイル Pro for kintone は、kintone の添付ファイルについて、プレビュー・一覧のアイコン表示・ZIP出力・画像圧縮・PDFへの書き込みの5つの機能を1つの設定画面で使えるプラグイン。詳細画面でテーブルの中も含む全添付を並べる「このレコードの添付」、一覧で添付の合計・大きいレコード・圧縮でおよそ減る量を確認できる「添付の容量」（画像の一括圧縮は、設定でオンにしたときだけ実行できる。既定はオフ）、ZIP に入れる画像だけを縮める機能、添付のファイル名と中の語（kintone の添付ファイルの検索で当たる範囲）から探す「添付を検索」、PDF・画像を1つの PDF にまとめて、ダウンロードまたはテーブルの外の添付欄に保存する機能、保存時に名前を付け直す「ファイル名をそろえる」、形式・大きさ・点数を決める「添付のきまり」、許可した人のほかは保存できなくする「ダウンロードの制限」、添付欄ごとの効き具合を確かめられる「まとめ」に対応。同じアプリにもとのプラグインが有効で設定済みのときは、その機能はもとのプラグインが動く。もとのプラグインの設定は［単品の設定を読み込む］で引き継げる。',
          publisher: { '@type': 'Organization', name: 'KIZUNA Works', url: 'https://kizuna-works.jp' },
          featureList: [
            'プレビュー：添付ファイルのリンクを押すと、画像・PDF・Word・Excel などをその場で開く',
            'アイコン表示：一覧に、添付の有無・種類・件数をアイコンで出す',
            'ZIP出力：一覧や詳細の添付ファイルを、まとめて ZIP で保存する',
            '画像圧縮：保存した画像を、自動で軽くする',
            'PDFへの書き込み：添付の PDF に、文字・図形・押印を書き込んで保存する',
            'このレコードの添付：詳細画面で、テーブルの中も含む全添付を並べて、見る・PDFに書き込む・ZIPで保存・画像を圧縮',
            '添付の容量：一覧で、いまの絞り込みの添付の合計・大きいレコード・圧縮でおよそ減る量を確認し、設定でオンにしたときだけ一括圧縮',
            'ZIP で画像を縮小：ZIP に入れる画像だけを縮める（レコードの画像は変わらない）',
            '添付を検索：一覧で、添付のファイル名とファイルの中の語（kintone の添付ファイルの検索で当たる範囲）から探し、サムネイルのカードで並べる（語を空にするとギャラリー）',
            'PDFにまとめる：PDF と画像を並べ替えて1つの PDF にし、ダウンロードまたはレコードの添付欄（テーブルの外の欄）へ保存',
            'ファイル名をそろえる：添付欄ごとの型で、保存時に新しく添付したファイルの名前を付け直す',
            '添付のきまり：添付欄ごとに、使える形式・1ファイルの上限・点数の上限を決めて、添付時と保存時に確かめる',
            'ダウンロードの制限：許可した人のほかは、添付ファイルをプレビューで見られるが PC に保存できなくする。許可する人・対象の欄・対象のレコードを選べる',
            'まとめ：添付欄ごとに、5つの機能が効いているかを1つの表で確認し、対象欄をまとめてそろえる（アイコン表示はテーブルの中の欄を対象にできない）',
            'これまでのプラグインの設定を読み込んで引き継ぐ',
            'プレビューを右に並べる：レコードを見ながら、プレビューを画面の右側に並べて表示。境目をドラッグして幅を変えられ、幅は記憶される',
            '別ウインドウで開く：プレビューを別のウインドウに出して、2 画面目に置ける',
            '多言語：kintone のユーザーの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示',
            '使う機能の選択：設定画面で、機能ごとにオン・オフを選ぶ。オフの機能は入力の確認をせず、一覧・レコード画面に何も出さない（保存済みの設定は残る）',
            '単品のプラグインを無効にしただけでも、その機能を動かす（単品に任せるのは、単品が有効で設定済みのときだけ）',
            'ゲストスペースのアプリに対応',
          ],
        },
      ],
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --kbp-navy: #1B3A6B;
      --kbp-ink: #0f1f3d;
      --kbp-gold: #b8862b;
      --kbp-gold-light: #e8c766;
      --kbp-gold-soft: #f0d58a;
      --kbp-green: #2E8B2E;
      --kbp-text: #333333;
      --kbp-muted: #64748b;
    }

    /* Hero: darker than the premium hero, gold accents mark the Pro series */
    .kbp-hero {
      /* Shared KIZUNA Pro hero background; sized by width, its baked bottom fade blends into this base gradient */
      background:
        url('/images/kizuna-pro-hero-bg.webp') center top / 100% auto no-repeat,
        linear-gradient(90deg, #020816 0%, #050b1c 30%, #081427 50%, #09182f 70%, #0c1729 100%);
      color: #fff;
      padding: 60px 5% 54px;
      text-align: center;
      border-bottom: 4px solid var(--kbp-gold);
    }
    .kbp-hero-icon {
      width: 136px; height: 136px; object-fit: contain; display: block; margin: 0 auto 18px;
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(232, 199, 102, 0.5);
      border-radius: 26px; padding: 10px; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    }
    .kbp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
    .kbp-badge-pro {
      display: inline-flex; align-items: center; gap: 6px; line-height: 1;
      padding: 7px 16px; border-radius: 20px;
      background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%);
      color: #1a1405; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.08em;
    }
    .kbp-hero-version {
      padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.45);
      font-size: 0.85rem; font-weight: 700; line-height: 1;
    }
    .kbp-hero-title { font-size: clamp(1.7rem, 4.2vw, 2.6rem); margin: 0 0 12px; line-height: 1.3; }
    .kbp-tagline { font-size: clamp(1.05rem, 2.4vw, 1.35rem); font-weight: 700; margin: 0 0 14px; color: var(--kbp-gold-soft); }
    .kbp-sub { max-width: 860px; margin: 0 auto 26px; line-height: 1.9; font-size: 1rem; color: rgba(255, 255, 255, 0.92); }
    .kbp-sub strong { color: #fff; }
    .kbp-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; max-width: 900px; margin: 0 auto 28px; }
    .kbp-pillar {
      display: block; padding: 16px 14px; border-radius: 12px; text-decoration: none; color: #fff;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(232, 199, 102, 0.45);
    }
    .kbp-pillar:hover { background: rgba(255, 255, 255, 0.14); }
    .kbp-pillar-no { display: block; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--kbp-gold-soft); font-weight: 800; }
    .kbp-pillar-name { display: block; font-size: 1.05rem; font-weight: 800; margin: 4px 0; }
    .kbp-pillar-desc { display: block; font-size: 0.84rem; line-height: 1.6; color: rgba(255, 255, 255, 0.85); }
    .kbp-hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .kbp-btn {
      display: inline-block; padding: 14px 26px; border-radius: 10px; font-weight: 800; text-decoration: none;
      font-size: 1rem; line-height: 1.3;
    }
    .kbp-btn.is-primary { background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%); color: #1a1405; box-shadow: 0 6px 18px rgba(184, 134, 43, 0.35); }
