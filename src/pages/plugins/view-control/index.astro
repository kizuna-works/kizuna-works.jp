---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
import Picture from '../../../components/Picture.astro';
---

<Layout
  title="一覧コントロール for kintone - 一覧・グラフを担当者ごとに出し分けるプラグイン | KIZUNA Works"
  description="kintone の一覧・グラフの表示／非表示を、ユーザー・組織・グループ単位で出し分ける kintone プラグイン。増えすぎた一覧切替から関係のない一覧を隠し、最初に開く一覧も担当ごとに指定できます。公式JS APIで制御するのでDOM操作なし。PC／モバイル・ゲストスペース対応、kintone完結・外部API不使用。"
  ogTitle="一覧コントロール for kintone - 一覧・グラフを担当者ごとに出し分けるプラグイン | KIZUNA Works"
  ogDescription="一覧切替に並ぶ一覧・グラフを、ユーザー・組織・グループごとに出し分け。最初に開く一覧も指定できます。公式JS API制御・PC/モバイル対応・kintone完結。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/view-control/"
  ogImage="https://kizuna-works.jp/images/view-control-banner.png"
  canonical="https://kizuna-works.jp/plugins/view-control/"
>
