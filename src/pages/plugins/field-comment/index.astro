---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="フィールドコメント for kintone - 入力欄に説明・注釈を表示して入力ミス防止 | KIZUNA Works"
  description="kintoneのフィールド名横にヘルプアイコン or 常時表示コメントを追加する無料プラグイン。アイコン+ホバー / アイコン+クリック / アイコンなし常時表示の3モードで入力ルールや業務ルールを担当者に伝達。完全無料のkintoneプラグイン、kintone プラグイン 無料配布中。"
  ogTitle="フィールドコメント for kintone - 入力欄に説明・注釈を表示して入力ミス防止 | KIZUNA Works"
  ogDescription="kintoneのフィールド名横にヘルプアイコン or 常時表示コメントを追加する無料プラグイン。3モード（ホバー/クリック/常時）でルールを担当者に伝達。完全無料のkintoneプラグイン、kintone プラグイン 無料配布中。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/field-comment/"
  ogImage="https://kizuna-works.jp/images/field-comment-banner.png"
  canonical="https://kizuna-works.jp/plugins/field-comment/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
