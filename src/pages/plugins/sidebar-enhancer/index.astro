---
import Layout from '../../../layouts/Layout.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import TrialBanner from '../../../components/TrialBanner.astro';
---

<Layout
  title="サイドバー拡張 for kintone｜右サイドバーにレコード追加・進捗・確認の5タブを増設 | KIZUNA Works"
  description="kintone のレコード詳細画面の右サイドバーに独自タブを5つ増設するプラグイン。値を引き継いで他アプリへレコード追加、URLや地図を画面を離れずプレビュー、プロセス管理のステータス履歴と滞留日数、ステータス別チェックリスト、アプリガイドを常設。フォームのレイアウトは一切変えません。"
  ogTitle="サイドバー拡張 for kintone｜右サイドバーにレコード追加・進捗・確認の5タブを増設 | KIZUNA Works"
  ogDescription="レコード詳細画面の右サイドバー（コメント・変更履歴の隣）に、追加・リンク・進捗・確認・ガイドの5タブを増設。フォームのレイアウトを変えずに、既存アプリへ後から機能を足せるプレミアムプラグインです。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/sidebar-enhancer/"
  ogImage="https://kizuna-works.jp/images/sidebar-enhancer-banner.png"
  canonical="https://kizuna-works.jp/plugins/sidebar-enhancer/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/sidebar-enhancer/",
          "url": "https://kizuna-works.jp/plugins/sidebar-enhancer/",
          "name": "サイドバー拡張 for kintone｜右サイドバーにレコード追加・進捗・確認の5タブを増設 | KIZUNA Works",
          "description": "kintone のレコード詳細画面の右サイドバーに独自タブを5つ増設するプラグイン。値を引き継いで他アプリへレコード追加、URLや地図を画面を離れずプレビュー、プロセス管理のステータス履歴と滞留日数、ステータス別チェックリスト、アプリガイドを常設する。フォームのレイアウトは変更しない。",
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "https://kizuna-works.jp/images/sidebar-enhancer-banner.png",
            "width": 1200,
            "height": 630
          },
          "isPartOf": { "@type": "WebSite", "name": "KIZUNA Works", "url": "https://kizuna-works.jp/" }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://kizuna-works.jp/" },
            { "@type": "ListItem", "position": 2, "name": "kintoneプラグイン", "item": "https://kizuna-works.jp/plugins/" },
            { "@type": "ListItem", "position": 3, "name": "サイドバー拡張 for kintone", "item": "https://kizuna-works.jp/plugins/sidebar-enhancer/" }
          ]
        },
        {
          "@type": "SoftwareApplication",
          "name": "サイドバー拡張 for kintone",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "kintone",
          "softwareVersion": "1.0.3",
          "dateModified": "2026-08-05",
          "url": "https://kizuna-works.jp/plugins/sidebar-enhancer/",
          "downloadUrl": "https://kizuna-works.jp/downloads/kw-sidebar-enhancer-v1.0.3.zip",
          "image": "https://kizuna-works.jp/images/sidebar-enhancer-banner.png",
          "offers": [
            {
              "@type": "Offer",
              "name": "無料プラン",
              "price": "0",
              "priceCurrency": "JPY",
              "availability": "https://schema.org/InStock",
              "description": "5つの機能のうち1つを、機能の中身を制限せずお試しいただけます（利用期限なし）。"
            },
            {
              "@type": "Offer",
              "name": "プレミアム年間サポーター（全プラグイン込み）",
              "price": "16500",
              "priceCurrency": "JPY",
              "availability": "https://schema.org/InStock",
              "description": "プレミアム年間サポーター（税込 ¥16,500/年）に加入すると、5機能すべてを同時に有効化でき、追加先・表示対象・テンプレートも無制限になります。単品販売はありません。"
            }
          ],
          "description": "kintone のレコード詳細画面の右サイドバー（コメント・変更履歴の隣）に独自タブを増設するプラグイン。開いているレコードの値を引き継いで他アプリへ新規レコードを作成、フィールドのURLや地図を画面を離れずプレビュー、プロセス管理のステータス履歴（どのアクションで・いつ・誰が変更したか）と滞留日数の警告、ステータス別チェックリスト、アプリの入力ルールやFAQの常設表示を提供する。フォームのレイアウトは一切変更しない。",
          "publisher": { "@type": "Organization", "name": "KIZUNA Works", "url": "https://kizuna-works.jp" },
          "featureList": [
            "レコード詳細画面の右サイドバーに独自タブを最大5つ増設（フォームのレイアウトは変更しない）",
            "開いているレコードの値を引き継いで他アプリ・自アプリへ新規レコードを作成",
            "レコード追加フォームは全フィールド型に対応し、表示する項目と並び順を選べる",
            "引き継いだ値の固定（編集不可）と、固定値の自動セットに対応",
            "フィールドに入っているURLをサイドバー内に埋め込み表示",
            "Googleマップの共有URLを埋め込み形式へ自動変換して地図表示",
            "プロセス管理のステータス履歴を縦のステッパーで表示（どのアクションで・いつ・誰が変更したか）",
            "ステータスが最後に変わってからの経過日数をしきい値と色で段階警告",
            "ステータス別チェックリストの消化・完了率表示・未完了ならプロセス管理のアクションを実行させない",
            "アプリの入力ルール・運用手順・FAQをMarkdownでサイドバーに常設",
            "kintone完結。外部サービスへ業務データを送信しない"
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            { "@type": "Question", "name": "既存アプリのフォームは変わってしまいますか？", "acceptedAnswer": { "@type": "Answer", "text": "変わりません。本プラグインは右サイドバー（コメント・変更履歴が並んでいる場所）にタブを追加するだけで、フォームのフィールド配置には手を加えません。そのため、すでに運用中のアプリへ後から入れても本体の見た目が崩れません。なお「進捗」タブを使う場合のみ、ステータスの変更履歴を保存する専用フィールドを2つ追加しますが、レコード画面では自動的に非表示になるため利用者の目には触れません。" } },
            { "@type": "Question", "name": "単品で購入できますか？", "acceptedAnswer": { "@type": "Answer", "text": "本プラグインはプレミアムプラグインのため単品販売はありません。無料プランでは5つの機能のうち1つを、機能の中身を制限せずお試しいただけます（利用期限なし）。複数の機能を同時に使うには、プレミアム年間サポーター（税込 ¥16,500/年）にご加入ください。販売中の全プラグインも利用できます。" } },
            { "@type": "Question", "name": "「進捗」タブはどの kintone 機能を使うものですか？プロセス管理は必須ですか？", "acceptedAnswer": { "@type": "Answer", "text": "kintone の「プロセス管理」（アプリの設定でステータスとアクションを定義する機能）を使っているアプリ向けのタブです。プロセス管理が無効なアプリでは、このタブは表示されません。表示されるのは、プロセス管理のアクションによってステータスがどう変わってきたか（どのアクションで・いつ・誰が）と、現在のステータスに何日とどまっているかです。" } },
            { "@type": "Question", "name": "過去のステータス変更も表示されますか？", "acceptedAnswer": { "@type": "Answer", "text": "いいえ。kintone にはプロセス管理のステータス変更履歴を取り出す API がないため、本プラグインはアクションが実行された時点で自分で記録します。したがって表示できるのは導入後に実行されたアクションだけです。導入前に通過したとみられるステータスは、まだ通っていない状態と区別できるようグレーの「記録なし」として表示し、凡例と注記も添えます。導入後の変更は、アクション名・日時・実行者つきで記録されます。" } },
            { "@type": "Question", "name": "リンクタブで表示できないサイトがありますか？", "acceptedAnswer": { "@type": "Answer", "text": "あります。セキュリティ設定で他サイトへの埋め込みを禁止しているサイト（金融機関や行政サイトなどに多い）は、仕様上どのプラグインでも埋め込めません。その場合は自動的に「別タブで開く」ボタンへ切り替わるので、操作が行き止まりになることはありません。Googleマップの共有URLは、埋め込み可能な形式へ自動で書き換えてから表示します。" } },
            { "@type": "Question", "name": "「追加」タブでサブテーブルも登録できますか？", "acceptedAnswer": { "@type": "Answer", "text": "現時点では対応していません。サブテーブル以外のフィールド型（文字列・数値・日付・選択系・ユーザー選択・ルックアップ・添付ファイルなど）はすべて登録できます。サブテーブルへの入力は、レコードを追加したあとにレコード本体で行ってください。" } },
            { "@type": "Question", "name": "スマートフォンでも使えますか？", "acceptedAnswer": { "@type": "Answer", "text": "現時点では PC 版のみの対応です。モバイル版はサイドバーの構造が異なるため、タブは表示されません（画面が乱れることはありません）。外出先での閲覧が中心の運用では、この点をご確認のうえご検討ください。" } },
            { "@type": "Question", "name": "チェックリストの内容は、担当者が変わっても引き継げますか？", "acceptedAnswer": { "@type": "Answer", "text": "引き継げます。チェック状態はレコード本体ではなく、同じスペース内に自動生成する保管アプリへ保存し、閲覧と編集は全員に許可しています（削除だけを管理者に限定）。そのため、前の担当者が途中まで消化したチェックの続きを、別の担当者がそのまま進められます。レコードの変更履歴を汚さない設計です。" } },
            { "@type": "Question", "name": "ほかのプラグインと同時に使えますか？", "acceptedAnswer": { "@type": "Answer", "text": "使えます。既読チェック・コメントコントロール・クイックタブ・アコーディオンタブ・クイック目次・テーマスタイラー・住所アシストとの同時利用を実機で確認しています。とくに既読チェックとは同じサイドバーにタブが並びますが、表示順は「標準タブ → サイドバー拡張の5タブ → 既読」で固定され、どちらを先にインストールしても変わりません。タブを切り替えると相手のパネルは自動で閉じるため、内容が重なって表示されることもありません。" } },
            { "@type": "Question", "name": "ゲストスペースでも使えますか？", "acceptedAnswer": { "@type": "Answer", "text": "使えます。ゲストスペース内のアプリでも、設定画面と5つの機能すべてが動作することを確認しています。" } }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0,0,0,0.08);
    }

    .afp-hero {
      background: linear-gradient(135deg, rgba(21,41,77,0.72) 0%, rgba(27,58,107,0.55) 60%, rgba(46,139,46,0.5) 130%),
                  url('/images/premium-plugins-bg.png') center center / cover no-repeat;
      background-color: #1B3A6B;
      color: #fff;
      padding: 56px 5% 48px;
      text-align: center;
    }
    .afp-hero-icon {
      width: 132px; height: 132px; object-fit: contain; display: block; margin: 0 auto 16px;
      background: rgba(255,255,255,0.14); border-radius: 24px; padding: 10px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }
    .afp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; margin-bottom: 14px; }
    .afp-badge-premium {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.5);
      color: #fff; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.06em;
      padding: 6px 14px; border-radius: 20px; line-height: 1;
    }
    /* Crown and label are separate flex items with line-height:1 so the emoji
       centres against the text instead of sitting on its baseline. */
    .afp-badge-premium .crown { display: block; line-height: 1; font-size: 1.02em; }
    .afp-badge-premium .label { display: block; line-height: 1; }
    /* The crown is a separate flex item with line-height:1 so it centres against
       the label instead of sitting on the text baseline. */
    .afp-badge-premium .crown { display: block; line-height: 1; font-size: 1.02em; }
    .afp-badge-premium .label { display: block; line-height: 1; }
    .afp-hero-version {
      display: inline-flex; align-items: center; line-height: 1;
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.4);
      color: #fff; font-weight: 700; font-size: 0.82rem; padding: 6px 12px; border-radius: 20px;
    }
    .afp-hero h1 { font-size: 2.1rem; font-weight: 700; margin: 0 0 10px; letter-spacing: 0.04em; }
    .afp-hero .afp-tagline { font-size: 1.15rem; font-weight: 600; margin: 0 0 8px; }
    .afp-hero .afp-sub { font-size: 1rem; opacity: 0.92; margin: 0 auto; max-width: 720px; line-height: 1.8; }
    .afp-hero-gradient-line { height: 6px; background: linear-gradient(to right, var(--color-navy), var(--color-green)); }

    /* Keep service names from breaking mid-word ("Google" / "Chat" on separate lines) */
    .nb { white-space: nowrap; }

    .afp-wrap { max-width: 1100px; margin: 0 auto; padding: 0 5%; }
    .afp-section { padding: 56px 0; }
    .afp-section.alt { background: #fff; }
    .afp-h2 {
      font-size: 1.7rem; color: var(--color-navy); margin: 0 0 28px; padding-left: 16px;
      border-left: 5px solid var(--color-green);
    }
    .afp-lead {
      font-size: 1.08rem; line-height: 1.9; color: var(--color-text-main);
      background: #fff; border-radius: 12px; padding: 28px 32px; box-shadow: var(--shadow-card);
    }
    .afp-lead strong { color: var(--color-navy); }

    .afp-feature { display: grid; grid-template-columns: 1.05fr 1fr; gap: 32px; align-items: center; margin-bottom: 48px; }
    .afp-feature:last-child { margin-bottom: 0; }
    .afp-feature.reverse { grid-template-columns: 1fr 1.05fr; }
    .afp-feature.reverse .afp-feature-text { order: 2; }
    .afp-feature picture, .afp-feature img { width: 100%; height: auto; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: var(--shadow-card); background: #fff; display: block; }
    .afp-feature img { cursor: zoom-in; }
    .afp-feature h3 { font-size: 1.25rem; color: var(--color-navy); margin: 0 0 12px; }
    .afp-feature p { font-size: 1rem; line-height: 1.8; margin: 0; }


    /* The sidebar screenshots are narrow and tall. Left at the shared
       .afp-feature ratio they tower over the text column and leave large gaps
       above and below it, so cap their width and top-align the pair. */
    .afp-feature.sbe-shot { grid-template-columns: 1.5fr 0.8fr; align-items: start; }
    .afp-feature.sbe-shot.reverse { grid-template-columns: 0.8fr 1.5fr; }
    .afp-feature.sbe-shot picture { max-width: 300px; margin-left: auto; margin-right: auto; }
    /* The record-add form and the embedded page are the two tallest shots, so pull
       them in further to keep each row close to its text height. */
    .afp-feature.sbe-shot--tall picture { max-width: 260px; }

    .afp-grid-feats { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .afp-feat-card { background: #fff; border-radius: 10px; padding: 24px; box-shadow: var(--shadow-card); }
    .afp-feat-card h3 { font-size: 1.1rem; color: var(--color-navy); margin: 0 0 10px; }
    .afp-feat-card p { font-size: 0.95rem; line-height: 1.75; margin: 0; }

    .afp-shot { max-width: 960px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: var(--shadow-card); overflow: hidden; }
    .afp-shot img { width: 100%; height: auto; display: block; background: #F0F4F8; cursor: zoom-in; }
    .afp-shot-cap { text-align: center; font-size: 0.9rem; color: var(--color-text-muted); margin: 12px 0 0; }

    .afp-msg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; align-items: start; }
    .afp-msg-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: var(--shadow-card); overflow: hidden; }
    .afp-msg-card h3 { font-size: 1rem; color: var(--color-navy); margin: 0; padding: 12px 16px; border-bottom: 1px solid #eef2f7; background: #f8fafc; }
    .afp-msg-card img { width: 100%; height: auto; display: block; cursor: zoom-in; background: #fff; }
    .afp-msg-card p { font-size: 0.88rem; line-height: 1.7; color: var(--color-text-muted); margin: 0; padding: 12px 16px 14px; }

    .afp-svc { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: var(--shadow-card); margin-bottom: 24px; overflow: hidden; }
    .afp-svc > summary { cursor: pointer; list-style: none; padding: 18px 48px 18px 22px; font-weight: 700; color: var(--color-navy); font-size: 1.05rem; position: relative; }
    .afp-svc > summary::-webkit-details-marker { display: none; }
    .afp-svc > summary::after { content: "＋"; position: absolute; right: 22px; top: 50%; transform: translateY(-50%); color: var(--color-green); font-weight: 700; }
    .afp-svc[open] > summary::after { content: "－"; }
    .afp-svc-body { padding: 0 22px 22px; }
    .afp-svc-body ol { padding-left: 22px; margin: 0 0 18px; }
    .afp-svc-body li { line-height: 1.9; margin-bottom: 6px; font-size: 0.97rem; }
    .afp-svc-shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
    .afp-svc-shots figure { margin: 0; }
    .afp-svc-shots img { width: 100%; height: auto; display: block; border: 1px solid #e2e8f0; border-radius: 8px; cursor: zoom-in; background: #fff; }
    .afp-svc-shots figcaption { font-size: 0.82rem; color: var(--color-text-muted); margin-top: 6px; line-height: 1.6; }

    .afp-tablewrap { overflow-x: auto; }
    table.afp-compare { border-collapse: collapse; width: 100%; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: var(--shadow-card); min-width: 560px; }
    table.afp-compare th, table.afp-compare td { border: 1px solid #e2e8f0; padding: 12px 14px; text-align: left; }
    table.afp-compare thead th { background: var(--color-navy); color: #fff; }
    table.afp-compare td.c, table.afp-compare th.c { text-align: center; }
    table.afp-compare tbody tr:nth-child(even) { background: #f8fafc; }

    .afp-plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-bottom: 44px; align-items: stretch; }
    .afp-plan-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 34px 28px 30px; box-shadow: var(--shadow-card); position: relative; text-align: center; display: flex; flex-direction: column; }
    .afp-plan-card.recommended { border: 2px solid var(--color-green); }
    .afp-plan-badge { position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: var(--color-green); color: #fff; font-weight: 700; font-size: 0.82rem; padding: 6px 18px; border-radius: 20px; white-space: nowrap; }
    .afp-plan-name { font-size: 1.3rem; color: var(--color-navy); margin: 0 0 18px; }
    .afp-plan-price { margin-bottom: 6px; }
    .afp-plan-price .amt { font-size: 2.4rem; font-weight: 700; color: var(--color-navy); }
    .afp-plan-price .unit { font-size: 0.95rem; color: var(--color-text-muted); margin-left: 4px; }
    .afp-plan-discount { color: var(--color-green); font-weight: 700; font-size: 0.92rem; margin-bottom: 16px; }
    .afp-plan-features { list-style: none; padding: 0; margin: 18px 0 24px; text-align: left; flex-grow: 1; }
    .afp-plan-features li { font-size: 0.95rem; line-height: 1.7; padding: 9px 0; border-bottom: 1px solid #eef2f7; }
    .afp-plan-cta { display: block; background: var(--color-navy); color: #fff; font-weight: 700; padding: 14px 20px; border-radius: 8px; text-decoration: none; transition: background .2s, transform .2s, box-shadow .2s; }
    .afp-plan-card.recommended .afp-plan-cta { background: var(--color-green); }
    .afp-plan-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(0,0,0,0.16); }
