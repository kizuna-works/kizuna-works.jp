  <script is:inline>
    (function () {
      var lightbox = document.getElementById('fc-lightbox');
      var lightboxImg = lightbox ? lightbox.querySelector('img') : null;
      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        if (lightboxImg) lightboxImg.src = '';
      }
      if (lightbox && lightboxImg) {
        document.querySelectorAll('img.zoomable').forEach(function (img) {
          img.addEventListener('click', function () {
            lightboxImg.src = img.currentSrc || img.src;
            lightboxImg.alt = img.alt || '拡大画像';
            lightbox.classList.add('is-open');
            lightbox.setAttribute('aria-hidden', 'false');
          });
        });
        lightbox.addEventListener('click', closeLightbox);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLightbox(); });
      }

      // ダウンロードは ヒーローとプランカードの2か所にあるので、まとめて計測する
      if (typeof gtag === 'function') {
        document.querySelectorAll('a.js-dl').forEach(function (dl) {
          dl.addEventListener('click', function () {
            gtag('event', 'file_download', {
              file_name: 'kw-form-connect-v1.0.0.zip',
              file_extension: 'zip',
              link_text: '無料でダウンロード',
              link_url: '/downloads/kw-form-connect-v1.0.0.zip'
            });
          });
        });
      }
    })();
  </script>
