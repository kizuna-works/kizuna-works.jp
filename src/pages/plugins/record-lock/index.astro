---
import Layout from '../../../layouts/Layout.astro';
import ResellerCard from '../../../components/ResellerCard.astro';
import PremiumPlanCard from '../../../components/PremiumPlanCard.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
import Picture from '../../../components/Picture.astro';
---

<Layout
  title="レコードロック for kintone｜条件で自動ロックして編集を制限する無料プラグイン | KIZUNA Works"
  description="kintoneレコードを条件で自動ロックして編集を制限する無料プラグイン。ロック設定は複数作れ、ステータスごとに入力できる人と欄を変えられます。レコード全体・選んだ欄だけ・選んだ欄以外すべて・本人捺印のロック、除外ユーザー設定、スマホにも対応。"
  ogTitle="レコードロック for kintone｜条件で自動ロックして編集を制限する無料プラグイン | KIZUNA Works"
  ogDescription="kintoneレコードを条件で自動ロックして編集を制限する無料プラグイン。ロック設定は複数作れ、ステータスごとに入力できる人と欄を変えられます。レコード全体・選んだ欄だけ・選んだ欄以外すべて・本人捺印のロック、除外ユーザー設定、スマホにも対応。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/record-lock/"
  ogImage="https://kizuna-works.jp/images/record-lock-banner.png"
  canonical="https://kizuna-works.jp/plugins/record-lock/"
>
