---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import BridgeRecipeCard from '../../../components/BridgeRecipeCard.astro';
import { bridgeRecipes, featuredBridgeRecipes } from '../../../data/bridge-recipes';
import { bridgePartnerPlugins } from '../../../data/plugins';
import type { Plugin } from '../../../data/plugins';
import { PREMIUM_PLAN, PRO_SET_PLAN, PRO_ADDON, yen } from '../../../data/pricing';

const VERSION = '1.1.1';
const ZIP = `/downloads/kw-bridge-v${VERSION}.zip`;
const PAGE_URL = 'https://kizuna-works.jp/plugins/bridge/';
const DATE_MODIFIED = '2026-10-29';

// Partner list: grouped by what the user can do together. Products are read from
// plugins.ts (`bridge` field), so a new partner shows up here without touching
// this page — anything not named in a group falls into the last one.
const GROUPS: { key: string; title: string; lead: string; ids: string[] }[] = [
  {
    key: 'apply',
    title: '書き込んだレコードにも、そのアプリのプラグインを当てる',
    lead: 'ブリッジが他のアプリにレコードを作る・変えるときは、kintone の保存の画面を通りません。ルールで［書き込み先のアプリの採番・文字列結合なども当てる］をオンにすると、書き込み先のアプリに入っている当社のプラグインの処理を、画面で保存したときと同じように当てます。',
    ids: [
      'kw-conditional-numbering', 'kw-address-assist', 'kw-elapsed-assist', 'kw-text-join',
      'kw-free-lookup', 'kw-lookup-pro', 'kw-link-assist', 'kw-image-compress', 'kw-footprint', 'kw-read-check',
    ],
  },
  {
    key: 'guard',
    title: '書き込み先で通知する・ロックを守る',
    lead: '書き込み先のアプリのチャット通知のルールで通知したり、ロックされているレコードを書き換えないようにしたりできます。どちらもルールごとにオンにします。',
    ids: ['kw-chat-notify', 'kw-record-lock'],
  },
  {
    key: 'run',
    title: 'ルールから、当社のプラグインの機能を実行する',
    lead: '動作［プラグインの機能を実行する］で、ほかのアプリに入っている当社のプラグインの処理（一括更新・ステータスの一括実行・保存した検索の結果の CSV 出力など）を呼び出せます。かんたん一括更新・ステータス一括実行で一括して変えたレコードには、逆にブリッジのルールが動きます。',
    ids: ['kw-bulk-update', 'kw-status-bulk-action', 'kw-search-pro'],
  },
  {
    key: 'more',
    title: '集計し直す・見やすく表示する',
    lead: '別のアプリの変更をきっかけにした集計の保存し直しや、ブリッジの不在カレンダーの表示に使えます。',
    ids: ['kw-related-enhancer', 'kw-calendar-view'],
  },
];
const named = new Set(GROUPS.flatMap((g) => g.ids));
const byId = new Map(bridgePartnerPlugins.map((p) => [p.id, p]));
const partnerGroups = GROUPS.map((g, i) => {
  const items = g.ids.map((id) => byId.get(id)).filter((p): p is Plugin => !!p);
  if (i === GROUPS.length - 1) {
    items.push(...bridgePartnerPlugins.filter((p) => !named.has(p.id)));
  }
  return { ...g, items };
}).filter((g) => g.items.length > 0);
const partnerCount = bridgePartnerPlugins.length;
const iconOf = (p: Plugin) => `/images/${p.slug.replace(/^kw-/, '')}-icon.png`;

// FAQ: the accordion and FAQPage JSON-LD are built from the same array so they always match.
const faqs: { q: string; a: string }[] = [
  {
    q: 'KIZUNAブリッジ for kintone だけを購入できますか？',
    a: `KIZUNAブリッジだけを個別にご契約いただくことはできません。プレミアム年間サポーターに KIZUNA Pro 拡張パックを追加すると、KIZUNAブリッジを含む KIZUNA Pro プラグインをすべてお使いいただけます。両方をまとめた「KIZUNA Pro 年間サポーター」（税込 ${yen(PRO_SET_PLAN.priceInTax)}/年）もあります。`,
  },
  {
    q: '年間サポーター（ちょこっとプラグインすべて）に、KIZUNA Pro 拡張パックを追加できますか？',
    a: 'できません。KIZUNA Pro 拡張パックは、プレミアム年間サポーターに追加していただくプランです。年間サポーターからは、KIZUNA Pro 年間サポーターへの切り替えでお使いいただけます。',
  },
  {
    q: 'ブリッジを入れるのは、どのアプリですか？',
    a: 'きっかけになるアプリ（保存やアクションが起きるアプリ）に入れます。書き込み先のアプリにブリッジを入れる必要はありません。ただし、書き込み先で当社のプラグインの処理を当てるときは、そのプラグインが書き込み先のアプリに入っている必要があります。',
  },
  {
    q: '他のアプリへの書き込みは、誰の権限で行われますか？',
    a: 'ルールを動かした人（保存やアクションをした人）の権限です。アクセス権を超えて書き込むことはありません。書き込み先の権限は前もって確かめないため、その人が書き込み先のレコードを編集できないときも、保存やアクションはそのまま終わります。書き込めなかった分は、理由を画面で知らせ、実行の記録に残します。他のアプリへの書き込みは 1 回にまとめて行うので、1 件でも権限がないと、その回の書き込みはすべて行われません。',
  },
  {
    q: '連携できる当社のプラグインは、どれですか？',
    a: `このページの「連携できるプラグイン」に一覧があります（現在 ${partnerCount} 製品）。各製品のページにも「ブリッジ連携」のバッジを付けています。連携には、それぞれの製品の最新版をお使いください。`,
  },
  {
    q: '設定を間違えたまま動かしてしまうのが心配です。',
    a: '設定画面の予行演習で、今のレコードを使って「どのルールが動き、何をどこへ書くか」を、実際には書き込まずに確かめられます。他のアプリへ書き込めなかったもの（と数値の足し引き）は実行の記録に残り、失敗したものは記録から再実行できます。',
  },
  {
    q: '当社のプラグインを、まとめて最新版にできますか？',
    a: 'できます。設定画面の［プラグインの更新］タブに、この kintone に読み込まれている KIZUNA Works のプラグインの、入っているバージョンと最新版が並びます。選んで更新すると、まとめて最新版に上書きします（1 本あたり約 3 秒）。プラグインの設定はそのまま残り、そのプラグインを使っているすべてのアプリにすぐ反映されます。実行できるのは kintone システム管理者だけです。',
  },
  {
    q: '無料で試せますか？',
    a: 'はい、30日間無料で試せます（カード登録不要・自動課金なし・1ドメインにつき1回まで。新しい KIZUNA Pro プラグインが出たときは、前回の体験の終了から90日以上たっていれば、もう一度お試しいただけます）。プレミアム年間サポーターを未契約の方は、プレミアム年間サポーターの無料体験に KIZUNA Pro プラグインが含まれます。プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを30日間無料でお試しいただけます。体験が終わるとルールは止まりますが、設定は消えません。',
  },
  {
    q: 'ご契約が切れたら、設定はどうなりますか？',
    a: '設定は消えません。ご契約が確認できない間は、ルールは動かず、設定画面にはご契約の案内だけが出ます。ご契約が戻れば、保存済みの設定のまま、すぐに動きます。',
  },
  {
    q: 'スマートフォンでも動きますか？',
    a: 'レコードの保存・アクションをきっかけにしたルールは、kintone のモバイル版でも動きます。ブリッジの設定画面はパソコンでお使いください。',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  heroBg="/images/kizuna-pro-hero-bg.webp"
  title="KIZUNAブリッジ for kintone｜アプリをまたぐ作業とプラグインの連携を自動化 | KIZUNA Works"
  description="KIZUNAブリッジ for kintone は、保存やアクションをきっかけに、他のアプリのレコードを作る・変える・ステータスを進める処理をノーコードのルールで自動化する KIZUNA Pro プラグイン。当社のプラグインとも連携し、書き込み先での採番や通知、画面を通らずに保存したレコードへの採番の当て直しまでつなげます。"
  ogTitle="KIZUNAブリッジ for kintone｜アプリをまたぐ作業とプラグインの連携を自動化 | KIZUNA Works"
  ogDescription="保存やアクションをきっかけに、他のアプリへの書き込みや当社プラグインの処理を、ノーコードのルールで自動化。KIZUNA Works の上位版「KIZUNA Pro プラグイン」の第1弾です。予行演習・実行の記録・連携の流れつき。"
  ogType="website"
  ogUrl={PAGE_URL}
  ogImage="https://kizuna-works.jp/images/bridge-banner.png"
  canonical={PAGE_URL}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': PAGE_URL,
          url: PAGE_URL,
          name: 'KIZUNAブリッジ for kintone｜アプリをまたぐ作業とプラグインの連携を自動化 | KIZUNA Works',
          description: 'KIZUNAブリッジ for kintone は、保存やアクションをきっかけに、他のアプリへの書き込みや当社プラグインの処理（採番の当て直しを含む）をルールで自動化する kintone プラグイン（KIZUNA Pro プラグイン）。',
          dateModified: DATE_MODIFIED,
          primaryImageOfPage: { '@type': 'ImageObject', url: 'https://kizuna-works.jp/images/bridge-banner.png', width: 1200, height: 630 },
          isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: 'https://kizuna-works.jp/' },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
            { '@type': 'ListItem', position: 2, name: 'kintoneプラグイン', item: 'https://kizuna-works.jp/plugins/' },
            { '@type': 'ListItem', position: 3, name: 'KIZUNAブリッジ for kintone', item: PAGE_URL },
          ],
        },
        {
          '@type': 'SoftwareApplication',
          name: 'KIZUNAブリッジ for kintone',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'kintone',
          // Literal on purpose: scripts/check-plugin-summaries.mjs reads it as text. Keep equal to VERSION.
          "softwareVersion": "1.1.1",
          dateModified: DATE_MODIFIED,
          url: PAGE_URL,
          downloadUrl: `https://kizuna-works.jp${ZIP}`,
          image: 'https://kizuna-works.jp/images/bridge-banner.png',
          offers: [
            {
              '@type': 'Offer',
              name: PRO_SET_PLAN.name,
              price: String(PRO_SET_PLAN.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターと KIZUNA Pro 拡張パックのセット（年額）。KIZUNA Pro プラグインをすべて含みます。製品ごとの個別のご契約はありません。',
            },
            {
              '@type': 'Offer',
              name: PRO_ADDON.name,
              price: String(PRO_ADDON.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターに追加するプラン（年額）。',
            },
          ],
          description: 'KIZUNAブリッジ for kintone は、kintone のアプリをまたぐ作業と当社のプラグインの連携を、ノーコードのルールで自動化するプラグイン。画面を開いた・値を変えた・保存の前後・アクションの前後・削除の前・ボタン・ブリッジの CSV ボタンでの読み込みと書き出しの前後をきっかけに、条件（このレコードの値と変更前の値・テーブル・ステータス・操作した人と組織・端末・日付・他のアプリのレコードの有無や件数・合計）に合えば、このレコードへの値の入力・集計・行の追加と削除、エラー・確認・お知らせ、他のアプリのレコードの取得・作成・更新・ステータスの変更・双方向の同期を行う。書き込み先のアプリに入っている当社のプラグインの処理（採番・地図リンク・経過日数・文字列結合・ルックアップのコピーなど）を当てる、カレンダービューのモーダルや一括更新で保存したこのアプリのレコードへの採番などの当て直し、チャット通知、レコードロックの確認、一括更新などの実行にも対応。予行演習・実行の記録と再実行・あとから流す・連携の流れ・不在カレンダーと営業日・当社プラグインの一括更新つき。',
          publisher: { '@type': 'Organization', name: 'KIZUNA Works', url: 'https://kizuna-works.jp' },
          featureList: [
            'きっかけ：画面を開いた・値を変えた・保存の前後・アクションの前後・削除の前・ボタン・ブリッジの CSV ボタンでの読み込みと書き出しの前後',
            '条件：このレコードの値と変更前の値・テーブル・ステータスと作業者・操作した人と組織・グループ・端末・日付と曜日・他のアプリ（ある・ない・件数・合計）。「かつ」「または」の入れ子（1 段まで）',
            'このレコード：値を入れる・空にする・集計・行を足す・行を消す',
            '確認・止める：エラーで止める・確認してから進める・お知らせ',
            '他のアプリ：取ってくる・作る・変える・ステータスを進める・双方向にそろえる',
            '書き込み先のアプリの当社プラグインの処理を当てる（採番・文字列結合など）',
            '書き込み先のアプリのチャット通知・レコードロックとの連携',
            'このレコードに、採番などの当社プラグインの処理を当て直す（カレンダービューのモーダル・一括更新で保存したレコード向け）',
            'ルールから当社のプラグインの機能を実行する',
            '予行演習（書き込まずに結果を確認）',
            '実行の記録と再実行・あとから流す',
            '連携の流れ（アプリのつながりと連鎖の確認）',
            '不在カレンダーと営業日の計算',
            '当社のプラグインをまとめて最新版にする',
            'ゲストスペース対応・モバイルのレコード画面に対応',
          ],
        },
      ],
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --kbp-navy: #1B3A6B;
      --kbp-ink: #0f1f3d;
      --kbp-gold: #b8862b;
      --kbp-gold-light: #e8c766;
      --kbp-gold-soft: #f0d58a;
      --kbp-green: #2E8B2E;
      --kbp-text: #333333;
      --kbp-muted: #64748b;
    }

    /* Hero: darker than the premium hero, gold accents mark the Pro series */
    .kbp-hero {
      /* Shared KIZUNA Pro hero background; sized by width, its baked bottom fade blends into this base gradient */
      background:
        url('/images/kizuna-pro-hero-bg.webp') center top / 100% auto no-repeat,
        linear-gradient(90deg, #020816 0%, #050b1c 30%, #081427 50%, #09182f 70%, #0c1729 100%);
      color: #fff;
      padding: 60px 5% 54px;
      text-align: center;
      border-bottom: 4px solid var(--kbp-gold);
    }
    .kbp-hero-icon {
      width: 136px; height: 136px; object-fit: contain; display: block; margin: 0 auto 18px;
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(232, 199, 102, 0.5);
      border-radius: 26px; padding: 10px; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    }
    .kbp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
    .kbp-badge-pro {
      display: inline-flex; align-items: center; gap: 6px; line-height: 1;
      padding: 7px 16px; border-radius: 20px;
      background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%);
      color: #1a1405; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.08em;
    }
    .kbp-hero-version {
      padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.45);
      font-size: 0.85rem; font-weight: 700; line-height: 1;
    }
    .kbp-hero-title { font-size: clamp(1.7rem, 4.2vw, 2.6rem); margin: 0 0 12px; line-height: 1.3; }
    .kbp-tagline { font-size: clamp(1.05rem, 2.4vw, 1.35rem); font-weight: 700; margin: 0 0 14px; color: var(--kbp-gold-soft); }
    .kbp-sub { max-width: 860px; margin: 0 auto 26px; line-height: 1.9; font-size: 1rem; color: rgba(255, 255, 255, 0.92); }
    .kbp-sub strong { color: #fff; }
    .kbp-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; max-width: 900px; margin: 0 auto 28px; }
    .kbp-pillar {
      display: block; padding: 16px 14px; border-radius: 12px; text-decoration: none; color: #fff;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(232, 199, 102, 0.45);
    }
    .kbp-pillar:hover { background: rgba(255, 255, 255, 0.14); }
    .kbp-pillar-no { display: block; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--kbp-gold-soft); font-weight: 800; }
    .kbp-pillar-name { display: block; font-size: 1.05rem; font-weight: 800; margin: 4px 0; }
    .kbp-pillar-desc { display: block; font-size: 0.84rem; line-height: 1.6; color: rgba(255, 255, 255, 0.85); }
    .kbp-hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .kbp-btn {
      display: inline-block; padding: 14px 26px; border-radius: 10px; font-weight: 800; text-decoration: none;
      font-size: 1rem; line-height: 1.3;
    }
    .kbp-btn.is-primary { background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%); color: #1a1405; box-shadow: 0 6px 18px rgba(184, 134, 43, 0.35); }
    .kbp-btn.is-ghost { border: 1px solid rgba(255, 255, 255, 0.6); color: #fff; }
    .kbp-btn.is-ghost:hover { background: rgba(255, 255, 255, 0.1); }
    .kbp-hero-note { margin: 14px auto 0; font-size: 0.85rem; color: rgba(255, 255, 255, 0.75); max-width: 760px; line-height: 1.7; }

    /* Series strip */
    .kbp-series { background: #fffaf0; border-bottom: 1px solid #eadcb2; }
    .kbp-series-inner { max-width: 1100px; margin: 0 auto; padding: 20px 5%; display: flex; gap: 16px; align-items: center; }
    .kbp-series-tag {
      flex-shrink: 0; padding: 6px 12px; border-radius: 6px; font-weight: 800; font-size: 0.8rem; letter-spacing: 0.06em;
      background: var(--kbp-ink); color: var(--kbp-gold-soft);
    }
    .kbp-series p { margin: 0; line-height: 1.8; font-size: 0.95rem; color: var(--kbp-text); min-width: 0; }

    /* Sections */
    .kbp-section { padding: 64px 5%; background: #fff; }
    .kbp-section.alt { background: #F0F4F8; }
    .kbp-wrap { max-width: 1100px; margin: 0 auto; }
    .kbp-eyebrow { display: inline-block; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.12em; color: var(--kbp-gold); margin-bottom: 6px; }
    .kbp-h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); color: var(--kbp-navy); margin: 0 0 14px; line-height: 1.4; }
    .kbp-lead { margin: 0 0 34px; line-height: 1.9; color: var(--kbp-text); max-width: 900px; }
    .kbp-h3 { font-size: 1.2rem; color: var(--kbp-navy); margin: 0 0 10px; line-height: 1.5; }

    /* Part header for the three ways to use */
    .kbp-part {
      display: flex; align-items: center; gap: 16px; padding: 22px 26px; margin: 0 0 34px; border-radius: 14px;
      background: linear-gradient(120deg, var(--kbp-ink) 0%, var(--kbp-navy) 100%); color: #fff;
    }
    .kbp-part-no {
      flex-shrink: 0; width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%); color: #1a1405; font-weight: 900; font-size: 1.4rem;
    }
    .kbp-part-body { min-width: 0; }
    .kbp-part-title { margin: 0 0 4px; font-size: clamp(1.25rem, 2.8vw, 1.7rem); line-height: 1.35; }
    .kbp-part-desc { margin: 0; line-height: 1.7; color: rgba(255, 255, 255, 0.88); font-size: 0.95rem; }

    /* Feature rows: text + screenshot */
    .kbp-feature { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px; align-items: start; margin: 0 0 48px; }
    .kbp-feature[id] { scroll-margin-top: 110px; }
    .kbp-feature.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .kbp-feature.flip .kbp-feature-text { order: 2; }
    .kbp-feature-text p { margin: 0 0 12px; line-height: 1.85; color: var(--kbp-text); }
    .kbp-feature-text ul { margin: 0 0 12px; padding-left: 1.2em; line-height: 1.85; color: var(--kbp-text); }
    .kbp-feature-text li { margin-bottom: 4px; }
    .kbp-feature-text ul:not(.kbp-chips) { list-style: disc; }
    /* Full-width row under a feature, so a long text column does not leave a gap under the shot */
    .kbp-feature-wide { grid-column: 1 / -1; order: 3; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .kbp-feature-wide .kbp-example { margin: 0; }
    .kbp-shot { margin: 0; min-width: 0; }
    .kbp-shot img { width: 100%; height: auto; display: block; border-radius: 10px; border: 1px solid #dbe3ee; box-shadow: 0 6px 18px rgba(15, 31, 61, 0.1); cursor: zoom-in; background: #fff; }
    .kbp-shot figcaption { margin-top: 8px; font-size: 0.84rem; color: var(--kbp-muted); line-height: 1.6; }
    .kbp-example {
      margin: 12px 0 0; padding: 12px 14px; border-radius: 8px; background: #f4f7fb; border-left: 4px solid var(--kbp-navy);
      font-size: 0.92rem; line-height: 1.8; color: var(--kbp-text);
    }
    .kbp-example strong { color: var(--kbp-navy); }

    /* Chips for triggers / actions */
    .kbp-chips, .kbp-feature-text .kbp-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; padding: 0; list-style: none; }
    .kbp-chips li { padding: 5px 12px; border-radius: 16px; background: #eef3fa; color: var(--kbp-navy); font-size: 0.85rem; font-weight: 700; }
    .kbp-chips.gold li { background: #fbf3dc; color: #6b4a0e; }

    /* Use case cards */
    .kbp-recipes-head { font-size: 1.1rem; color: var(--kbp-navy); margin: 0 0 16px; line-height: 1.5; scroll-margin-top: 110px; }
    .kbp-recipes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .kbp-recipes-more { text-align: center; margin: 24px 0 8px; }
    .kbp-recipes-btn {
      display: inline-block; max-width: 100%; box-sizing: border-box;
      padding: 12px 26px; border-radius: 30px; border: 2px solid var(--kbp-navy);
      color: var(--kbp-navy); font-weight: 700; text-decoration: none; background: #fff;
    }
    .kbp-recipes-btn:hover { background: var(--kbp-navy); color: #fff; }

    /* Partner list */
    .kbp-partner-group { margin: 0 0 36px; }
    .kbp-partner-group > p { margin: 0 0 16px; line-height: 1.85; color: var(--kbp-text); }
    .kbp-partners { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; list-style: none; margin: 0; padding: 0; }
    .kbp-partner a {
      display: flex; gap: 14px; align-items: flex-start; padding: 16px; height: 100%; box-sizing: border-box;
      background: #fff; border: 1px solid #e3d6ae; border-radius: 12px; text-decoration: none; color: inherit;
      transition: box-shadow 0.2s ease;
    }
    .kbp-partner a:hover { box-shadow: 0 6px 18px rgba(15, 31, 61, 0.12); }
    .kbp-partner-icon { width: 48px; height: 48px; flex-shrink: 0; border-radius: 10px; object-fit: contain; background: #f4f7fb; }
    .kbp-partner-body { min-width: 0; }
    .kbp-partner-name { display: block; font-weight: 800; color: var(--kbp-navy); margin-bottom: 2px; }
    .kbp-partner-tier { display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 1px 8px; border-radius: 10px; margin-bottom: 6px; }
    .kbp-partner-tier.free { background: #e7f5e7; color: #1f5c1f; }
    .kbp-partner-tier.premium { background: #fdf4d9; color: #77590a; }
    .kbp-partner-tier.pro { background: #1B3A6B; color: #f0d58a; }
    .kbp-partner-role { display: block; font-size: 0.88rem; line-height: 1.7; color: var(--kbp-text); }

    /* Feature summary list */
    .kbp-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 28px; list-style: none; margin: 0; padding: 0; }
    .kbp-list li { position: relative; padding-left: 26px; line-height: 1.75; color: var(--kbp-text); }
    .kbp-list li::before { content: '✓'; position: absolute; left: 0; top: 0; color: var(--kbp-gold); font-weight: 900; }

    /* Plans */
    .kbp-plan-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 0 0 24px; }
    .kbp-plan { background: #fff; border: 1px solid #dbe3ee; border-radius: 14px; padding: 26px; position: relative; min-width: 0; }
    .kbp-plan.top { border: 2px solid var(--kbp-gold); box-shadow: 0 10px 30px rgba(184, 134, 43, 0.18); }
    .kbp-plan-badge {
      position: absolute; top: -13px; left: 22px; padding: 4px 12px; border-radius: 14px;
      background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%); color: #1a1405; font-size: 0.78rem; font-weight: 800;
    }
    .kbp-plan h3 { margin: 4px 0 6px; color: var(--kbp-navy); font-size: 1.2rem; }
    .kbp-plan-price { margin: 0 0 4px; }
    .kbp-plan-price .amt { font-size: 1.9rem; font-weight: 900; color: var(--kbp-ink); }
    .kbp-plan-price .unit { font-size: 0.9rem; color: var(--kbp-muted); margin-left: 4px; }
    .kbp-plan-sub { margin: 0 0 14px; font-size: 0.85rem; color: var(--kbp-muted); }
    .kbp-plan ul { margin: 0 0 18px; padding-left: 1.2em; line-height: 1.85; color: var(--kbp-text); font-size: 0.93rem; }
    .kbp-plan-cta { display: block; text-align: center; padding: 12px 16px; border-radius: 10px; background: var(--kbp-navy); color: #fff; font-weight: 800; text-decoration: none; }
    .kbp-plan.top .kbp-plan-cta { background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%); color: #1a1405; }
    .kbp-trial { margin: 0 0 18px; padding: 18px 20px; border-radius: 10px; background: #f4faf4; border: 1px solid #cfe8cf; line-height: 1.85; font-size: 0.93rem; color: var(--kbp-text); }
    .kbp-trial h3 { margin: 0 0 6px; font-size: 1.05rem; color: #1B3A6B; }
    .kbp-trial p { margin: 0 0 8px; }
    .kbp-trial ul { margin: 0 0 8px; padding-left: 1.3em; }
    .kbp-trial a { color: #2E8B2E; font-weight: 700; }
    .kbp-note { padding: 16px 18px; border-radius: 10px; background: #fffaf0; border: 1px solid #eadcb2; line-height: 1.85; font-size: 0.93rem; color: var(--kbp-text); }

    /* Install steps */
    .steps-list { list-style: none; margin: 0; padding: 0; counter-reset: step; }
    .steps-list li { display: flex; gap: 20px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid #e2e8f0; line-height: 1.8; counter-increment: step; }
    .steps-list li::before {
      content: counter(step); flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      background: var(--kbp-navy); color: #fff; font-weight: 800;
    }
    .steps-list li > span { min-width: 0; }

    /* Cautions */
    .kbp-cautions ul { margin: 0; padding-left: 1.2em; line-height: 1.9; color: var(--kbp-text); }
    .kbp-cautions li { margin-bottom: 6px; }

    /* FAQ */
    .kbp-faq { margin: 0; }
    .kbp-faq details { background: #fff; border: 1px solid #dbe3ee; border-radius: 10px; margin: 0 0 10px; }
    .kbp-faq summary { cursor: pointer; padding: 16px 18px; font-weight: 800; color: var(--kbp-navy); line-height: 1.6; }
    .kbp-faq details p { margin: 0; padding: 0 18px 16px; line-height: 1.85; color: var(--kbp-text); }

    /* Closing CTA */
    .kbp-cta { background: linear-gradient(135deg, #0b1630 0%, #1B3A6B 100%); color: #fff; text-align: center; padding: 56px 5%; border-top: 4px solid var(--kbp-gold); }
    .kbp-cta h2 { margin: 0 0 12px; font-size: clamp(1.3rem, 3vw, 1.8rem); line-height: 1.45; }
    .kbp-cta p { margin: 0 auto 22px; max-width: 760px; line-height: 1.85; color: rgba(255, 255, 255, 0.88); }

    /* Update box (latest version highlight) */
    .update-box { max-width: 980px; margin: 0 auto; background: #fff; border: 1px solid #dbe3ee; border-left: 5px solid var(--kbp-green); border-radius: 12px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); padding: 32px 32px 36px; }
    .update-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .update-tag { background-color: var(--kbp-green); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; padding: 4px 12px; border-radius: 6px; flex-shrink: 0; }
    .update-title { color: var(--kbp-navy); font-size: 20px; font-weight: 700; line-height: 1.4; margin: 0; }
    .update-desc { color: var(--kbp-text); font-size: 15px; line-height: 1.8; margin: 0 0 20px; }
    .update-desc strong { color: var(--kbp-navy); }
    .update-note { color: var(--kbp-muted); font-size: 13px; line-height: 1.7; margin: 18px 0 0; }
    .update-shot { max-width: 640px; margin: 0 auto; }
    .update-shot .zoom-hint { text-align: center; color: var(--kbp-muted); font-size: 12px; margin: 10px 0 0; }

    /* Lightbox */
    .lightbox { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.85); display: none; align-items: center; justify-content: center; z-index: 10000; padding: 24px; cursor: zoom-out; }
    .lightbox.is-open { display: flex; }
    .lightbox img { max-width: 96vw; max-height: 92vh; width: auto; height: auto; border-radius: 8px; box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5); }
    .lightbox-close { position: absolute; top: 16px; right: 20px; background: none; border: none; color: #fff; font-size: 2rem; cursor: pointer; }

    @media (max-width: 860px) {
      .kbp-feature, .kbp-feature.flip { grid-template-columns: minmax(0, 1fr); gap: 18px; }
      .kbp-feature.flip .kbp-feature-text { order: 0; }
      .kbp-feature-wide { grid-template-columns: minmax(0, 1fr); }
      .kbp-recipes { grid-template-columns: minmax(0, 1fr); }
      .kbp-partners, .kbp-list, .kbp-plan-grid { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 640px) {
      .update-box { padding: 24px 20px 28px; }
      .update-title { font-size: 17px; }
      .kbp-pillars { grid-template-columns: minmax(0, 1fr); }
      .kbp-section { padding: 48px 5%; }
      .kbp-part { padding: 18px; gap: 12px; }
      .kbp-part-no { width: 44px; height: 44px; font-size: 1.1rem; }
      .kbp-series-inner { flex-direction: column; align-items: flex-start; }
      .kbp-btn { width: 100%; box-sizing: border-box; text-align: center; }
    }
  </style>

  <main>
    <!-- Hero -->
    <section class="kbp-hero">
      <img class="kbp-hero-icon" src="/images/bridge-icon.png" alt="KIZUNAブリッジ for kintone アイコン" width="200" height="200" loading="eager" />
      <div class="kbp-hero-badges">
        <span class="kbp-badge-pro">KIZUNA Pro PLUGIN</span>
        <span class="kbp-hero-version">v{VERSION}</span>
      </div>
      <h1 class="kbp-hero-title">KIZUNAブリッジ for kintone</h1>
      <p class="kbp-tagline">アプリをまたぐ作業も、プラグインの連携も、自動化。</p>
      <p class="kbp-sub">KIZUNAブリッジ for kintone は、<strong>保存やアクションをきっかけに、他のアプリのレコードを作る・変える・ステータスを進める</strong>処理を、ノーコードのルールで自動化する kintone プラグインです。当社のプラグインとも連携し、<strong>書き込み先での採番や通知、一括更新の実行</strong>までつなげられます。パソコンでカレンダービューのモーダルや一括更新から保存したレコードにも、<strong>採番などの処理を当て直せます</strong>。さらに、担当者の不在や会社の休みを踏まえて日付を計算する<strong>不在カレンダー</strong>と、当社のプラグインをまとめて最新版にする<strong>プラグインの一括更新</strong>も備えます。KIZUNA Works の上位版「KIZUNA Pro プラグイン」の第1弾です。</p>
      <div class="kbp-pillars">
        <a class="kbp-pillar" href="#single"><span class="kbp-pillar-no">PART 1</span><span class="kbp-pillar-name">このアプリの中で</span><span class="kbp-pillar-desc">きっかけ・条件・動作のルールで、入力・確認・集計を自動に</span></a>
        <a class="kbp-pillar" href="#apps"><span class="kbp-pillar-no">PART 2</span><span class="kbp-pillar-name">アプリ間連携</span><span class="kbp-pillar-desc">他のアプリへの取得・作成・更新・ステータス・双方向の同期</span></a>
        <a class="kbp-pillar" href="#plugins"><span class="kbp-pillar-no">PART 3</span><span class="kbp-pillar-name">プラグイン間連携</span><span class="kbp-pillar-desc">当社の {partnerCount} 製品と組み合わせて、書き込み先でも同じ処理を</span></a>
      </div>
      <div class="kbp-hero-cta">
        <a class="kbp-btn is-primary" href="#plan">プランと料金を見る →</a>
        <a class="kbp-btn is-ghost js-dl" href={ZIP} download>プラグインをダウンロード</a>
        <a class="kbp-btn is-ghost" href="/plugins/premium-trial/">30日間無料で試す</a>
      </div>
      <p class="kbp-hero-note">ご利用には、プレミアム年間サポーターと KIZUNA Pro 拡張パックのご契約が必要です。ご契約が確認できるまで、設定画面にはご契約の案内だけが表示されます。<strong>30日間無料で試せます</strong>（未契約の方はプレミアムの無料体験に含まれます。プレミアム契約中の方は拡張パックだけを試せます）。</p>
    </section>

    <!-- Update Info (v1.1.1) -->
    <section class="kbp-section">
      <div class="update-box">
        <div class="update-head">
          <span class="update-tag">UPDATE</span>
          <h2 class="update-title">v1.1.1：続けてステータスを進めたときも、他のアプリへステータスを書き写すように直しました</h2>
        </div>
        <p class="update-desc">きっかけ「アクションを実行した後」のルールで、このレコードのステータスを他のアプリのフィールドへ書き写す場合に、2 回目以降のステータスの変更が書き写されないことがありました。たとえば「未処理」から「処理中」に進めると書き写し先は「処理中」になりますが、続けて「完了」に進めても、書き写し先が「処理中」のまま変わりませんでした。</p>
        <p class="update-desc">v1.1.1 では、<strong>ステータスを進めるたびに、進んだ後のステータスが書き写される</strong>ようにしました。</p>
        <p class="update-note">既存ユーザーの方は、最新版（v1.1.1）をダウンロードして kintone のシステム管理 → プラグインから上書きアップロードするだけで適用できます。アプリに保存済みのルールはそのまま引き継がれます。</p>
      </div>
    </section>

    <!-- Series -->
    <div class="kbp-series">
      <div class="kbp-series-inner">
        <span class="kbp-series-tag">KIZUNA Pro とは</span>
        <p>ちょこっとプラグイン・プレミアムプラグインの上にある、KIZUNA Works の上位版のプラグインのシリーズです。<strong>KIZUNA Pro 拡張パック</strong>で、KIZUNAブリッジをはじめ、今後リリースされる KIZUNA Pro プラグインもすべてお使いいただけます。</p>
      </div>
    </div>

    <!-- Problem -->
    <section class="kbp-section">
      <div class="kbp-wrap">
        <span class="kbp-eyebrow">PROBLEM</span>
        <h2 class="kbp-h2">アプリをまたぐ処理を、手で転記していませんか</h2>
        <p class="kbp-lead">kintone は業務ごとにアプリを分けて作れるのが強みですが、アプリをまたぐ処理は標準の機能ではほとんど自動にできません。「受注を保存したら在庫を減らす」「案件が完了したら請求のレコードを作る」といった処理を、手作業の転記や、アプリごとに書いた JavaScript のカスタマイズに頼ると、条件や担当が変わるたびに直す手間がかかります。KIZUNAブリッジは、こうした処理を<strong>設定画面のルール</strong>に置き換えます。</p>
        <h3 class="kbp-recipes-head" id="recipes">使い方の例：今の作業が、どんなルールで、どう変わるか</h3>
        <div class="kbp-recipes">
          {featuredBridgeRecipes.map((r) => <BridgeRecipeCard recipe={r} />)}
        </div>
        <div class="kbp-recipes-more">
          <a class="kbp-recipes-btn" href="/plugins/bridge/recipes/">ほかの使い方の例も見る（全{bridgeRecipes.length}件）→</a>
        </div>
      </div>
    </section>

    <!-- PART 1 -->
    <section class="kbp-section alt" id="single">
      <div class="kbp-wrap">
        <div class="kbp-part">
          <span class="kbp-part-no">1</span>
          <div class="kbp-part-body">
            <h2 class="kbp-part-title">ブリッジだけでできること</h2>
            <p class="kbp-part-desc">ブリッジを入れたアプリの中で、入力・確認・集計を自動にします。ルールは「きっかけ」「条件」「動作」の3つを選んで作ります。</p>
          </div>
        </div>

        <div class="kbp-feature">
          <div class="kbp-feature-text">
            <h3 class="kbp-h3">ルールは、きっかけ・条件・動作を選ぶだけ</h3>
            <p>コードは書きません。設定画面で、いつ（きっかけ）、どんなときに（条件）、何をするか（動作）を選んでルールを作ります。</p>
            <ul class="kbp-chips">
              <li>画面を開いた</li><li>値を変えた</li><li>保存の前・後</li><li>アクションの前・後</li><li>削除の前</li><li>ボタン</li><li>CSV の読み込み・書き出し（ブリッジのボタン）</li>
            </ul>
            <p>条件には、このレコードの値と<strong>変更前の値</strong>、テーブル、ステータスと作業者、操作した人と組織・グループ、端末、日付・曜日などを使えます。「かつ」「または」を入れ子にして組み合わせられます（入れ子は 1 段まで）。</p>
            <p>CSV のきっかけは、一覧の上に出すブリッジの［CSV を読み込む］［CSV を書き出す］のボタン（パソコン）を使ったときに動きます。kintone 標準のファイルの読み込み・書き出しでは動きません。</p>
          </div>
          <figure class="kbp-shot">
            <Picture src="/images/bridge-config-rule-01.png" alt="KIZUNAブリッジの設定画面のルールタブ。左に設定したルールの目次、中央にきっかけ・条件・動作を選んで作るルールの編集欄が表示されている" width="1400" height="1250" class="zoomable" />
            <figcaption>設定画面の［ルール］タブ。左の目次でルールを選び、中央で編集します。</figcaption>
          </figure>
        </div>

        <div class="kbp-feature flip">
          <div class="kbp-feature-text">
            <h3 class="kbp-h3">このレコードへの入力と、保存前の確認</h3>
            <ul class="kbp-chips gold">
              <li>値を入れる</li><li>空にする</li><li>集計</li><li>行を足す</li><li>行を消す</li><li>エラーで止める</li><li>確認してから進める</li><li>お知らせ</li>
            </ul>
            <p>条件に合えば値を入れる、テーブルの合計を出す、といった入力の自動化に加えて、<strong>条件に合わない保存やアクションを止める</strong>・<strong>確認してから進める</strong>こともできます。</p>
            <p class="kbp-example"><strong>例：</strong>金額が 100 万円を超える見積を「承認依頼」に進めるときだけ、確認の画面を出す。</p>
          </div>
          <figure class="kbp-shot">
            <Picture src="/images/bridge-record-confirm-01.png" alt="kintone のレコード画面で、ブリッジのルールによる確認の画面が表示されている。条件に合ったことと、このまま進めるかを選ぶボタンがある" width="900" height="545" class="zoomable" />
            <figcaption>ルールの動作［確認してから進める］の画面。［キャンセル］を押すと保存やアクションを止めます。</figcaption>
          </figure>
        </div>

        <div class="kbp-feature">
          <div class="kbp-feature-text">
            <h3 class="kbp-h3">予行演習で、書き込む前に結果を確かめる</h3>
            <p>今あるレコードを選んで、<strong>どのルールが動き、何をどこへ書くか</strong>を、実際には書き込まずに確かめられます。条件のどこで外れたかも表示するので、設定の見直しが早くなります。</p>
          </div>
          <figure class="kbp-shot">
            <Picture src="/images/bridge-config-dryrun-01.png" alt="設定画面の予行演習の結果。選んだレコードで動くルール、条件の判定、書き込む予定の値が一覧で表示されている" width="1400" height="485" class="zoomable" />
            <figcaption>予行演習の結果。書き込む予定の値と、条件の判定を確かめられます。</figcaption>
          </figure>
        </div>

        <div class="kbp-feature flip">
          <div class="kbp-feature-text">
            <h3 class="kbp-h3">実行の記録と再実行・あとから流す</h3>
            <p>他のアプリへ書き込めなかったものは<strong>実行の記録</strong>に残ります（数値を足す・引く処理は、二重に当てないよう、成功したものも残します。記録には保管アプリが要ります）。権限や入力の不足で書き込めなかったものは、原因を直してから記録から再実行できます。</p>
            <p>kintone 標準の CSV の読み込みなど、画面を通らずに入ったレコードには、<strong>あとから流す</strong>でルールをまとめて当てられます。ただし、CSV を読み込む前・書き出す前のきっかけのルールと、動かす内容に［プラグインの処理を当てる（採番など）］［レコードにプラグインの処理をかけ直す］［プラグインの機能を実行する］を含むルールは流せません。</p>
          </div>
          <figure class="kbp-shot">
            <Picture src="/images/bridge-config-log-01.png" alt="設定画面の実行の記録タブ。記録した日時・レコード・結果が並び、失敗したものに再実行のボタンがある" width="1400" height="1010" class="zoomable" />
            <figcaption>［実行の記録］タブ。失敗したものだけを選んで再実行できます。</figcaption>
          </figure>
        </div>

        <div class="kbp-feature">
          <div class="kbp-feature-text">
            <h3 class="kbp-h3">不在カレンダーと営業日</h3>
            <p>休暇や出張の予定を<strong>不在カレンダー</strong>に登録しておくと、レコードの詳細画面で担当者の不在を知らせたり、アクションの前に「次の作業者は不在です」と確かめたりできます（プロセス管理を使っているアプリで使えます）。ルールの式では、土日と全社の休業日を除いた<strong>営業日</strong>で期日を数えられます（組織・グループごとの休みは、営業日の計算には使いません）。</p>
          </div>
          <figure class="kbp-shot">
            <Picture src="/images/bridge-config-absence-01.png" alt="設定画面の不在・在席タブ。不在カレンダーの作成と、詳細画面での知らせ方・アクション前の確認の設定が表示されている" width="1400" height="1010" class="zoomable" />
            <figcaption>［不在・在席］タブ。不在カレンダーのアプリは設定画面から作れます。</figcaption>
          </figure>
        </div>

        <div class="kbp-feature flip" id="plugin-update">
          <div class="kbp-feature-text">
            <h3 class="kbp-h3">当社のプラグインを、まとめて最新版に</h3>
            <p>kintone のプラグインは自動では更新されません。［プラグインの更新］タブで、この kintone に読み込まれている KIZUNA Works のプラグインの版を一覧で確かめ、<strong>選んだものをまとめて最新版に上書き</strong>できます（kintone システム管理者のみ）。プラグインの設定はそのまま残ります。</p>
            <ul class="kbp-chips gold">
              <li>1 本あたり約 3 秒</li>
              <li>新しい版には最初からチェック</li>
              <li>プラグインの設定はそのまま</li>
            </ul>
            <ul>
              <li>入っているバージョンと最新版が並ぶので、<strong>どれが古いかがひと目で分かります</strong>。</li>
              <li>選んで［選んだ ○ 本を最新版に更新する］を押すだけ。<strong>ZIP のダウンロードも、1 本ずつの読み込みも要りません</strong>。</li>
              <li>上書きすると、そのプラグインを使っている<strong>すべてのアプリにすぐ反映</strong>されます。アプリの更新は要りません。</li>
            </ul>
          </div>
          <figure class="kbp-shot">
            <Picture src="/images/bridge-config-update-01.png" alt="設定画面のプラグインの更新タブ。当社のプラグインごとに入っているバージョンと最新版が並び、新しいバージョンがあるものにチェックが付いている" width="1400" height="1010" class="zoomable" />
            <figcaption>［プラグインの更新］タブ。新しいバージョンがあるものには最初からチェックが付きます。</figcaption>
          </figure>
          <div class="kbp-feature-wide">
            <p class="kbp-example"><strong>たとえば 10 本を更新するとき：</strong>製品ページから ZIP をダウンロードして 1 本ずつ読み込む手間がかかりません。［プラグインの更新］タブなら 1 本あたり約 3 秒、10 本で約 30 秒です。</p>
            <p class="kbp-example">更新するかどうかは管理者が選びます（勝手には更新しません）。更新が出たことに気づくには、無料の Chrome 拡張機能 <a href="/extensions/kw-plugin-updater-for-kintone/">KW Plugin Updater for kintone</a> と組み合わせるのがおすすめです。手作業との比べ方は<a href="/plugins/update/#bulk">プラグインの更新方法</a>にもまとめています。</p>
          </div>
        </div>
      </div>
    </section>

