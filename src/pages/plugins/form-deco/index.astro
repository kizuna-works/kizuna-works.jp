---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="FormDeco for kintone - 罫線・スペース装飾 無料プラグイン | KIZUNA Works"
  description="kintoneレコード詳細画面の罫線（区切り線）スタイルとスペースフィールドの装飾（背景色・テキスト・画像）をノーコード設定できる無料プラグイン。フォームの見た目を整えて視認性アップ。完全無料のkintoneプラグイン、kintone プラグイン 無料配布中。"
  ogTitle="FormDeco for kintone - 罫線・スペース装飾 無料プラグイン | KIZUNA Works"
  ogDescription="kintoneレコード詳細画面の罫線（区切り線）スタイルとスペースフィールドの装飾（背景色・テキスト・画像）をノーコード設定できる無料プラグイン。フォームの見た目を整えて視認性アップ。完全無料のkintoneプラグイン、kintone プラグイン 無料配布中。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/form-deco/"
  ogImage="https://kizuna-works.jp/images/form-deco-banner.png"
  canonical="https://kizuna-works.jp/plugins/form-deco/"
>
