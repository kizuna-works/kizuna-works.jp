---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { plugins, premiumPlugins } from '../../../data/plugins';
import { PREMIUM_PLAN, PRO_SET_PLAN, PRO_ADDON, yen } from '../../../data/pricing';
import HeroSubBadges from '../../../components/HeroSubBadges.astro';
import RequestOriginBadge from '../../../components/RequestOriginBadge.astro';

const VERSION = '1.1.0';
const ZIP = `/downloads/kw-design-pro-v${VERSION}.zip`;
const PAGE_URL = 'https://kizuna-works.jp/plugins/design-pro/';
const DATE_MODIFIED = '2026-11-04';

// The six single products this one bundles. Cards are built from plugins.ts so names and slugs never drift.
const singleOf = (id: string) => {
  const p = [...plugins, ...premiumPlugins].find((x) => x.id === id);
  if (!p) throw new Error(`design-pro: plugin "${id}" not found in plugins.ts`);
  return p;
};
const iconOf = (slug: string) => `/images/${slug}-icon.png`;
const BUNDLED = [
  { id: 'kw-field-styler', role: 'フィールドスタイラー' },
  { id: 'kw-form-deco', role: 'FormDeco' },
  { id: 'kw-theme-styler', role: 'テーマスタイラー' },
  { id: 'kw-comment-control', role: 'コメントコントロール' },
  { id: 'kw-user-autofill', role: 'ユーザーオートフィル' },
  { id: 'kw-report-designer', role: '帳票デザイナー' },
];
const bundled = BUNDLED.map((b) => ({ ...b, p: singleOf(b.id) }));

// FAQ: the accordion and FAQPage JSON-LD are built from the same array so they always match.
const faqs: { q: string; a: string }[] = [
  {
    q: 'デザイン Pro だけを購入できますか？',
    a: `製品ごとの個別のご契約はありません。プレミアム年間サポーターに KIZUNA Pro 拡張パックを追加すると、デザイン Pro を含む KIZUNA Pro プラグインをすべてお使いいただけます。両方をまとめた「KIZUNA Pro 年間サポーター」（税込 ${yen(PRO_SET_PLAN.priceInTax)}/年）もあります。`,
  },
  {
    q: '年間サポーター（ちょこっとプラグインすべて）に、KIZUNA Pro 拡張パックを追加できますか？',
    a: 'できません。KIZUNA Pro 拡張パックは、プレミアム年間サポーターに追加していただくプランです。年間サポーターからは、KIZUNA Pro 年間サポーターへの切り替えでお使いいただけます。',
  },
  {
    q: 'フィールドスタイラーなどの単品のプラグインと、何が違いますか？',
    a: '6つの機能（フィールドスタイラー・FormDeco・テーマスタイラー・コメントコントロール・ユーザーオートフィル・帳票デザイナー）は、もとのプラグインと同じ内容です。デザイン Pro では、それらを1つの設定画面で扱えます。そのうえで、見せる項目を切り替える「表示パターン」、［印刷 ▼］で選ぶ印刷パターン、印刷プレビュー上の仕上げ、一覧からのまとめ印刷、PDF の添付保存が加わります。',
  },
  {
    q: '同じアプリに、もとのプラグインが入っていても大丈夫ですか？',
    a: '大丈夫です。もとのプラグインが有効で、設定が済んでいる機能は、もとのプラグインに任せ、デザイン Pro では動かしません（二重に動くのを防ぐためです）。ほかの機能は、デザイン Pro が動かします。もとのプラグインを外すか、無効にすると、デザイン Pro がその機能を動かします。',
  },
  {
    q: 'これまでのプラグインで作った設定を、デザイン Pro に引き継げますか？',
    a: '引き継げます。もとのプラグインが入っているアプリでデザイン Pro の設定画面を開くと、該当の機能の設定欄に［単品の設定を読み込む］が出ます。押して確認で OK を押すと、設定が読み込まれます。読み込みは手動で、もとのプラグインの設定はそのまま残ります。内容を確かめて保存し、もとのプラグインをアプリから外してください。帳票デザイナーを使っているアプリでは、1件用のテンプレートを「帳票テンプレート」の印刷パターンとして取り込めます。',
  },
  {
    q: '「表示パターン」では、何ができますか？',
    a: '「お客様提示用」「社内確認用」のように、見せる項目の組み合わせに名前を付けて登録し、レコード画面のボタンで切り替えます。詳細・編集・新規作成の画面で使え、パソコンとスマートフォンの両方に対応します。最初に開くパターンは、押したボタン、ステータス（作業者のとき別のパターンにもできます）、フィールドの値の条件、ユーザー・組織・グループ、既定のパターンの順に決まります。ボタンは、ユーザー・組織・グループで絞って表示することもできます。',
  },
  {
    q: '表示パターンで隠した項目は、見られなくなりますか？',
    a: 'いいえ。表示パターンは画面の見せ方を切り替える機能で、アクセス権ではありません。隠した項目も、［すべて］のボタン、CSV、API などでは見られます。見せたくない値の制御には、kintone のアクセス権をお使いください。',
  },
  {
    q: '［印刷 ▼］では、何を選べますか？',
    a: '印刷パターンを選びます。種類は3つです。「見たまま」は、いまの表示パターンの見た目に近い形で、フォームから自動で配置します。「仕上げたレイアウト」は、見たままの配置を印刷プレビュー上で整えたものです。「帳票テンプレート」は、帳票デザイナーで作ったテンプレートです。印刷パターンが1つだけのときは、メニューを出さずに印刷プレビューへ進みます。表示パターンやステータスごとに、出す印刷パターンを絞ることもできます。',
  },
  {
    q: '印刷プレビュー上の「仕上げ」は、誰でもできますか？',
    a: 'アプリの管理者だけが、［仕上げる］から設定できます。仕上げた内容は、専用の保管アプリに保存し、管理者でない方が印刷するときも、そのとおりに印刷されます。保管アプリは、設定画面の［保管アプリを新しく作る］で、このアプリと同じスペースに作れます。パソコンのみです。',
  },
  {
    q: 'kintone のフォームのレイアウトは変わりますか？',
    a: '変わりません。仕上げで動かすのは「印刷される位置」だけで、アプリのフォームには触れません。フォームに項目を足したときは、仕上げの一覧に「新」の印で出て、既定の位置で印刷に加わります。',
  },
  {
    q: '一覧から、まとめて印刷できますか？',
    a: 'できます。一覧の［まとめて印刷］で、いまの絞り込みの結果を、選んだ印刷パターンで印刷します。ステータスごとに印刷パターンを変える「ステータスに合わせる」も選べます。件数の上限は設定で決められ（既定は100件・最大300件）、超えるときは確認が出ます。パソコンのみです。',
  },
  {
    q: 'PDF を作って添付ファイルに保存できますか？',
    a: 'できます。印刷パターンごとに、保存先の添付ファイル欄と、上書き・追加を決めます。印刷プレビューのボタンが［PDF を保存して印刷］になり、保存してから印刷します。保存される PDF は、印刷内容を画像にして作るため、文字の検索やコピーはできず、容量はやや大きくなります。PDF の部品（pdf-lib・html2canvas）は当社サイトから読み込みますが、レコードの値は送りません。',
  },
  {
    q: 'KIZUNAブリッジから使えますか？',
    a: '使えます。KIZUNAブリッジのルールの動作［プラグインの機能を実行する］から、PDF の作成（添付ファイルへの保存）と、実行した本人の押印を呼び出せます。たとえば「承認」のアクションをきっかけに、承認した方の印を押し、控えの PDF を保存できます。',
  },
  {
    q: '無料で試せますか？',
    a: 'はい、30日間無料で試せます（カード登録不要・自動課金なし・1ドメインにつき1回まで。新しい KIZUNA Pro プラグインが出たときは、もう一度お試しいただけます）。プレミアム年間サポーターを未契約の方は、プレミアム年間サポーターの無料体験に KIZUNA Pro プラグインが含まれます。プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを30日間無料でお試しいただけます。体験が終わると機能は止まりますが、設定は消えません。',
  },
  {
    q: 'ご契約が切れたら、設定はどうなりますか？',
    a: '設定は消えません。ご契約が確認できない間は、機能は動かず、設定画面にはご契約の案内だけが出ます。ご契約が戻れば、保存済みの設定のまま、すぐに動きます。',
  },
  {
    q: 'スマートフォンでも使えますか？',
    a: '表示パターンの切り替えは使えます。印刷・印刷プレビュー上の仕上げ・まとめ印刷は、パソコンのみです。そのほかの機能と設定画面は、もとのプラグインと同じです。',
  },
  {
    q: 'ゲストスペースのアプリでも使えますか？',
    a: '使えます。ただし、ゲストスペースでは組織・グループの所属を取得できないため、表示パターンの条件では、ユーザーを指定した条件だけが働きます。',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  heroBg="/images/kizuna-pro-hero-bg.webp"
  title="デザイン Pro for kintone｜画面の見せ方も、印刷も、ひとつに | KIZUNA Works"
  description="デザイン Pro for kintone は、フィールドスタイラー・FormDeco・テーマスタイラー・コメントコントロール・ユーザーオートフィル・帳票デザイナーの6つを1つにまとめた KIZUNA Pro プラグイン。見せる項目を切り替える表示パターン、［印刷 ▼］で選ぶ印刷パターン、印刷プレビュー上の仕上げ、一覧からのまとめ印刷、PDF の添付保存に対応。使う機能を機能ごとに選べ、日本語・英語・中国語（簡体字）の表示にも対応します。"
  ogTitle="デザイン Pro for kintone｜画面の見せ方も、印刷も、ひとつに | KIZUNA Works"
  ogDescription="装飾・配色・承認印・帳票の6つのプラグインを1つに統合。表示パターンの切り替え、［印刷 ▼］で選ぶ印刷パターン、印刷プレビュー上の仕上げ、まとめ印刷、PDF の添付保存に対応する KIZUNA Pro プラグインです。"
  ogType="website"
  ogUrl={PAGE_URL}
  ogImage="https://kizuna-works.jp/images/design-pro-banner.png"
  canonical={PAGE_URL}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': PAGE_URL,
          url: PAGE_URL,
          name: 'デザイン Pro for kintone｜画面の見せ方も、印刷も、ひとつに | KIZUNA Works',
          description: 'デザイン Pro for kintone は、kintone の画面の装飾・配色・承認印・帳票の6つの機能を1つのプラグインにまとめ、見せる項目を切り替える表示パターン、印刷パターン、印刷プレビュー上の仕上げ、まとめ印刷、PDF の添付保存もできる kintone プラグイン（KIZUNA Pro プラグイン）。',
          dateModified: DATE_MODIFIED,
          primaryImageOfPage: { '@type': 'ImageObject', url: 'https://kizuna-works.jp/images/design-pro-banner.png', width: 1200, height: 630 },
          isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: 'https://kizuna-works.jp/' },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
            { '@type': 'ListItem', position: 2, name: 'kintoneプラグイン', item: 'https://kizuna-works.jp/plugins/' },
            { '@type': 'ListItem', position: 3, name: 'デザイン Pro for kintone', item: PAGE_URL },
          ],
        },
        {
          '@type': 'SoftwareApplication',
          name: 'デザイン Pro for kintone',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'kintone',
          // Literal on purpose: scripts/check-plugin-summaries.mjs reads it as text. Keep equal to VERSION.
          "softwareVersion": "1.1.0",
          dateModified: DATE_MODIFIED,
          url: PAGE_URL,
          downloadUrl: `https://kizuna-works.jp${ZIP}`,
          image: 'https://kizuna-works.jp/images/design-pro-banner.png',
          offers: [
            {
              '@type': 'Offer',
              name: PRO_SET_PLAN.name,
              price: String(PRO_SET_PLAN.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターと KIZUNA Pro 拡張パックのセット（年額）。KIZUNA Pro プラグインをすべて含みます。製品ごとの個別のご契約はありません。',
            },
            {
              '@type': 'Offer',
              name: PRO_ADDON.name,
              price: String(PRO_ADDON.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターに追加するプラン（年額）。',
            },
          ],
          description: 'デザイン Pro for kintone は、kintone のフィールドスタイラー・FormDeco・テーマスタイラー・コメントコントロール・ユーザーオートフィル・帳票デザイナーの6つの機能を1つの設定画面で使えるプラグイン。詳細・編集・新規で見せる項目をボタンで切り替える「表示パターン」（パソコン・スマートフォン）、詳細画面の［印刷 ▼］で選ぶ印刷パターン（見たまま・仕上げたレイアウト・帳票テンプレート）、印刷プレビュー上で項目の位置・幅・文字の大きさ・改ページを整える「仕上げ」、一覧からのまとめ印刷、PDF を作って添付ファイルに保存する機能に対応。KIZUNAブリッジのルールから、PDF の作成と本人の押印を実行できる。同じアプリにもとのプラグインが有効で設定済みのときは、その機能はもとのプラグインが動く。もとのプラグインの設定は［単品の設定を読み込む］で引き継げる。',
          publisher: { '@type': 'Organization', name: 'KIZUNA Works', url: 'https://kizuna-works.jp' },
          featureList: [
            'フィールドスタイラー：フィールドの背景色・文字色・フォント・太字・サイズ・条件付きスタイル（今月・先月・来月の判定を含む）・リンク欄の値の装飾・文字数制限・入力文字種制限・コピー・プレースホルダー',
            'FormDeco：罫線の見た目、スペースへの見出し・画像・吹き出し・リンク、折りたたみ、固定表示、スペースの前での改ページ',
            'テーマスタイラー：アプリのテーマ色の一括適用、アプリ名の帯のリンクボタン',
            'コメントコントロール：コメント欄の開き方、一覧のコメント件数の色分け・ホバーで全文表示',
            'ユーザーオートフィル：ユーザー属性の転記、プロフィールカード、捺印',
            '帳票デザイナー：PDF や白紙の用紙に項目を配置したテンプレート、1件・まとめての印刷、PDF の添付保存、テンプレートを見られる人の指定',
            '表示パターン：詳細・編集・新規で見せる項目をボタンで切り替える。最初に開くパターンを、ステータス・値の条件・ユーザー・組織・グループで決められる（アクセス権ではない）',
            '印刷パターン：詳細画面の［印刷 ▼］で、見たまま・仕上げたレイアウト・帳票テンプレートから選んで印刷プレビューへ進む',
            '印刷プレビュー上の仕上げ：項目の位置・幅・文字の大きさ・改ページを、印刷される位置として整える（アプリの管理者のみ）',
            'まとめ印刷：一覧の絞り込みの結果を、選んだ印刷パターン（またはステータスに合った印刷パターン）で印刷',
            'PDF の添付保存：印刷パターンごとに、PDF を作って添付ファイル欄に上書きまたは追加で保存',
            'KIZUNAブリッジの受け口：ブリッジのルールから、PDF の作成（添付ファイルへの保存）と本人の押印を実行',
            '印刷で色を出す・装飾ごとに「画面のみ／印刷のみ／両方」を選ぶ',
            '共通カラーパレット：色を選ぶ欄に、マイカラーと最近使った色を表示',
            '多言語：kintone のユーザーの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示。管理者が入力する文字も言語ごとに入力できる',
            '使う機能の選択：設定画面で、機能ごとにオン・オフを選ぶ。オフの機能は何も出さない（保存済みの設定は残る）',
            '単品のプラグインを無効にしただけでも、その機能を動かす（単品に任せるのは、単品が有効で設定済みのときだけ）',
            'ゲストスペースのアプリに対応',
          ],
        },
      ],
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --kbp-navy: #1B3A6B;
      --kbp-ink: #0f1f3d;
      --kbp-gold: #b8862b;
      --kbp-gold-light: #e8c766;
      --kbp-gold-soft: #f0d58a;
      --kbp-green: #2E8B2E;
      --kbp-text: #333333;
      --kbp-muted: #64748b;
    }

    /* Hero: darker than the premium hero, gold accents mark the Pro series */
    .kbp-hero {
      /* Shared KIZUNA Pro hero background; sized by width, its baked bottom fade blends into this base gradient */
      background:
        url('/images/kizuna-pro-hero-bg.webp') center top / 100% auto no-repeat,
        linear-gradient(90deg, #020816 0%, #050b1c 30%, #081427 50%, #09182f 70%, #0c1729 100%);
      color: #fff;
      padding: 60px 5% 54px;
      text-align: center;
      border-bottom: 4px solid var(--kbp-gold);
    }
    .kbp-hero-icon {
      width: 136px; height: 136px; object-fit: contain; display: block; margin: 0 auto 18px;
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(232, 199, 102, 0.5);
      border-radius: 26px; padding: 10px; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    }
    .kbp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
    .kbp-badge-pro {
      display: inline-flex; align-items: center; gap: 6px; line-height: 1;
      padding: 7px 16px; border-radius: 20px;
      background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%);
      color: #1a1405; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.08em;
    }
    .kbp-hero-version {
      padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.45);
      font-size: 0.85rem; font-weight: 700; line-height: 1;
    }
    .kbp-hero-title { font-size: clamp(1.7rem, 4.2vw, 2.6rem); margin: 0 0 12px; line-height: 1.3; }
    .kbp-tagline { font-size: clamp(1.05rem, 2.4vw, 1.35rem); font-weight: 700; margin: 0 0 14px; color: var(--kbp-gold-soft); }
    .kbp-sub { max-width: 860px; margin: 0 auto 26px; line-height: 1.9; font-size: 1rem; color: rgba(255, 255, 255, 0.92); }
    .kbp-sub strong { color: #fff; }
    .kbp-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; max-width: 900px; margin: 0 auto 28px; }
    .kbp-pillar {
      display: block; padding: 16px 14px; border-radius: 12px; text-decoration: none; color: #fff;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(232, 199, 102, 0.45);
    }
    .kbp-pillar:hover { background: rgba(255, 255, 255, 0.14); }
    .kbp-pillar-no { display: block; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--kbp-gold-soft); font-weight: 800; }
    .kbp-pillar-name { display: block; font-size: 1.05rem; font-weight: 800; margin: 4px 0; }
