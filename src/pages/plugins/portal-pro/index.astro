const shotOk = (k: string) => fs.existsSync(path.join(process.cwd(), 'public', 'images', SHOTS[k].file));
const shotClass = (k: string, extra = '') => `kbp-feature ${extra}${shotOk(k) ? '' : ' noshot'}`.trim();

