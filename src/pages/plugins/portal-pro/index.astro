---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { PREMIUM_PLAN, PRO_SET_PLAN, PRO_ADDON, yen } from '../../../data/pricing';
import HeroSubBadges from '../../../components/HeroSubBadges.astro';

const VERSION = '1.0.0';
const ZIP = `/downloads/kw-portal-pro-v${VERSION}.zip`;
const PAGE_URL = 'https://kizuna-works.jp/plugins/portal-pro/';
const DATE_MODIFIED = '2026-11-16';

// Screenshots are added later. A figure is drawn only when its file exists in public/images,
// so the page never shows a broken image while the shots are still being taken.
const SHOTS: Record<string, { file: string; alt: string; width: number; height: number; caption: string }> = {
