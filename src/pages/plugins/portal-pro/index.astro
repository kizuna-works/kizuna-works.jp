    </section>

    <!-- Security -->
    <section class="kbp-section alt">
      <div class="kbp-wrap">
        <SecurityBox pluginId="kw-portal-pro" />
        <ShareButtons title="ポータル Pro for kintone" />
      </div>
    </section>

    <!-- CTA -->
    <section class="kbp-cta">
      <h2>開いた人の"今日"が並び、そのまま仕事が始められるポータルを。</h2>
      <p>ポータル Pro は、KIZUNA Pro プラグインです。{PRO_SET_PLAN.name}（税込 {yen(PRO_SET_PLAN.priceInTax)}/年）、またはプレミアム年間サポーターへの KIZUNA Pro 拡張パックの追加でお使いいただけます。</p>
      <a class="kbp-btn is-primary" href="/plugins/supporter/?plan=pro_set">{PRO_SET_PLAN.name}を見る →</a>
    </section>

    <div class="lightbox" id="kbp-lightbox" aria-hidden="true">
      <button class="lightbox-close" type="button" aria-label="閉じる">×</button>
      <img src="" alt="拡大画像" />
    </div>
  </main>

  <script is:inline define:vars={{ zip: ZIP }}>
    (function () {
      var lightbox = document.getElementById('kbp-lightbox');
      var lightboxImg = lightbox ? lightbox.querySelector('img') : null;
      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        if (lightboxImg) lightboxImg.src = '';
      }
      if (lightbox && lightboxImg) {
        document.querySelectorAll('img.zoomable').forEach(function (img) {
          img.addEventListener('click', function () {
            lightboxImg.src = img.currentSrc || img.src;
            lightboxImg.alt = img.alt || '拡大画像';
            lightbox.classList.add('is-open');
            lightbox.setAttribute('aria-hidden', 'false');
          });
        });
        lightbox.addEventListener('click', closeLightbox);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLightbox(); });
      }
      (function () {
        var g = document.getElementById('style-gallery');
        if (!g) return;
        var slides = g.querySelectorAll('.ppp-gallery-slide');
        var chips = g.querySelectorAll('.ppp-gallery-chip');
        var capNo = g.querySelector('.ppp-gallery-cap-no');
        var capName = g.querySelector('.ppp-gallery-caption strong');
        var capMood = g.querySelector('.ppp-gallery-cap-mood');
        var n = slides.length;
        var cur = 0;
        function show(i) {
          cur = ((i % n) + n) % n;
          slides.forEach(function (s, k) { s.hidden = k !== cur; });
          chips.forEach(function (c, k) {
            if (k === cur) c.setAttribute('aria-current', 'true'); else c.removeAttribute('aria-current');
          });
          var c = chips[cur];
          capNo.textContent = c.getAttribute('data-no');
          capName.textContent = c.getAttribute('data-name');
          capMood.textContent = c.getAttribute('data-mood');
        }
        g.querySelectorAll('.ppp-gallery-nav').forEach(function (b) {
          b.addEventListener('click', function () { show(cur + Number(b.getAttribute('data-dir'))); });
        });
        chips.forEach(function (c, k) { c.addEventListener('click', function () { show(k); }); });
        g.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft') { show(cur - 1); e.preventDefault(); }
          else if (e.key === 'ArrowRight') { show(cur + 1); e.preventDefault(); }
        });
        var sx = null, sy = null;
        g.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
        g.addEventListener('touchend', function (e) {
          if (sx === null) return;
          var dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
          sx = null;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) show(cur + (dx < 0 ? 1 : -1));
        }, { passive: true });
      })();
      if (typeof gtag === 'function') {
        document.querySelectorAll('a.js-dl').forEach(function (dl) {
          dl.addEventListener('click', function () {
            gtag('event', 'file_download', {
              file_name: zip.split('/').pop(),
              file_extension: 'zip',
              link_text: 'プラグインをダウンロード',
              link_url: zip
            });
          });
        });
      }
    })();
  </script>
</Layout>
