    width: 1440, height: 900,
    caption: '完成したポータル。開いた人ごとに、自分の担当や今日の予定が並びます。',
  },
  editor: {
    file: 'portal-pro-editor.png',
    alt: 'ポータル編集の全画面。上の帯に［ポータルに戻る］［下書きを保存］［公開］、左にウィジェットのパレット、中央にグリッド、右に設定パネルが表示されている',
    width: 1440, height: 900,
    caption: 'ポータル編集。ウィジェットをドラッグして置き、角をつまんで大きさを変えます。',
  },
  applist: {
    file: 'portal-pro-applist.png',
    alt: 'アプリ一覧のウィジェット。分類ごとにアプリのアイコンが並び、件数のバッジが付いている',
    width: 1440, height: 900,
    caption: 'アプリ一覧。分類・表示名・アイコンを自社の言葉に直せます。',
  },
  data: {
    file: 'portal-pro-data.png',
    alt: '数値カード・グラフ・ランキングが並んだポータルの画面。今月・今四半期などの期間ボタンが置かれている',
    width: 1440, height: 900,
    caption: '数値カード・グラフ・ランキング。期間ボタン（期間バー）で、連動させたウィジェットを一度に切り替えます。',
  },
  quick: {
    file: 'portal-pro-quickinput.png',
    alt: 'ポータルのクイック入力ウィジェット。入力欄と［登録］ボタンがあり、登録後にメッセージが出ている',
    width: 1440, height: 900,
    caption: 'クイック入力。ポータルから、そのままレコードを登録します。',
  },
  ack: {
    file: 'portal-pro-ack.png',
    alt: '重要なお知らせに「未確認」の表示と［確認しました］ボタンが付いたお知らせウィジェットの画面',
    width: 1440, height: 900,
    caption: 'お知らせの［確認しました］ボタン。押していない人には「未確認」と出ます。',
  },
  wizard: {
    file: 'portal-pro-wizard.png',
    alt: '画面作成ウィザード。ひな形6種類のサムネイルが並んでいる',
    width: 1440, height: 900,
    caption: '画面作成ウィザード。ひな形とスタイルを、仕上がりのサムネイルで選びます。',
  },
  styles: {
    file: 'portal-pro-styles.png',
    alt: '同じ画面にスタイル10種類を当てたサムネイルが並び、色・角丸・書体の違いが比べられる画面',
    width: 1440, height: 900,
    caption: 'デザインのパネル。スタイルを選ぶと、画面全体の雰囲気がその場で変わります。',
  },
  mobile: {
    file: 'portal-pro-mobile.png',
    alt: 'スマートフォンのポータル。大きなタイルのアプリ一覧とクイック入力が縦に並んでいる',
    width: 750, height: 1334,
    caption: 'スマホ用の画面。PC とは別に並べられます。',
  },
  launcher: {
    file: 'portal-pro-launcher.png',
    alt: 'Ctrl+K で開いたランチャー。入力した文字に合うアプリが候補に並んでいる',
    width: 1440, height: 900,
    caption: 'ランチャー。どの画面でも Ctrl+K でアプリを探せます。',
  },
  setup: {
    file: 'portal-pro-config-setup.png',
    alt: 'ポータル Pro の設定画面の初期設定。［設定アプリを準備する］と［ポータル利用ログを作成する］が「準備済み」「作成済み」になっている',
    width: 1440, height: 900,
    caption: '設定画面の初期設定。2つのボタンで、保管用のアプリが整います。',
  },
  js: {
    file: 'portal-pro-config-js.png',
    alt: 'ポータル Pro の設定画面のポータル用JS。［PC 用をダウンロード］［スマホ用をダウンロード］と登録の手順が表示されている',
    width: 1440, height: 900,
    caption: 'ポータル用JS。ダウンロードして、kintone の全体のカスタマイズに登録します。',
  },
};
const shotOk = (k: string) => fs.existsSync(path.join(process.cwd(), 'public', 'images', SHOTS[k].file));
const shotClass = (k: string, extra = '') => `kbp-feature ${extra}${shotOk(k) ? '' : ' noshot'}`.trim();

// The 19 widgets of v1.0, grouped as in the editor palette.
const WIDGET_GROUPS: { label: string; items: { name: string; desc: string }[] }[] = [
  {
    label: '基本',
    items: [
      { name: 'アプリ一覧', desc: '10の表示パターン。よく使う順・分類・ピン留め・件数バッジ' },
      { name: 'ショートカットボタン', desc: 'アプリ・一覧・新規作成・外部 URL への大きなボタン' },
      { name: 'お知らせ', desc: '重要度・掲載期間・新着バッジ・［確認しました］ボタン' },
      { name: 'リッチテキスト', desc: '文字・表・リンク・画像を自由に書く' },
      { name: '見出し・区切り線', desc: '画面の区切りと見出し' },
      { name: '画像・バナー', desc: '1枚・スライド・ギャラリー・画像＋文章・ロゴの5形式' },
      { name: 'リンク集', desc: 'リンクを分類して並べる' },
    ],
  },
  {
    label: 'データ',
    items: [
      { name: 'レコード一覧', desc: '条件・列・並び順を決めて、アプリのレコードを並べる' },
      { name: '数値カード', desc: '件数・合計・平均・最小・最大。前期比と目標値' },
      { name: 'グラフ', desc: '棒・折れ線・円・ドーナツ・積み上げ。2つのアプリの比較も' },
      { name: 'ゲージ', desc: '目標に対する現在値を半円で見せる' },
      { name: '進捗バー', desc: '複数の目標の達成率を並べる' },
      { name: 'ランキング・クロス集計', desc: '上位 N 件の順位表と、行×列の集計表' },
      { name: 'カレンダー', desc: '複数のアプリの予定を色分けして重ねる' },
      { name: 'カウントダウン', desc: '期日までの日数。固定の日付でもレコードの日付でも' },
    ],
  },
  {
    label: '業務',
    items: [
      { name: '自分の担当', desc: '複数のアプリから、自分が担当のレコードを集める' },
      { name: 'クイック入力', desc: 'ポータルからレコードを登録。ワンタップ登録も' },
    ],
  },
  {
    label: 'その他',
    items: [
      { name: '埋め込み（iframe）', desc: 'YouTube・Google マップ・Looker Studio などを画面に置く' },
      { name: '時計・日付', desc: '表示形式を選べる。祝日の表示も' },
    ],
  },
];

// Colour swatches are only a guide to each style's mood; they are not the exact theme values.
const STYLES: { no: string; name: string; mood: string; colors: [string, string, string] }[] = [
  { no: 'S-01', name: 'ビジネス', mood: '落ち着き・信頼。多くの会社の基本', colors: ['#1B3A6B', '#2E8B2E', '#F0F4F8'] },
  { no: 'S-02', name: 'クール', mood: '先進的・すっきり。IT・企画部門', colors: ['#374151', '#0891b2', '#ffffff'] },
  { no: 'S-03', name: 'カジュアル', mood: '親しみやすい。社内コミュニケーション', colors: ['#f97316', '#facc15', '#fffbeb'] },
  { no: 'S-04', name: 'ナチュラル', mood: 'やさしい・穏やか。医療・福祉・教育', colors: ['#6b7a3a', '#d9c7a3', '#f7f1e3'] },
  { no: 'S-05', name: 'エレガント', mood: '上品・高級感。接客・ブランド', colors: ['#7a1f3d', '#b8923a', '#faf7f2'] },
  { no: 'S-06', name: 'ポップ', mood: '明るく元気。店舗・イベント', colors: ['#ec4899', '#14b8a6', '#ffffff'] },
  { no: 'S-07', name: 'ミニマル', mood: '余白重視で、情報だけを見せる', colors: ['#111827', '#6b7280', '#ffffff'] },
  { no: 'S-08', name: 'ダーク', mood: '目にやさしい・引き締まる', colors: ['#3b82f6', '#22c55e', '#1f2937'] },
  { no: 'S-09', name: '和モダン', mood: '落ち着いた日本らしさ。製造・老舗', colors: ['#1f3f66', '#d9482b', '#f5efe0'] },
  { no: 'S-10', name: 'コーポレート', mood: '自社のブランドカラーで統一', colors: ['#1B3074', '#2E8B2E', '#ffffff'] },
];

// Alt text for the style sample screens (same order as STYLES; names come from STYLES).
const STYLE_SHOT_ALTS: string[] = [
  '淡いグレー青の地に、紺の見出しと棒グラフを置いたポータル画面。',
  '白地に細い黒枠のカードを並べたポータル画面。',
  'クリーム地にオレンジの数値と棒グラフ、丸い角のカードを使ったポータル画面。',
  'ベージュのグラデーション地に、オリーブ緑を使ったポータル画面。',
  '生成り地にワインレッドと明朝体の見出しを使ったポータル画面。',
  'ミントの水玉の背景に、マゼンタの見出しと強い角丸・影を使ったポータル画面。',
  '白地で枠も影も付けず、黒のボタンだけを使ったポータル画面。',
  '濃紺の暗い地に、明るい青の数値と棒グラフを置いたポータル画面。',
  '和紙風の生成りの地に、明朝体の見出しと朱の重要バッジを使ったポータル画面。',
  '上端に紺から緑のグラデーションの帯を置き、白いカードを並べたポータル画面。',
];

const TEMPLATES = [
  { name: '全社ポータル', desc: '時計・お知らせ・アプリ一覧・自分の担当' },
  { name: '営業ダッシュボード', desc: '期間ボタン・数値カード・グラフ・ランキング・今日の予定' },
  { name: '総務のお知らせ板', desc: '確認ボタン付きのお知らせ・リンク集・社内行事のカレンダー' },
  { name: 'プロジェクト用スペース', desc: 'アプリ一覧・進捗バー・カウントダウン・新着' },
  { name: '現場向けスマホ画面', desc: '大きなタイルのアプリ一覧・クイック入力（打刻）・お知らせ' },
  { name: '新人向けスタートページ', desc: '説明付きのアプリ一覧・リンク集・連絡先' },
];

const HOWTO_STEPS = [
  { name: '配布ファイルを読み込む', text: 'このページから zip をダウンロードし、kintone システム管理のプラグインで読み込みます。' },
  { name: 'プラグインを設定アプリに追加する', text: '新しい空のアプリを作り、そのアプリにポータル Pro を追加します。このアプリが設定アプリになります。' },
  { name: '設定アプリを準備する', text: '設定画面で［設定アプリを準備する］と［ポータル利用ログを作成する］を押します。kintone システム管理者の権限が必要です。' },
  { name: 'ポータル用 JS を登録する', text: '設定画面で PC 用とスマホ用のポータル用 JS をダウンロードし、kintone システム管理の JavaScript / CSS でカスタマイズに登録します。kintone システム管理者の作業です。' },
  { name: '画面を作って公開する', text: '設定アプリのポータル編集で画面を作り、［公開］を押します。' },
];

// FAQ: the accordion and FAQPage JSON-LD are built from the same array so they always match.
const faqs: { q: string; a: string }[] = [
  {
    q: 'ポータル Pro だけを購入できますか？',
    a: `製品ごとの個別のご契約はありません。プレミアム年間サポーターに KIZUNA Pro 拡張パックを追加すると、ポータル Pro を含む KIZUNA Pro プラグインをすべてお使いいただけます。両方をまとめた「KIZUNA Pro 年間サポーター」（税込 ${yen(PRO_SET_PLAN.priceInTax)}/年）もあります。`,
  },
  {
    q: '年間サポーター（ちょこっとプラグインすべて）に、KIZUNA Pro 拡張パックを追加できますか？',
    a: 'できません。KIZUNA Pro 拡張パックは、プレミアム年間サポーターに追加していただくプランです。年間サポーターからは、KIZUNA Pro 年間サポーターへの切り替えでお使いいただけます。',
  },
  {
    q: '導入には、どんな作業が要りますか？',
    a: '配布 zip の読み込みと、設定アプリの準備（［設定アプリを準備する］［ポータル利用ログを作成する］）のあと、ポータル用 JS を kintone システム管理の「JavaScript / CSS でカスタマイズ」に登録します。kintone の全体のカスタマイズは API で登録できないため、この登録は kintone システム管理者の作業です。プラグインを更新したときは、ポータル用 JS をもう一度ダウンロードして登録し直します。版が古いときは、編集できる人のポータルに更新をお願いする帯が出ます。',
  },
  {
    q: 'kintone 標準の「2枚目以降のポータル」とは、何が違いますか？',
    a: '標準の「2枚目以降のポータル」は、そのまま使えます。ポータル Pro は、標準の機能では組み立てられない、メインのポータル（1枚目）とスペースのポータル、スマホの画面を担当します。2枚目以降のポータルには表示されません。',
  },
  {
    q: 'どの画面に表示されますか？',
    a: 'メインのポータルと、「スペースのポータルと複数のスレッドを使用する」を有効にしたスペースのポータルです。パソコンとスマホの両方に対応し、スマホ用の画面は PC とは別に並べられます。ゲストスペースとゲストユーザーには表示されません。',
  },
  {
    q: '開いた人ごとに、見える内容は変わりますか？',
    a: '変わります。データ系のウィジェットは、開いた人の権限でレコードを取得するため、アプリ・レコード・フィールドのアクセス権がそのまま反映されます。件数や合計が人によって違うのは、そのためです。条件に「自分」「自分の組織」「今日」「今週」を使えば、1枚の画面で開いた人ごとの中身になります。画面ごとに表示する人を限ることもでき、これはレコードのアクセス権で守られます。ウィジェット単位の出し分けは表示の切り替えで、セキュリティの機能ではありません。',
  },
  {
    q: 'kintone 標準のお知らせやアプリの欄を、隠せますか？',
    a: '隠せます。設定画面の［全体設定］の「kintone 標準の表示」で、トップのポータルとスペースのそれぞれに、［隠さない］［すべて隠す］［選んだものだけ隠す］から選びます。選べるのは、トップのポータルがお知らせ・通知・未処理・スペース・アプリ、スペースがお知らせ（本文）・スレッド・アプリ・ピープル・関連リンクです。既定は［隠さない］です。隠すのは、ポータル Pro の画面を表示できたときだけで、隠しているときは、画面の一番下の「kintone 標準の表示を開く」で、その間だけ戻せます。設定を変えたら、ポータル用 JS をダウンロードし直して登録し直してください。非公開スペースは対象外です。',
  },
  {
    q: '外部のサービスに、業務データを送りますか？',
    a: '送りません。画面の設定もレコードの値も、お使いの kintone の中だけで扱います。外部への通信は、ライセンス認証（プラグイン ID と利用ドメイン名のみ）だけです。ただし、「埋め込み」や URL 指定の画像は、管理者が許可したサイトを閲覧者のブラウザが読み込みます。この通信でレコードの値は送りません。',
  },
  {
    q: 'クイック入力で登録したレコードに、アプリのカスタマイズや他のプラグインは動きますか？',
    a: '動きません。クイック入力は REST API で登録するため、レコードの追加画面で動くカスタマイズや、他のプラグインの保存時の処理は動きません。対象は、文字列・数値・日付・時刻・日時・ドロップダウン・ラジオボタン・チェックボックス・複数選択・ユーザー選択のフィールドです。ルックアップ・テーブル・添付ファイルなどは対象外です。登録できる権限のある人にだけ見せるよう、画面の表示対象で設定してください。',
  },
  {
    q: 'API の1日のリクエスト数に影響しますか？',
    a: '抑えるしくみがあります。画面の更新の確認とアプリ一覧の取得は、1日のリクエスト数に数えられない API で行います。データ系のウィジェットの結果はブラウザに一時保存し、同じ条件の取得はまとめます。［更新］を押したときだけ取り直します。エディタの下部には、アプリごとの1日のリクエスト数の見積もりが出ます。',
  },
  {
    q: '画像は、どこに保存されますか？',
    a: '設定アプリの添付ファイルに保存します。アップロード時にブラウザで自動的に圧縮します（長辺 1920 px 以内・目安 300 KB 以下）。保存した画像は kintone のディスク使用量に含まれます。',
  },
  {
    q: '無料で試せますか？',
    a: 'はい、30日間無料で試せます（カード登録不要・自動課金なし・1ドメインにつき1回まで。新しい KIZUNA Pro プラグインが出たときは、もう一度お試しいただけます）。プレミアム年間サポーターを未契約の方は、プレミアム年間サポーターの無料体験に KIZUNA Pro プラグインが含まれます。プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを30日間無料でお試しいただけます。体験が終わると機能は止まりますが、設定は消えません。',
  },
  {
    q: 'ご契約が切れたら、どうなりますか？',
    a: '設定した画面は消えません。ご契約が確認できない間、一般の利用者には何も出ず、標準のポータルのままです。編集できる人にだけ、ご契約が確認できない旨の帯が出ます。設定画面とエディタには、ご契約の案内だけが出ます。ご契約が戻れば、保存済みの画面のまま、すぐに動きます。',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  heroBg="/images/kizuna-pro-hero-bg.webp"
  title="ポータル Pro for kintone｜開いた人の今日が並ぶポータルを組み立てる | KIZUNA Works"
  description="ポータル Pro for kintone は、メインのポータルとスペースのポータルに、アプリ一覧・お知らせ・グラフ・クイック入力などのウィジェットをドラッグ＆ドロップで並べる KIZUNA Pro プラグイン。開いた人ごとに中身が変わり、スタイル10種で見た目も整えられます。"
  ogTitle="ポータル Pro for kintone｜開いた人の今日が並ぶポータルを組み立てる | KIZUNA Works"
