---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="添付ファイルアイコン表示 for kintone - 一覧で添付の有無・種類を可視化 | KIZUNA Works"
  description="kintone一覧画面で添付ファイルの有無・種別・件数をアイコン可視化する無料プラグイン。PDF/Excel/画像など28種の拡張子別アイコンと件数バッジで、レコード詳細を開かずひと目で判別。hoverツールチップでファイル名表示。kintone プラグイン 無料配布中。"
