---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { plugins, premiumPlugins } from '../../../data/plugins';
import { PREMIUM_PLAN, PRO_SET_PLAN, PRO_ADDON, yen } from '../../../data/pricing';
import HeroSubBadges from '../../../components/HeroSubBadges.astro';

const VERSION = '1.0.0';
const ZIP = `/downloads/kw-sheet-pro-v${VERSION}.zip`;
const PAGE_URL = 'https://kizuna-works.jp/plugins/sheet-pro/';
const DATE_MODIFIED = '2026-11-25';

// The four products this one bundles. Search both free and premium lists,
// and fail the build on a missing id instead of silently dropping the card.
const singleOf = (id: string) => {
  const p = [...plugins, ...premiumPlugins].find((x) => x.id === id);
  if (!p) throw new Error(`sheet-pro: plugin "${id}" not found in plugins.ts`);
  return p;
};
const iconOf = (slug: string) => `/images/${slug}-icon.png`;
// Single source: `bundles` on this product in plugins.ts (also drives the 「KIZUNA Pro 版あり」 badge).
const BUNDLED = premiumPlugins.find((x) => x.id === 'kw-sheet-pro')?.bundles ?? [];
if (BUNDLED.length === 0) throw new Error('sheet-pro: bundles is empty in plugins.ts');
const bundled = BUNDLED.map((b) => ({ ...b, p: singleOf(b.id) }));

// FAQ: the accordion and FAQPage JSON-LD are built from the same array so they always match.
const faqs: { q: string; a: string }[] = [
  {
    q: 'シート Pro だけを購入できますか？',
    a: `製品ごとの個別のご契約はありません。プレミアム年間サポーターに KIZUNA Pro 拡張パックを追加すると、シート Pro を含む KIZUNA Pro プラグインをすべてお使いいただけます。両方をまとめた「KIZUNA Pro 年間サポーター」（税込 ${yen(PRO_SET_PLAN.priceInTax)}/年）もあります。`,
  },
  {
    q: '年間サポーター（ちょこっとプラグインすべて）に、KIZUNA Pro 拡張パックを追加できますか？',
    a: 'できません。KIZUNA Pro 拡張パックは、プレミアム年間サポーターに追加していただくプランです。年間サポーターからは、KIZUNA Pro 年間サポーターへの切り替えでお使いいただけます。',
  },
  {
    q: 'シート編集などのプラグインと、何が違いますか？',
    a: '4 つの機能（シート・テーブル貼り付け・コピー・横並びシート）は、もとのプラグインと同じ内容です。シート Pro では、1 つの設定画面で扱えます。そのうえで、Excel と同じ操作、Excel ファイルの取り込みと、Excel で直して戻す操作、書き出しのひな形、集計表が加わります。',
  },
  {
    q: '同じアプリに、シート編集などのプラグインが入っていても大丈夫ですか？',
    a: '大丈夫です。同じ機能が両方に入っているときは、もとのプラグインが有効で設定済みなら、その機能はもとのプラグインのほうで動き、シート Pro では動きません（二重に動くのを防ぐためです）。もとのプラグインを「無効」にするか、アプリから外すと、シート Pro がその機能を動かします。',
  },
  {
    q: '使わない機能を、出さないようにできますか？',
    a: 'できます。使う機能は機能ごとに選べます。使わない機能は画面に何も出ず、必須の設定もありません。新しく入れたときは、すべての機能がオフから始まります。',
  },
  {
    q: 'これまでのプラグインで作った設定を、シート Pro に引き継げますか？',
    a: '引き継げます。もとのプラグインが入っているアプリでシート Pro の設定画面を開き、［はじめに］の［単品の設定を読み込む］を押します。読み込みは手動で、もとのプラグインの設定はそのまま残ります。内容を確かめて保存し、もとのプラグインを無効にするか外してください。',
  },
  {
    q: 'Excel ファイルは、どこかに送られますか？',
    a: '送られません。ファイルはブラウザの中だけで読み、どこにも送りません。xlsx を扱うときに、読み取り用の部品を当社サイトから読み込むだけです。',
  },
  {
    q: '取り込める Excel の大きさに、上限はありますか？',
    a: '1 ファイルは 10MB・5 万行までです。それを超えるときは、取り込みを始める前に止めます。定型の Excel（注文書など）は、最大 100 ファイルをまとめて取り込めます。',
  },
  {
    q: 'Excel で直したファイルを戻すと、レコードが消えることはありますか？',
    a: '消えません。行を消したファイルを戻しても、レコードは消さず、変わったセルだけを更新します。書き出したあとに kintone 側で変わったレコードは「競合」として示し、どちらの値を残すかを選べます。',
  },
  {
    q: 'ポータルにシートを表示できますか？',
    a: 'できます。ポータル Pro の「一覧の埋め込み」ウィジェットで、シート・横並びシート・集計表の一覧を選びます。ポータルの中では、Excel の取り込み・書き出しのボタンは出さず、レコードは新しいタブで開きます。',
  },
  {
    q: '無料で試せますか？',
    a: 'はい、30日間無料で試せます（カード登録不要・自動課金なし・1ドメインにつき1回まで。新しい KIZUNA Pro プラグインが出たときは、もう一度お試しいただけます）。プレミアム年間サポーターを未契約の方は、プレミアム年間サポーターの無料体験に KIZUNA Pro プラグインが含まれます。プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを30日間無料でお試しいただけます。体験が終わると機能は止まりますが、設定は消えません。',
  },
  {
    q: 'ご契約が切れたら、設定はどうなりますか？',
    a: '設定は消えません。ご契約が確認できない間は、機能は動かず、設定画面にはご契約の案内だけが出ます。ご契約が戻れば、保存済みの設定のまま、すぐに動きます。',
  },
  {
    q: '表示は何語に対応していますか？',
    a: 'kintone のユーザーごとの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示します。ほかの言語の方には英語で表示します。フィールド名・一覧名など、kintone に登録した内容はそのまま表示します。',
  },
  {
    q: 'スマートフォンでも使えますか？',
    a: 'パソコンの画面のみ対応です。',
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  heroBg="/images/kizuna-pro-hero-bg.webp"
  title="シート Pro for kintone｜Excel と同じ操作で、一覧の編集・取り込み・書き出し・集計 | KIZUNA Works"
  description="シート Pro for kintone は、kintone の一覧を Excel と同じ操作で使える KIZUNA Pro プラグイン。範囲の選択・コピーと貼り付け・検索と置換・集計行に加え、Excel ファイル（xlsx）の取り込み（注文書などの定型も可）と、Excel で直して戻す機能、書き出しのひな形、集計表に対応します。シート編集など 4 つのプラグインも 1 つの設定画面にまとまります。日本語・英語・中国語（簡体字）の表示にも対応します。"
  ogTitle="シート Pro for kintone｜Excel と同じ操作で、一覧の編集・取り込み・書き出し・集計 | KIZUNA Works"
  ogDescription="kintone の一覧を Excel と同じ操作で。Excel ファイルの取り込みと Excel で直して戻す機能、書き出しのひな形、セルを押すと絞り込んだ一覧が開く集計表に対応する KIZUNA Pro プラグインです。日本語・英語・中国語（簡体字）の表示に対応します。"
  ogType="website"
  ogUrl={PAGE_URL}
  ogImage="https://kizuna-works.jp/images/sheet-pro-banner.png"
  canonical={PAGE_URL}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': PAGE_URL,
          url: PAGE_URL,
          name: 'シート Pro for kintone｜Excel と同じ操作で、一覧の編集・取り込み・書き出し・集計 | KIZUNA Works',
          description: 'シート Pro for kintone は、kintone の一覧を Excel と同じ操作で使え、Excel ファイルの取り込み・書き出し・集計表もできる kintone プラグイン（KIZUNA Pro プラグイン）。',
          dateModified: DATE_MODIFIED,
          primaryImageOfPage: { '@type': 'ImageObject', url: 'https://kizuna-works.jp/images/sheet-pro-banner.png', width: 1200, height: 630 },
          isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: 'https://kizuna-works.jp/' },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
            { '@type': 'ListItem', position: 2, name: 'kintoneプラグイン', item: 'https://kizuna-works.jp/plugins/' },
            { '@type': 'ListItem', position: 3, name: 'シート Pro for kintone', item: PAGE_URL },
          ],
        },
        {
          '@type': 'SoftwareApplication',
          name: 'シート Pro for kintone',
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'kintone',
          // Literal on purpose: scripts/check-plugin-summaries.mjs reads it as text. Keep equal to VERSION.
          "softwareVersion": "1.0.0",
          dateModified: DATE_MODIFIED,
          url: PAGE_URL,
          downloadUrl: `https://kizuna-works.jp${ZIP}`,
          image: 'https://kizuna-works.jp/images/sheet-pro-banner.png',
          offers: [
            {
              '@type': 'Offer',
              name: PRO_SET_PLAN.name,
              price: String(PRO_SET_PLAN.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターと KIZUNA Pro 拡張パックのセット（年額）。KIZUNA Pro プラグインをすべて含みます。製品ごとの個別のご契約はありません。',
            },
            {
              '@type': 'Offer',
              name: PRO_ADDON.name,
              price: String(PRO_ADDON.priceInTax),
              priceCurrency: 'JPY',
              availability: 'https://schema.org/InStock',
              description: 'プレミアム年間サポーターに追加するプラン（年額）。',
            },
          ],
          description: 'シート Pro for kintone は、kintone のレコード一覧を Excel と同じ操作で使えるプラグイン。範囲の選択・範囲のコピーと貼り付け・打ち始めで上書き・日付や時刻の略記の読み替え・フィル・行の追加と削除（削除の前に控えの Excel を保存できる）・右クリックのメニュー・検索と置換・複数列の並べ替え・列幅の自動調整・集計行・計算列・シートの見出し・セルのメモに対応する。Excel ファイル（xlsx）の取り込みは、一覧形式・見出し 2 段・テーブル付き・注文書などの定型の Excel に対応し、列の自動対応づけ・取り込む前の確認・取り込みの履歴アプリを備える。書き出したファイルを Excel で直して戻すと、変わったセルだけを更新する。書き出しのひな形では、列・見出し・書式・テーブルの出し方（行を展開・別のシート・横に並べる）・戻せる形・出せる人を決められる。集計表は、行×列×値で集計し、日付を年・四半期・月・週・日にまとめ、セルを押すと絞り込んだ一覧が開く。シート編集・エクセル一括貼り付け・コピーアシスト・横並びシートの 4 つの機能も 1 つの設定画面で使える。ポータル Pro の「一覧の埋め込み」ウィジェットにシートを表示できる。Excel ファイルはブラウザの中だけで読み、外部へ送信しない。kintone のユーザーの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示する。使う機能は機能ごとに選べる。',
          publisher: { '@type': 'Organization', name: 'KIZUNA Works', url: 'https://kizuna-works.jp' },
          featureList: [
            'Excel と同じ操作：範囲の選択・範囲のコピー／切り取り／貼り付け・打ち始めで上書き・Enter／Tab／F2 などのキー操作',
            '入力の読み替え：=1200*3 などの計算・11/24 や R8.11.24 などの日付・930 などの時刻',
            'フィル（連番・日付）とダブルクリックで下まで・複数列の並べ替え',
            '行の追加と削除（削除の前に控えの Excel を保存できる）',
            '右クリックのメニュー・検索と置換・選んだ範囲の合計／平均／件数',
            '列幅の自動調整・集計行・計算列・シートの見出し・セルのメモ',
            'Excel ファイル（xlsx）の取り込み：一覧形式・見出し 2 段・テーブル付き・列の自動対応づけ・取り込む前の確認',
            '定型の Excel（注文書など）を 1 枚 1 レコードで取り込む（取り込み先の振り分け・最大 100 ファイル）',
            '書き出したファイルを Excel で直して戻す機能（変わったセルだけを更新・競合の選択）',
            '取り込みの履歴を、選んだアプリに残す',
            '書き出しのひな形：列・見出し・書式・テーブルの出し方 3 通り・戻せる形・出せる人の制限',
            '集計表：行×列×値・日付の年／四半期／月／週／日・合計・件数・平均・セルを押すと絞り込んだ一覧が開く・並べ方を人ごとに保存',
            'ポータル Pro の「一覧の埋め込み」ウィジェットでシートを表示',
            'シート編集・エクセル一括貼り付け・コピーアシスト・横並びシートの 4 つの機能を 1 つの設定画面で',
            'これまでのプラグインの設定を読み込んで引き継ぐ',
            '使う機能を機能ごとに選べる（使わない機能は画面に何も出ない）',
            '設定画面のライブプレビュー',
            '多言語：kintone のユーザーの言語設定に合わせて、日本語・英語・中国語（簡体字）で表示',
            'ゲストスペースのアプリに対応（パソコンの画面）',
          ],
        },
      ],
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --kbp-navy: #1B3A6B;
      --kbp-ink: #0f1f3d;
      --kbp-gold: #b8862b;
      --kbp-gold-light: #e8c766;
      --kbp-gold-soft: #f0d58a;
      --kbp-green: #2E8B2E;
      --kbp-text: #333333;
      --kbp-muted: #64748b;
    }

    /* Hero: darker than the premium hero, gold accents mark the Pro series */
    .kbp-hero {
      /* Shared KIZUNA Pro hero background; sized by width, its baked bottom fade blends into this base gradient */
      background:
        url('/images/kizuna-pro-hero-bg.webp') center top / 100% auto no-repeat,
        linear-gradient(90deg, #020816 0%, #050b1c 30%, #081427 50%, #09182f 70%, #0c1729 100%);
      color: #fff;
      padding: 60px 5% 54px;
      text-align: center;
      border-bottom: 4px solid var(--kbp-gold);
    }
    .kbp-hero-icon {
      width: 136px; height: 136px; object-fit: contain; display: block; margin: 0 auto 18px;
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(232, 199, 102, 0.5);
      border-radius: 26px; padding: 10px; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    }
    .kbp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
    .kbp-badge-pro {
      display: inline-flex; align-items: center; gap: 6px; line-height: 1;
      padding: 7px 16px; border-radius: 20px;
      background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%);
      color: #1a1405; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.08em;
    }
    .kbp-hero-version {
      padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.45);
      font-size: 0.85rem; font-weight: 700; line-height: 1;
    }
    .kbp-hero-title { font-size: clamp(1.7rem, 4.2vw, 2.6rem); margin: 0 0 12px; line-height: 1.3; }
    .kbp-tagline { font-size: clamp(1.05rem, 2.4vw, 1.35rem); font-weight: 700; margin: 0 0 14px; color: var(--kbp-gold-soft); }
    .kbp-sub { max-width: 860px; margin: 0 auto 26px; line-height: 1.9; font-size: 1rem; color: rgba(255, 255, 255, 0.92); }
    .kbp-sub strong { color: #fff; }
    .kbp-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; max-width: 900px; margin: 0 auto 28px; }
    .kbp-pillar {
      display: block; padding: 16px 14px; border-radius: 12px; text-decoration: none; color: #fff;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(232, 199, 102, 0.45);
    }
    .kbp-pillar:hover { background: rgba(255, 255, 255, 0.14); }
    .kbp-pillar-no { display: block; font-size: 0.75rem; letter-spacing: 0.1em; color: var(--kbp-gold-soft); font-weight: 800; }
    .kbp-pillar-name { display: block; font-size: 1.05rem; font-weight: 800; margin: 4px 0; }
    .kbp-pillar-desc { display: block; font-size: 0.84rem; line-height: 1.6; color: rgba(255, 255, 255, 0.85); }
    .kbp-hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .kbp-btn {
      display: inline-block; padding: 14px 26px; border-radius: 10px; font-weight: 800; text-decoration: none;
      font-size: 1rem; line-height: 1.3;
    }
    .kbp-btn.is-primary { background: linear-gradient(135deg, var(--kbp-gold-light) 0%, var(--kbp-gold) 100%); color: #1a1405; box-shadow: 0 6px 18px rgba(184, 134, 43, 0.35); }
    .kbp-btn.is-ghost { border: 1px solid rgba(255, 255, 255, 0.6); color: #fff; }
    .kbp-btn.is-ghost:hover { background: rgba(255, 255, 255, 0.1); }
    .kbp-hero-note { margin: 14px auto 0; font-size: 0.85rem; color: rgba(255, 255, 255, 0.75); max-width: 760px; line-height: 1.7; }

    /* Update box (version highlight) */
    .update-box { max-width: 980px; margin: 0 auto; background: #fff; border: 1px solid #dbe3ee; border-left: 5px solid var(--kbp-green); border-radius: 12px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06); padding: 28px 28px 32px; min-width: 0; }
    .update-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .update-tag { background: var(--kbp-green); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 0.05em; padding: 4px 12px; border-radius: 6px; flex-shrink: 0; }
    .update-title { color: var(--kbp-navy); font-size: 20px; font-weight: 700; line-height: 1.4; margin: 0; }
    .update-desc { color: var(--kbp-text); font-size: 15px; line-height: 1.8; margin: 0 0 16px; }
    .update-desc strong { color: var(--kbp-navy); }
    .update-shot { max-width: 640px; margin: 22px auto 20px; }
    .update-shot img { width: 100%; height: auto; display: block; border: 1px solid #e2e8f0; border-radius: 8px; cursor: zoom-in; }
    .update-shot .zoom-hint { text-align: center; color: #64748b; font-size: 12px; margin: 10px 0 0; }
    .update-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #e3eaf3; }
    .update-list > li { position: relative; padding: 14px 4px 14px 34px; border-bottom: 1px solid #e3eaf3; line-height: 1.8; color: var(--kbp-text); min-width: 0; }
    .update-list > li::before { content: '✓'; position: absolute; left: 4px; top: 18px; width: 20px; height: 20px; border-radius: 50%; background: var(--kbp-green); color: #fff; font-size: 12px; font-weight: 900; line-height: 20px; text-align: center; }
    .update-list > li > strong:first-child { display: block; color: var(--kbp-navy); font-size: 16px; margin-bottom: 2px; }
    .update-sub { list-style: disc; margin: 6px 0 0; padding-left: 1.3em; }
    .update-sub li { padding: 1px 0; }
    .update-sub li::marker { color: var(--kbp-green); }
    .update-list + .kbp-h3 { margin-top: 26px; }
    .update-note { color: var(--kbp-muted); font-size: 13px; line-height: 1.7; margin: 18px 0 0; }
    @media (max-width: 700px) { .update-box { padding: 22px 18px 26px; } .update-title { font-size: 17px; } }

    /* Series strip */
    .kbp-series { background: #fffaf0; border-bottom: 1px solid #eadcb2; }
    .kbp-series-inner { max-width: 1100px; margin: 0 auto; padding: 20px 5%; display: flex; gap: 16px; align-items: center; }
    .kbp-series-tag {
