---
import Layout from '../../../layouts/Layout.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import { recipes, widgetTypeLabels } from '../../../data/recipes';

// Pick a few representative recipes to showcase in the "設定レシピ集" teaser.
const teaserIds = ['bar-office-sales', 'donut-category-share', 'line-monthly-trend', 'crosstab-office-category', 'heatmap-winrate', 'card-win-rate'];
const teaser = teaserIds
  .map((id) => recipes.find((r) => r.id === id))
  .filter((r): r is NonNullable<typeof r> => Boolean(r));
---

<Layout
  title="ダッシュボード for kintone｜グラフ・集計を1枚に(BI/可視化) | KIZUNA Works"
  description="kintone のダッシュボード（BI）プラグイン。グラフ・数値カード・クロス集計表を1枚に集約し、一覧のカスタマイズビューやポータルに常設の集計ダッシュボードを描画。期間連動の再集計・アプリ横断集計・データ可視化に対応。kintone完結のプレミアムプラグイン。"
  ogTitle="ダッシュボード for kintone｜グラフ・集計を1枚に(BI/可視化) | KIZUNA Works"
  ogDescription="kintone のダッシュボード（BI）プラグイン。グラフ・数値カード・クロス集計表を1枚に集約。期間連動の再集計・アプリ横断集計・データ可視化に対応するプレミアムプラグイン。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/dashboard/"
  ogImage="https://kizuna-works.jp/images/dashboard-banner.png"
  canonical="https://kizuna-works.jp/plugins/dashboard/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/dashboard/",
          "url": "https://kizuna-works.jp/plugins/dashboard/",
          "name": "ダッシュボード for kintone｜グラフ・集計を1枚に(BI/可視化) | KIZUNA Works",
          "description": "kintone のダッシュボード（BI）プラグイン。グラフ・数値カード・クロス集計表を1枚に集約し、一覧のカスタマイズビューやポータルに常設の集計ダッシュボードを描画・データ可視化する。",
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "https://kizuna-works.jp/images/dashboard-banner.png",
            "width": 1200,
            "height": 630
          },
          "isPartOf": { "@type": "WebSite", "name": "KIZUNA Works", "url": "https://kizuna-works.jp/" }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://kizuna-works.jp/" },
            { "@type": "ListItem", "position": 2, "name": "kintoneプラグイン", "item": "https://kizuna-works.jp/plugins/" },
            { "@type": "ListItem", "position": 3, "name": "ダッシュボード for kintone", "item": "https://kizuna-works.jp/plugins/dashboard/" }
          ]
        },
        {
          "@type": "SoftwareApplication",
          "name": "ダッシュボード for kintone",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web (kintone)",
          "softwareVersion": "1.0.0",
          "dateModified": "2026-06-27",
          "url": "https://kizuna-works.jp/plugins/dashboard/",
          "downloadUrl": "https://kizuna-works.jp/downloads/kw-dashboard-v1.0.0.zip",
          "image": "https://kizuna-works.jp/images/dashboard-banner.png",
          "offers": [
            {
              "@type": "Offer",
              "name": "基本プラン（無料）",
              "price": "0",
              "priceCurrency": "JPY",
              "availability": "https://schema.org/InStock",
              "description": "基本機能を無料でご利用いただけます（データソース1つ・ウィジェット数制限あり）。"
            },
            {
              "@type": "Offer",
              "name": "プレミアム年間サポーター（全プラグイン込み）",
              "price": "16500",
              "priceCurrency": "JPY",
              "availability": "https://schema.org/InStock",
              "description": "プレミアム年間サポーター（税込 ¥16,500/年）に加入すると、本プラグインと販売中の全プラグインの全機能を利用できます。単品販売はありません。"
            }
          ],
          "description": "グラフ・数値カード・クロス集計表を1枚に集約し、レコード一覧のカスタマイズビューに常設の集計ダッシュボードを描画する kintone プラグイン。期間連動再集計・アプリ横断集計・ポータル常設・集計キャッシュに対応。",
          "publisher": { "@type": "Organization", "name": "KIZUNA Works", "url": "https://kizuna-works.jp" },
          "featureList": [
            "グラフ（縦棒・横棒・折れ線・エリア・円・ドーナツ・レーダー・積み上げ各種・複合・割合%）",
            "数値カード（合計・件数・平均などの単一値／割合%／★評価）",
            "クロス集計表・ヒートマップ（行×列のピボット集計・濃淡/閾値カラー）",
            "12列グリッドに複数ウィジェットを自由配置",
            "期間セレクタで全ウィジェットを連動再集計",
            "ウィジェットクリックで対象レコードへドリルダウン",
            "アプリ横断集計（複数アプリのデータソースを1ボードに集約・プレミアム）",
            "ポータルへの iframe 埋め込みコードを自動生成（プレミアム）",
            "集計キャッシュで大規模データを高速描画（プレミアム）",
            "設定画面のライブプレビュー（ボード全体・カード個別）",
            "グラフは自社配信のChart.jsをSRI付きで読込・集計はブラウザ内完結で外部送信なし"
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            { "@type": "Question", "name": "kintoneをBIツールのようにデータ可視化に使えますか？", "acceptedAnswer": { "@type": "Answer", "text": "はい。ダッシュボード for kintone は、グラフ・数値カード・クロス集計表を1枚に集約してレコード一覧やポータルに常設し、kintone のデータを外部のBIツールに出さずに可視化できるプラグインです。期間連動の再集計やアプリ横断集計にも対応します。" } },
            { "@type": "Question", "name": "標準のグラフと何が違いますか？", "acceptedAnswer": { "@type": "Answer", "text": "kintone標準のグラフは1グラフ1画面ですが、本プラグインは複数のグラフ・数値カード・クロス集計を1枚のボードに集約し、ポータルに常設したり複数アプリの数字を横断集計したりできます。" } },
            { "@type": "Question", "name": "ダッシュボードが表示されません。", "acceptedAnswer": { "@type": "Answer", "text": "対象アプリに「カスタマイズ」表示形式のビューがあり、そのビューがボードに割り当てられているか、設定後にアプリを更新（デプロイ）したかをご確認ください。" } },
            { "@type": "Question", "name": "数値や棒グラフが一瞬出ないことがあります。", "acceptedAnswer": { "@type": "Answer", "text": "データ取得中は「集計中…」を表示します。件数が多い場合は読み込みに数秒かかります。集計キャッシュのご利用で高速化できます。" } },
            { "@type": "Question", "name": "複数のアプリの数字を1枚で見られますか？", "acceptedAnswer": { "@type": "Answer", "text": "はい。アプリ横断集計（プレミアム）で、複数アプリのデータソースを1つのボードに集約できます。" } },
            { "@type": "Question", "name": "外部にデータが送られませんか？", "acceptedAnswer": { "@type": "Answer", "text": "集計はすべてブラウザ内で行い、業務データを外部へ送信しません。グラフ描画用の Chart.js は自社サーバーから SRI 付きで読み込み、第三者 CDN は使用しません。" } },
            { "@type": "Question", "name": "ゲストスペースのアプリでも使えますか？", "acceptedAnswer": { "@type": "Answer", "text": "はい、ゲストスペース内のアプリでも利用できます。" } },
            { "@type": "Question", "name": "単品で購入できますか？", "acceptedAnswer": { "@type": "Answer", "text": "本プラグインはプレミアムプラグインのため単品販売はありません。プレミアム年間サポーター（税込 ¥16,500/年）にご加入いただくと、本プラグインと販売中の全プラグインを利用できます。" } }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0,0,0,0.08);
    }

    .dbp-hero {
      background: linear-gradient(135deg, rgba(21,41,77,0.72) 0%, rgba(27,58,107,0.55) 60%, rgba(46,139,46,0.5) 130%),
                  url('/images/premium-plugins-bg.png') center center / cover no-repeat;
      background-color: #1B3A6B;
      color: #fff;
      padding: 56px 5% 48px;
      text-align: center;
    }
    .dbp-hero-icon {
      width: 132px; height: 132px; object-fit: contain; display: block; margin: 0 auto 16px;
      background: rgba(255,255,255,0.14); border-radius: 24px; padding: 10px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }
    .dbp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; margin-bottom: 14px; }
    .dbp-badge-premium {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.5);
      color: #fff; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.06em;
      padding: 5px 14px; border-radius: 20px;
    }
    .dbp-hero-version {
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.4);
      color: #fff; font-weight: 700; font-size: 0.82rem; padding: 5px 12px; border-radius: 20px;
    }
    .dbp-hero h1 { font-size: 2.1rem; font-weight: 700; margin: 0 0 10px; letter-spacing: 0.04em; }
    .dbp-hero .dbp-tagline { font-size: 1.15rem; font-weight: 600; margin: 0 0 8px; }
    .dbp-hero .dbp-sub { font-size: 1rem; opacity: 0.92; margin: 0 auto; max-width: 720px; line-height: 1.8; }
    .dbp-hero-gradient-line { height: 6px; background: linear-gradient(to right, var(--color-navy), var(--color-green)); }

    .dbp-wrap { max-width: 1100px; margin: 0 auto; padding: 0 5%; }
    .dbp-section { padding: 56px 0; }
    .dbp-section.alt { background: #fff; }
    .dbp-h2 {
      font-size: 1.7rem; color: var(--color-navy); margin: 0 0 28px; padding-left: 16px;
      border-left: 5px solid var(--color-green);
    }
    .dbp-lead {
      font-size: 1.08rem; line-height: 1.9; color: var(--color-text-main);
      background: #fff; border-radius: 12px; padding: 28px 32px; box-shadow: var(--shadow-card);
    }
    .dbp-lead strong { color: var(--color-navy); }

    .dbp-shot-full { margin: 0; }
    .dbp-shot-full img {
      width: 100%; height: auto; display: block; border: 1px solid #e2e8f0;
      border-radius: 12px; box-shadow: var(--shadow-card); background: #fff;
    }
    .dbp-shot-full figcaption { text-align: center; font-size: 0.9rem; color: var(--color-text-muted); margin-top: 12px; }

    .dbp-feature { display: grid; grid-template-columns: 1.05fr 1fr; gap: 32px; align-items: center; margin-bottom: 48px; }
    .dbp-feature:last-child { margin-bottom: 0; }
    .dbp-feature.reverse { grid-template-columns: 1fr 1.05fr; }
    .dbp-feature.reverse .dbp-feature-text { order: 2; }
    .dbp-feature img { width: 100%; height: auto; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: var(--shadow-card); background: #fff; }
    .dbp-feature h3 { font-size: 1.25rem; color: var(--color-navy); margin: 0 0 12px; }
    .dbp-feature p { font-size: 1rem; line-height: 1.8; margin: 0; }

    .dbp-grid-feats { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .dbp-feat-card { background: #fff; border-radius: 10px; padding: 24px; box-shadow: var(--shadow-card); }
    .dbp-feat-card .dbp-tag-premium { display: inline-block; background: #fdf0d5; color: #b9770e; font-size: 0.72rem; font-weight: 700; padding: 2px 9px; border-radius: 9px; margin-bottom: 8px; }
    .dbp-feat-card h3 { font-size: 1.1rem; color: var(--color-navy); margin: 0 0 10px; }
    .dbp-feat-card p { font-size: 0.95rem; line-height: 1.75; margin: 0; }

    /* Recipe teaser */
    .dbp-recipe-cta { background: linear-gradient(135deg, #eef3fb 0%, #eaf6ea 130%); border: 1px solid #dbe6f3; border-radius: 16px; padding: 32px; }
    .dbp-recipe-cta-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-bottom: 8px; }
    .dbp-recipe-cta h3 { font-size: 1.3rem; color: var(--color-navy); margin: 0; }
    .dbp-recipe-cta p { font-size: 1rem; line-height: 1.8; color: var(--color-text-main); margin: 0 0 20px; }
    .dbp-recipe-thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 22px; }
    .dbp-recipe-thumb { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
    .dbp-recipe-thumb img { width: 100%; height: 132px; object-fit: cover; object-position: center top; display: block; background: #F0F4F8; }
    .dbp-recipe-thumb span { display: block; font-size: 0.78rem; color: var(--color-text-muted); padding: 7px 10px; }
    .dbp-recipe-btn { display: inline-block; background: var(--color-navy); color: #fff; font-weight: 700; padding: 13px 28px; border-radius: 8px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
    .dbp-recipe-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(27,58,107,0.22); }

    .dbp-tablewrap { overflow-x: auto; }
    table.dbp-compare { border-collapse: collapse; width: 100%; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: var(--shadow-card); }
    table.dbp-compare th, table.dbp-compare td { border: 1px solid #e2e8f0; padding: 12px 14px; text-align: left; }
    table.dbp-compare thead th { background: var(--color-navy); color: #fff; }
    table.dbp-compare td.c, table.dbp-compare th.c { text-align: center; }
    table.dbp-compare tbody tr:nth-child(even) { background: #f8fafc; }

    .dbp-plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-bottom: 44px; align-items: stretch; }
    .dbp-plan-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 34px 28px 30px; box-shadow: var(--shadow-card); position: relative; text-align: center; display: flex; flex-direction: column; }
    .dbp-plan-card.recommended { border: 2px solid var(--color-green); }
    .dbp-plan-badge { position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: var(--color-green); color: #fff; font-weight: 700; font-size: 0.82rem; padding: 6px 18px; border-radius: 20px; white-space: nowrap; }
    .dbp-plan-name { font-size: 1.3rem; color: var(--color-navy); margin: 0 0 18px; }
    .dbp-plan-price { margin-bottom: 6px; }
    .dbp-plan-price .amt { font-size: 2.4rem; font-weight: 700; color: var(--color-navy); }
    .dbp-plan-price .unit { font-size: 0.95rem; color: var(--color-text-muted); margin-left: 4px; }
    .dbp-plan-discount { color: var(--color-green); font-weight: 700; font-size: 0.92rem; margin-bottom: 16px; }
    .dbp-plan-features { list-style: none; padding: 0; margin: 18px 0 24px; text-align: left; flex-grow: 1; }
    .dbp-plan-features li { font-size: 0.95rem; line-height: 1.7; padding: 9px 0; border-bottom: 1px solid #eef2f7; }
    .dbp-plan-cta { display: block; background: var(--color-navy); color: #fff; font-weight: 700; padding: 14px 20px; border-radius: 8px; text-decoration: none; transition: background .2s, transform .2s, box-shadow .2s; }
    .dbp-plan-card.recommended .dbp-plan-cta { background: var(--color-green); }
    .dbp-plan-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(0,0,0,0.16); }
    .dbp-plan-compare-head { font-size: 1.15rem; color: var(--color-navy); margin: 8px 0 16px; padding-left: 12px; border-left: 4px solid var(--color-green); }

    .dbp-steps { counter-reset: step; list-style: none; padding: 0; margin: 0; }
    .dbp-steps li { position: relative; padding: 0 0 18px 52px; line-height: 1.8; }
    .dbp-steps li::before {
      counter-increment: step; content: counter(step);
      position: absolute; left: 0; top: 0; width: 34px; height: 34px;
      background: var(--color-green); color: #fff; border-radius: 50%;
      display: flex; align-items: center; justify-content: center; font-weight: 700;
    }
    .dbp-note { background: #fff8e6; border-left: 4px solid #e0a400; padding: 14px 16px; border-radius: 0 8px 8px 0; margin: 16px 0; }
    .dbp-cautions { background: #fff; border-radius: 10px; padding: 24px 28px; box-shadow: var(--shadow-card); }
    .dbp-cautions li { margin: 8px 0; line-height: 1.7; }

    .dbp-cta { background: linear-gradient(135deg, #15294d 0%, #1B3A6B 60%, #2E8B2E 140%); color: #fff; text-align: center; padding: 56px 5%; }
    .dbp-cta h2 { font-size: 1.6rem; margin: 0 0 12px; }
    .dbp-cta p { font-size: 1.05rem; opacity: 0.95; max-width: 640px; margin: 0 auto 24px; line-height: 1.8; }
    .dbp-cta-btn { display: inline-block; background: #fff; color: var(--color-navy); font-weight: 700; font-size: 1.05rem; padding: 16px 36px; border-radius: 10px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
    .dbp-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,0.3); }

    @media (max-width: 768px) {
      .dbp-hero h1 { font-size: 1.6rem; }
      .dbp-feature, .dbp-feature.reverse { grid-template-columns: 1fr; }
      .dbp-feature.reverse .dbp-feature-text { order: 0; }
      .dbp-plan-grid { grid-template-columns: 1fr; }
      .dbp-h2 { font-size: 1.4rem; }
      .dbp-recipe-thumbs { grid-template-columns: 1fr 1fr; }
    }
  </style>

  <main>
    <!-- Hero -->
    <section class="dbp-hero">
      <img class="dbp-hero-icon" src="/images/dashboard-icon.png" alt="ダッシュボード for kintone アイコン" width="200" height="200" loading="eager" />
      <div class="dbp-hero-badges">
        <span class="dbp-badge-premium">👑 PREMIUM PLUGIN</span>
        <span class="dbp-hero-version">v1.0.0</span>
      </div>
      <h1>ダッシュボード for kintone</h1>
      <p class="dbp-tagline">見たい数字を、1枚に。</p>
      <p class="dbp-sub">グラフ・数値カード・クロス集計表を1つのボードに集約。レコード一覧のカスタマイズビューに、業務の数字を一望できる集計ダッシュボードを常設します。</p>
    </section>
    <div class="dbp-hero-gradient-line"></div>

    <!-- 定義（結論ファースト） -->
    <section class="dbp-section">
      <div class="dbp-wrap">
        <p class="dbp-lead">
          <strong>ダッシュボード for kintone</strong> は、複数の<strong>グラフ・数値カード・クロス集計表</strong>を1枚のボードに自由配置し、レコード一覧の<strong>カスタマイズビュー</strong>に常設の集計ダッシュボードを描画する kintone プラグインです。標準グラフのように1画面1グラフではなく、見たい指標を並べて一望できます。上部の<strong>期間セレクタで全ウィジェットを連動再集計</strong>でき、<strong>複数アプリ横断の集計・ポータルへの常時表示・大規模データ向けの集計キャッシュ</strong>にも対応。集計はすべてブラウザ内で完結し、業務データを外部へ送信しません。<strong>「プレミアムプラグイン」シリーズの第 2 弾</strong>です。
        </p>
      </div>
    </section>

    <!-- 完成イメージ -->
    <section class="dbp-section alt">
      <div class="dbp-wrap">
        <h2 class="dbp-h2">完成イメージ</h2>
        <figure class="dbp-shot-full">
          <picture>
            <source srcset="/images/dashboard-overview.webp" type="image/webp" />
            <img src="/images/dashboard-overview.png" alt="ダッシュボード for kintone の表示例 — 受注金額・受注件数・受注率・平均評価の数値カードと、営業所別・担当者別の棒グラフ、月別推移、カテゴリ構成比、営業所×カテゴリのクロス集計表を1枚に集約した営業ダッシュボード" width="1914" height="1675" loading="lazy" />
          </picture>
          <figcaption>① 数値カード・グラフ・クロス集計表を1枚に集約した「成績ダッシュボード」の例（ダミーデータ）</figcaption>
        </figure>
        <figure class="dbp-shot-full" style="margin-top:36px;">
          <picture>
            <source srcset="/images/dashboard-overview-yojitsu.webp" type="image/webp" />
