---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="住所アシスト for kintone - 郵便番号⇔住所を双方向で自動入力＋地図プレビュー | KIZUNA Works"
  description="郵便番号から住所、住所から郵便番号を双方向で自動入力する kintone プラグイン。Google マップ URL 生成・レコード詳細画面への地図プレビュー埋め込み・住所コピーまで一気通貫。請求先・配送先・本社など複数の住所を同時に扱え、サブテーブルにも対応。API キー不要、無料配布中。"
  ogTitle="住所アシスト for kintone - 郵便番号⇔住所を双方向で自動入力＋地図プレビュー | KIZUNA Works"
  ogDescription="郵便番号から住所、住所から郵便番号を双方向で自動入力。Google マップを直接レコード詳細画面に埋め込み表示し、住所コピー・URL 生成も自動。複数の住所を同時に扱えます。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/address-assist/"
  ogImage="https://kizuna-works.jp/images/address-assist-banner.png"
  canonical="https://kizuna-works.jp/plugins/address-assist/"
>
