---
import Layout from '../../../layouts/Layout.astro';
import SupporterCTA from '../../../components/SupporterCTA.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import PluginFaqSection from '../../../components/PluginFaqSection.astro';
---

<Layout
  title="住所アシスト for kintone - 郵便番号で住所自動入力＋レコード詳細画面に地図プレビュー | KIZUNA Works"
  description="郵便番号を入れるだけで住所自動入力・Google マップ URL 生成・レコード詳細画面への地図プレビュー埋め込み・住所コピーまで一気通貫。レコードを開いた瞬間に地図が見える業務効率が他社プラグインとの差別化ポイント。一体形式・分割形式 両対応、API キー不要、無料配布中の kintone プラグイン。"
  ogTitle="住所アシスト for kintone - 郵便番号で住所自動入力＋レコード詳細画面に地図プレビュー | KIZUNA Works"
  ogDescription="郵便番号入力で住所を自動入力し、Google マップを直接レコード詳細画面に埋め込み表示。住所コピー・URL 生成も自動。レコードを開いた瞬間に地図が見える業務効率が他社プラグインとの差別化ポイント。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/address-assist/"
  ogImage="https://kizuna-works.jp/images/address-assist-banner.png"
  canonical="https://kizuna-works.jp/plugins/address-assist/"
>
