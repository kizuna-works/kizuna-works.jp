---
import Layout from '../../../layouts/Layout.astro';
import TrialForm from '../../../components/TrialForm.astro';
import { plugins, proPlugins, premiumOnlyPlugins as premiumPlugins } from '../../../data/plugins';
import { PRICE_REVISION_LIVE, PRO_ADDON, PRO_SET_PLAN, yen } from '../../../data/pricing';

const availablePremium = premiumPlugins.filter((p) => p.status === 'available');
const availableChokotto = plugins.filter((p) => p.status === 'available');
const availablePro = proPlugins.filter((p) => p.status === 'available');
const premiumCount = availablePremium.length;
const chokottoCount = availableChokotto.length;
const totalCount = premiumCount + chokottoCount;

// Icon path: slug-based, matching the ranking page (kw-conditional-numbering is the only exception).
const iconPath = (slug: string): string =>
  slug === 'kw-conditional-numbering'
    ? '/images/conditional-numbering-icon.png'
    : `/images/${slug}-icon.png`;

const pageUrl = 'https://kizuna-works.jp/plugins/premium-trial/';
const pageTitle =
  'KIZUNA Pro 年間サポーター 30日間無料体験 | KIZUNA Works';
const pageDesc =
  'kintone プラグインの KIZUNA Pro 年間サポーター（ちょこっと＆プレミアム＆KIZUNA Pro プラグインすべて）を30日間無料でお試し。カード登録不要・自動課金なし。全機能を広告なしで体験でき、契約中の方は KIZUNA Pro 拡張パックだけの体験も可能です。';

// FAQ — keep the on-page Q&A and this JSON-LD identical.
const faqs = [
  {
    q: '無料体験にクレジットカードは必要ですか？',
    a: 'いいえ、不要です。カード登録は一切なく、体験終了後に自動で課金されることもありません。',
  },
  {
    q: '30日を過ぎると自動で課金されますか？',
    a: '課金されません。期間終了後は自動的に無料版（広告表示）に戻ります。続けたい場合のみ、KIZUNA Pro 年間サポーター（またはプレミアム年間サポーター）に別途お申し込みいただきます。',
  },
  {
    q: '無料体験には何が含まれますか？',
    a: 'KIZUNA Pro 年間サポーターと同じ状態になり、ちょこっと＆プレミアムプラグインすべての全機能を広告非表示でご利用いただけます。さらに、KIZUNA Pro プラグイン（KIZUNAブリッジ for kintone など）もご利用いただけます。なお、HP のサポーター一覧へのロゴ掲載は有料のプレミアム年間サポーター特典のため、体験には含まれません。',
  },
  {
    q: '体験が終わると、KIZUNA Pro プラグインはどうなりますか？',
    a: '体験が終わると KIZUNA Pro プラグインのルールは止まりますが、設定は消えません。続けてお使いになるときは、KIZUNA Pro 年間サポーター（プレミアム年間サポーター＋KIZUNA Pro 拡張パック）、またはプレミアム年間サポーターへの KIZUNA Pro 拡張パックの追加にお申し込みください。申し込み後は、保存済みの設定のまま動きます。',
  },
  {
    q: 'プレミアム年間サポーターを契約中です。KIZUNA Pro だけ試せますか？',
    a: 'はい。プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを30日間無料でお試しいただけます。カード登録は不要で、自動課金もありません。1つの kintone ドメインにつき1回までです。プレミアム未契約・体験済み・拡張パックをご契約中のドメインは対象外で、その場合もメールでお知らせします。',
  },
  {
    q: '前に体験を使いましたが、もう一度試せますか？',
    a: '新しい KIZUNA Pro プラグインが公開されたときは、前回の体験の終了から90日以上たっていれば、もう一度30日間お試しいただけます（体験の途中の方・拡張パックをご契約中の方は対象外です）。再体験の中身は、プレミアム年間サポーターをご契約中の方は KIZUNA Pro 拡張パックだけ、未契約の方はプレミアム年間サポーター＋KIZUNA Pro 拡張パックです。申し込みは、これまでと同じ申込欄から行います。結果はメールでお知らせします。',
  },
  {
    q: '誰でも体験できますか？',
    a: '1つの kintone ドメインにつき体験は1回までです（新しい KIZUNA Pro プラグインが出たときは、もう一度お試しいただけます）。すでにプレミアム年間サポーターをご契約中、または過去にプレミアムをご利用・体験済みのドメインは対象外です。' + (PRICE_REVISION_LIVE ? '年間サポーターをご利用中の方も体験いただけます。' : '個別の年間サポーターをご利用中の方は体験いただけます。'),
  },
  {
    q: PRICE_REVISION_LIVE
      ? '年間サポーターを契約中です。プレミアムに切り替えるとどうなりますか？'
      : '個別プラグインを契約中です。プレミアムに乗り換えるとどうなりますか？',
    a: PRICE_REVISION_LIVE
      ? 'お問い合わせいただければ、ご契約中の年間サポーターの残りの期間に応じた差額で、プレミアム年間サポーターへ切り替えられます。'
      : '体験後にプレミアム年間サポーターへお申し込みいただくと、初回は1年＋60日でご提供します（乗り換え特典）。ご契約中の個別ライセンスは満了までそのままご利用いただけます。',
  },
  {
    q: '申し込むとすぐに使えますか？',
    a: 'お申し込み後、ご入力のメールアドレス宛に確認メールをお送りします。メールのリンクを開いて「申込を確定する」を押すと（48時間以内）、その場で体験が始まり、利用開始のご案内メールが届きます。体験ライセンスはご入力の kintone ドメインに対して有効になります。確認メールが届かないときは、迷惑メールのフォルダもご確認ください。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: pageTitle,
      description: pageDesc,
      isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: 'https://kizuna-works.jp/' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
        { '@type': 'ListItem', position: 2, name: 'kintoneプラグイン', item: 'https://kizuna-works.jp/plugins/' },
        { '@type': 'ListItem', position: 3, name: 'KIZUNA Pro 年間サポーター 30日間無料体験', item: pageUrl },
      ],
    },
    {
      '@type': 'HowTo',
      '@id': pageUrl + '#how-it-works',
      name: 'KIZUNA Pro 年間サポーター 30日間無料体験の始め方',
      description: '4ステップでちょこっと＆プレミアム＆KIZUNA Pro プラグインすべてを30日間、広告なし・全機能で試せます。カード登録・お支払いの手続きはありません。',
      step: [
        { '@type': 'HowToStep', position: 1, name: '申し込む', text: '会社名・メール・kintone ドメインを入力するだけ。カード登録は不要です。' },
        { '@type': 'HowToStep', position: 2, name: '確認メールで確定', text: '届いたメールのリンクを開き「申込を確定する」を押します（48時間以内）。届かないときは迷惑メールのフォルダもご確認ください。' },
        { '@type': 'HowToStep', position: 3, name: 'すぐに使い始める', text: '確定と同時に体験が始まり、ご案内メールが届きます。対象ドメインでちょこっと＆プレミアム＆KIZUNA Pro プラグインすべてが広告なし・全機能で使えます。' },
        { '@type': 'HowToStep', position: 4, name: '30日後に決める', text: '気に入ったら続けるだけ。何もしなければ自動的に無料版に戻り、KIZUNA Pro プラグインのルールは止まります（設定は残ります）。自動課金はありません。' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  ogTitle={pageTitle}
  ogDescription={pageDesc}
  ogUrl={pageUrl}
  ogType="website"
  canonical={pageUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="pt-page">
    <!-- Hero -->
    <section class="pt-hero">
      <div class="pt-hero-inner">
        <span class="pt-hero-badge">30日間無料・全機能制限なし</span>
        <p class="pt-hero-eyebrow">KIZUNA Pro 年間サポーター 30日間無料体験</p>
        <h1 class="pt-hero-title">「全部使ってから決める」を、30日間。</h1>
        <p class="pt-hero-sub">
          KIZUNA Pro 年間サポーターとして、KIZUNA Works のちょこっと＆プレミアム＆KIZUNA Pro プラグインすべてを30日間、広告なし・全機能制限なしでお試しいただけます。カード登録不要・自動課金なし。まずは全部使ってから決められます。
        </p>
        <a href="#trial-form" class="pt-hero-cta">無料で体験を始める</a>
        <p class="pt-hero-pro-link"><a href="#pro-trial">プレミアム年間サポーターをご契約中の方は、KIZUNA Pro 拡張パックだけを試せます →</a></p>
        <p class="pt-hero-note">
          お申し込み後に届く確認メールから確定すると、すぐに使い始められます。期間終了後は自動的に無料版に戻り、KIZUNA Pro プラグインのルールは止まります（設定は残ります・勝手に課金されません）。
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section class="pt-section">
      <div class="pt-inner">
        <h2 class="pt-h2">無料体験の仕組み</h2>
        <p class="pt-lead">4ステップで、今日からちょこっと＆プレミアム＆KIZUNA Pro プラグインすべてを試せます。お支払いの手続きはありません。</p>
        <div class="pt-steps">
          <div class="pt-step">
            <div class="pt-step-num">1</div>
            <h3 class="pt-step-title">申し込む</h3>
            <p class="pt-step-desc">会社名・メール・kintone ドメインを入力するだけ。カード登録は不要です。</p>
          </div>
          <div class="pt-step pt-step-key">
            <div class="pt-step-num">2</div>
            <h3 class="pt-step-title">確認メールで確定</h3>
            <p class="pt-step-desc">届いたメールのリンクを開き「申込を確定する」を押します（48時間以内）。届かないときは迷惑メールのフォルダもご確認ください。</p>
          </div>
          <div class="pt-step">
            <div class="pt-step-num">3</div>
            <h3 class="pt-step-title">すぐに使い始める</h3>
            <p class="pt-step-desc">確定と同時に体験が始まり、ご案内メールが届きます。対象ドメインでちょこっと＆プレミアム＆KIZUNA Pro プラグインすべてが広告なし・全機能で使えます。</p>
          </div>
          <div class="pt-step">
            <div class="pt-step-num">4</div>
            <h3 class="pt-step-title">30日後に決める</h3>
            <p class="pt-step-desc">気に入ったら続けるだけ。何もしなければ自動的に無料版に戻り、KIZUNA Pro のルールは止まります（設定は残ります）。自動課金はありません。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Premium plugins list -->
    <section class="pt-section pt-section-alt">
      <div class="pt-inner">
        <h2 class="pt-h2">体験中は、全{totalCount}個のプラグインと KIZUNA Pro プラグインが使えます</h2>
        <p class="pt-lead">
          KIZUNA Pro 年間サポーターと同じ状態を、そのまま30日間お試しいただけます。KIZUNA Pro プラグインをご利用いただけるほか、プレミアムプラグイン{premiumCount}個は無料プランで制限されている機能もすべて解放され、ちょこっとプラグイン{chokottoCount}個は広告が非表示になります。
        </p>

        <h3 class="pt-plugins-sub">KIZUNA Pro プラグイン ── 体験中は使えます</h3>
        <div class="pt-plugins">
          {availablePro.map((p) => (
            <a class="pt-plugin-card" href={`/plugins/${p.slug}/`}>
              <div class="pt-plugin-thumb">
                <img src={p.image} alt={p.imageAlt} width={p.imageWidth} height={p.imageHeight} loading="lazy" />
              </div>
              <div class="pt-plugin-body">
                <h3 class="pt-plugin-name">{p.name}</h3>
                <p class="pt-plugin-desc">{p.cardDescription}</p>
              </div>
            </a>
          ))}
        </div>

        <h3 class="pt-plugins-sub pt-plugins-sub-2">プレミアムプラグイン{premiumCount}個 ── 全機能が解放されます</h3>
        <div class="pt-plugins">
          {availablePremium.map((p) => (
            <a class="pt-plugin-card" href={`/plugins/${p.slug}/`}>
              <div class="pt-plugin-thumb">
                <img src={p.image} alt={p.imageAlt} width={p.imageWidth} height={p.imageHeight} loading="lazy" />
              </div>
              <div class="pt-plugin-body">
                <h3 class="pt-plugin-name">{p.name}</h3>
                <p class="pt-plugin-desc">{p.cardDescription}</p>
              </div>
            </a>
          ))}
        </div>

        <h3 class="pt-plugins-sub pt-plugins-sub-2">ちょこっとプラグイン{chokottoCount}個 ── すべて広告なしで使えます</h3>
        <div class="pt-icons">
          {availableChokotto.map((p) => (
            <a class="pt-icon-item" href={`/plugins/${p.slug}/`} title={p.name}>
              <img class="pt-icon-img" src={iconPath(p.slug)} alt={`${p.name} のアイコン`} width="200" height="200" loading="lazy" />
              <span class="pt-icon-name">{p.name.replace(/ for kintone$/, '')}</span>
            </a>
          ))}
        </div>

        <p class="pt-note-small">
          これだけのプラグインが、体験中はすべて無料・広告なしで使えます。体験中にリリースされる新しいプラグイン（KIZUNA Pro プラグインを含む）も対象です。各プラグインの詳細は<a href="/plugins/">プラグイン一覧</a>からご確認いただけます。
        </p>
      </div>
    </section>

    <!-- Pricing / value -->
    <section class="pt-section">
      <div class="pt-inner pt-inner-narrow">
        <h2 class="pt-h2">体験のあとは</h2>
        <div class="pt-price-card">
          <div class="pt-price-name">プレミアム年間サポーター</div>
          <div class="pt-price-amount">¥16,500<span class="pt-price-unit"> / 年（税込）</span></div>
          <div class="pt-price-sub">税抜 ¥15,000 ／ 月額換算 約 1,250 円 ・ ちょこっと＆プレミアムプラグインすべてが対象</div>
          <p class="pt-price-logic">
            {PRICE_REVISION_LIVE ? (
              <><strong>プレミアムプラグインも使うならプレミアム年間サポーター</strong>です。ちょこっとプラグインだけなら年間サポーター（¥8,250/年）もお選びいただけます。</>
            ) : (
              <><strong>5プラグイン以上ご利用なら、年間サポーター（1プラグイン ¥3,300/年）を個別に買うよりお得</strong>です。プラグインが増えるほど、まとめて使えるプレミアムの価値が上がります。</>
            )}
          </p>
        </div>

        <div class="pt-scope">
          <div class="pt-scope-col pt-scope-yes">
            <h3 class="pt-scope-title">体験に含まれるもの</h3>
            <ul>
              <li>ちょこっとプラグイン＋プレミアムプラグインすべての全機能</li>
              <li>すべてのプラグインで広告が非表示</li>
              <li>KIZUNA Pro プラグイン（KIZUNAブリッジ for kintone など）</li>
              <li>期間中にリリースされる新プラグイン</li>
            </ul>
          </div>
          <div class="pt-scope-col pt-scope-no">
            <h3 class="pt-scope-title">体験に含まれないもの</h3>
            <ul>
              <li>HP サポーター一覧へのロゴ掲載（有料プレミアム特典）</li>
              <li>体験が終わったあとの KIZUNA Pro プラグインの動作（ルールは止まります。設定は残ります）</li>
            </ul>
          </div>
        </div>

        <p class="pt-note-small">
          体験のあとも KIZUNA Pro プラグインを続けるときは、<a href="/plugins/supporter/?plan=pro_set"><strong>{PRO_SET_PLAN.name}</strong>（{yen(PRO_SET_PLAN.priceInTax)}/年・税込）</a>、またはプレミアム年間サポーターへの<a href="/plugins/supporter/?plan=pro_add"><strong>{PRO_ADDON.name}</strong>の追加</a>（{yen(PRO_ADDON.priceInTax)}/年・税込）にお申し込みください。
        </p>

        <p class="pt-note-small">
          {PRICE_REVISION_LIVE ? (
            <>年間サポーターからプレミアムへは、ご契約中の年間サポーターの<strong>残りの期間に応じた差額</strong>で切り替えられます（<a href="/contact/">お問い合わせ</a>ください）。</>
          ) : (
            <>個別の年間サポーターからプレミアムへ乗り換える場合、初回は<strong>1年＋60日</strong>でご提供します。ご契約中の個別ライセンスは満了までそのままご利用いただけます。</>
          )}
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pt-section pt-section-alt">
      <div class="pt-inner pt-inner-narrow">
        <h2 class="pt-h2">よくある質問</h2>
        <div class="pt-faq">
          {faqs.map((f) => (
            <details class="pt-faq-item">
              <summary class="pt-faq-q">{f.q}</summary>
              <p class="pt-faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Trial form -->
    <TrialForm />

    <!-- KIZUNA Pro add-on pack trial (for Premium subscribers) -->
    <section class="pt-section pt-section-pro" id="pro-trial">
      <div class="pt-inner pt-inner-narrow">
        <span class="pt-pro-eyebrow">KIZUNA Pro</span>
        <h2 class="pt-h2">プレミアム年間サポーターご契約中の方：KIZUNA Pro 拡張パックを30日間無料で試す</h2>
        <p class="pt-lead">
          すでにプレミアム年間サポーターをご契約中の方は、<strong>KIZUNA Pro 拡張パックだけ</strong>を30日間無料でお試しいただけます。アプリをまたぐ作業も、プラグインの連携も自動化する <a href="/plugins/bridge/">KIZUNAブリッジ for kintone</a> など、KIZUNA Pro プラグインがすべて使えます。カード登録不要・自動課金なしです。
        </p>
        <ul class="pt-pro-points">
          <li>対象は、プレミアム年間サポーターをご契約中の kintone ドメインです（1ドメインにつき1回まで。新しい KIZUNA Pro プラグインが出たときは、もう一度お試しいただけます）。</li>
          <li>結果はご担当者のメールでお知らせします。プレミアム未契約・体験済み・拡張パックをご契約中のドメインなど、対象外の場合もメールでご案内します。</li>
          <li>体験が終わると KIZUNA Pro プラグインのルールは止まりますが、設定は残ります。続けるときは <a href="/plugins/supporter/?plan=pro_add">{PRO_ADDON.name}の追加</a>（{yen(PRO_ADDON.priceInTax)}/年・税込）にお申し込みください。</li>
          <li>プレミアム年間サポーターをまだご契約でない方は、上の「無料体験」に KIZUNA Pro プラグインが含まれます。</li>
        </ul>
      </div>
    </section>
    <TrialForm mode="pro_trial" />

    <!-- Secondary links -->
    <section class="pt-section pt-links">
      <div class="pt-inner pt-inner-narrow">
        <p>
          プラグインの詳細は<a href="/plugins/">プラグイン一覧</a>から、プランの比較や通常のお申し込みは<a href="/plugins/supporter/">サポーター申し込みページ</a>からご確認いただけます。ご不明な点は<a href="/contact/">お問い合わせ</a>ください。
        </p>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  .pt-page {
    background-color: #F0F4F8;
    color: #333333;
  }

  .pt-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 5%;
  }

  .pt-inner-narrow {
    max-width: 820px;
  }

  .pt-section {
    padding: 64px 0;
  }

  .pt-section-alt {
    background-color: #FFFFFF;
  }

  .pt-h2 {
    font-size: 1.75rem;
    color: #1B3A6B;
    text-align: center;
    margin: 0 0 12px;
    line-height: 1.4;
