---
import Layout from '../../../layouts/Layout.astro';
import ResellerCard from '../../../components/ResellerCard.astro';
import ProPlanNote from '../../../components/ProPlanNote.astro';
import Picture from '../../../components/Picture.astro';
import SecurityBox from '../../../components/SecurityBox.astro';
import PremiumFaqSection from '../../../components/PremiumFaqSection.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import RequestOriginBadge from '../../../components/RequestOriginBadge.astro';
import BridgeBadge from '../../../components/BridgeBadge.astro';
---

<Layout
  title="フリールックアップ for kintone｜自分のアプリも参照できる［取得］ボタン | KIZUNA Works"
  description="kintone のルックアップでは難しい、自分のアプリの参照・重複したキーからの取得・区分による参照先アプリの切り替え・テーブルの行ごとの取得ができるプラグイン。CSV で読み込んでも参照エラーになりません。"
  ogTitle="フリールックアップ for kintone｜自分のアプリも参照できる［取得］ボタン | KIZUNA Works"
  ogDescription="文字列（1行）フィールドの横に［取得］を出し、別のアプリ（自分のアプリも可）から値をコピー。区分で参照先を切り替え、すべてのアプリからまとめて探し、入力中に候補も出せます。テーブルは行ごとに取得、重複したキーも候補から選べます。CSV で読み込んでも参照エラーになりません。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/plugins/free-lookup/"
  ogImage="https://kizuna-works.jp/images/free-lookup-banner.png"
  canonical="https://kizuna-works.jp/plugins/free-lookup/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/plugins/free-lookup/",
          "url": "https://kizuna-works.jp/plugins/free-lookup/",
          "name": "フリールックアップ for kintone｜自分のアプリも参照できる［取得］ボタン | KIZUNA Works",
          "description": "フリールックアップ for kintone は、文字列（1行）フィールドの横に［取得］［クリア］を出し、別のアプリ（このアプリ自身も可）のレコードを探して、決めたフィールドへ値をコピーする kintone プラグイン。ルックアップフィールドを使わないため、自分のアプリの参照、重複したキーからの取得、区分による参照先アプリの切り替え、テーブルの行ごとの取得ができ、CSV で読み込んでも参照エラーにならない。",
          "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "https://kizuna-works.jp/images/free-lookup-banner.png",
            "width": 1200,
            "height": 630
          },
          "isPartOf": { "@type": "WebSite", "name": "KIZUNA Works", "url": "https://kizuna-works.jp/" }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://kizuna-works.jp/" },
            { "@type": "ListItem", "position": 2, "name": "kintoneプラグイン", "item": "https://kizuna-works.jp/plugins/" },
            { "@type": "ListItem", "position": 3, "name": "フリールックアップ for kintone", "item": "https://kizuna-works.jp/plugins/free-lookup/" }
          ]
        },
        {
          "@type": "SoftwareApplication",
          "name": "フリールックアップ for kintone",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "kintone",
          "softwareVersion": "1.3.0",
          "dateModified": "2026-10-23",
          "url": "https://kizuna-works.jp/plugins/free-lookup/",
          "downloadUrl": "https://kizuna-works.jp/downloads/kw-free-lookup-v1.3.0.zip",
          "image": "https://kizuna-works.jp/images/free-lookup-banner.png",
          "offers": {
            "@type": "Offer",
            "name": "プレミアム年間サポーター（ちょこっと＆プレミアムプラグインすべて込み）",
            "price": "16500",
            "priceCurrency": "JPY",
            "availability": "https://schema.org/InStock",
            "description": "プレミアム年間サポーター（税込 ¥16,500/年）に含まれます。単品販売はありません。無料プランでもフリールックアップ1つ（参照先は固定のみ）で利用できます。"
          },
          "description": "フリールックアップ for kintone は、文字列（1行）フィールドの横に［取得］［クリア］を出し、別のアプリ（このアプリ自身も可）のレコードを探して、決めたフィールドへ値をコピーする。kintone のルックアップフィールドは使わない。キーに入れたキーワードで参照先を探し、1件ならそのままコピー、複数なら候補の一覧から選ぶ。探すフィールドは最大3つで、部分一致で1文字から探せる。件数の多いアプリでは、先頭の500件を表示し、入力したキーワードでkintone側から探す。参照先は区分などの値で切り替えられ、［取得］のときに利用者が選ぶことも、すべての参照先からまとめて探すこともできる。キーに文字を入力している間、キーの下に候補を出す設定もある。テーブルの中では行ごとに取得でき、参照先の絞り込みの初期設定はフィールド・条件・比べる値を選んで作り、このレコードの値・今日・ログインユーザーと比べられる。取得元のレコードを新しいタブで開くリンクも出せる。キーが同じ候補は、このアプリのフィールドと参照先のフィールドまたは決まった値との照合（最大3行）で1件に決めて取得できる。",
          "publisher": { "@type": "Organization", "name": "KIZUNA Works", "url": "https://kizuna-works.jp" },
          "featureList": [
            "文字列（1行）フィールドの横に［取得］［クリア］を表示（ルックアップフィールドは不要）",
            "別のアプリに加え、このアプリ自身のレコードも参照できる",
            "区分などの値で参照先のアプリを切り替え（最大5つ）",
            "［取得］のときに利用者が参照先のアプリを選ぶ",
            "［取得］で、すべての関連付けるアプリからまとめて探す（候補の一覧の左端に参照先の列）",
            "入力中に、キーのフィールドの下へ候補を出す（上から8件・↓↑とEnterまたはクリックで取得）",
            "取得できたことが分かる案内と、参照先を変えて取り直したときに前の値が残らない動き",
            "キーが同じ候補を「1 件に決める照合」で絞り、1 件に決まればそのまま取得（最大3行・すべて満たすもの・決まった値と比べて取得する参照先を選ぶこともできる）",
            "テーブルの行ごとに取得・クリア",
            "キーが重複していても候補の一覧から選べる（1 件に決める照合も設定できる）",
            "探すフィールドを最大3つ選べる部分一致の検索（1文字から・空白区切りでAND）",
            "件数の多いアプリでも速く探せる（先頭の500件を表示し、入力したキーワードでkintone側から探す。2文字以上の語は1万件を超えるアプリでも全件から探せる）",
            "候補の一覧に表示するフィールドを最大10個まで選べる",
            "候補の一覧に件数表示と［前へ］［次へ］（100件ずつ）・キーボード操作（↑↓・Enter）",
            "CSV で読み込んでも参照エラーにならない（キーはただの文字列）",
            "ルックアップのコピー先を書き換えられなくするプラグインと一緒に使っても、取得した値がそのまま入る",
            "取得元のレコードを新しいタブで開く「↗ 開く」リンク",
            "絞り込みの初期設定を選んで作れる（このレコードの値・今日・ログインユーザーと比較）",
            "キーを書き換えたまま［取得］していなければ保存させない",
            "条件分岐フォーム v3.0.0 以降と併用可（読み込み順は不問）",
            "標準のルックアップと同じアプリ・同じテーブルの行で併用可",
            "既存のルックアップを置き換えられる（設定とキーの値をボタンで写し、削除するまでは今のルックアップが動く）",
            "パソコン・スマートフォン・ゲストスペース対応"
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }
    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0,0,0,0.08);
    }

    .afp-hero {
      background: linear-gradient(135deg, rgba(21,41,77,0.72) 0%, rgba(27,58,107,0.55) 60%, rgba(46,139,46,0.5) 130%),
                  url('/images/premium-plugins-bg.png') center center / cover no-repeat;
      background-color: #1B3A6B;
      color: #fff;
      padding: 56px 5% 48px;
      text-align: center;
    }
    .afp-hero-icon {
      width: 132px; height: 132px; object-fit: contain; display: block; margin: 0 auto 16px;
      background: rgba(255,255,255,0.14); border-radius: 24px; padding: 10px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }
    .afp-hero-badges { display: flex; gap: 10px; justify-content: center; align-items: center; margin-bottom: 14px; flex-wrap: wrap; row-gap: 8px; }
    .afp-badge-premium {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.5);
      color: #fff; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.06em;
      padding: 6px 14px; border-radius: 20px; line-height: 1;
    }
    .afp-badge-premium .crown { display: block; line-height: 1; font-size: 1.02em; }
    .afp-badge-premium .label { display: block; line-height: 1; }
    .afp-hero-version {
      display: inline-flex; align-items: center; line-height: 1;
      background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.4);
      color: #fff; font-weight: 700; font-size: 0.82rem; padding: 6px 12px; border-radius: 20px;
    }
    .afp-hero h1 { font-size: 2.1rem; font-weight: 700; margin: 0 0 10px; letter-spacing: 0.04em; }
    .afp-hero .afp-tagline { font-size: 1.15rem; font-weight: 600; margin: 0 0 8px; }
    .afp-hero .afp-sub { font-size: 1rem; opacity: 0.92; margin: 0 auto; max-width: 760px; line-height: 1.8; }
    .afp-hero-points {
      list-style: none; padding: 0; margin: 22px auto 0; max-width: 860px;
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; text-align: left;
    }
    .afp-hero-points li {
      min-width: 0; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.32);
      border-radius: 10px; padding: 12px 16px 12px 40px; position: relative; line-height: 1.6; font-size: 0.98rem;
    }
    .afp-hero-points li::before {
      content: "\2713"; position: absolute; left: 14px; top: 12px;
      color: #7ee07e; font-weight: 700;
    }
    .afp-hero-points li span { display: block; font-size: 0.84rem; opacity: 0.85; margin-top: 2px; }
    @media (max-width: 700px) { .afp-hero-points { grid-template-columns: minmax(0, 1fr); } }
    .afp-hero-cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 26px; }
    .afp-hero-btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 48px; padding: 0 26px; border-radius: 26px;
      font-weight: 700; font-size: 1rem; text-decoration: none; line-height: 1.3;
    }
    .afp-hero-btn.is-primary { background: #2E8B2E; color: #fff; box-shadow: 0 6px 16px rgba(0,0,0,0.22); }
    .afp-hero-btn.is-primary:hover { background: #35a035; }
    .afp-hero-btn.is-ghost { background: rgba(255,255,255,0.14); color: #fff; border: 1px solid rgba(255,255,255,0.6); }
    .afp-hero-btn.is-ghost:hover { background: rgba(255,255,255,0.24); }
    @media (max-width: 600px) { .afp-hero-btn { width: 100%; } }

    .afp-hero-gradient-line { height: 6px; background: linear-gradient(to right, var(--color-navy), var(--color-green)); }

    .afp-wrap { max-width: 1100px; margin: 0 auto; padding: 0 5%; }
    .afp-section { padding: 56px 0; }
    .afp-section.alt { background: #fff; }
    .afp-h2 {
      font-size: 1.7rem; color: var(--color-navy); margin: 0 0 28px; padding-left: 16px;
      border-left: 5px solid var(--color-green);
    }
    .afp-lead {
      font-size: 1.08rem; line-height: 1.9; color: var(--color-text-main);
      background: #fff; border-radius: 12px; padding: 28px 32px; box-shadow: var(--shadow-card);
      margin: 0 0 26px;
    }
    .afp-lead strong { color: var(--color-navy); }

    .afp-ps-list { display: flex; flex-direction: column; gap: 14px; margin-top: 8px; }
    .afp-ps { display: grid; grid-template-columns: 1fr 40px 1fr; align-items: stretch; gap: 0; }
    .afp-ps-before, .afp-ps-after { min-width: 0; border-radius: 10px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; line-height: 1.6; }
    .afp-ps-before { background: #fff; border: 1px dashed #cbd5e1; color: #475569; }
    .afp-ps-before .afp-ps-tag { color: #b91c1c; }
    .afp-ps-before strong { color: #334155; font-size: 1rem; }
    .afp-ps-after { background: #fff; border: 2px solid var(--color-green, #2E8B2E); box-shadow: var(--shadow-card); }
    .afp-ps-after strong { color: var(--color-navy, #1B3A6B); font-size: 1.05rem; }
    .afp-ps-tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; color: #64748b; }
    .afp-ps-after .afp-ps-tag { color: var(--color-green, #2E8B2E); }
    .afp-ps-ex { font-size: 0.85rem; color: #64748b; }
    .afp-ps-after a { align-self: flex-start; margin-top: 4px; font-size: 0.85rem; font-weight: 700; color: var(--color-green, #2E8B2E); text-decoration: none; }
    .afp-ps-after a:hover { text-decoration: underline; }
    .afp-ps-arrow { display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 700; color: var(--color-green, #2E8B2E); }
    @media (max-width: 720px) {
      .afp-ps { grid-template-columns: 1fr; }
      .afp-ps-arrow { transform: rotate(90deg); height: 30px; }
    }
    .afp-grid-feats { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
    .afp-feat-card { background: #fff; border-radius: 10px; padding: 24px; box-shadow: var(--shadow-card); }
    .afp-feat-card h3 { font-size: 1.1rem; color: var(--color-navy); margin: 0 0 10px; }
    .afp-feat-card p { font-size: 0.95rem; line-height: 1.75; margin: 0; }

    .afp-shot { max-width: 960px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: var(--shadow-card); overflow: hidden; }
    .afp-shot + .afp-shot,
    .afp-shot + .afp-cautions,
    .afp-shot + .afp-note,
    .afp-shot + .afp-grid-feats { margin-top: 26px; }
    .afp-shot img { width: 100%; height: auto; display: block; background: #F0F4F8; cursor: zoom-in; }
    .afp-shot-cap { text-align: center; font-size: 0.9rem; color: var(--color-text-muted); margin: 12px 0 0; }
    .afp-shot-w340 { max-width: 340px; }
    .afp-shot-w380 { max-width: 380px; }
    .afp-shot-w420 { max-width: 420px; }
    .afp-shot-w520 { max-width: 520px; }
    .afp-shot-w560 { max-width: 560px; }
    .afp-shot-w640 { max-width: 640px; }
    .afp-shot-w720 { max-width: 720px; }
    .afp-shot-w840 { max-width: 840px; }

    .afp-tablewrap { overflow-x: auto; }
    table.afp-compare { border-collapse: collapse; width: 100%; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: var(--shadow-card); min-width: 520px; }
    table.afp-compare th, table.afp-compare td { border: 1px solid #e2e8f0; padding: 12px 14px; text-align: left; }
    table.afp-compare thead th { background: var(--color-navy); color: #fff; }
    table.afp-compare td.c, table.afp-compare th.c { text-align: center; }
    table.afp-compare tbody tr:nth-child(even) { background: #f8fafc; }

    .afp-plan-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-bottom: 44px; align-items: stretch; }
    .afp-plan-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 34px 28px 30px; box-shadow: var(--shadow-card); position: relative; text-align: center; display: flex; flex-direction: column; }
    .afp-plan-card.recommended { border: 2px solid var(--color-green); }
    .afp-plan-badge { position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: var(--color-green); color: #fff; font-weight: 700; font-size: 0.82rem; padding: 6px 18px; border-radius: 20px; white-space: nowrap; }
    .afp-plan-name { font-size: 1.3rem; color: var(--color-navy); margin: 0 0 18px; }
    .afp-plan-price { margin-bottom: 6px; }
    .afp-plan-price .amt { font-size: 2.4rem; font-weight: 700; color: var(--color-navy); }
    .afp-plan-price .unit { font-size: 0.95rem; color: var(--color-text-muted); margin-left: 4px; }
    .afp-plan-discount { color: var(--color-green); font-weight: 700; font-size: 0.92rem; margin-bottom: 16px; }
    .afp-plan-features { list-style: none; padding: 0; margin: 18px 0 24px; text-align: left; flex-grow: 1; }
    .afp-plan-features li { font-size: 0.95rem; line-height: 1.7; padding: 9px 0; border-bottom: 1px solid #eef2f7; }
    .afp-plan-cta { display: block; background: var(--color-navy); color: #fff; font-weight: 700; padding: 14px 20px; border-radius: 8px; text-decoration: none; transition: background .2s, transform .2s, box-shadow .2s; }
    .afp-plan-card.recommended .afp-plan-cta { background: var(--color-green); }
    .afp-plan-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(0,0,0,0.16); }

    .afp-note { background: #fff8e6; border-left: 4px solid #e0a400; padding: 14px 16px; border-radius: 0 8px 8px 0; margin: 16px 0; line-height: 1.7; }
    .afp-cautions { background: #fff; border-radius: 10px; padding: 24px 28px; box-shadow: var(--shadow-card); }
    .afp-cautions li { margin: 8px 0; line-height: 1.7; }
    .afp-cautions-title { margin: 0 0 6px; font-weight: 700; color: var(--color-navy); }
    #replace, #switch, #search, #filter, #import { scroll-margin-top: 90px; }
    .afp-replace-link { margin: 20px 0 0; font-size: 15px; }
    .afp-replace-link a { color: var(--color-navy); font-weight: 700; }
    /* Accordion for the replacement guide */
    .afp-acc { background: #fff; border-radius: 10px; box-shadow: var(--shadow-card); margin: 14px 0; }
    .afp-acc > summary {
      list-style: none; cursor: pointer; padding: 18px 52px 18px 22px; position: relative;
      font-weight: 700; color: var(--color-navy); font-size: 16px; line-height: 1.6;
    }
    .afp-acc > summary::-webkit-details-marker { display: none; }
    .afp-acc > summary::after {
      content: "+"; position: absolute; right: 20px; top: 50%; transform: translateY(-50%);
      width: 26px; height: 26px; border-radius: 50%; background: #eef2f7;
      display: flex; align-items: center; justify-content: center; font-size: 18px; line-height: 1;
    }
    .afp-acc[open] > summary::after { content: "\2212"; }
    .afp-acc > summary:hover { background: #f7f9fc; border-radius: 10px; }
    .afp-acc-body { padding: 0 22px 20px; min-width: 0; }
    .afp-acc-body > ul { margin: 0; padding-left: 20px; }
    .afp-acc-body > ul li { margin: 8px 0; line-height: 1.7; }
    .afp-acc-body > .afp-note { margin: 0; }

    .afp-cta { background: linear-gradient(135deg, #15294d 0%, #1B3A6B 60%, #2E8B2E 140%); color: #fff; text-align: center; padding: 56px 5%; }
    .afp-cta h2 { font-size: 1.6rem; margin: 0 0 12px; }
    .afp-cta p { font-size: 1.05rem; opacity: 0.95; max-width: 640px; margin: 0 auto 24px; line-height: 1.8; }
    .afp-cta-btn { display: inline-block; background: #fff; color: var(--color-navy); font-weight: 700; font-size: 1.05rem; padding: 16px 36px; border-radius: 10px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
    .afp-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,0.3); }

    .zoomable { cursor: zoom-in; }
    .afp-zoomhint { text-align: center; font-size: 0.82rem; color: var(--color-text-muted); margin: 10px 0 0; }

    .steps-list { list-style: none; padding: 0; margin: 8px 0 4px; counter-reset: afpstep; }
    .steps-list li { display: flex; gap: 20px; align-items: flex-start; padding: 18px 0; border-top: 1px dashed #d7dee8; line-height: 1.9; }
    .steps-list li:first-child { border-top: none; }
    .steps-list li::before {
      counter-increment: afpstep; content: counter(afpstep);
