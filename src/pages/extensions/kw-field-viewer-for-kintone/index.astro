---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="KW Field Viewer for kintone - Chrome拡張機能 | KIZUNA Works"
  description="kintoneアプリのフィールドコード・フィールドタイプを画面上にオーバーレイ表示する無料Chrome拡張機能。CSV/JSON/Markdown/HTML出力対応。kintone カスタマイズ開発・API連携開発を爆速化する開発者向けツール。"
  ogTitle="KW Field Viewer for kintone - Chrome拡張機能 | KIZUNA Works"
  ogDescription="kintoneのフィールドコードを画面上にオーバーレイ表示する無料Chrome拡張機能。CSV/JSON/Markdown/HTML出力対応。kintone カスタマイズ開発を爆速化。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/extensions/kw-field-viewer-for-kintone/"
  ogImage="https://kizuna-works.jp/images/extensions/kw-field-viewer-banner.png"
  canonical="https://kizuna-works.jp/extensions/kw-field-viewer-for-kintone/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/extensions/kw-field-viewer-for-kintone/",
          "url": "https://kizuna-works.jp/extensions/kw-field-viewer-for-kintone/",
          "name": "KW Field Viewer for kintone - Chrome拡張機能 | KIZUNA Works",
          "description": "kintoneアプリのフィールドコード・フィールドタイプを画面上にオーバーレイ表示する無料Chrome拡張機能。",
          "isPartOf": {
