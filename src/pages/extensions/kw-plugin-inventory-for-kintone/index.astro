          "applicationCategory": "BusinessApplication",
          "applicationSubCategory": "BrowserExtension",
          "operatingSystem": "Chrome",
          "url": "https://kizuna-works.jp/extensions/kw-plugin-inventory-for-kintone/",
          "image": "https://kizuna-works.jp/images/extensions/kw-plugin-inventory-banner.png",
          "screenshot": [
