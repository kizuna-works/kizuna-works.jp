---
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';

const PAGE_URL = 'https://kizuna-works.jp/extensions/kw-plugin-inventory-for-kintone/';

// FAQ: the same array renders the visible accordion and the FAQPage JSON-LD,
// so the two can never drift apart (Google requires them to match exactly).
const faqs = [
  {
    q: 'kintone の標準機能とは何が違いますか？',
    a: 'kintone のシステム管理の［プラグイン］画面でも、どのプラグインがどのアプリに追加されているかは確認でき、CSV でも出力できます。KW Plugin Inventory for kintone はそれに加えて、JavaScript／CSS カスタマイズまで含めて全アプリを1つのレポートにまとめること、未反映の変更・外部ドメインからの読み込み・「アプリの管理者だけ」に適用したままの設定など見直しが必要なものを自動で判定すること、KIZUNA Works 製プラグインに新しい版があるかを確認すること、Excel や PDF などの整形済みの形式で出力できることが異なります。引き継ぎ資料や監査、情報システム部門への報告にそのまま使えます。',
  },
  {
    q: 'kintone の設定が変わることはありますか？',
    a: 'ありません。kintone へのリクエストは読み取り（GET）のみで、設定は一切変更しません。レコードのデータ（業務データ）も読み取りません。',
  },
  {
    q: '取得した情報はどこかに送信されますか？',
    a: '送信しません。取得した情報はお使いのブラウザ内だけで処理します。外部との通信は、当方が公開している最新版の一覧（https://kizuna-works.jp/versions.json）の取得のみで、設定でオフにできます。',
  },
  {
    q: 'cybozu.com 共通管理者でなくても使えますか？',
    a: '使えます。その場合は、実行した方にアプリ管理権限のあるアプリが対象になります。権限がなく読めなかったアプリは「取得不可」として一覧に出ます。なお、どのアプリにも使われていないプラグインの判定は、cybozu.com 共通管理者が実行して最後まで取得できたときだけ行います。',
  },
  {
    q: 'ゲストスペースのアプリも対象になりますか？',
    a: '対象になります。ゲストスペースのアプリは、自動でゲストスペースの送信先に切り替えて取得します。設定画面のゲストスペースIDは、それでも取得できない場合の補助です。',
  },
  {
    q: 'アプリが多いと時間がかかりますか？',
    a: '当社の検証環境（81アプリ・71プラグイン）では、約420回の読み取りで、約1分以内に取得が完了しました。同時実行数は設定で1〜5（既定3）から選べます。途中で［中止］を押すと、取得できた分までを表示します。',
  },
  {
    q: 'Microsoft Edge でも使えますか？',
    a: 'Google Chrome 専用です。Microsoft Edge は対象外です。',
  },
  {
    q: '料金はかかりますか？',
    a: '完全無料です。課金・アカウント登録・ライセンス認証はありません。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${PAGE_URL}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="kintone のプラグイン・カスタマイズ棚卸し Chrome拡張機能 - KW Plugin Inventory | KIZUNA Works"
  description="kintoneの全アプリのプラグインとJavaScript/CSSカスタマイズを読み取り、未反映の変更・外部ドメインからの読込・使われていないカスタマイズなど見直しが必要なものを自動で一覧にする無料Chrome拡張機能。Excel・PDF出力に対応し、引き継ぎや監査に使えます。"
  ogTitle="kintone のプラグイン・カスタマイズ棚卸し Chrome拡張機能 - KW Plugin Inventory | KIZUNA Works"
  ogDescription="kintoneの全アプリのプラグインとJavaScript/CSSカスタマイズを読み取り、未反映の変更・外部ドメインからの読込・使われていないカスタマイズなど見直しが必要なものを自動で一覧にする無料Chrome拡張機能。Excel・PDF出力に対応し、引き継ぎや監査に使えます。"
  ogType="website"
  ogUrl="https://kizuna-works.jp/extensions/kw-plugin-inventory-for-kintone/"
  ogImage="https://kizuna-works.jp/images/extensions/kw-plugin-inventory-banner.png"
  canonical="https://kizuna-works.jp/extensions/kw-plugin-inventory-for-kintone/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
