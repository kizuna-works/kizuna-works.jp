            { "@type": "ListItem", "position": 2, "name": "Chrome拡張機能", "item": "https://kizuna-works.jp/extensions/" },
            { "@type": "ListItem", "position": 3, "name": "KW Plugin Inventory for kintone", "item": "https://kizuna-works.jp/extensions/kw-plugin-inventory-for-kintone/" }
