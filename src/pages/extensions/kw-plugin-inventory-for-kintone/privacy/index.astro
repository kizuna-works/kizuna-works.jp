          "url": "https://kizuna-works.jp/extensions/kw-plugin-inventory-for-kintone/privacy/",
          "name": "プライバシーポリシー - KW Plugin Inventory for kintone",
          "description": "Chrome拡張機能「KW Plugin Inventory for kintone」のプライバシーポリシー。",
          "dateModified": "2026-10-16",
          "isPartOf": {
            "@type": "WebSite",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://kizuna-works.jp/" },
            { "@type": "ListItem", "position": 2, "name": "Chrome拡張機能", "item": "https://kizuna-works.jp/extensions/" },
            { "@type": "ListItem", "position": 3, "name": "KW Plugin Inventory for kintone", "item": "https://kizuna-works.jp/extensions/kw-plugin-inventory-for-kintone/" },
            { "@type": "ListItem", "position": 4, "name": "プライバシーポリシー", "item": "https://kizuna-works.jp/extensions/kw-plugin-inventory-for-kintone/privacy/" }
