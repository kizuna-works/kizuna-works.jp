---
import Layout from '../../layouts/Layout.astro';
import { tools, toolAbsUrl } from '../../data/tools';
import Picture from '../../components/Picture.astro';

// kintone-specific tools are surfaced as a distinct group above the generic web tools.
const kintoneTools = tools.filter((t) => t.kintoneNative);
const genericTools = tools.filter((t) => !t.kintoneNative);
const toolGroups = [
  kintoneTools.length
    ? {
        title: 'kintone専用ツール',
        lead: 'kintoneユーザーのための専用ツール。kintoneの業務に直結する機能を、インストール・登録不要の完全無料で提供しています。',
        items: kintoneTools,
      }
    : null,
  {
    title: '汎用Webツール',
    lead: '業種を問わず使える、ブラウザ完結型の便利ツール。電子印鑑・PDF編集・QRコード作成・画像変換など、インストール・登録不要で使えます。',
    items: genericTools,
  },
].filter((g): g is NonNullable<typeof g> => g !== null);

// JSON-LD derived from the tools data file (ItemList stays in sync automatically).
const toolsJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://kizuna-works.jp/tools/',
      url: 'https://kizuna-works.jp/tools/',
      name: '無料Webツール一覧 | KIZUNA Works',
      description:
        'インストール不要・登録不要で使える無料Webツール。電子印鑑メーカーなど、ブラウザだけで完結する便利ツールを公開中。',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
        { '@type': 'ListItem', position: 2, name: '無料Webツール', item: 'https://kizuna-works.jp/tools/' },
      ],
    },
    {
      '@type': 'ItemList',
      itemListElement: tools.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: t.name,
          url: toolAbsUrl(t),
          applicationCategory: t.applicationCategory,
          operatingSystem: 'WebBrowser',
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
        },
      })),
    },
  ],
};
---

<Layout
  title="無料Webツール一覧 - 電子印鑑・PDF捺印・QRコード作成 | KIZUNA Works"
  description="インストール不要・登録不要のブラウザ完結型 無料Webツール一覧。電子印鑑メーカー、PDF捺印、PDF結合分割、QRコード作成、画像マスキング、画像圧縮・変換、PDF→HTML変換など、業務効率化に役立つ便利ツールを KIZUNA Works が無料で公開中です。"
  ogTitle="無料Webツール一覧 - 電子印鑑・PDF捺印・QRコード作成 | KIZUNA Works"
  ogDescription="インストール不要・登録不要のブラウザ完結型 無料Webツール一覧。電子印鑑メーカー、PDF捺印、PDF結合分割、QRコード作成、画像マスキング、画像圧縮・変換、PDF→HTML変換など、業務効率化に役立つ便利ツールを KIZUNA Works が無料で公開中です。"
  ogUrl="https://kizuna-works.jp/tools/"
  canonical="https://kizuna-works.jp/tools/"
  heroBg="/images/tools-bg.webp"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(toolsJsonLd)} />
  </Fragment>

  <style is:global>
    body {
      background-color: #f4f7f6;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* Hero Section */
    .hero {
      background:
        linear-gradient(135deg, rgba(27,58,107,0.45) 0%, rgba(42,82,152,0.4) 100%),
        url('/images/tools-bg.webp') center center / cover no-repeat;
      color: #FFFFFF;
      padding: 80px 20px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(90deg, #1B3A6B 0%, #2E8B2E 100%);
    }

    .hero h1 {
      font-size: 2.4rem;
      font-weight: 900;
      letter-spacing: 2px;
      margin-bottom: 15px;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .hero p {
      font-size: 1.15rem;
      font-weight: 500;
      opacity: 0.95;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Intro Section */
    .intro-section {
      padding: 60px 20px 40px;
      background-color: #f4f7f6;
    }

    .intro-card {
      background-color: #FFFFFF;
      max-width: 800px;
      margin: 0 auto;
      border-radius: 16px;
      padding: 40px 50px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      text-align: center;
    }

    .intro-card h2 {
      color: #1B3A6B;
      font-size: 1.6rem;
      margin-bottom: 20px;
      font-weight: 700;
      position: relative;
      display: inline-block;
    }

    .intro-card h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 40px;
      height: 3px;
      background-color: #2E8B2E;
      border-radius: 2px;
    }

    .intro-card p {
      color: #4a5568;
      font-size: 1.05rem;
      line-height: 1.8;
    }

    /* Tools Grid Section */
    .tools-grid-section {
      padding: 0 20px 80px;
      background-color: #f4f7f6;
      flex: 1;
    }

    .tools-group {
      max-width: 1100px;
      margin: 0 auto 50px;
    }

    .tools-group:last-child {
      margin-bottom: 0;
    }

    .tools-group-title {
      color: #1B3A6B;
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 6px;
      padding-left: 14px;
      border-left: 5px solid #2E8B2E;
    }

    .tools-group-lead {
      color: #4a5568;
      font-size: 0.98rem;
      line-height: 1.7;
      margin: 0 0 22px;
      padding-left: 14px;
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 30px;
    }

    .tool-card {
      background-color: #FFFFFF;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border-top: 4px solid transparent;
    }

    .tool-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(27, 58, 107, 0.12);
      border-top-color: #2E8B2E;
    }

    .tool-image-wrapper {
      background-color: #e2e8f0;
      height: 200px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .tool-image-wrapper--dark {
      background: linear-gradient(135deg, #1a1b20 0%, #23252c 100%);
      flex-direction: column;
      gap: 12px;
    }

    .tool-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .tool-card:hover .tool-image-wrapper img {
      transform: scale(1.05);
    }

    .tool-content {
      padding: 25px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .tool-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }

    .tool-tag {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      background-color: #f1f5f9;
      color: #64748b;
    }

    .tool-tag.highlight {
      background-color: #e6f4e6;
      color: #2E8B2E;
    }

    .tool-content h3 {
      font-size: 1.4rem;
      color: #1B3A6B;
      margin-bottom: 15px;
      font-weight: 700;
    }

    .tool-content p {
      color: #4a5568;
      font-size: 0.95rem;
      margin-bottom: 25px;
      flex: 1;
    }

    .tool-btn {
      display: inline-block;
      text-align: center;
      background-color: #2E8B2E;
      color: #FFFFFF;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 30px;
      transition: all 0.3s ease;
      width: 100%;
    }

    .tool-btn:hover {
      background-color: #1B3A6B;
      color: #FFFFFF;
    }

    @media (max-width: 768px) {
      .hero {
        padding: 60px 20px;
      }
      .hero h1 {
        font-size: 1.8rem;
      }
      .intro-section {
        padding: 40px 15px 30px;
      }
      .intro-card {
        padding: 30px 20px;
      }
      .intro-card h2 {
        font-size: 1.4rem;
      }
      .tools-grid-section {
        padding: 0 15px 60px;
      }
      .tools-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main>
  <section class="hero">
    <h1>無料Webツール</h1>
    <p>インストール不要・登録不要。ブラウザだけで使える便利ツールを無料で公開しています</p>
  </section>

  <section class="intro-section">
    <div class="intro-card">
      <h2>ツールの特長</h2>
      <p>KIZUNA Worksが提供する無料Webツールは、すべてブラウザ上で動作し、インストールやアカウント登録は一切不要です。誰でもすぐに、安全にご利用いただけます。業務効率化やペーパーレス化に役立つツールを順次公開しています。</p>
    </div>
  </section>

  <section class="tools-grid-section">
    {toolGroups.map((group) => (
      <div class="tools-group">
        <h2 class="tools-group-title">{group.title}</h2>
        <p class="tools-group-lead">{group.lead}</p>
        <div class="tools-grid">
          {group.items.map((tool) => (
            <article class="tool-card">
              {tool.image ? (
                <div class="tool-image-wrapper">
                  <Picture src={tool.image} alt={tool.imageAlt} width={tool.imageWidth} height={tool.imageHeight} card />
                </div>
              ) : (
                <div class="tool-image-wrapper tool-image-wrapper--dark">
                  <Fragment set:html={tool.svg} />
                  <span style="color: #c8a872; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em;">{tool.svgLabel}</span>
                </div>
              )}
              <div class="tool-content">
                <div class="tool-tags">
                  {tool.tags.map((tag, i) => (
                    <span class={i === 0 ? 'tool-tag highlight' : 'tool-tag'}>{tag}</span>
                  ))}
                </div>
                <h3>{tool.name}</h3>
                <p>{tool.description}</p>
                <a href={`/tools/${tool.file}`} class="tool-btn">無料で使う</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>
  </main>
</Layout>
