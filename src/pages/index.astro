---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BlogCard from '../components/BlogCard.astro';
import InstallRankingTop3 from '../components/InstallRankingTop3.astro';
import { allPlugins as plugins } from '../data/plugins';
import { extensions } from '../data/extensions';
import { tools } from '../data/tools';

// Newest first — for problems list and the homepage compact showcase.
const pluginsNewestFirst = [...plugins].reverse();
// Showcase grid: latest 6 plugins (newest first).
const showcasePlugins = pluginsNewestFirst.slice(0, 6);

// kintone-specific tools get a dedicated featured block; generic tools fill the compact grid.
const featuredKintoneTool = tools.find((t) => t.file === 'Shirushi.html');
const obiTool = tools.find((t) => t.file === 'Obi.html');
const genericTools = tools.filter((t) => !t.kintoneNative);

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 新着: latest 3 by pubDate
const recentPosts = allPosts.slice(0, 3);

// お知らせ最新3件
const recentNews = (await getCollection('news'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const newsCategoryLabels: Record<string, string> = {
  release: '新着リリース',
  update: 'アップデート',
  incident: '障害情報',
  notice: 'お知らせ',
};
const fmtNewsDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// 人気: hand-curated for visitors looking to compare/decide
const popularSlugs = [
  'kintone-kensaku-plugin-hikaku',
  'kintone-design-plugin-osusume',
  'kintone-teichaku-shinai-riyu',
];
const popularPosts = popularSlugs
  .map((slug) => allPosts.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// プラグイン解説: posts tagged "プラグイン"
const pluginPosts = allPosts
  .filter((p) => Array.isArray(p.data.tags) && p.data.tags.includes('プラグイン'))
  .slice(0, 3);
---

<Layout
  title="KIZUNA Works | kintone プラグイン 無料配布・業務効率化ツール"
  description="KIZUNA Worksは、kintoneプラグインと業務効率化ツールを無料で提供。フィールドスタイラー・自動採番・FormDeco等の無料プラグインや、電子印鑑メーカー・PDF捺印・PDF結合分割等のブラウザ完結型無料Webツールを配布中。kintone プラグイン 無料お試し可能。"
  ogTitle="KIZUNA Works | kintone プラグイン 無料配布・業務効率化ツール"
  ogDescription="KIZUNA Worksの無料プラグインと無料Webツール。フィールドスタイラー・自動採番等のkintoneプラグインに加え、電子印鑑メーカー等のブラウザ完結型ツールを配布。kintone プラグイン 無料配布中。"
  ogUrl="https://kizuna-works.jp/"
  canonical="https://kizuna-works.jp/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/",
          "url": "https://kizuna-works.jp/",
          "name": "KIZUNA Works | kintone プラグイン 無料配布・業務効率化ツール",
          "description": "KIZUNA Worksは、kintoneプラグインと業務効率化ツールを無料で提供するサービス。kintone プラグイン 無料配布中。"
        },
        {
          "@type": "WebSite",
          "@id": "https://kizuna-works.jp/#website",
          "url": "https://kizuna-works.jp/",
          "name": "KIZUNA Works",
          "description": "kintoneプラグインと業務効率化ツールを無料で提供。kintone プラグイン 無料配布中。",
          "inLanguage": "ja"
        },
        {
          "@type": "Organization",
          "@id": "https://kizuna-works.jp/#organization",
          "name": "KIZUNA Works",
          "url": "https://kizuna-works.jp/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://kizuna-works.jp/images/logo.png"
          },
          "sameAs": [
            "https://twitter.com/KIZUNA_works_DX"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "info@kizuna-works.jp",
            "contactType": "customer service"
          }
        }
      ]
    }
    </script>
  </Fragment>
  <style is:global>
    body { background-color: #FFFFFF; }

    /* =========================================
       Utility
    ========================================= */
    .bg-light { background-color: #f4f7f6; }
    .bg-white { background-color: #FFFFFF; }
    .text-center { text-align: center; }
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 80px 20px;
    }

    /* =========================================
       Section Titles
    ========================================= */
    .section-title {
      text-align: center;
      color: #1B3A6B;
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 50px;
      position: relative;
      padding-bottom: 15px;
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 4px;
      background-color: #2E8B2E;
      border-radius: 2px;
    }

    /* =========================================
       Buttons
    ========================================= */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 32px;
      font-size: 1.05rem;
      font-weight: 700;
      border-radius: 30px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-primary {
      background-color: #2E8B2E;
      color: #FFFFFF;
      box-shadow: 0 4px 15px rgba(46, 139, 46, 0.3);
    }

    .btn-primary:hover {
      background-color: #1B3A6B;
      color: #FFFFFF;
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(27, 58, 107, 0.4);
    }

    .btn-outline {
      background-color: transparent;
      color: #FFFFFF;
      border: 2px solid #FFFFFF;
    }

    .btn-outline:hover {
      background-color: #FFFFFF;
      color: #1B3A6B;
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(255, 255, 255, 0.3);
    }

    /* =========================================
       Hero Section
    ========================================= */
    .hero {
      background:
        linear-gradient(135deg, rgba(13,33,71,0.75) 0%, rgba(27,58,107,0.7) 40%, rgba(42,82,152,0.65) 70%, rgba(26,107,74,0.7) 100%),
        url('/images/hero-bg.webp') center center / cover no-repeat;
      color: #FFFFFF;
      padding: 120px 20px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
      border-radius: 50%;
    }

    .hero::after {
      content: '';
      position: absolute;
      bottom: -30%;
      right: -5%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(46,139,46,0.15) 0%, rgba(46,139,46,0) 70%);
      border-radius: 50%;
    }

    .hero-inner {
      max-width: 800px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .hero-title {
      font-size: 2.6rem;
      font-weight: 900;
      line-height: 1.3;
      margin-bottom: 24px;
      letter-spacing: -0.02em;
      text-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .hero-subtitle {
      font-size: 1.2rem;
      font-weight: 500;
      margin-bottom: 32px;
      opacity: 0.9;
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }

    .hero-stat {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 30px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #fff;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .hero-stat-icon {
      font-size: 1.1rem;
    }

    .hero-stat-num {
      color: #98e598;
      font-weight: 800;
      font-size: 1rem;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      align-items: center;
    }

    .hero-actions .btn-primary {
      padding: 18px 40px;
      font-size: 1.15rem;
    }

    .hero-secondary-link {
      color: #fff;
      font-size: 0.95rem;
      text-decoration: underline;
      text-underline-offset: 4px;
      opacity: 0.85;
      transition: opacity 0.2s;
    }

    .hero-secondary-link:hover {
      opacity: 1;
      color: #98e598;
    }

    /* =========================================
       Home News Section (お知らせ)
    ========================================= */
    .home-news {
      background: #FFFFFF;
      border-bottom: 1px solid #e2e8f0;
    }
    .home-news-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 28px 20px;
    }
    .home-news-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 14px;
      gap: 16px;
      flex-wrap: wrap;
    }
    .home-news-title {
      color: #1B3A6B;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0;
    }
    .home-news-title-icon { font-size: 1.05rem; }
    .home-news-more {
      color: #2E8B2E;
      font-size: 0.88rem;
      font-weight: 700;
      text-decoration: none;
    }
    .home-news-more:hover { text-decoration: underline; }

    .home-news-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .home-news-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 14px;
      border-radius: 8px;
      color: inherit;
      text-decoration: none;
      transition: background 0.18s;
      border-left: 3px solid #1B3A6B;
      background: #f8fafc;
    }
    .home-news-item:hover { background: #eef3f9; }
    .home-news-item.cat-release { border-left-color: #2E8B2E; }
    .home-news-item.cat-update  { border-left-color: #1B3A6B; }
    .home-news-item.cat-incident { border-left-color: #c0392b; }
    .home-news-item.cat-notice  { border-left-color: #64748b; }

    .home-news-date {
      flex-shrink: 0;
      font-size: 0.82rem;
      color: #64748b;
      font-weight: 600;
      min-width: 84px;
    }
    .home-news-badge {
      flex-shrink: 0;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 10px;
      border-radius: 11px;
      color: #fff;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    .home-news-badge.badge-release { background: #2E8B2E; }
    .home-news-badge.badge-update  { background: #1B3A6B; }
    .home-news-badge.badge-incident { background: #c0392b; }
    .home-news-badge.badge-notice  { background: #64748b; }
    .home-news-text {
      flex: 1;
      min-width: 0;
      color: #1B3A6B;
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1.5;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .home-news-ext {
      display: inline-block;
      margin-left: 4px;
      color: #2E8B2E;
      font-size: 0.85em;
    }

    @media (max-width: 640px) {
      .home-news-inner { padding: 22px 16px; }
      .home-news-item {
        flex-wrap: wrap;
        gap: 8px 10px;
        padding: 12px;
      }
      .home-news-date { font-size: 0.78rem; min-width: 0; }
      .home-news-text {
        flex-basis: 100%;
        white-space: normal;
        font-size: 0.9rem;
      }
    }

    /* =========================================
       Strengths Section (Why KIZUNA Works)
    ========================================= */
    .strengths {
      background: linear-gradient(180deg, #F0F4F8 0%, #FFFFFF 100%);
    }

    .strengths-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      max-width: 1000px;
      margin: 0 auto;
    }

    .strength-card {
      background: #FFFFFF;
      border-radius: 16px;
      padding: 40px 28px;
      text-align: center;
      box-shadow: 0 4px 18px rgba(27, 58, 107, 0.08);
      transition: transform 0.3s, box-shadow 0.3s;
      border-bottom: 4px solid #2E8B2E;
    }

    .strength-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 30px rgba(27, 58, 107, 0.15);
    }

    .strength-icon {
      font-size: 2.6rem;
      margin-bottom: 14px;
      display: block;
      line-height: 1;
    }

    .strength-title {
      color: #1B3A6B;
      font-size: 1.25rem;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .strength-desc {
      color: #555;
      font-size: 0.95rem;
      line-height: 1.85;
    }

    .strength-desc strong {
      color: #1B3A6B;
    }

    /* =========================================
       Problems Section (こんなことで困っていませんか？)
    ========================================= */
    .problems {
      background: #FFFFFF;
    }

    .section-subtitle {
      text-align: center;
      color: #555;
      font-size: 1rem;
      margin: -32px auto 40px;
      max-width: 700px;
      line-height: 1.7;
    }

    .problems-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      max-width: 1000px;
      margin: 0 auto 40px;
    }

    .problem-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 20px 24px;
      background: #F0F4F8;
      border-radius: 10px;
      border-left: 4px solid #2E8B2E;
      transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
      text-decoration: none;
      color: inherit;
    }

    .problem-item:hover {
      transform: translateX(4px);
      box-shadow: 0 4px 14px rgba(27, 58, 107, 0.08);
      background: #E6EDF5;
    }

    .problem-mark {
      flex-shrink: 0;
      font-size: 1.3rem;
      color: #2E8B2E;
      font-weight: 900;
      margin-top: 2px;
    }

    .problem-text {
      color: #333;
      font-size: 0.98rem;
      line-height: 1.7;
      flex: 1;
    }

    .problem-text strong {
      color: #1B3A6B;
    }

    .problems-cta {
      text-align: center;
      color: #555;
      font-size: 1rem;
      margin-bottom: 28px;
    }

    .problems-cta strong {
      color: #1B3A6B;
    }

    /* =========================================
       Plugins Grid (3-column compact cards)
    ========================================= */
    .plugins-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 26px;
      margin-bottom: 40px;
    }

    .plugin-card-compact {
      background: #FFFFFF;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      transition: transform 0.3s, box-shadow 0.3s;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      position: relative;
    }

    .plugin-card-compact:hover {
      transform: translateY(-6px);
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.15);
    }

    .plugin-card-thumb {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #F0F4F8;
      overflow: hidden;
    }

    .plugin-card-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .plugin-card-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #fff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }

    .plugin-card-badge.new {
      background: #e74c3c;
    }

    .plugin-card-badge.free {
      background: #2E8B2E;
    }

    .plugin-card-badge.premium {
      background: linear-gradient(135deg, #1B3A6B 0%, #2E8B2E 100%);
    }

    /* Premium plugins use a designed banner (1200×630) — show it fully without cropping */
    .plugin-card-thumb.is-premium {
      aspect-ratio: 1200 / 630;
    }

    .plugin-card-body {
      padding: 18px 20px 22px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .plugin-card-body h3 {
      color: #1B3A6B;
      font-size: 1.08rem;
      font-weight: 800;
      margin-bottom: 10px;
      line-height: 1.4;
    }

    .plugin-card-body p {
      color: #555;
      font-size: 0.88rem;
      line-height: 1.7;
      margin-bottom: 14px;
      flex: 1;
    }

    .plugin-card-link {
      color: #2E8B2E;
      font-size: 0.9rem;
      font-weight: 700;
    }

    /* =========================================
       Featured kintone tool (Shirushi)
    ========================================= */
    .kintool-feature {
      padding: 64px 20px 24px;
    }
    .kintool-feature .section-title {
      font-size: 1.7rem;
      margin-bottom: 12px;
    }
    .kintool-feature .section-title::after {
      width: 40px;
      height: 3px;
    }
    /* Reset the global subtitle's negative top margin (tuned for the 50px title gap). */
    .kintool-feature .section-subtitle {
      margin-top: 8px;
    }
    .kintool-card {
      display: grid;
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
      gap: 36px;
      align-items: center;
      max-width: 940px;
      margin: 28px auto 0;
      background: #f7faff;
      border: 1px solid #e2e9f3;
      border-radius: 18px;
      padding: 36px;
      box-shadow: 0 10px 30px rgba(27, 58, 107, 0.06);
    }
    .kintool-visual {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      justify-items: center;
    }
    .ktv-icon {
      width: 100px;
      height: 100px;
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 2.2rem;
      box-shadow: 0 10px 22px rgba(27, 58, 107, 0.18);
    }
    .ktv-1 { background: #1B3A6B; }
    .ktv-2 { background: linear-gradient(135deg, #2E8B2E, #1A5C1A); }
    .ktv-3 { background: #0f766e; font-size: 1.5rem; }
    .ktv-4 { background: linear-gradient(135deg, #6d28d9, #be185d); }
    .kintool-lead {
      color: #4a5568;
      line-height: 1.9;
      margin: 0 0 16px;
      font-size: 1rem;
    }
    .kintool-points {
      margin: 0 0 24px;
      padding-left: 1.2em;
    }
    .kintool-points li {
      color: #4a5568;
      margin-bottom: 6px;
      line-height: 1.7;
    }
    /* Obi cover-image visual: stacked horizontal cover bands with a left square icon */
    .obi-visual {
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 100%;
    }
    .obi-band {
      display: flex;
      align-items: center;
      height: 58px;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 8px 18px rgba(27, 58, 107, 0.16);
    }
    .obi-band-icon {
      flex-shrink: 0;
      width: 58px;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.92);
      font-size: 1.5rem;
      font-weight: 800;
      color: #1B3A6B;
    }
    .obi-band-label {
      flex: 1;
      padding: 0 14px;
      color: #fff;
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.04em;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .obi-band-1 { background: linear-gradient(135deg, #1B3A6B, #2a5298); }
    .obi-band-2 { background: linear-gradient(135deg, #2E8B2E, #1A5C1A); }
    .obi-band-3 {
      background: repeating-linear-gradient(45deg, #0f766e, #0f766e 14px, #0d655e 14px, #0d655e 28px);
    }

    @media (max-width: 768px) {
      .kintool-feature { padding: 48px 16px 16px; }
      .kintool-card {
        grid-template-columns: 1fr;
        padding: 24px;
        gap: 24px;
      }
      .kintool-visual { max-width: 260px; margin: 0 auto; }
      .ktv-icon { width: 88px; height: 88px; }
      .obi-visual { max-width: 360px; margin: 0 auto; }
    }

    /* =========================================
       Tools Mini Grid (compact / おまけ)
    ========================================= */
    .tools-section-compact {
      padding: 60px 20px;
    }

    .tools-section-compact .section-title {
      font-size: 1.6rem;
      margin-bottom: 12px;
    }

    .tools-section-compact .section-title::after {
      width: 40px;
      height: 3px;
    }

    .tools-section-compact .section-subtitle {
      margin-top: 8px;
    }

    .tools-mini-grid {
      display: grid;
