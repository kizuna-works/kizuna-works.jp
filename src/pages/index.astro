      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .home-note-card .blog-card-excerpt {
      font-size: 0.9rem;
      color: #64748b;
      line-height: 1.6;
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .home-note-card .blog-card-btn {
      margin-top: auto;
      display: inline-block;
      text-align: center;
      padding: 10px 15px;
      border: 1px solid #2cb696;
      color: #2cb696;
      border-radius: 6px;
      font-weight: 700;
      transition: all 0.3s;
    }

    .home-note-card:hover .blog-card-btn {
      background-color: #2cb696;
      color: #ffffff;
    }

    .home-note-badge {
      background-color: #2cb696;
      color: #fff;
      padding: 2px 10px;
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .note-loading {
      grid-column: 1 / -1;
      text-align: center;
      padding: 30px 0;
      color: #64748b;
    }

    .note-spinner {
      border: 4px solid rgba(0, 0, 0, 0.1);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border-left-color: #2E8B2E;
      animation: home-note-spin 1s linear infinite;
      margin: 0 auto 12px auto;
    }

    @keyframes home-note-spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    /* =========================================
       Responsive
    ========================================= */
    @media (max-width: 768px) {
      .hero {
        padding: 80px 15px;
      }
      .hero-title {
        font-size: 1.85rem;
      }
      .hero-subtitle {
        font-size: 0.95rem;
      }
      .hero-stats {
        gap: 8px;
        margin-bottom: 28px;
      }
      .hero-stat {
        font-size: 0.8rem;
        padding: 6px 12px;
      }
      .hero-actions .btn-primary {
        padding: 14px 28px;
        font-size: 1rem;
      }
      .strengths-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }
      .strength-card {
        padding: 28px 22px;
      }
      .problems-grid {
