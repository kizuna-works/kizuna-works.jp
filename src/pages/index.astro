  <InstallRankingTop3 />

  {recentNews.length > 0 && (
    <section class="home-news">
      <div class="home-news-inner">
        <div class="home-news-head">
          <h2 class="home-news-title">
            <span class="home-news-title-icon" aria-hidden="true">📣</span>
            お知らせ
          </h2>
          <a href="/news/" class="home-news-more">すべて見る →</a>
        </div>
        <ul class="home-news-list">
          {recentNews.map((n) => {
            const isExternal = Boolean(n.data.externalUrl);
            const href = isExternal ? n.data.externalUrl! : `/news/${n.id}/`;
            const cat = n.data.category;
            return (
              <li>
                <a
                  href={href}
                  class={`home-news-item cat-${cat}`}
                  target={isExternal ? '_blank' : undefined}
                  rel={isExternal ? 'noopener noreferrer' : undefined}
                >
                  <span class="home-news-date">{fmtNewsDate(n.data.pubDate)}</span>
                  <span class={`home-news-badge badge-${cat}`}>{newsCategoryLabels[cat]}</span>
                  <span class="home-news-text">
                    {n.data.title}
                    {isExternal && <span class="home-news-ext" aria-label="外部リンク">↗</span>}
                  </span>
                </a>
              </li>
            );
          })}
