  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const API_ENDPOINT = '/api/note-feed.json';
      const MAX_ITEMS = 3;
      const container = document.getElementById('home-note-articles');
      const loading = document.getElementById('home-note-loading');
      if (!container || !loading) return;

      const formatDate = (dateString) => {
        if (!dateString) return '';
        const date = new Date(dateString.replace(/-/g, '/'));
        if (isNaN(date.getTime())) return dateString.split(' ')[0].replace(/-/g, '.');
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}.${m}.${d}`;
      };

      const stripHtml = (html) => {
        if (!html) return '';
        const tmp = document.createElement('div');
        tmp.innerHTML = html;
        return tmp.textContent || tmp.innerText || '';
      };

      const escapeHtml = (s) => s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

      fetch(API_ENDPOINT)
        .then((res) => {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then((data) => {
          loading.remove();
          if (data.status === 'ok' && Array.isArray(data.items) && data.items.length > 0) {
            data.items.slice(0, MAX_ITEMS).forEach((item) => {
              const excerpt = stripHtml(item.description || '').substring(0, 80) + '...';
              const card = document.createElement('a');
              card.href = item.link;
              card.target = '_blank';
              card.rel = 'noopener noreferrer';
              card.className = 'blog-card home-note-card';
              card.innerHTML = `
                <div class="blog-card-body">
                  <p class="blog-card-date"><span class="home-note-badge">note</span> ${formatDate(item.pubDate)}</p>
                  <h3 class="blog-card-title">${escapeHtml(item.title || '')}</h3>
                  <p class="blog-card-excerpt">${escapeHtml(excerpt)}</p>
                  <span class="blog-card-btn">noteで読む</span>
                </div>
              `;
              container.appendChild(card);
            });
          } else {
            container.innerHTML = '<p class="no-posts" style="grid-column:1/-1;">現在note記事はありません</p>';
          }
        })
        .catch((err) => {
          console.error('note RSS fetch error:', err);
          if (loading.parentNode) loading.remove();
          container.innerHTML = '<p class="no-posts" style="grid-column:1/-1;">note記事の取得に失敗しました</p>';
        });
    });
  </script>
