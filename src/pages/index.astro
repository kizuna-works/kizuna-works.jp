      )}

      <h2 class="section-title section-title-note">note 記事</h2>
      <div class="blog-grid" id="home-note-articles">
        <div class="note-loading" id="home-note-loading">
          <div class="note-spinner"></div>
          <p>読み込み中...</p>
        </div>
      </div>

