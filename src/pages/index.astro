      }
      .stat-item {
        padding: 14px 10px;
      }
      .blog-tabs {
        gap: 6px;
      }
      .blog-tab {
        padding: 8px 16px;
        font-size: 0.85rem;
      }
      .note-compact {
        padding: 24px 22px;
