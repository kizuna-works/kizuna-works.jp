---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="ブログ - kintoneプラグイン活用と業務効率化のヒント | KIZUNA Works"
  description="KIZUNA Worksのブログ・コラム。kintoneプラグインの設定方法・無料プラグイン比較・kintone活用術・AI/Google業務効率化のヒント・DX事例・ノーコード開発の最新情報を発信。kintone プラグイン 無料配布の解説記事も多数掲載しています。"
  ogTitle="ブログ - kintoneプラグイン活用と業務効率化のヒント | KIZUNA Works"
  ogDescription="KIZUNA Worksのブログ・コラム。kintoneプラグインの設定方法・無料プラグイン比較・kintone活用術・AI/Google業務効率化のヒント・DX事例・ノーコード開発の最新情報を発信。kintone プラグイン 無料配布の解説記事も多数掲載しています。"
  ogUrl="https://kizuna-works.jp/blog/"
  canonical="https://kizuna-works.jp/blog/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": "https://kizuna-works.jp/blog/",
          "url": "https://kizuna-works.jp/blog/",
          "name": "ブログ - kintoneプラグイン活用と業務効率化のヒント | KIZUNA Works",
          "description": "KIZUNA Worksのブログ。kintoneプラグインの活用法・無料プラグイン比較・業務効率化情報を発信。kintone プラグイン 無料配布の解説記事も掲載。"
        },
        {
          "@type": "Blog",
          "@id": "https://kizuna-works.jp/blog/#blog",
          "url": "https://kizuna-works.jp/blog/",
          "name": "KIZUNA Works ブログ・コラム",
          "publisher": {
            "@type": "Organization",
            "name": "KIZUNA Works",
            "url": "https://kizuna-works.jp/"
          }
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    :root {
      --color-navy: #1B3A6B;
      --color-green: #2E8B2E;
      --color-bg-light: #F0F4F8;
      --color-text-main: #333333;
      --color-text-muted: #64748b;
      --color-white: #FFFFFF;
      --shadow-card: 0 4px 12px rgba(0, 0, 0, 0.08);
      --shadow-hover: 0 8px 16px rgba(0, 0, 0, 0.15);
      --transition-speed: 0.3s;
    }

    /* Hero Section */
    .blog-hero {
      position: relative;
      background: linear-gradient(135deg, rgba(27,58,107,0.45) 0%, rgba(42,82,152,0.4) 100%),
                  url('/images/blog-bg.webp') center center / cover no-repeat;
      background-color: var(--color-navy);
      padding: 100px 5%;
      text-align: center;
      color: var(--color-white);
    }

    .blog-hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 0.05em;
    }

    .blog-hero p {
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto;
      font-weight: 500;
    }

    .hero-gradient-line {
      height: 6px;
      background: linear-gradient(to right, var(--color-navy), var(--color-green));
      width: 100%;
      display: block;
    }

    /* Intro Section */
    .intro-section {
      padding: 60px 5% 40px;
      display: flex;
      justify-content: center;
    }

    .intro-card {
      background: var(--color-white);
      max-width: 800px;
      width: 100%;
      padding: 40px;
      border-radius: 12px;
      box-shadow: var(--shadow-card);
      text-align: center;
    }

    .intro-card h2 {
      color: var(--color-navy);
      font-size: 1.5rem;
      margin-bottom: 20px;
      position: relative;
      display: inline-block;
    }

    .intro-card h2::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 40px;
      height: 3px;
      background-color: var(--color-green);
      border-radius: 2px;
    }

    .intro-card p {
      font-size: 1.05rem;
      color: var(--color-text-main);
      line-height: 1.8;
    }

    /* Sections */
    .section-container {
      padding: 40px 5% 80px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      font-size: 1.75rem;
      color: var(--color-navy);
      margin-bottom: 30px;
      padding-left: 12px;
      border-left: 5px solid var(--color-green);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Article Grid */
    .article-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 30px;
    }

    /* Coming Soon */
    .coming-soon-card {
      background-color: var(--color-white);
      border-radius: 10px;
      padding: 60px 20px;
      text-align: center;
      box-shadow: var(--shadow-card);
      color: var(--color-text-muted);
      grid-column: 1 / -1;
    }

    /* Note Badge */
    .note-badge-inline {
      background-color: #2cb696;
      color: #fff;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: bold;
    }

    .note-card-no-image {
      border-left: 4px solid #2cb696;
    }

    .note-card-no-image .card-content {
      padding: 24px;
    }

    .card-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .card-excerpt {
      font-size: 0.9rem;
      color: #64748b;
      line-height: 1.6;
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Loading Spinner */
    .loading-container {
      text-align: center;
      padding: 40px 0;
      grid-column: 1 / -1;
      color: var(--color-text-muted);
    }

    .spinner {
      border: 4px solid rgba(0, 0, 0, 0.1);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border-left-color: var(--color-green);
      animation: spin 1s linear infinite;
      margin: 0 auto 15px auto;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .error-message, .empty-message {
      grid-column: 1 / -1;
      text-align: center;
      padding: 40px 20px;
      background: var(--color-white);
      border-radius: 10px;
      color: var(--color-text-muted);
      box-shadow: var(--shadow-card);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .blog-hero {
        padding: 60px 5%;
      }
      .blog-hero h1 {
        font-size: 1.8rem;
      }
      .intro-section {
        padding: 40px 5% 30px;
      }
      .intro-card {
        padding: 30px 20px;
      }
      .article-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main>
    <section class="blog-hero">
      <h1>ブログ・コラム</h1>
      <p>業務効率化に役立つ情報や、ツールの便利な使い方を発信しています</p>
    </section>
    <div class="hero-gradient-line"></div>

    <section class="intro-section">
      <div class="intro-card">
        <h2>発信テーマ</h2>
        <p>KIZUNA Worksでは、kintone活用術やGoogle・AIツールの便利な使い方、業務改善のヒントなどを発信しています。<br>実務で「すぐ使える」実践的な情報をお届けします。</p>
      </div>
    </section>

    <section class="section-container">
      <h2 class="section-title">KIZUNA Works 記事</h2>
      <div class="article-grid">
        {posts.length > 0 ? posts.map((post) => (
          <BlogCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            date={post.data.pubDate}
            heroImage={post.data.heroImage}
            ogImage={post.data.ogImage}
            description={post.data.description}
          />
        )) : (
          <div class="coming-soon-card">
            <p>記事を準備中です。公開までしばらくお待ちください。</p>
          </div>
        )}
      </div>
    </section>

    <section class="section-container" style="padding-top: 0;">
      <h2 class="section-title">note 記事</h2>
      <div class="article-grid" id="note-articles">
        <div class="loading-container" id="note-loading">
          <div class="spinner"></div>
          <p>読み込み中...</p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const API_ENDPOINT = '/api/note-feed.json';

      const container = document.getElementById('note-articles');
      const loading = document.getElementById('note-loading');

      const formatDate = (dateString) => {
        if (!dateString) return '';
        const date = new Date(dateString.replace(/-/g, '/'));
        if (isNaN(date.getTime())) return dateString.split(' ')[0].replace(/-/g, '.');
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}.${month}.${day}`;
      };

      const stripHtml = (html) => {
        if (!html) return '';
        const tmp = document.createElement('div');
        tmp.innerHTML = html;
        return tmp.textContent || tmp.innerText || '';
      };

      fetch(API_ENDPOINT)
        .then(response => {
          if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
          return response.json();
        })
        .then(data => {
          loading.remove();
          if (data.status === 'ok' && data.items && data.items.length > 0) {
            data.items.forEach(item => {
              const excerpt = stripHtml(item.description).substring(0, 100) + '...';
              const card = document.createElement('a');
              card.href = item.link;
              card.target = '_blank';
              card.rel = 'noopener noreferrer';
              card.className = 'article-card note-card-no-image';
              card.innerHTML = `
                <div class="card-content">
                  <div class="card-meta">
                    <span class="note-badge-inline">note</span>
                    <span class="card-date">${formatDate(item.pubDate)}</span>
                  </div>
                  <h3 class="card-title">${item.title}</h3>
                  <p class="card-excerpt">${excerpt}</p>
                  <span class="card-button">noteで読む</span>
                </div>
              `;
              container.appendChild(card);
            });
          } else {
            container.innerHTML = '<div class="empty-message"><p>現在note記事はありません</p></div>';
          }
        })
        .catch(error => {
          console.error('RSS Fetch Error:', error);
          loading.remove();
          container.innerHTML = '<div class="error-message"><p>記事の取得に失敗しました</p></div>';
        });
    });
  </script>
</Layout>
