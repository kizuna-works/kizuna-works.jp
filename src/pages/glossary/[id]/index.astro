---
import Layout from '../../../layouts/Layout.astro';
import {
  glossary,
  categoryLabels,
  type Term,
} from '../../../data/glossary';
// allPlugins（通常＋プレミアム）で引く。plugins だけだと relatedPlugins に
// プレミアムのスラッグを書いても黙って表示から落ちる。
import { allPlugins } from '../../../data/plugins';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // Only terms flagged with hasPage get a dedicated long-tail landing page.
  return glossary
    .filter((t) => t.hasPage)
    .map((t) => ({ params: { id: t.id }, props: { term: t } }));
}

const { term } = Astro.props as { term: Term };

const pluginsBySlug = new Map(allPlugins.map((p) => [p.slug, p]));
const termsById = new Map(glossary.map((t) => [t.id, t]));
const blogPosts = await getCollection('blog');
const blogById = new Map(blogPosts.map((b) => [b.id, b]));

const renderCode = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');

const url = `https://kizuna-works.jp/glossary/${term.id}/`;
const pageTitle = term.seoTitle ?? `kintoneの${term.term}とは？意味・使い方をわかりやすく解説`;

// Build a click-worthy meta description: front-load the search phrase ("kintoneの〇〇とは"),
// answer with the definition, and cut at a sentence boundary so the snippet never ends mid-word.
const buildMetaDescription = (t: Term): string => {
  const lead = `kintoneの${t.term}とは？`;
  const clean = t.definition.replace(/`/g, '').replace(/\s+/g, ' ').trim();
  const budget = 118 - lead.length;
  let body = clean;
  if (body.length > budget) {
    body = body.slice(0, budget);
    const cut = Math.max(body.lastIndexOf('。'), body.lastIndexOf('、'));
    body = cut > budget * 0.5 ? body.slice(0, cut + 1) : `${body}…`;
  }
  return `${lead}${body}`;
};
const metaDescription = term.seoDescription ?? buildMetaDescription(term);

const relatedTermObjs = (term.relatedTerms ?? [])
  .map((id) => termsById.get(id))
  .filter((t): t is Term => Boolean(t));
const relatedPluginObjs = (term.relatedPlugins ?? [])
  .map((slug) => pluginsBySlug.get(slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const relatedBlogObjs = (term.relatedBlog ?? [])
  .map((id) => blogById.get(id))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

// JSON-LD
const definedTerm = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  '@id': url,
  name: term.term,
  description: term.definition.replace(/`/g, ''),
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'kintone 用語集',
    url: 'https://kizuna-works.jp/glossary/',
  },
  inLanguage: 'ja',
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kizuna-works.jp/' },
    { '@type': 'ListItem', position: 2, name: 'kintone 用語集', item: 'https://kizuna-works.jp/glossary/' },
    { '@type': 'ListItem', position: 3, name: term.term, item: url },
  ],
};

const faqLd =
  term.faq && term.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: term.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') },
        })),
      }
    : null;
---

<Layout
  title={`${pageTitle} | KIZUNA Works`}
  description={metaDescription}
  ogTitle={`${pageTitle} | KIZUNA Works`}
  ogDescription={metaDescription}
  ogType="article"
  ogUrl={url}
  canonical={url}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(definedTerm)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    {faqLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <style is:global>
    body { background-color: #F0F4F8; }

    .term-wrapper { max-width: 820px; margin: 40px auto; padding: 0 20px 80px; }

    .term-breadcrumb { font-size: 0.85rem; color: #64748b; margin-bottom: 16px; }
    .term-breadcrumb a { color: #2E8B2E; text-decoration: none; }
    .term-breadcrumb a:hover { text-decoration: underline; }

    .term-card {
      background: #fff; border-radius: 16px; padding: 44px 48px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08); position: relative; overflow: hidden;
    }
    .term-card::before {
      content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 6px;
      background: linear-gradient(90deg, #1B3A6B, #2E8B2E);
    }

    .term-cat {
      display: inline-block; background: #1B3A6B; color: #fff; font-size: 0.75rem;
      font-weight: 700; padding: 4px 12px; border-radius: 12px; margin-bottom: 14px;
    }
    .term-title { color: #1B3A6B; font-size: 1.9rem; font-weight: 800; line-height: 1.3; margin: 0 0 6px; }
    .term-reading { color: #64748b; font-size: 0.9rem; margin: 0 0 24px; }

    .term-lead {
      font-size: 1.05rem; line-height: 1.9; color: #1f2a3a; background: #f4f7fb;
      border-left: 4px solid #2E8B2E; border-radius: 8px; padding: 18px 22px; margin: 0 0 28px;
    }
    .term-lead code, .term-body code {
      background: #E2E8F0; padding: 2px 6px; border-radius: 4px; font-size: 0.88em;
    }

    .term-body { color: #333; line-height: 1.95; }
    .term-body h2 {
      color: #1B3A6B; font-size: 1.25rem; font-weight: 700; margin: 2em 0 0.8em;
      padding-left: 12px; border-left: 4px solid #2E8B2E;
    }
    .term-body p { margin: 0 0 1.2em; }
    .term-body ul { list-style: disc; margin: 0 0 1.4em 1.4em; }
    .term-body li { margin-bottom: 0.5em; line-height: 1.8; }

    .term-faq-item { border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px 20px; margin-bottom: 12px; background: #fff; }
    .term-faq-q { color: #1B3A6B; font-weight: 700; margin: 0 0 8px; }
    .term-faq-q::before { content: 'Q. '; color: #2E8B2E; }
    .term-faq-a { margin: 0; color: #4a5568; line-height: 1.85; }
    .term-faq-a a { color: #2E8B2E; }

    .term-rel { margin-top: 12px; }
    .term-rel h2 {
      color: #1B3A6B; font-size: 1.25rem; font-weight: 700; margin: 2em 0 0.8em;
      padding-left: 12px; border-left: 4px solid #2E8B2E;
    }
    .term-rel-group { margin-bottom: 16px; }
    .term-rel-label { font-weight: 700; color: #1B3A6B; font-size: 0.9rem; margin-right: 8px; }
    .term-rel a { color: #2E8B2E; text-decoration: underline; }
    .term-rel a:hover { color: #1B3A6B; }
    .term-rel li { margin-bottom: 6px; line-height: 1.7; }
    .term-rel ul { list-style: none; margin: 0; padding: 0; }

    .term-cta {
      margin-top: 32px; padding: 22px; background: #f0f4f8; border-radius: 12px; text-align: center;
    }
    .term-cta a { color: #1B3A6B; font-weight: 700; margin: 0 12px; }

    @media (max-width: 768px) {
      .term-card { padding: 28px 22px; }
      .term-title { font-size: 1.5rem; }
    }
  </style>

  <main class="term-wrapper">
    <nav class="term-breadcrumb" aria-label="パンくず">
      <a href="/">ホーム</a> ＞ <a href="/glossary/">kintone 用語集</a> ＞ <span>{term.term}</span>
    </nav>

    <article class="term-card">
      <span class="term-cat">{categoryLabels[term.category]}</span>
      <h1 class="term-title">{term.term}</h1>
      <p class="term-reading">読み：{term.reading}</p>

      <p class="term-lead" set:html={renderCode(term.definition)} />

      {term.longDescription && term.longDescription.length > 0 && (
        <div class="term-body">
          <h2>{term.term}とは（詳しく）</h2>
          {term.longDescription.map((p) => (
            <p set:html={renderCode(p)} />
          ))}
        </div>
      )}

      {term.useCases && term.useCases.length > 0 && (
        <div class="term-body">
          <h2>主な使いどころ</h2>
          <ul>
            {term.useCases.map((u) => (
              <li set:html={renderCode(u)} />
            ))}
          </ul>
        </div>
      )}

      {term.faq && term.faq.length > 0 && (
        <div class="term-body">
          <h2>よくある質問</h2>
          {term.faq.map((f) => (
            <div class="term-faq-item">
              <p class="term-faq-q">{f.q}</p>
              <p class="term-faq-a" set:html={f.a.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')} />
            </div>
          ))}
        </div>
      )}

      {(relatedTermObjs.length > 0 || relatedPluginObjs.length > 0 || relatedBlogObjs.length > 0) && (
        <div class="term-rel">
          <h2>関連する用語・プラグイン・記事</h2>
          {relatedTermObjs.length > 0 && (
            <div class="term-rel-group">
              <span class="term-rel-label">関連用語</span>
              {relatedTermObjs.map((t, i) => (
                <>
                  {t.hasPage ? <a href={`/glossary/${t.id}/`}>{t.term}</a> : <a href={`/glossary/#${t.id}`}>{t.term}</a>}
                  {i < relatedTermObjs.length - 1 && <span>・</span>}
                </>
              ))}
            </div>
          )}
          {relatedPluginObjs.length > 0 && (
            <div class="term-rel-group">
              <span class="term-rel-label">関連プラグイン</span>
              <ul>
                {relatedPluginObjs.map((p) => (
                  <li><a href={`/plugins/${p.slug}/`}>{p.name}</a>{p.description ? ` — ${p.description}` : ''}</li>
                ))}
              </ul>
            </div>
          )}
          {relatedBlogObjs.length > 0 && (
            <div class="term-rel-group">
              <span class="term-rel-label">関連記事</span>
              <ul>
                {relatedBlogObjs.map((b) => (
                  <li><a href={`/blog/${b.id}/`}>{b.data.title}</a></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      <div class="term-cta">
        <a href="/glossary/">← kintone 用語集に戻る</a>
        <a href="/plugins/">kintoneプラグイン一覧 →</a>
      </div>
    </article>
  </main>
</Layout>
