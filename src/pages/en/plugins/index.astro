---
// English catalogue of every kintone plugin. Names and summaries come from
// src/data/plugins-en.ts; images, slugs and tiers from plugins.ts. A plugin
// without its own English page links to its Japanese page (marked as such).
import Layout from '../../../layouts/Layout.astro';
import Picture from '../../../components/Picture.astro';
import { plugins, premiumOnlyPlugins, proPlugins, type Plugin } from '../../../data/plugins';
import { pluginsEn } from '../../../data/plugins-en';
import versions from '../../../../public/versions.json';

const SITE = 'https://kizuna-works.jp';
const url = `${SITE}/en/plugins/`;

const missing = [...plugins, ...premiumOnlyPlugins, ...proPlugins].filter((p) => !pluginsEn[p.id]);
if (missing.length) {
  throw new Error(`plugins-en.ts has no English entry for: ${missing.map((p) => p.id).join(', ')}`);
}

const freeCount = plugins.length;
const premiumCount = premiumOnlyPlugins.length;
const proCount = proPlugins.length;
const totalCount = freeCount + premiumCount + proCount;

const vmap = versions as Record<string, { version: string }>;
const zipOf = (p: Plugin) => {
  const v = vmap[p.id]?.version;
  return v ? `/downloads/${p.id}-v${v}.zip` : null;
};
const hrefOf = (p: Plugin) => (pluginsEn[p.id].page ? `/en/plugins/${p.slug}/` : `/plugins/${p.slug}/`);

const groups: { id: string; title: string; lead: string; items: Plugin[]; free: boolean }[] = [
  {
    id: 'free',
    title: `Free plugins (${freeCount})`,
    lead: 'Every feature is free, with no time limit and no sign-up. Download the zip and install it in your kintone. A small ad area appears on the plugin settings screen only, never in your apps.',
    items: plugins,
    free: true,
  },
  {
    id: 'premium',
    title: `Premium plugins (${premiumCount})`,
    lead: 'Free to download and use the basic features. The full feature set needs an annual license. Contact us in English for a quote or a trial.',
    items: premiumOnlyPlugins,
    free: false,
  },
  {
    id: 'pro',
    title: `KIZUNA Pro (${proCount})`,
    lead: 'Bundles that combine several plugins into one, with one settings screen. Available with an annual license — contact us for details.',
    items: proPlugins,
    free: false,
  },
];

const title = `${totalCount} kintone Plugins - ${freeCount} Free, English UI | KIZUNA Works`;
const description = `${totalCount} kintone plugins by KIZUNA Works, ${freeCount} of them free with every feature. All plugins work in English, Japanese and Chinese. Styling, search, lookups, auto numbering, file preview and more.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': url,
      url,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', name: 'KIZUNA Works', url: `${SITE}/en/` },
    },
    {
      '@type': 'ItemList',
      name: 'kintone plugins by KIZUNA Works',
      numberOfItems: totalCount,
      itemListElement: groups.flatMap((g) => g.items).map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: pluginsEn[p.id].name,
          url: `${SITE}${hrefOf(p)}`,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'kintone',
          description: pluginsEn[p.id].summary,
        },
      })),
    },
  ],
};
---
<Layout
  lang="en"
  title={title}
  description={description}
  canonical={url}
  ogTitle={title}
  ogDescription={description}
  ogUrl={url}
  ogType="website"
  ogImage={`${SITE}/images/ogp.png`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class="enl">
    <section class="enl-hero">
      <div class="enl-wrap">
        <h1>kintone plugins by KIZUNA Works</h1>
        <p class="enl-lead">KIZUNA Works makes {totalCount} plugins for kintone. {freeCount} of them are completely free. Every plugin shows its screens in English, Japanese or Chinese, following each user's kintone language setting.</p>
        <nav class="enl-jump" aria-label="Plugin groups">
          {groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
          <a href="/en/install/">How to install</a>
        </nav>
      </div>
    </section>

    {groups.map((g) => (
      <section class="enl-sec" id={g.id}>
        <div class="enl-wrap">
          <h2>{g.title}</h2>
          <p class="enl-sec-lead">{g.lead}</p>
          <div class="enl-grid">
            {g.items.map((p) => {
              const en = pluginsEn[p.id];
              const zip = g.free ? zipOf(p) : null;
              return (
                <article class="enl-card">
                  <a class="enl-thumb" href={hrefOf(p)} tabindex="-1" aria-hidden="true">
                    <Picture src={p.image} alt="" width={p.imageWidth} height={p.imageHeight} card />
                  </a>
                  <div class="enl-body">
                    <h3><a href={hrefOf(p)}>{en.name}</a></h3>
                    <p>{en.summary}</p>
                    <div class="enl-links">
                      {en.page
                        ? <a href={hrefOf(p)} class="enl-more">Details</a>
                        : <a href={hrefOf(p)} class="enl-more" lang="ja">Details (Japanese page)</a>}
                      {zip && <a href={zip} download class="enl-dl js-en-dl" data-file={zip.split('/').pop()}>Download free</a>}
                      {!g.free && <a href="/en/contact/" class="enl-dl is-contact">Contact us</a>}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    ))}

    <section class="enl-sec is-end">
      <div class="enl-wrap">
        <h2>About prices</h2>
        <p>Paid licenses are annual and billed in Japanese yen by card through a payment link. Ask us in English and we will send a quote. Free plugins need no payment or registration.</p>
        <p><a href="/en/contact/">Contact KIZUNA Works</a></p>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.js-en-dl').forEach((a) => {
    a.addEventListener('click', () => {
      const g = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
      if (typeof g === 'function') {
        g('event', 'file_download', {
          file_name: a.dataset.file || '',
          file_extension: 'zip',
          link_text: a.textContent || '',
          link_url: a.getAttribute('href') || '',
          link_position: 'en_list',
          page_language: 'en',
        });
      }
    });
  });
</script>

<style is:global>
  /* English plugin catalogue */
  .enl { flex: 1; min-width: 0; background: #F0F4F8; color: #333; }
  .enl-wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; min-width: 0; }
  .enl-hero { background: linear-gradient(135deg, #1B3A6B 0%, #224a85 100%); color: #fff; padding: 44px 0; }
  .enl-hero h1 { margin: 0 0 14px; font-size: clamp(26px, 4.2vw, 38px); line-height: 1.25; }
  .enl-lead { margin: 0 0 20px; max-width: 820px; font-size: 17px; line-height: 1.75; }
  .enl-jump { display: flex; flex-wrap: wrap; gap: 10px; }
  .enl-jump a { color: #fff; border: 1px solid rgba(255, 255, 255, 0.6); border-radius: 999px; padding: 6px 14px; font-size: 14px; text-decoration: none; }
  .enl-jump a:hover { background: rgba(255, 255, 255, 0.18); }
  .enl-sec { padding: 44px 0 20px; scroll-margin-top: 80px; }
  .enl-sec h2 { margin: 0 0 8px; color: #1B3A6B; font-size: clamp(22px, 3vw, 28px); }
  .enl-sec-lead { margin: 0 0 22px; color: #475569; line-height: 1.7; max-width: 860px; }
  .enl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .enl-card { min-width: 0; display: flex; flex-direction: column; background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid #dbe3ec; }
  .enl-thumb { display: block; background: #e8eef5; }
  .enl-thumb img { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; }
  .enl-body { padding: 16px 18px 18px; display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .enl-body h3 { margin: 0 0 8px; font-size: 17px; line-height: 1.4; }
  .enl-body h3 a { color: #1B3A6B; text-decoration: none; overflow-wrap: anywhere; }
  .enl-body h3 a:hover { color: #2E8B2E; }
  .enl-body p { margin: 0 0 14px; font-size: 14.5px; line-height: 1.7; flex: 1; overflow-wrap: anywhere; }
  .enl-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .enl-more, .enl-dl { display: inline-block; padding: 7px 14px; border-radius: 999px; font-size: 14px; font-weight: 700; text-decoration: none; }
  .enl-more { color: #1B3A6B; border: 1.5px solid #1B3A6B; }
  .enl-more:hover { color: #2E8B2E; border-color: #2E8B2E; }
  .enl-dl { background: #2E8B2E; color: #fff; }
  .enl-dl:hover { background: #35a035; }
  .enl-dl.is-contact { background: #1B3A6B; }
  .enl-dl.is-contact:hover { background: #2E8B2E; }
  .enl-sec.is-end { padding-bottom: 56px; }
  .enl-sec.is-end p { line-height: 1.75; max-width: 860px; }
  .enl-sec.is-end a { color: #1B3A6B; font-weight: 700; }
  @media (max-width: 600px) {
    .enl-hero { padding: 30px 0; }
    .enl-lead { font-size: 16px; }
    .enl-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
