---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';

const title = 'Privacy Policy | KIZUNA Works';
const description =
  'The KIZUNA Works privacy policy: personal information, cookies, analytics and plugin banners, and how Google Drive Connect for kintone handles Google user data.';
const pageUrl = 'https://kizuna-works.jp/en/privacy/';
---

<Layout
  lang="en"
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="website"
  ogImage="https://kizuna-works.jp/images/ogp.png"
  canonical={pageUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": "https://kizuna-works.jp/en/privacy/",
      "url": "https://kizuna-works.jp/en/privacy/",
      "name": "Privacy Policy | KIZUNA Works",
      "description": "The KIZUNA Works privacy policy: personal information, cookies, analytics, and how Google Drive Connect for kintone handles Google user data.",
      "inLanguage": "en",
      "isPartOf": {
        "@type": "WebSite",
        "name": "KIZUNA Works",
        "url": "https://kizuna-works.jp/"
      }
    }
    </script>
  </Fragment>
  <style is:global>
    body { background-color: #f4f7f6; }

    .content-card a {
      color: #2E8B2E;
    }
    .content-card a:hover {
      color: #1B3A6B;
    }

    .main-container {
      max-width: 860px;
      margin: 50px auto;
      padding: 0 20px;
      flex: 1;
      min-width: 0;
    }

    .content-card {
      background-color: #FFFFFF;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      padding: 50px 60px;
      overflow: hidden;
      position: relative;
      overflow-wrap: anywhere;
    }

    .content-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(90deg, #1B3A6B, #2E8B2E);
    }

    .page-title {
      text-align: center;
      color: #1B3A6B;
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 30px;
      position: relative;
      padding-bottom: 15px;
    }

    .page-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 3px;
      background-color: #2E8B2E;
      border-radius: 2px;
    }

    .translation-notice {
      background-color: #F0F4F8;
      border-left: 4px solid #1B3A6B;
      border-radius: 0 8px 8px 0;
      padding: 14px 18px;
      margin-bottom: 40px;
      font-size: 0.92rem;
      color: #4a5568;
      line-height: 1.7;
    }

    .policy-section {
      margin-bottom: 45px;
      animation: fadeInUp 0.6s ease-out forwards;
      opacity: 0;
      transform: translateY(20px);
    }

    .policy-section:nth-child(2) { animation-delay: 0.1s; }
    .policy-section:nth-child(3) { animation-delay: 0.2s; }
    .policy-section:nth-child(4) { animation-delay: 0.3s; }
    .policy-section:nth-child(5) { animation-delay: 0.4s; }
    .policy-section:nth-child(6) { animation-delay: 0.5s; }
    .policy-section:nth-child(7) { animation-delay: 0.6s; }
    .policy-section:nth-child(8) { animation-delay: 0.7s; }
    .policy-section:nth-child(9) { animation-delay: 0.8s; }

    @keyframes fadeInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .policy-section {
        animation: none;
        opacity: 1;
        transform: none;
      }
    }

    .policy-section h2 {
      font-size: 1.3rem;
      color: #1B3A6B;
      font-weight: 700;
      margin-bottom: 20px;
      padding: 10px 15px;
      background: linear-gradient(90deg, rgba(46,139,46,0.08) 0%, rgba(255,255,255,0) 100%);
      border-left: 5px solid #2E8B2E;
      border-radius: 0 4px 4px 0;
    }

    .policy-section p {
      margin-bottom: 15px;
      color: #4a5568;
    }

    .policy-section ul {
      margin-left: 20px;
      margin-bottom: 15px;
      color: #4a5568;
      list-style: disc;
    }

    .policy-section li {
      margin-bottom: 8px;
    }

    .contact-box {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 20px;
      margin-top: 15px;
      text-align: center;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    .contact-box img {
      display: block;
      margin: 0 auto 15px;
      height: 60px;
      width: auto;
    }

    .contact-box a {
      display: inline-block;
      font-weight: 700;
      font-size: 1.1rem;
      margin-top: 5px;
    }

    @media (max-width: 768px) {
      .main-container {
        margin: 30px auto;
      }
      .content-card {
        padding: 30px 20px;
        border-radius: 12px;
      }
      .page-title {
        font-size: 1.6rem;
      }
      .policy-section h2 {
        font-size: 1.15rem;
        padding: 8px 12px;
      }
    }
  </style>

  <main class="main-container">
    <article class="content-card">
      <h1 class="page-title">Privacy Policy</h1>

      <p class="translation-notice">
        This is an English translation for convenience. If there is any difference between this translation and the Japanese original, the Japanese version prevails.
        <a href="/privacy/" lang="ja">Japanese original (プライバシーポリシー)</a>
      </p>

      <section class="policy-section">
        <h2>1. Collection and purpose of use of personal information</h2>
        <p>This website (KIZUNA Works) may ask you to provide personal information, such as your name and email address, when you use our services.</p>
        <p>The personal information we collect is used to answer your inquiries and to contact you by email or other means with necessary information. It is not used for any other purpose.</p>
      </section>

      <section class="policy-section">
        <h2>2. Personal information in the contact form</h2>
        <p>Personal information entered when you use the contact form on this website (your name, email address, the content of your inquiry, etc.) is used only to respond appropriately to your requests and questions and for related communication.</p>
        <p>The information collected is managed strictly and is not provided to any third party without your prior consent.</p>
      </section>

      <section class="policy-section">
        <h2>3. Analytics tools</h2>
        <p>This website uses Google Analytics, an analytics tool provided by Google.</p>
        <p>Google Analytics uses cookies to collect traffic data. This traffic data is collected anonymously and does not identify individuals.</p>
        <p>You can refuse this collection by disabling cookies, so please check your browser settings. For details, see the <a href="https://marketingplatform.google.com/about/analytics/terms/us/" target="_blank" rel="noopener noreferrer">Google Analytics Terms of Service</a>.</p>
        <p>In addition, if you come to this website from a banner shown in one of our kintone plugins, information indicating this (the type of banner and the name of the plugin it was shown in) is stored in your browser for 30 days. If you apply for an annual supporter license or a free trial within that period, we receive this information together with your application and use it only to understand how effective the banners are. We never obtain data stored in your kintone or your kintone domain name through the banners.</p>
      </section>

      <section class="policy-section">
        <h2>4. Handling of Google user data (kintone plugin "Google Drive Connect")</h2>
        <p>"Google Drive Connect for kintone", a kintone plugin provided by KIZUNA Works, connects to the user's Google account and uses the Google Drive API. This section sets out how the plugin handles Google user data. Our other plugins and free web tools do not connect to Google accounts.</p>

        <p><strong>Access requested (scope)</strong></p>
        <p>The plugin requests only one scope: <strong>https://www.googleapis.com/auth/drive.file</strong>. This access is limited to "files and folders created by this app" and "folders the user explicitly selects in the picker (Google Picker)". The plugin cannot see any other files in your Drive.</p>

        <p><strong>Information collected and used, and why</strong></p>
        <ul>
          <li>kintone attachments: to upload them to the folder you specify</li>
          <li>File names and file sizes: to tell whether a file has already been transferred and prevent duplicate transfers</li>
          <li>The ID and name of the destination folder: to identify where files go and to create a folder for each record</li>
          <li>The display name and email address of the connected Google account: to show which account is connected on the settings screen</li>
        </ul>

        <p><strong>Storage</strong></p>
        <ul>
          <li>KIZUNA Works servers are not involved in the path of the files at all. Files are sent directly from the user's browser to Google Drive.</li>
          <li>KIZUNA Works does not store file contents, file names or folder information.</li>
          <li>Connection data (such as the refresh token) is stored only in the plugin settings area of the user's kintone environment. KIZUNA Works does not keep it.</li>
          <li>The access token is held only temporarily in the browser's sessionStorage and is deleted when the tab is closed.</li>
        </ul>

        <p><strong>Limited Use</strong></p>
        <ul>
          <li>We do not use Google user data for any purpose other than those listed above.</li>
          <li>We do not sell, transfer or provide it to third parties.</li>
          <li>We do not use it for advertising.</li>
          <li>We do not use it to train machine learning or AI models.</li>
          <li>No human reads it (except where required by law, with the user's explicit consent, or where necessary for security).</li>
        </ul>
        <p>The plugin's use and transfer to any other app of information received from Google APIs will adhere to the <a href="https://developers.google.com/terms/api-services-user-data-policy" target="_blank" rel="noopener noreferrer">Google API Services User Data Policy</a>, including the Limited Use requirements.</p>

        <p><strong>Disconnecting</strong></p>
        <p>You can disconnect at any time with "Disconnect" on the plugin settings screen. You can also revoke access from "Third-party apps and services" in your Google account. Disconnecting does not delete the files in Google Drive.</p>
      </section>

      <section class="policy-section">
        <h2>5. Disclaimer</h2>
        <p>This website is not responsible for any information or services provided on external sites reached through links or banners on this website.</p>
        <p>We do our best to provide accurate information on this website, but we do not guarantee its accuracy or safety, and some information may be out of date.</p>
        <p>Please note in advance that we cannot accept any responsibility for problems or damage arising from the content of this website.</p>
      </section>

      <section class="policy-section">
        <h2>6. Changes to this privacy policy</h2>
        <p>This website complies with the Japanese laws and regulations that apply to personal information and reviews this policy from time to time to improve it.</p>
        <p>A revised privacy policy takes effect when it is posted on this website, and the latest version is always available on this page.</p>
      </section>

      <section class="policy-section">
        <h2>7. Contact</h2>
        <p>For questions or concerns about how this website handles personal information, please contact us at the address below. You may write in English.</p>
        <div class="contact-box">
          <Picture src="/images/logo.png" alt="KIZUNA Works" width={677} height={369} />
          <a href="mailto:info@kizuna-works.jp">info@kizuna-works.jp</a>
        </div>
      </section>
    </article>
  </main>
</Layout>
