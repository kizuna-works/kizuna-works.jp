---
import Layout from '../../layouts/Layout.astro';

const title = 'Refund Policy | KIZUNA Works';
const description =
  'Refund policy for KIZUNA Works supporter licenses and paid kintone plugins: no refunds after a license is issued, except double charges or similar errors.';
const pageUrl = 'https://kizuna-works.jp/en/refund/';
---

<Layout
  lang="en"
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogUrl={pageUrl}
  ogType="website"
  ogImage="https://kizuna-works.jp/images/ogp.png"
  canonical={pageUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": "https://kizuna-works.jp/en/refund/",
      "url": "https://kizuna-works.jp/en/refund/",
      "name": "Refund Policy | KIZUNA Works",
      "description": "The KIZUNA Works refund policy. No refunds after a license is issued, but please contact us about billing errors such as double charges.",
      "inLanguage": "en",
      "isPartOf": {
        "@type": "WebSite",
        "name": "KIZUNA Works",
        "url": "https://kizuna-works.jp/"
      }
    }
    </script>
  </Fragment>
  <style is:global>
    body {
      background-color: #f4f7f6;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .page-header {
      background:
        linear-gradient(135deg, rgba(27,58,107,0.45) 0%, rgba(42,82,152,0.4) 100%),
        url('/images/contact-bg.webp') center center / cover no-repeat;
      color: #FFFFFF;
      padding: 60px 20px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .page-header::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(90deg, #1B3A6B 0%, #2E8B2E 100%);
    }

    .page-header h1 {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .document-wrapper {
      flex: 1;
      padding: 60px 20px;
      min-width: 0;
    }

    .document-container {
      background-color: #FFFFFF;
      max-width: 800px;
      margin: 0 auto;
      padding: 50px 60px;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      overflow-wrap: anywhere;
    }

    .translation-notice {
      background-color: #F0F4F8;
      border-left: 4px solid #1B3A6B;
      border-radius: 0 8px 8px 0;
      padding: 14px 18px;
      margin-bottom: 40px;
      font-size: 0.92rem;
      color: #4a5568;
      line-height: 1.7;
    }

    .translation-notice a {
      color: #2E8B2E;
    }

    .document-section {
      margin-bottom: 40px;
    }

    .document-section:last-child {
      margin-bottom: 0;
    }

    .document-section h2 {
      font-size: 1.25rem;
      color: #1B3A6B;
      font-weight: 700;
      margin-bottom: 16px;
      padding-left: 14px;
      border-left: 4px solid #2E8B2E;
      line-height: 1.4;
    }

    .document-section p {
      color: #444444;
      margin-bottom: 12px;
    }

    .document-section p:last-child {
      margin-bottom: 0;
    }

    .document-list {
      list-style-type: none;
      margin-top: 10px;
      margin-bottom: 12px;
    }

    .document-list li {
      position: relative;
      padding-left: 1.5em;
      margin-bottom: 8px;
      color: #444444;
    }

    .document-list li::before {
      content: "•";
      position: absolute;
      left: 0.3em;
      color: #2E8B2E;
      font-weight: bold;
    }

    .contact-info {
      background-color: #F0F4F8;
      padding: 20px;
      border-radius: 8px;
      margin-top: 15px;
    }

    .contact-info a {
      color: #1B3A6B;
      font-weight: 700;
      text-decoration: underline;
    }

    .contact-info a:hover {
      color: #2E8B2E;
    }

    @media (max-width: 768px) {
      .page-header {
        padding: 40px 20px;
      }
      .page-header h1 {
        font-size: 1.6rem;
      }
      .document-wrapper {
        padding: 40px 15px;
      }
      .document-container {
        padding: 30px 20px;
      }
      .document-section h2 {
        font-size: 1.15rem;
      }
    }
  </style>

  <section class="page-header">
    <h1>Refund Policy</h1>
  </section>

  <main class="document-wrapper">
    <div class="document-container">

      <p class="translation-notice">
        This is an English translation for convenience. If there is any difference between this translation and the Japanese original, the Japanese version prevails.
        <a href="/refund/" lang="ja">Japanese original (返金ポリシー)</a>
      </p>

      <section class="document-section">
        <h2>1. Basic policy</h2>
        <p>Because of the nature of digital products, <strong>we do not accept refunds or cancellations after a license has been issued.</strong><br>Please be sure to check the product description, system requirements and specifications before purchasing.</p>
        <p>The Premium Annual Supporter plan comes with a 30-day free trial. Please use it to check that everything works before you buy.</p>
      </section>

      <section class="document-section">
        <h2>2. Cases where we cannot offer a refund</h2>
        <ul class="document-list">
          <li>Refunds after a license has been issued</li>
          <li>Cancellations because you changed your mind after purchase</li>
          <li>Cases where your environment was not supported</li>
          <li>Cases where you notice after purchase that it overlaps with another product</li>
          <li>Refunds of the difference or pro-rata adjustments when switching from the Annual Supporter plan to the Premium Annual Supporter plan</li>
        </ul>
      </section>

      <section class="document-section">
        <h2>3. Exceptional cases where we offer a refund</h2>
        <p>We will handle the following cases individually:</p>
        <ul class="document-list">
          <li>An error in our billing, such as a double charge</li>
          <li>A product does not work properly because of a serious defect in the Service, and there is no prospect of a fix</li>
        </ul>
      </section>

      <section class="document-section">
        <h2>4. How to request a refund</h2>
        <p>Please contact us at the email address below. You may write in English.</p>
        <div class="contact-info">
          <p><a href="mailto:info@kizuna-works.jp">info@kizuna-works.jp</a></p>
          <p>Subject: [Refund request] Product name<br>
          Body: please include the purchase date, the product purchased and the reason for the refund.</p>
        </div>
      </section>

      <section class="document-section">
        <h2>5. How refunds are processed</h2>
        <p>When we make an exceptional refund, purchases paid through Square are refunded through Square to the payment method used at purchase, and purchases paid by bank transfer are refunded by transfer to the account you specify.<br>Processing may take 3 to 10 business days.<br>For refunds by bank transfer, we bear the transfer fee.</p>
      </section>

    </div>
  </main>
</Layout>
