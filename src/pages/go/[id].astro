---
/**
 * /go/<広告ID>/ — プラグイン内バナーのクリックを数えて、広告主のページへ移動する中継ページ。
 *
 * 各プラグインの共通 ad.js（v2）は、ads.json の広告（行き先が当社サイトでも他社サイトでも）をすべて
 * https://kizuna-works.jp/go/<id>/?p=<プラグインID> に向ける。ここで GA4 に ad_click を記録してから移動する。
 * 記録先を増やす（スプレッドシートなど）ときは、このページだけ直せばよい（プラグインの版上げは不要）。
 *
 * 行き先はビルド時に public/ads/ads.json から固定で埋め込む（URL で行き先を受け取らない）。
 * 受け取るのはプラグインIDだけで、それも英小文字・数字・ハイフン以外は捨てる。
 * ＝第三者が当社のドメインを使って任意のサイトへ飛ばせる「オープンリダイレクト」にしない。
 *
 * 仕様：SECRET/kintone_plugin_workspace/_planning/ad-remote_design.md
 */
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const file = path.join(process.cwd(), 'public', 'ads', 'ads.json');
  let banners = [];
  try { banners = JSON.parse(fs.readFileSync(file, 'utf8')).banners || []; } catch { banners = []; }
  return banners
    .filter((b) => b && b.type !== 'default' && typeof b.id === 'string' && /^[A-Za-z0-9_-]+$/.test(b.id)
      && typeof b.link === 'string' && /^https:\/\//.test(b.link))
    .map((b) => ({ params: { id: b.id }, props: { dest: b.link, label: b.alt || b.text || b.id } }));
}

const { id } = Astro.params;
const { dest, label } = Astro.props;
const cfg = JSON.stringify({ id, dest });
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  <title>移動しています… | KIZUNA Works</title>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Q1B44N0922"></script>
  <script is:inline define:vars={{ cfg }}>
    (function () {
      var c = JSON.parse(cfg);
      var p = '';
      try { p = (new URLSearchParams(location.search).get('p') || '').replace(/[^a-z0-9-]/g, '').slice(0, 60); } catch (e) { p = ''; }
      var dest = c.dest.split('{plugin}').join(encodeURIComponent(p));
      // 行き先が当社サイトなら、着いたページの GA4 でもバナーからの流入と分かるよう utm を付ける
      if (dest.indexOf('https://kizuna-works.jp/') === 0 && !/[?&]utm_source=/.test(dest)) {
        var hash = '', hi = dest.indexOf('#');
        if (hi >= 0) { hash = dest.slice(hi); dest = dest.slice(0, hi); }
        dest += (dest.indexOf('?') >= 0 ? '&' : '?') + 'utm_source=kizuna-plugin&utm_medium=banner&utm_campaign=' + encodeURIComponent(c.id) + '&utm_content=' + encodeURIComponent(p) + hash;
      }
      var gone = false;
      function go() { if (gone) return; gone = true; location.replace(dest); }
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-Q1B44N0922', { send_page_view: false });
      gtag('event', 'ad_click', { ad_id: c.id, plugin_id: p || '(none)', event_callback: go, event_timeout: 800 });
      setTimeout(go, 1000);
      window.__kzDest = dest;
    })();
  </script>
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #F0F4F8; color: #333333; font-family: "Hiragino Kaku Gothic ProN", Meiryo, sans-serif; padding: 0 16px; }
    p { font-size: 14px; text-align: center; }
    a { color: #1B3A6B; }
  </style>
</head>
<body>
  <p>{label} のページへ移動しています…<br><a id="kz-next" href={dest.split('{plugin}').join('')} rel="noreferrer">移動しない場合はこちら</a></p>
  <script is:inline>
    (function () { var a = document.getElementById('kz-next'); if (a && window.__kzDest) a.href = window.__kzDest; })();
  </script>
</body>
</html>
